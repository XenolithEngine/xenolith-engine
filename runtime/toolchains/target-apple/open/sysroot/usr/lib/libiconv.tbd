--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-macos, arm64-macos ]
install-name:    '/usr/lib/libiconv.2.dylib'
current-version: 7.0.0
compatibility-version: 7.0.0
exports:
  - targets:         [ x86_64-macos, arm64-macos ]
    symbols:         [
        _iconv,
        _iconv_open,
        _iconv_close,
        _iconvctl,
        _iconvlist,
        _iconv_canonicalize,
        _iconv_open_into,
        _libiconv_set_relocation_prefix,
        __libiconv_version,
        ___iconv,
        ___iconv_free_list,
        ___iconv_get_list,
        __citrus_iconv_open,
        __citrus_iconv_close,
        __citrus_iconv_canonicalize,
        ___bsd_iconv,
        ___bsd_iconv_open,
        ___bsd_iconv_close,
        ___bsd_iconvctl,
        ___bsd_iconvlist,
        ___bsd_iconv_canonicalize,
        ___bsd_iconv_open_into,
        ___bsd_iconv_set_relocation_prefix,
        ___bsd___iconv,
        ___bsd___iconv_free_list,
        ___bsd___iconv_get_list,
    ]
...
