Subject: [PATCH] Keep the static archive name independent of the MSVC frontend

Consumers use z.lib on Windows and libz.a elsewhere. zlib 1.4 chooses
libzs.lib for MSVC and zs.lib for clang's GNU-style frontend targeting
Windows. Set the archive name once so the installed CMake exports and
pkg-config metadata agree with the library name we ship.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -321,15 +321,7 @@
         set_target_properties(zlibstatic PROPERTIES PREFIX "lib")
     endif(CYGWIN)
 
-    if(MSVC)
-        set_target_properties(zlibstatic
-            PROPERTIES
-                ARCHIVE_OUTPUT_NAME libz${zlib_static_suffix})
-    else(MSVC)
-        set_target_properties(zlibstatic
-            PROPERTIES
-                ARCHIVE_OUTPUT_NAME z${zlib_static_suffix})
-    endif(MSVC)
+    set_target_properties(zlibstatic PROPERTIES ARCHIVE_OUTPUT_NAME z)
 
     set_target_properties(zlibstatic
         PROPERTIES
