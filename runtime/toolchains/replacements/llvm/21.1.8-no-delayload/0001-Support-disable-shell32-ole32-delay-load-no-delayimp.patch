From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Xenolith Team <admin@xenolith.studio>
Date: Thu, 17 Jul 2026 00:00:00 +0000
Subject: [PATCH] Support: disable shell32/ole32 delay-load (no delayimp)

The freestanding sprt Windows runtime ships no MSVC delay-load helper
(__delayLoadHelper2 / delayimp.lib). Link shell32.dll and ole32.dll as
ordinary imports (already in system_libs) instead of delay-loading them,
dropping the delayimp dependency. Startup cost is negligible for the tools.
---
diff --git a/llvm/lib/Support/CMakeLists.txt b/llvm/lib/Support/CMakeLists.txt
index a579eaf7d..e3dc97d5c 100644
--- a/llvm/lib/Support/CMakeLists.txt
+++ b/llvm/lib/Support/CMakeLists.txt
@@ -82,15 +82,12 @@ if(CMAKE_VERSION VERSION_GREATER_EQUAL "3.25"
   set(WL "$<$<OR:$<LINK_LANG_AND_ID:C,IntelLLVM>,$<LINK_LANG_AND_ID:CXX,IntelLLVM>,$<LINK_LANG_AND_ID:Fortran,IntelLLVM>>:-Qoption,link,>")
 endif()
 
-# Delay load shell32.dll if possible to speed up process startup.
+# Delay loading of shell32.dll / ole32.dll is disabled for the sprt Windows target:
+# the freestanding sprt runtime ships no MSVC delay-load helper (__delayLoadHelper2 /
+# delayimp.lib), so shell32/ole32 are linked as ordinary imports instead (they are
+# already in system_libs above). The lost startup optimisation is negligible for the
+# LLVM tools. Keep delayload_flags defined (empty) so the link line below is unchanged.
 set (delayload_flags)
-if (MSVC)
-  # When linking with Swift, `swiftc.exe` is used as the linker drive rather
-  # than invoking `link.exe` directly.  In such a case, the flags should be
-  # marked as `-Xlinker` to pass them directly to the linker.  As a temporary
-  # workaround simply elide the delay loading.
-  set (delayload_flags $<$<NOT:$<LINK_LANGUAGE:Swift>>:delayimp ${WL}-delayload:shell32.dll ${WL}-delayload:ole32.dll>)
-endif()
 
 # Link Z3 if the user wants to build it.
 if(LLVM_WITH_Z3)
-- 
