diff --git a/llvm/lib/TargetParser/Host.cpp b/llvm/lib/TargetParser/Host.cpp
index b01dca93d..4ecb9bb1c 100644
--- a/llvm/lib/TargetParser/Host.cpp
+++ b/llvm/lib/TargetParser/Host.cpp
@@ -1644,6 +1644,14 @@ StringRef sys::getHostCPUName() {
   StringRef Content = P ? P->getBuffer() : "";
   return detail::getHostCPUNameForARM(Content);
 }
+#elif defined(__EMBOX__) && defined(__aarch64__)
+// Embox runs applications at EL1, where MIDR_EL1 is readable directly; there
+// is no /proc/cpuinfo. Only the current core is seen.
+StringRef sys::getHostCPUName() {
+  uint64_t Midr;
+  asm volatile("mrs %0, midr_el1" : "=r"(Midr));
+  return detail::getHostCPUNameForARM(Midr, ArrayRef<uint64_t>(Midr));
+}
 #elif defined(__linux__) && defined(__s390x__)
 StringRef sys::getHostCPUName() {
   std::unique_ptr<llvm::MemoryBuffer> P = getProcCpuinfoContent();
@@ -2531,6 +2539,32 @@ StringMap<bool> sys::getHostCPUFeatures() {
 
   return Features;
 }
+#elif defined(__EMBOX__) && defined(__aarch64__)
+// The features Linux reports in /proc/cpuinfo, read from the ID registers at
+// EL1 (see Documentation/arch/arm64/elf_hwcaps.rst for the fields).
+StringMap<bool> sys::getHostCPUFeatures() {
+  uint64_t Pfr0, Isar0;
+  asm volatile("mrs %0, id_aa64pfr0_el1" : "=r"(Pfr0));
+  asm volatile("mrs %0, id_aa64isar0_el1" : "=r"(Isar0));
+  auto Field = [](uint64_t Reg, unsigned Shift) { return (Reg >> Shift) & 0xf; };
+
+  StringMap<bool> Features;
+  // FP and AdvSIMD: 0xf is "not implemented", other values are versions.
+  Features["fp-armv8"] = Field(Pfr0, 16) != 0xf;
+  Features["neon"] = Field(Pfr0, 20) != 0xf;
+  Features["aes"] = Field(Isar0, 4) >= 2; // AES with PMULL
+  Features["sha2"] = Field(Isar0, 8) >= 1 && Field(Isar0, 12) >= 1;
+  Features["crc"] = Field(Isar0, 16) >= 1;
+  Features["lse"] = Field(Isar0, 20) >= 2;
+  Features["sha3"] = Field(Isar0, 32) >= 1;
+  Features["sm4"] = Field(Isar0, 40) >= 1;
+  Features["rand"] = Field(Isar0, 60) >= 1;
+  // The kernel does not enable SVE or SME (CPACR_EL1.ZEN/SMEN) and does not
+  // switch their state, so they are off whatever the core has.
+  Features["sve"] = false;
+  Features["sme"] = false;
+  return Features;
+}
 #else
 StringMap<bool> sys::getHostCPUFeatures() { return {}; }
 #endif
