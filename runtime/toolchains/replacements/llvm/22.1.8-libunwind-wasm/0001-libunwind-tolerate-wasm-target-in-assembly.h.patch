From 4c46ef2013fc728e570e366abad052f788095b53 Mon Sep 17 00:00:00 2001
From: SBKarr <sbkarr@stappler.org>
Date: Fri, 10 Jul 2026 17:38:38 +0800
Subject: [PATCH] libunwind: tolerate wasm target in assembly.h

---
 libunwind/src/assembly.h | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/libunwind/src/assembly.h b/libunwind/src/assembly.h
index f8e83e138..67dc11b0e 100644
--- a/libunwind/src/assembly.h
+++ b/libunwind/src/assembly.h
@@ -250,6 +250,17 @@ aliasname:                                                                     \
 #define NO_EXEC_STACK_DIRECTIVE
 
 // clang-format on
+#elif defined(__wasm__)
+
+// WebAssembly has no assembly implementation of the register save/restore
+// routines: the bodies of UnwindRegisters{Save,Restore}.S are wrapped in
+// `#if !defined(__wasm__)` and expand to nothing. None of the platform macros
+// defined above are referenced on wasm EXCEPT NO_EXEC_STACK_DIRECTIVE, which is
+// emitted unconditionally at end-of-file. Define it empty (wasm has no
+// executable-stack concept) so the assembler translation unit compiles cleanly
+// instead of tripping the "Unsupported target" #error below.
+#define NO_EXEC_STACK_DIRECTIVE
+
 #else
 
 #error Unsupported target
-- 
2.54.0

