+++ b/llvm/lib/Support/Unix/Unix.h
@@ -30,7 +30,7 @@
 #include <string>
 #include <sys/types.h>
 
-#if !defined(__wasm__)
+#if !defined(__wasm__) && !defined(__TAU__)
 #include <sys/wait.h>
 #endif
 
