Subject: [PATCH] Tau: a Unix platform without window systems

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -111,7 +111,7 @@
     if (CMAKE_SYSTEM_NAME STREQUAL "Darwin")
         target_compile_definitions(platform_wsi INTERFACE VK_USE_PLATFORM_MACOS_MVK)
     endif()
-elseif(CMAKE_SYSTEM_NAME MATCHES "Linux|BSD|DragonFly|GNU|CYGWIN")
+elseif(CMAKE_SYSTEM_NAME MATCHES "Linux|BSD|DragonFly|GNU|CYGWIN|Tau")
     option(BUILD_WSI_XCB_SUPPORT "Build XCB WSI support" ON)
     option(BUILD_WSI_XLIB_SUPPORT "Build Xlib WSI support" ON)
     option(BUILD_WSI_XLIB_XRANDR_SUPPORT "Build X11 Xrandr WSI support" ON)
--- a/loader/vk_loader_platform.h
+++ b/loader/vk_loader_platform.h
@@ -44,7 +44,8 @@
 
 // Set of platforms with a common set of functionality which is queried throughout the program
 #if defined(__linux__) || defined(__APPLE__) || defined(__Fuchsia__) || defined(__QNX__) || defined(__FreeBSD__) || \
-    defined(__OpenBSD__) || defined(__NetBSD__) || defined(__DragonFly__) || defined(__GNU__) || defined(__CYGWIN__)
+    defined(__OpenBSD__) || defined(__NetBSD__) || defined(__DragonFly__) || defined(__GNU__) || defined(__CYGWIN__) || \
+    defined(__TAU__)
 #define COMMON_UNIX_PLATFORMS 1
 #else
 #define COMMON_UNIX_PLATFORMS 0
@@ -56,7 +57,9 @@
 #include <dlfcn.h>
 #include <pthread.h>
 #include <stdlib.h>
+#if !defined(__TAU__)
 #include <libgen.h>
+#endif
 
 #elif defined(_WIN32)
 // WinBase.h defines CreateSemaphore and synchapi.h defines CreateEvent
@@ -298,7 +301,19 @@
         return false;
 }
 
+#if defined(__TAU__)
+// The engine's libc has no <libgen.h>: dirname() in place.
+static inline char *loader_platform_dirname(char *path) {
+    static char dot[] = ".";
+    char *slash = strrchr(path, '/');
+    if (slash == NULL) return dot;
+    if (slash == path) slash++;
+    *slash = '\0';
+    return path;
+}
+#else
 static inline char *loader_platform_dirname(char *path) { return dirname(path); }
+#endif
 
 // loader_platform_executable_path finds application path + name.
 // Path cannot be longer than 1024, returns NULL if it is greater than that.
@@ -360,7 +375,7 @@
 
     return buffer;
 }
-#elif defined(__Fuchsia__) || defined(__OpenBSD__)
+#elif defined(__Fuchsia__) || defined(__OpenBSD__) || defined(__TAU__)
 static inline char *loader_platform_executable_path(char *buffer, size_t size) { return NULL; }
 #elif defined(__QNX__)
 
