diff --git a/src/util/libsync.h b/src/util/libsync.h
index b22b75a..3430e76 100644
--- a/src/util/libsync.h
+++ b/src/util/libsync.h
@@ -43,6 +43,12 @@
 #include "util/detect_os.h"
 #include "util/os_file.h"
 
+#if DETECT_OS_EMBOX && !defined(_IOWR)
+/* The libc layer's sys/ioctl.h does not encode requests. There are no sync
+ * files on Embox: these requests only have to compile, and fail on any fd. */
+#define _IOWR(type, nr, arg) ((((type) & 0xff) << 8) | ((nr) & 0xff))
+#endif
+
