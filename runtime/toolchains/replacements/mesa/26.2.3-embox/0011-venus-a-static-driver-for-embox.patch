 extern "C" {
 #endif
diff --git a/src/virtio/vulkan/meson.build b/src/virtio/vulkan/meson.build
index fda382d..2182379 100644
--- a/src/virtio/vulkan/meson.build
+++ b/src/virtio/vulkan/meson.build
@@ -122,7 +122,11 @@ vn_link_args = [
 
 vn_libs = []
 
-if not with_platform_windows
+# Embox: the virtio-gpu driver is in the kernel image and its C API
+# (xl_vgpu.h) is the transport; no vtest socket, no DRM.
+if host_machine.system() == 'embox'
+  libvn_files += files('vn_renderer_embox.c')
+elif not with_platform_windows
   libvn_files += files('vn_renderer_vtest.c')
 endif
 
@@ -136,7 +140,7 @@ endif
 
 if with_platform_wayland or with_platform_x11 or \
    (system_has_kms_drm and not with_platform_android) or \
-   with_platform_windows
+   with_platform_windows or host_machine.system() == 'embox'
   libvn_files += files('vn_wsi.c')
   vn_c_args += '-DVN_USE_WSI_PLATFORM'
 endif
@@ -154,6 +158,23 @@ if with_platform_android
   vn_deps += [dep_android, idep_u_gralloc]
 endif
 
+# Embox has no dynamic loader: the driver is linked into the kernel image and
+# the application takes vk_icdGetInstanceProcAddr from it directly, as with
+# lavapipe. The internal libraries it depends on are bundled into the archive
+# (it is installed, they are not); the application links it whole, since the
+# dispatch tables name the entry points as weak symbols.
+if host_machine.system() == 'embox'
+libvulkan_virtio = static_library(
+  'vulkan_virtio',
+  [libvn_files, vn_entrypoints, vn_drirc, sha1_h],
+  include_directories : vn_incs,
+  link_with : vn_libs,
+  dependencies : vn_deps,
+  c_args : vn_c_args,
+  gnu_symbol_visibility : 'hidden',
+  install : true,
+)
+else
 libvulkan_virtio = shared_library(
   'vulkan_virtio',
   [libvn_files, vn_entrypoints, vn_drirc, sha1_h],
@@ -166,3 +187,4 @@ libvulkan_virtio = shared_library(
   gnu_symbol_visibility : 'hidden',
   install : true,
 )
+endif
