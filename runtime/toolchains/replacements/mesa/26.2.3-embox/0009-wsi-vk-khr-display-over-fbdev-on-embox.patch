+/** VK_KHR_display over a framebuffer device, for systems without DRM/KMS.
+ *
+ * Written for Embox, where lavapipe is linked into the kernel image and the
+ * screen is /dev/fb0 (MESA_WSI_FBDEV names another). It stands in for
+ * wsi_common_display.c: the same wsi_display_init_wsi() and the VK_KHR_display
+ * entrypoints, with one display (the framebuffer), one mode (its resolution)
+ * and one plane.
+ *
+ * Swapchain images are CPU images (sw devices: linear, host-visible, mapped for
+ * their lifetime), as in the headless backend. Presenting copies the damaged
+ * rows into the framebuffer mapping: the bounding box of the present regions,
+ * x widened to 16 pixels so each row starts on a cache line (a framebuffer may
+ * be uncached or Device memory, where unaligned wide stores are slow or fault).
+ * There is one buffer and no vblank: FIFO presents as soon as the copy is done.
+ *
+ * The framebuffer is opened once per process and never closed: the last close
+ * of fb0 blanks the output on some boards (bcm2711).
+ */
+
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <linux/fb.h>
+
+#include "c11/threads.h"
+#include "util/macros.h"
+#include "util/timespec.h"
+#include "vk_instance.h"
+#include "vk_physical_device.h"
+#include "vk_util.h"
+#include "wsi_common_entrypoints.h"
+#include "wsi_common_private.h"
+
+/* Clean a cacheable framebuffer after writing to it (Xenolith's fb_dev.c,
+ * 'F' 0x30). ENOSYS where there is nothing to clean (QEMU ramfb). */
+#define WSI_FBDEV_FLUSH_CACHE 0x4630
+
+struct wsi_fbdev_flush_range {
+   void *ptr;
+   size_t len;
+};
+
+/* The process' framebuffer: opened on first use, kept for good. */
+struct wsi_fbdev_screen {
+   int fd;
+   uint8_t *map;
+   size_t map_size;
+   uint32_t stride;
+   uint32_t width;
+   uint32_t height;
+   mtx_t mutex; /* one screen, presents from any swapchain */
+};
+
+static struct wsi_fbdev_screen fbdev_screen = { .fd = -1 };
+static once_flag fbdev_screen_once = ONCE_FLAG_INIT;
+
+static void
+wsi_fbdev_open_screen(void)
+{
+   struct wsi_fbdev_screen *screen = &fbdev_screen;
+   const char *path = getenv("MESA_WSI_FBDEV");
+   if (!path || !path[0])
+      path = "/dev/fb0";
+
+   mtx_init(&screen->mutex, mtx_plain);
+
+   int fd = open(path, O_RDWR);
+   if (fd < 0)
+      return;
+
+   struct fb_var_screeninfo var;
+   struct fb_fix_screeninfo fix;
+   memset(&var, 0, sizeof(var));
+   memset(&fix, 0, sizeof(fix));
+   if (ioctl(fd, FBIOGET_VSCREENINFO, &var) < 0 ||
+       ioctl(fd, FBIOGET_FSCREENINFO, &fix) < 0 ||
+       var.bits_per_pixel != 32 || var.xres == 0 || var.yres == 0 ||
+       fix.line_length < var.xres * 4 ||
+       fix.smem_len < (size_t)fix.line_length * var.yres) {
+      close(fd);
+      return;
+   }
+
+   void *map = mmap(NULL, fix.smem_len, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+   if (map == MAP_FAILED) {
+      close(fd);
+      return;
+   }
+
+   screen->map = map;
+   screen->map_size = fix.smem_len;
+   screen->stride = fix.line_length;
+   screen->width = var.xres;
+   screen->height = var.yres;
+   screen->fd = fd;
+}
+
+static struct wsi_fbdev_screen *
+wsi_fbdev_get_screen(void)
+{
+   call_once(&fbdev_screen_once, wsi_fbdev_open_screen);
+   return fbdev_screen.fd >= 0 ? &fbdev_screen : NULL;
+}
+
+/* VkDisplayKHR and VkDisplayModeKHR: the backend's own objects. */
+typedef struct wsi_fbdev_connector {
+   uint32_t unused;
+} wsi_fbdev_connector;
+
+typedef struct wsi_fbdev_mode {
+   uint32_t width;
+   uint32_t height;
+} wsi_fbdev_mode;
+
+ICD_DEFINE_NONDISP_HANDLE_CASTS(wsi_fbdev_connector, VkDisplayKHR)
+ICD_DEFINE_NONDISP_HANDLE_CASTS(wsi_fbdev_mode, VkDisplayModeKHR)
+
+/* Nominal: a framebuffer has no vblank to report. */
+#define WSI_FBDEV_REFRESH_MHZ 60000
+
+struct wsi_fbdev {
+   struct wsi_interface base;
+   const VkAllocationCallbacks *alloc;
+   struct wsi_fbdev_screen *screen; /* NULL: no framebuffer, no displays */
+   wsi_fbdev_connector connector;
+   wsi_fbdev_mode mode;
+};
+
+static struct wsi_fbdev *
+wsi_fbdev_from_pdevice(VkPhysicalDevice physicalDevice)
+{
+   VK_FROM_HANDLE(vk_physical_device, pdevice, physicalDevice);
+   struct wsi_device *wsi_device = pdevice->wsi_device;
+   return (struct wsi_fbdev *)wsi_device->wsi[VK_ICD_WSI_PLATFORM_DISPLAY];
+}
+
+#define MM_PER_PIXEL (1.0 / 96.0 * 25.4)
+
+static void
+wsi_fbdev_fill_display_properties(struct wsi_fbdev *wsi,
+                                  VkDisplayPropertiesKHR *properties)
+{
+   properties->display = wsi_fbdev_connector_to_handle(&wsi->connector);
+   properties->displayName = "fb0";
+   properties->physicalResolution.width = wsi->mode.width;
+   properties->physicalResolution.height = wsi->mode.height;
+   /* 96 dpi, as wsi_common_display.c does without EDID */
+   properties->physicalDimensions.width =
+      (uint32_t)(wsi->mode.width * MM_PER_PIXEL + 0.5);
+   properties->physicalDimensions.height =
+      (uint32_t)(wsi->mode.height * MM_PER_PIXEL + 0.5);
+   properties->supportedTransforms = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+   properties->planeReorderPossible = VK_FALSE;
+   /* what is not presented again stays on the screen */
+   properties->persistentContent = VK_TRUE;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+wsi_GetPhysicalDeviceDisplayPropertiesKHR(VkPhysicalDevice physicalDevice,
+                                          uint32_t *pPropertyCount,
+                                          VkDisplayPropertiesKHR *pProperties)
+{
+   struct wsi_fbdev *wsi = wsi_fbdev_from_pdevice(physicalDevice);
+   VK_OUTARRAY_MAKE_TYPED(VkDisplayPropertiesKHR, out, pProperties, pPropertyCount);
+
+   if (wsi && wsi->screen) {
+      vk_outarray_append_typed(VkDisplayPropertiesKHR, &out, prop) {
+         wsi_fbdev_fill_display_properties(wsi, prop);
+      }
+   }
+   return vk_outarray_status(&out);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+wsi_GetPhysicalDeviceDisplayProperties2KHR(VkPhysicalDevice physicalDevice,
+                                           uint32_t *pPropertyCount,
+                                           VkDisplayProperties2KHR *pProperties)
+{
+   struct wsi_fbdev *wsi = wsi_fbdev_from_pdevice(physicalDevice);
+   VK_OUTARRAY_MAKE_TYPED(VkDisplayProperties2KHR, out, pProperties, pPropertyCount);
+
+   if (wsi && wsi->screen) {
+      vk_outarray_append_typed(VkDisplayProperties2KHR, &out, prop) {
+         wsi_fbdev_fill_display_properties(wsi, &prop->displayProperties);
+      }
+   }
+   return vk_outarray_status(&out);
+}
+
+static void
+wsi_fbdev_fill_plane_properties(struct wsi_fbdev *wsi,
+                                VkDisplayPlanePropertiesKHR *prop)
+{
+   prop->currentDisplay = wsi_fbdev_connector_to_handle(&wsi->connector);
+   prop->currentStackIndex = 0;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+wsi_GetPhysicalDeviceDisplayPlanePropertiesKHR(VkPhysicalDevice physicalDevice,
+                                               uint32_t *pPropertyCount,
+                                               VkDisplayPlanePropertiesKHR *pProperties)
+{
+   struct wsi_fbdev *wsi = wsi_fbdev_from_pdevice(physicalDevice);
+   VK_OUTARRAY_MAKE_TYPED(VkDisplayPlanePropertiesKHR, out, pProperties, pPropertyCount);
+
+   if (wsi && wsi->screen) {
+      vk_outarray_append_typed(VkDisplayPlanePropertiesKHR, &out, prop) {
+         wsi_fbdev_fill_plane_properties(wsi, prop);
+      }
+   }
+   return vk_outarray_status(&out);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+wsi_GetPhysicalDeviceDisplayPlaneProperties2KHR(VkPhysicalDevice physicalDevice,
+                                                uint32_t *pPropertyCount,
+                                                VkDisplayPlaneProperties2KHR *pProperties)
+{
+   struct wsi_fbdev *wsi = wsi_fbdev_from_pdevice(physicalDevice);
+   VK_OUTARRAY_MAKE_TYPED(VkDisplayPlaneProperties2KHR, out, pProperties, pPropertyCount);
+
+   if (wsi && wsi->screen) {
+      vk_outarray_append_typed(VkDisplayPlaneProperties2KHR, &out, prop) {
+         wsi_fbdev_fill_plane_properties(wsi, &prop->displayPlaneProperties);
+      }
+   }
+   return vk_outarray_status(&out);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+wsi_GetDisplayPlaneSupportedDisplaysKHR(VkPhysicalDevice physicalDevice,
+                                        uint32_t planeIndex,
+                                        uint32_t *pDisplayCount,
+                                        VkDisplayKHR *pDisplays)
+{
+   struct wsi_fbdev *wsi = wsi_fbdev_from_pdevice(physicalDevice);
+   VK_OUTARRAY_MAKE_TYPED(VkDisplayKHR, out, pDisplays, pDisplayCount);
+
+   if (wsi && wsi->screen && planeIndex == 0) {
+      vk_outarray_append_typed(VkDisplayKHR, &out, display) {
+         *display = wsi_fbdev_connector_to_handle(&wsi->connector);
+      }
+   }
+   return vk_outarray_status(&out);
+}
+
+static void
+wsi_fbdev_fill_mode_properties(struct wsi_fbdev *wsi,
+                               VkDisplayModePropertiesKHR *prop)
+{
+   prop->displayMode = wsi_fbdev_mode_to_handle(&wsi->mode);
+   prop->parameters.visibleRegion.width = wsi->mode.width;
+   prop->parameters.visibleRegion.height = wsi->mode.height;
+   prop->parameters.refreshRate = WSI_FBDEV_REFRESH_MHZ;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+wsi_GetDisplayModePropertiesKHR(VkPhysicalDevice physicalDevice,
+                                VkDisplayKHR display,
+                                uint32_t *pPropertyCount,
+                                VkDisplayModePropertiesKHR *pProperties)
+{
+   struct wsi_fbdev *wsi = wsi_fbdev_from_pdevice(physicalDevice);
+   VK_OUTARRAY_MAKE_TYPED(VkDisplayModePropertiesKHR, out, pProperties, pPropertyCount);
+
+   if (wsi && wsi->screen &&
+       wsi_fbdev_connector_from_handle(display) == &wsi->connector) {
+      vk_outarray_append_typed(VkDisplayModePropertiesKHR, &out, prop) {
+         wsi_fbdev_fill_mode_properties(wsi, prop);
+      }
+   }
+   return vk_outarray_status(&out);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+wsi_GetDisplayModeProperties2KHR(VkPhysicalDevice physicalDevice,
+                                 VkDisplayKHR display,
+                                 uint32_t *pPropertyCount,
+                                 VkDisplayModeProperties2KHR *pProperties)
+{
+   struct wsi_fbdev *wsi = wsi_fbdev_from_pdevice(physicalDevice);
+   VK_OUTARRAY_MAKE_TYPED(VkDisplayModeProperties2KHR, out, pProperties, pPropertyCount);
+
+   if (wsi && wsi->screen &&
+       wsi_fbdev_connector_from_handle(display) == &wsi->connector) {
+      vk_outarray_append_typed(VkDisplayModeProperties2KHR, &out, prop) {
+         wsi_fbdev_fill_mode_properties(wsi, &prop->displayModeProperties);
+      }
+   }
+   return vk_outarray_status(&out);
+}
+
+/* The one mode there is, when that is what is asked for (as with KMS). */
+VKAPI_ATTR VkResult VKAPI_CALL
+wsi_CreateDisplayModeKHR(VkPhysicalDevice physicalDevice,
+                         VkDisplayKHR display,
+                         const VkDisplayModeCreateInfoKHR *pCreateInfo,
+                         const VkAllocationCallbacks *pAllocator,
+                         VkDisplayModeKHR *pMode)
+{
+   struct wsi_fbdev *wsi = wsi_fbdev_from_pdevice(physicalDevice);
+
+   if (!wsi || !wsi->screen || pCreateInfo->flags != 0 ||
+       wsi_fbdev_connector_from_handle(display) != &wsi->connector)
+      return VK_ERROR_INITIALIZATION_FAILED;
+
+   const VkDisplayModeParametersKHR *params = &pCreateInfo->parameters;
+   if (params->visibleRegion.width != wsi->mode.width ||
+       params->visibleRegion.height != wsi->mode.height ||
+       (params->refreshRate != 0 && params->refreshRate != WSI_FBDEV_REFRESH_MHZ))
+      return VK_ERROR_INITIALIZATION_FAILED;
+
+   *pMode = wsi_fbdev_mode_to_handle(&wsi->mode);
+   return VK_SUCCESS;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+wsi_GetDisplayPlaneCapabilitiesKHR(VkPhysicalDevice physicalDevice,
+                                   VkDisplayModeKHR _mode,
+                                   uint32_t planeIndex,
+                                   VkDisplayPlaneCapabilitiesKHR *pCapabilities)
+{
+   wsi_fbdev_mode *mode = wsi_fbdev_mode_from_handle(_mode);
+
+   memset(pCapabilities, 0, sizeof(*pCapabilities));
+   pCapabilities->supportedAlpha = VK_DISPLAY_PLANE_ALPHA_OPAQUE_BIT_KHR;
+   pCapabilities->minSrcExtent.width = mode->width;
+   pCapabilities->minSrcExtent.height = mode->height;
+   pCapabilities->maxSrcExtent.width = mode->width;
+   pCapabilities->maxSrcExtent.height = mode->height;
+   pCapabilities->minDstExtent.width = mode->width;
+   pCapabilities->minDstExtent.height = mode->height;
+   pCapabilities->maxDstExtent.width = mode->width;
+   pCapabilities->maxDstExtent.height = mode->height;
+   return VK_SUCCESS;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+wsi_GetDisplayPlaneCapabilities2KHR(VkPhysicalDevice physicalDevice,
+                                    const VkDisplayPlaneInfo2KHR *pDisplayPlaneInfo,
+                                    VkDisplayPlaneCapabilities2KHR *pCapabilities)
+{
+   assert(pCapabilities->sType == VK_STRUCTURE_TYPE_DISPLAY_PLANE_CAPABILITIES_2_KHR);
+
+   VkResult result =
+      wsi_GetDisplayPlaneCapabilitiesKHR(physicalDevice, pDisplayPlaneInfo->mode,
+                                         pDisplayPlaneInfo->planeIndex,
+                                         &pCapabilities->capabilities);
+
+   vk_foreach_struct(ext, pCapabilities->pNext) {
+      if (ext->sType == VK_STRUCTURE_TYPE_SURFACE_PROTECTED_CAPABILITIES_KHR) {
+         VkSurfaceProtectedCapabilitiesKHR *protected = (void *)ext;
+         protected->supportsProtected = VK_FALSE;
+      }
+   }
+
+   return result;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+wsi_CreateDisplayPlaneSurfaceKHR(VkInstance _instance,
+                                 const VkDisplaySurfaceCreateInfoKHR *pCreateInfo,
+                                 const VkAllocationCallbacks *pAllocator,
+                                 VkSurfaceKHR *pSurface)
+{
+   VK_FROM_HANDLE(vk_instance, instance, _instance);
+   VkIcdSurfaceDisplay *surface;
+
+   assert(pCreateInfo->sType == VK_STRUCTURE_TYPE_DISPLAY_SURFACE_CREATE_INFO_KHR);
+
+   surface = vk_zalloc2(&instance->alloc, pAllocator, sizeof(*surface), 8,
+                        VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   if (surface == NULL)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   surface->base.platform = VK_ICD_WSI_PLATFORM_DISPLAY;
+   surface->displayMode = pCreateInfo->displayMode;
+   surface->planeIndex = pCreateInfo->planeIndex;
+   surface->planeStackIndex = pCreateInfo->planeStackIndex;
+   surface->transform = pCreateInfo->transform;
+   surface->globalAlpha = pCreateInfo->globalAlpha;
+   surface->alphaMode = pCreateInfo->alphaMode;
+   surface->imageExtent = pCreateInfo->imageExtent;
+
+   *pSurface = VkIcdSurfaceBase_to_handle(&surface->base);
+   return VK_SUCCESS;
+}
+
+static VkResult
+wsi_fbdev_surface_get_support(VkIcdSurfaceBase *surface,
+                              struct wsi_device *wsi_device,
+                              uint32_t queueFamilyIndex,
+                              VkBool32 *pSupported)
+{
+   struct wsi_fbdev *wsi = (struct wsi_fbdev *)wsi_device->wsi[VK_ICD_WSI_PLATFORM_DISPLAY];
+
+   *pSupported = wsi->screen != NULL;
+   return VK_SUCCESS;
+}
+
+static const VkPresentModeKHR present_modes[] = {
+   VK_PRESENT_MODE_FIFO_KHR,
+   VK_PRESENT_MODE_IMMEDIATE_KHR,
+   VK_PRESENT_MODE_MAILBOX_KHR,
+};
+
+static VkResult
+wsi_fbdev_surface_get_capabilities(VkIcdSurfaceBase *surface_base,
+                                   struct wsi_device *wsi_device,
+                                   VkSurfaceCapabilities2KHR *caps)
+{
+   VkIcdSurfaceDisplay *surface = (VkIcdSurfaceDisplay *)surface_base;
+   wsi_fbdev_mode *mode = wsi_fbdev_mode_from_handle(surface->displayMode);
+
+   caps->surfaceCapabilities.currentExtent.width = mode->width;
+   caps->surfaceCapabilities.currentExtent.height = mode->height;
+   caps->surfaceCapabilities.minImageExtent = (VkExtent2D) { 1, 1 };
+   caps->surfaceCapabilities.maxImageExtent = (VkExtent2D) {
+      wsi_device->maxImageDimension2D,
+      wsi_device->maxImageDimension2D,
+   };
+
+   caps->surfaceCapabilities.supportedCompositeAlpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
+   caps->surfaceCapabilities.minImageCount = 2;
+   caps->surfaceCapabilities.maxImageCount = 8;
+   caps->surfaceCapabilities.supportedTransforms = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+   caps->surfaceCapabilities.currentTransform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+   caps->surfaceCapabilities.maxImageArrayLayers = 1;
+
+   VkImageUsageFlags image_usage = wsi_caps_get_image_usage();
+
+   VK_FROM_HANDLE(vk_physical_device, pdevice, wsi_device->pdevice);
+   if (pdevice->supported_extensions.EXT_attachment_feedback_loop_layout)
+      image_usage |= VK_IMAGE_USAGE_ATTACHMENT_FEEDBACK_LOOP_BIT_EXT;
+
+   VkImageUsageFlags2CreateInfoKHR *usage2 =
+      vk_find_struct(caps->pNext, IMAGE_USAGE_FLAGS_2_CREATE_INFO_KHR);
+   if (usage2) {
+      usage2->usage = image_usage;
+   } else {
+      caps->surfaceCapabilities.supportedUsageFlags = image_usage;
+   }
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+wsi_fbdev_surface_get_capabilities2(VkIcdSurfaceBase *surface,
+                                    struct wsi_device *wsi_device,
+                                    const void *info_next,
+                                    VkSurfaceCapabilities2KHR *caps)
+{
+   assert(caps->sType == VK_STRUCTURE_TYPE_SURFACE_CAPABILITIES_2_KHR);
+
+   const VkSurfacePresentModeKHR *present_mode =
+      vk_find_struct_const(info_next, SURFACE_PRESENT_MODE_EXT);
+
+   VkResult result = wsi_fbdev_surface_get_capabilities(surface, wsi_device, caps);
+
+   vk_foreach_struct(ext, caps->pNext) {
+      switch (ext->sType) {
+      case VK_STRUCTURE_TYPE_SURFACE_PROTECTED_CAPABILITIES_KHR: {
+         VkSurfaceProtectedCapabilitiesKHR *protected = (void *)ext;
+         protected->supportsProtected = VK_FALSE;
+         break;
+      }
+      case VK_STRUCTURE_TYPE_SURFACE_PRESENT_SCALING_CAPABILITIES_KHR: {
+         VkSurfacePresentScalingCapabilitiesKHR *scaling = (void *)ext;
+         scaling->supportedPresentScaling = 0;
+         scaling->supportedPresentGravityX = 0;
+         scaling->supportedPresentGravityY = 0;
+         scaling->minScaledImageExtent = caps->surfaceCapabilities.minImageExtent;
+         scaling->maxScaledImageExtent = caps->surfaceCapabilities.maxImageExtent;
+         break;
+      }
+      case VK_STRUCTURE_TYPE_SURFACE_PRESENT_MODE_COMPATIBILITY_KHR: {
+         VkSurfacePresentModeCompatibilityKHR *compat = (void *)ext;
+         if (compat->pPresentModes == NULL) {
+            compat->presentModeCount = 1;
+         } else if (compat->presentModeCount) {
+            compat->presentModeCount = 1;
+            compat->pPresentModes[0] =
+               present_mode ? present_mode->presentMode : VK_PRESENT_MODE_FIFO_KHR;
+         }
+         break;
+      }
+      case VK_STRUCTURE_TYPE_PRESENT_TIMING_SURFACE_CAPABILITIES_EXT: {
+         VkPresentTimingSurfaceCapabilitiesEXT *timing = (void *)ext;
+         timing->presentStageQueries = 0;
+         timing->presentTimingSupported = VK_FALSE;
+         timing->presentAtAbsoluteTimeSupported = VK_FALSE;
+         timing->presentAtRelativeTimeSupported = VK_FALSE;
+         break;
+      }
+      default:
+         break;
+      }
+   }
+
+   return result;
+}
+
+/* 32-bit framebuffers are read as little-endian XRGB, the layout QEMU's ramfb
+ * and the boards' simple framebuffers have: B8G8R8A8 in memory. */
+static VkResult
+wsi_fbdev_surface_get_formats(VkIcdSurfaceBase *icd_surface,
+                              struct wsi_device *wsi_device,
+                              uint32_t *pSurfaceFormatCount,
+                              VkSurfaceFormatKHR *pSurfaceFormats)
+{
+   VK_OUTARRAY_MAKE_TYPED(VkSurfaceFormatKHR, out, pSurfaceFormats, pSurfaceFormatCount);
+
+   vk_outarray_append_typed(VkSurfaceFormatKHR, &out, fmt) {
+      fmt->format = VK_FORMAT_B8G8R8A8_UNORM;
+      fmt->colorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+   }
+   vk_outarray_append_typed(VkSurfaceFormatKHR, &out, fmt) {
+      fmt->format = VK_FORMAT_B8G8R8A8_SRGB;
+      fmt->colorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+   }
+
+   return vk_outarray_status(&out);
+}
+
+static VkResult
+wsi_fbdev_surface_get_formats2(VkIcdSurfaceBase *icd_surface,
+                               struct wsi_device *wsi_device,
+                               const void *info_next,
+                               uint32_t *pSurfaceFormatCount,
+                               VkSurfaceFormat2KHR *pSurfaceFormats)
+{
+   VK_OUTARRAY_MAKE_TYPED(VkSurfaceFormat2KHR, out, pSurfaceFormats, pSurfaceFormatCount);
+
+   vk_outarray_append_typed(VkSurfaceFormat2KHR, &out, fmt) {
+      fmt->surfaceFormat.format = VK_FORMAT_B8G8R8A8_UNORM;
+      fmt->surfaceFormat.colorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+   }
+   vk_outarray_append_typed(VkSurfaceFormat2KHR, &out, fmt) {
+      fmt->surfaceFormat.format = VK_FORMAT_B8G8R8A8_SRGB;
+      fmt->surfaceFormat.colorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+   }
+
+   return vk_outarray_status(&out);
+}
+
+static VkResult
+wsi_fbdev_surface_get_present_modes(VkIcdSurfaceBase *surface,
+                                    struct wsi_device *wsi_device,
+                                    uint32_t *pPresentModeCount,
+                                    VkPresentModeKHR *pPresentModes)
+{
+   if (pPresentModes == NULL) {
+      *pPresentModeCount = ARRAY_SIZE(present_modes);
+      return VK_SUCCESS;
+   }
+
+   *pPresentModeCount = MIN2(*pPresentModeCount, ARRAY_SIZE(present_modes));
+   typed_memcpy(pPresentModes, present_modes, *pPresentModeCount);
+
+   return *pPresentModeCount < ARRAY_SIZE(present_modes) ? VK_INCOMPLETE : VK_SUCCESS;
+}
+
+static VkResult
+wsi_fbdev_surface_get_present_rectangles(VkIcdSurfaceBase *surface_base,
+                                         struct wsi_device *wsi_device,
+                                         uint32_t *pRectCount,
+                                         VkRect2D *pRects)
+{
+   VkIcdSurfaceDisplay *surface = (VkIcdSurfaceDisplay *)surface_base;
+   wsi_fbdev_mode *mode = wsi_fbdev_mode_from_handle(surface->displayMode);
+   VK_OUTARRAY_MAKE_TYPED(VkRect2D, out, pRects, pRectCount);
+
+   vk_outarray_append_typed(VkRect2D, &out, rect) {
+      *rect = (VkRect2D) {
+         .offset = { 0, 0 },
+         .extent = { mode->width, mode->height },
+      };
+   }
+
+   return vk_outarray_status(&out);
+}
+
+struct wsi_fbdev_image {
+   struct wsi_image base;
+   bool busy_on_host;   /* acquired by the app, not presented yet */
+   bool busy_on_device; /* just presented: steer the next acquire past it */
+};
+
+struct wsi_fbdev_swapchain {
+   struct wsi_swapchain base;
+   struct wsi_fbdev_screen *screen;
+   VkExtent2D extent;
+   struct wsi_fbdev_image images[0];
+};
+
+static struct wsi_image *
+wsi_fbdev_swapchain_get_wsi_image(struct wsi_swapchain *wsi_chain,
+                                  uint32_t image_index)
+{
+   struct wsi_fbdev_swapchain *chain = (struct wsi_fbdev_swapchain *)wsi_chain;
+   return &chain->images[image_index].base;
+}
+
+static VkResult
+wsi_fbdev_swapchain_release_images(struct wsi_swapchain *wsi_chain,
+                                   uint32_t count, const uint32_t *indices)
+{
+   struct wsi_fbdev_swapchain *chain = (struct wsi_fbdev_swapchain *)wsi_chain;
+
+   for (uint32_t i = 0; i < count; i++) {
+      uint32_t index = indices[i];
+      assert(index < chain->base.image_count);
+      chain->images[index].busy_on_device = false;
+      chain->images[index].busy_on_host = false;
+   }
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+wsi_fbdev_swapchain_acquire_next_image(struct wsi_swapchain *wsi_chain,
+                                       const VkAcquireNextImageInfoKHR *info,
+                                       uint32_t *image_index)
+{
+   struct wsi_fbdev_swapchain *chain = (struct wsi_fbdev_swapchain *)wsi_chain;
+   struct timespec start_time, end_time, rel_timeout;
+
+   timespec_from_nsec(&rel_timeout, info->timeout);
+   clock_gettime(CLOCK_MONOTONIC, &start_time);
+   timespec_add(&end_time, &rel_timeout, &start_time);
+
+   while (1) {
+      for (uint32_t i = 0; i < chain->base.image_count; i++) {
+         if (!chain->images[i].busy_on_host) {
+            if (chain->images[i].busy_on_device) {
+               chain->images[i].busy_on_device = false;
+               continue;
+            }
+
+            *image_index = i;
+            chain->images[i].busy_on_host = true;
+            chain->images[i].busy_on_device = true;
+            return VK_SUCCESS;
+         }
+      }
+
+      struct timespec current_time;
+      clock_gettime(CLOCK_MONOTONIC, &current_time);
+      if (timespec_after(&current_time, &end_time))
+         return info->timeout == 0 ? VK_NOT_READY : VK_TIMEOUT;
+   }
+}
+
+/* The rows a present changed, from the image into the framebuffer. The
+ * rendering is complete: wsi_common_queue_present waits for it on sw devices
+ * before calling this. */
+static VkResult
+wsi_fbdev_swapchain_queue_present(struct wsi_swapchain *wsi_chain,
+                                  uint32_t image_index,
+                                  uint64_t present_id,
+                                  const VkPresentRegionKHR *damage)
+{
+   struct wsi_fbdev_swapchain *chain = (struct wsi_fbdev_swapchain *)wsi_chain;
+   struct wsi_fbdev_screen *screen = chain->screen;
+   struct wsi_image *image = &chain->images[image_index].base;
+
+   assert(image_index < chain->base.image_count);
+
+   const uint32_t width = MIN2(chain->extent.width, screen->width);
+   const uint32_t height = MIN2(chain->extent.height, screen->height);
+
+   uint32_t x0 = 0, y0 = 0, x1 = width, y1 = height;
+   if (damage && damage->rectangleCount > 0 && damage->pRectangles) {
+      x0 = width;
+      y0 = height;
+      x1 = 0;
+      y1 = 0;
+      for (uint32_t i = 0; i < damage->rectangleCount; i++) {
+         const VkRectLayerKHR *r = &damage->pRectangles[i];
+         const uint32_t rx0 = MIN2((uint32_t)MAX2(r->offset.x, 0), width);
+         const uint32_t ry0 = MIN2((uint32_t)MAX2(r->offset.y, 0), height);
+         const uint32_t rx1 = MIN2(rx0 + r->extent.width, width);
+         const uint32_t ry1 = MIN2(ry0 + r->extent.height, height);
+         if (rx1 <= rx0 || ry1 <= ry0)
+            continue;
+         x0 = MIN2(x0, rx0);
+         y0 = MIN2(y0, ry0);
+         x1 = MAX2(x1, rx1);
+         y1 = MAX2(y1, ry1);
+      }
+   }
+
+   if (x1 > x0 && y1 > y0 && image->cpu_map) {
+      /* whole cache lines per row: 16 pixels of 4 bytes */
+      x0 &= ~15u;
+      x1 = MIN2((x1 + 15u) & ~15u, width);
+
+      const size_t row_bytes = (size_t)(x1 - x0) * 4;
+      const uint8_t *src = image->cpu_map;
+      const size_t src_pitch = image->row_pitches[0];
+
+      mtx_lock(&screen->mutex);
+      for (uint32_t y = y0; y < y1; y++) {
+         memcpy(screen->map + (size_t)y * screen->stride + (size_t)x0 * 4,
+                src + (size_t)y * src_pitch + (size_t)x0 * 4, row_bytes);
+      }
+
+      struct wsi_fbdev_flush_range flush = {
+         .ptr = screen->map + (size_t)y0 * screen->stride + (size_t)x0 * 4,
+         .len = (size_t)(y1 - y0 - 1) * screen->stride + row_bytes,
+      };
+      (void)ioctl(screen->fd, WSI_FBDEV_FLUSH_CACHE, &flush);
+#ifdef FBIO_UPDATE
+      (void)ioctl(screen->fd, FBIO_UPDATE, 0);
+#endif
+      mtx_unlock(&screen->mutex);
+   }
+
+   chain->images[image_index].busy_on_host = false;
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+wsi_fbdev_swapchain_wait_for_present(struct wsi_swapchain *wsi_chain,
+                                     uint64_t waitValue,
+                                     uint64_t timeout)
+{
+   return wsi_swapchain_wait_for_present_semaphore(wsi_chain, waitValue, timeout);
+}
+
+static VkResult
+wsi_fbdev_swapchain_destroy(struct wsi_swapchain *wsi_chain,
+                            const VkAllocationCallbacks *pAllocator)
+{
+   struct wsi_fbdev_swapchain *chain = (struct wsi_fbdev_swapchain *)wsi_chain;
+
+   for (uint32_t i = 0; i < chain->base.image_count; i++) {
+      if (chain->images[i].base.image != VK_NULL_HANDLE)
+         wsi_destroy_image(&chain->base, &chain->images[i].base);
+   }
+
+   wsi_swapchain_finish(&chain->base);
+   vk_free(pAllocator, chain);
+   return VK_SUCCESS;
+}
+
+static VkResult
+wsi_fbdev_surface_create_swapchain(VkIcdSurfaceBase *icd_surface,
+                                   VkDevice device,
+                                   struct wsi_device *wsi_device,
+                                   const VkSwapchainCreateInfoKHR *pCreateInfo,
+                                   const VkAllocationCallbacks *pAllocator,
+                                   struct wsi_swapchain **swapchain_out)
+{
+   struct wsi_fbdev *wsi = (struct wsi_fbdev *)wsi_device->wsi[VK_ICD_WSI_PLATFORM_DISPLAY];
+   struct wsi_fbdev_swapchain *chain;
+   VkResult result;
+
+   assert(pCreateInfo->sType == VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR);
+
+   /* Only software rasterizers: the images must be readable by the CPU. */
+   if (!wsi->screen || !wsi_device->sw)
+      return VK_ERROR_SURFACE_LOST_KHR;
+
+   const uint32_t num_images = pCreateInfo->minImageCount;
+
+   size_t size = sizeof(*chain) + num_images * sizeof(chain->images[0]);
+   chain = vk_zalloc(pAllocator, size, 8, VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   if (chain == NULL)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   struct wsi_cpu_image_params cpu_params = {
+      .base.image_type = WSI_IMAGE_TYPE_CPU,
+   };
+
+   result = wsi_swapchain_init(wsi_device, &chain->base, device, pCreateInfo,
+                               &cpu_params.base, pAllocator);
+   if (result != VK_SUCCESS)
+      goto fail_free_chain;
+
+   chain->base.destroy = wsi_fbdev_swapchain_destroy;
+   chain->base.get_wsi_image = wsi_fbdev_swapchain_get_wsi_image;
+   chain->base.acquire_next_image = wsi_fbdev_swapchain_acquire_next_image;
+   chain->base.release_images = wsi_fbdev_swapchain_release_images;
+   chain->base.queue_present = wsi_fbdev_swapchain_queue_present;
+   chain->base.wait_for_present = wsi_fbdev_swapchain_wait_for_present;
+   chain->base.present_mode = wsi_swapchain_get_present_mode(wsi_device, pCreateInfo);
+   chain->base.image_count = num_images;
+   chain->screen = wsi->screen;
+   chain->extent = pCreateInfo->imageExtent;
+
+   uint32_t image = 0;
+   for (; image < chain->base.image_count; image++) {
+      result = wsi_create_image(&chain->base, &chain->base.image_info,
+                                &chain->images[image].base);
+      if (result != VK_SUCCESS)
+         goto fail_destroy_images;
+   }
+
+   *swapchain_out = &chain->base;
+   return VK_SUCCESS;
+
+fail_destroy_images:
+   for (uint32_t i = 0; i < image; i++)
+      wsi_destroy_image(&chain->base, &chain->images[i].base);
+   wsi_swapchain_finish(&chain->base);
+fail_free_chain:
+   vk_free(pAllocator, chain);
+   return result;
+}
+
+VkResult
+wsi_display_init_wsi(struct wsi_device *wsi_device,
+                     const VkAllocationCallbacks *alloc,
+                     int display_fd)
+{
+   struct wsi_fbdev *wsi = vk_zalloc(alloc, sizeof(*wsi), 8,
+                                     VK_SYSTEM_ALLOCATION_SCOPE_INSTANCE);
+   if (!wsi) {
+      wsi_device->wsi[VK_ICD_WSI_PLATFORM_DISPLAY] = NULL;
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+
+   /* No framebuffer is not an error: there are no displays. */
+   wsi->alloc = alloc;
+   wsi->screen = wsi_fbdev_get_screen();
+   if (wsi->screen) {
+      wsi->mode.width = wsi->screen->width;
+      wsi->mode.height = wsi->screen->height;
+   }
+
+   wsi->base.get_support = wsi_fbdev_surface_get_support;
+   wsi->base.get_capabilities2 = wsi_fbdev_surface_get_capabilities2;
+   wsi->base.get_formats = wsi_fbdev_surface_get_formats;
+   wsi->base.get_formats2 = wsi_fbdev_surface_get_formats2;
+   wsi->base.get_present_modes = wsi_fbdev_surface_get_present_modes;
+   wsi->base.get_present_rectangles = wsi_fbdev_surface_get_present_rectangles;
+   wsi->base.create_swapchain = wsi_fbdev_surface_create_swapchain;
+
+   wsi_device->wsi[VK_ICD_WSI_PLATFORM_DISPLAY] = &wsi->base;
+   return VK_SUCCESS;
+}
+
+void
+wsi_display_finish_wsi(struct wsi_device *wsi_device,
+                       const VkAllocationCallbacks *alloc)
+{
+   struct wsi_fbdev *wsi = (struct wsi_fbdev *)wsi_device->wsi[VK_ICD_WSI_PLATFORM_DISPLAY];
+   if (!wsi)
+      return;
+
+   /* the screen stays open, see the top of the file */
+   vk_free(alloc, wsi);
+   wsi_device->wsi[VK_ICD_WSI_PLATFORM_DISPLAY] = NULL;
+}
