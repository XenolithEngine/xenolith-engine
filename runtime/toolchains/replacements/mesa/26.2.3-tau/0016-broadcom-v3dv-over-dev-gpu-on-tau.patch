--- a/include/drm-uapi/drm.h
+++ b/include/drm-uapi/drm.h
@@ -1033,10 +1033,17 @@
 #endif
 
 #define DRM_IOCTL_BASE			'd'
+#if defined(__TAU__)
+#define DRM_IO(nr) ((DRM_IOCTL_BASE << 8) | (nr))
+#define DRM_IOR(nr,type) (DRM_IO(nr) | (sizeof(type) << 16) | 0x80000000u)
+#define DRM_IOW(nr,type) (DRM_IO(nr) | (sizeof(type) << 16) | 0x40000000u)
+#define DRM_IOWR(nr,type) (DRM_IO(nr) | (sizeof(type) << 16) | 0xc0000000u)
+#else
 #define DRM_IO(nr)			_IO(DRM_IOCTL_BASE,nr)
 #define DRM_IOR(nr,type)		_IOR(DRM_IOCTL_BASE,nr,type)
 #define DRM_IOW(nr,type)		_IOW(DRM_IOCTL_BASE,nr,type)
 #define DRM_IOWR(nr,type)		_IOWR(DRM_IOCTL_BASE,nr,type)
+#endif
 
 #define DRM_IOCTL_VERSION		DRM_IOWR(0x00, struct drm_version)
 #define DRM_IOCTL_GET_UNIQUE		DRM_IOWR(0x01, struct drm_unique)
