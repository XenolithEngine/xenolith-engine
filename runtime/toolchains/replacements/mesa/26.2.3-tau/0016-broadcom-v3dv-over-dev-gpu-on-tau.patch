--- /dev/null
+++ b/src/broadcom/tau/v3d_tau.c
@@ -0,0 +1,533 @@
+/* Copyright 2026 Xenolith Team
+ * SPDX-License-Identifier: MIT
+ */
+#include <dlfcn.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <stdbool.h>
+#include <threads.h>
+#include <time.h>
+#include <unistd.h>
+#include <sprt/c/cross/tau_sprt/sprt_tau.h>
+#include <sprt/c/cross/tau_sprt/gpufd.h>
+#include "xf86drm.h"
+#include "v3d_tau.h"
+#include "drm-uapi/v3d_drm.h"
+#include "util/os_time.h"
+
+#define MAX_BOS 1025
+#define MAX_SYNCS 1024
+#define MAX_POINTS 64
+#define TAU_FD 0x563344
+#define PTR(v) ((void *)(uintptr_t)(v))
+
+struct gpu_calls {
+   int (*open)(int, struct __sprt_tau_gpu_info *);
+   int (*heap)(unsigned, void **, unsigned long long *, unsigned *);
+   int (*query)(unsigned, unsigned, unsigned, void *, unsigned, unsigned *);
+   int (*ctx_create)(unsigned, unsigned, unsigned *);
+   int (*ctx_destroy)(unsigned);
+   int (*bo_create)(unsigned, unsigned, unsigned long long, unsigned,
+                    unsigned long long, unsigned *, void **);
+   int (*bo_destroy)(unsigned);
+   int (*bo_export)(const struct __sprt_tau_gpu_bo_desc *, struct __sprt_tau_gpu_buf **);
+   int (*buf_import)(struct __sprt_tau_gpu_buf *, unsigned, struct __sprt_tau_gpu_bo_desc *);
+   void (*buf_release)(struct __sprt_tau_gpu_buf *);
+   int (*submit)(unsigned, unsigned, unsigned, const void *, unsigned,
+                 const struct __sprt_tau_gpu_ref *, unsigned,
+                 const struct __sprt_tau_gpu_point *, unsigned, unsigned long long *);
+   int (*wait)(const struct __sprt_tau_gpu_point *, unsigned, int, unsigned long long);
+   void (*close)(void);
+   unsigned long long (*session)(void);
+};
+static struct gpu_calls gpu;
+static once_flag once = ONCE_FLAG_INIT;
+static mtx_t lock;
+static cnd_t changed;
+static unsigned ctx, users;
+static unsigned long long session, heap_size;
+static void *heap_data;
+static struct {
+   uint32_t heap_va, cpu_ops;
+   uint64_t resets, values[12];
+} params;
+static struct bo {
+   struct __sprt_tau_gpu_bo_desc desc;
+   struct __sprt_tau_gpu_point last;
+} bos[MAX_BOS];
+static struct sync {
+   bool used, available;
+   unsigned count;
+   struct __sprt_tau_gpu_point points[MAX_POINTS];
+} syncs[MAX_SYNCS];
+
+static int error(int e) { errno = e; return -1; }
+static int status(int s) { return s ? error(-s) : 0; }
+static void init(void)
+{
+   mtx_init(&lock, mtx_plain);
+   cnd_init(&changed);
+#define LOAD(name, symbol) gpu.name = dlsym(RTLD_DEFAULT, "__sprt_tau_gpu_" symbol)
+   LOAD(open, "open"); LOAD(heap, "heap"); LOAD(query, "query");
+   LOAD(ctx_create, "ctx_create"); LOAD(ctx_destroy, "ctx_destroy");
+   LOAD(bo_create, "bo_create"); LOAD(bo_destroy, "bo_destroy");
+   LOAD(bo_export, "bo_export"); LOAD(buf_import, "buf_import");
+   LOAD(buf_release, "buf_release"); LOAD(submit, "submit_job");
+   LOAD(wait, "wait"); LOAD(close, "close"); LOAD(session, "session");
+#undef LOAD
+}
+static bool live(void) { return users && gpu.session() == session; }
+static struct bo *bo(uint32_t h) { return h && h < MAX_BOS && bos[h].desc.bo ? &bos[h] : NULL; }
+static struct sync *syncobj(uint32_t h) { return h && h < MAX_SYNCS && syncs[h].used ? &syncs[h] : NULL; }
+
+int v3d_tau_open(void)
+{
+   call_once(&once, init);
+   mtx_lock(&lock);
+   if (users) {
+      int ret = live() ? (++users, TAU_FD) : error(ECONNRESET);
+      mtx_unlock(&lock);
+      return ret;
+   }
+   struct __sprt_tau_gpu_info info;
+   unsigned flags, written;
+   int st = -ENOENT;
+   if (!gpu.open || !gpu.heap || !gpu.query || !gpu.ctx_create || !gpu.ctx_destroy ||
+       !gpu.bo_create || !gpu.bo_destroy || !gpu.bo_export || !gpu.buf_import ||
+       !gpu.buf_release || !gpu.submit || !gpu.wait || !gpu.close || !gpu.session)
+      goto fail;
+   st = gpu.open(1, &info);
+   if (st) goto fail;
+   if (info.kind != 2 || info.params_bytes != sizeof(params)) { st = -ENODEV; goto close; }
+   st = gpu.heap(0, &heap_data, &heap_size, &flags);
+   if (st) goto close;
+   st = gpu.query(1, 0, 0, &params, sizeof(params), &written);
+   if (st || written != sizeof(params)) { st = st ? st : -EIO; goto close; }
+   st = gpu.ctx_create(0, 4, &ctx);
+   if (st) goto close;
+   session = gpu.session();
+   users = 1;
+   mtx_unlock(&lock);
+   return TAU_FD;
+close:
+   gpu.close();
+fail:
+   mtx_unlock(&lock);
+   return error(-st);
+}
+void v3d_tau_close(void)
+{
+   mtx_lock(&lock);
+   if (users && !--users) {
+      gpu.ctx_destroy(ctx);
+      for (unsigned i = 1; i < MAX_BOS; ++i)
+         if (bo(i)) gpu.bo_destroy(i);
+      gpu.close();
+      memset(bos, 0, sizeof(bos));
+      memset(syncs, 0, sizeof(syncs));
+      session = 0;
+      cnd_broadcast(&changed);
+   }
+   mtx_unlock(&lock);
+}
+uint64_t v3d_tau_heap_size(void) { return heap_size > (4u << 20) ? heap_size - (4u << 20) : 0; }
+
+static bool add_point(struct __sprt_tau_gpu_point *points, unsigned *count,
+                      struct __sprt_tau_gpu_point point)
+{
+   if (!point.value) return true;
+   for (unsigned i = 0; i < *count; ++i) {
+      if (points[i].ctx == point.ctx && points[i].ring == point.ring) {
+         if (points[i].value < point.value) points[i].value = point.value;
+         return true;
+      }
+   }
+   if (*count == MAX_POINTS) return false;
+   points[(*count)++] = point;
+   return true;
+}
+static int create_sync(uint32_t flags, uint32_t *handle)
+{
+   if (flags & ~DRM_SYNCOBJ_CREATE_SIGNALED) return error(EINVAL);
+   for (unsigned i = 1; i < MAX_SYNCS; ++i) {
+      if (!syncs[i].used) {
+         syncs[i] = (struct sync){.used = true, .available = !!(flags & DRM_SYNCOBJ_CREATE_SIGNALED)};
+         *handle = i;
+         return 0;
+      }
+   }
+   return error(ENOMEM);
+}
+int drmSyncobjCreate(int fd, uint32_t flags, uint32_t *h)
+{
+   mtx_lock(&lock); int ret = live() ? create_sync(flags, h) : error(ECONNRESET);
+   mtx_unlock(&lock); return ret;
+}
+int drmSyncobjDestroy(int fd, uint32_t h)
+{
+   mtx_lock(&lock); struct sync *s = syncobj(h); int ret = s ? 0 : error(EINVAL);
+   if (s) { memset(s, 0, sizeof(*s)); cnd_broadcast(&changed); }
+   mtx_unlock(&lock); return ret;
+}
+static int set_syncs(const uint32_t *handles, unsigned count, bool signal)
+{
+   for (unsigned i = 0; i < count; ++i) if (!syncobj(handles[i])) return error(EINVAL);
+   for (unsigned i = 0; i < count; ++i) {
+      struct sync *s = syncobj(handles[i]); s->available = signal; s->count = 0;
+   }
+   cnd_broadcast(&changed); return 0;
+}
+int drmSyncobjReset(int fd, const uint32_t *h, uint32_t n)
+{ mtx_lock(&lock); int r = set_syncs(h, n, false); mtx_unlock(&lock); return r; }
+int drmSyncobjSignal(int fd, const uint32_t *h, uint32_t n)
+{ mtx_lock(&lock); int r = set_syncs(h, n, true); mtx_unlock(&lock); return r; }
+
+int drmSyncobjWait(int fd, uint32_t *handles, unsigned count, int64_t deadline,
+                   unsigned flags, uint32_t *first)
+{
+   if (!count || count > MAX_SYNCS) return error(EINVAL);
+   mtx_lock(&lock);
+   for (;;) {
+      unsigned ready = 0;
+      struct __sprt_tau_gpu_point pending[MAX_POINTS]; unsigned n = 0;
+      if (!live()) { mtx_unlock(&lock); return error(ECONNRESET); }
+      for (unsigned i = 0; i < count; ++i) {
+         struct sync *s = syncobj(handles[i]);
+         if (!s) { mtx_unlock(&lock); return error(EINVAL); }
+         bool done = s->available;
+         if (done && !(flags & DRM_SYNCOBJ_WAIT_FLAGS_WAIT_AVAILABLE)) {
+            int st = gpu.wait(s->points, s->count, 0, 0);
+            if (st && st != -ETIMEDOUT) { mtx_unlock(&lock); return status(st); }
+            done = !st;
+         }
+         if (done) {
+            if (first && !ready) *first = i;
+            ++ready;
+         } else if (s->available) {
+            for (unsigned j = 0; j < s->count; ++j)
+               add_point(pending, &n, s->points[j]);
+         }
+      }
+      if (ready == count || (ready && !(flags & DRM_SYNCOBJ_WAIT_FLAGS_WAIT_ALL))) {
+         mtx_unlock(&lock); return 0;
+      }
+      uint64_t now = os_time_get_nano();
+      if (deadline <= 0 || now >= (uint64_t)deadline) { mtx_unlock(&lock); return error(ETIME); }
+      uint64_t remaining = (uint64_t)deadline - now;
+      if (remaining > 10000000) remaining = 10000000;
+      if (n) {
+         mtx_unlock(&lock);
+         int st = gpu.wait(pending, n, 0, remaining);
+         mtx_lock(&lock);
+         if (st && st != -ETIMEDOUT) { mtx_unlock(&lock); return status(st); }
+      } else {
+         struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts);
+         ts.tv_sec += (ts.tv_nsec + remaining) / 1000000000;
+         ts.tv_nsec = (ts.tv_nsec + remaining) % 1000000000;
+         cnd_timedwait(&changed, &lock, &ts);
+      }
+   }
+}
+int drmSyncobjExportSyncFile(int fd, uint32_t h, int *out)
+{
+   mtx_lock(&lock); struct sync *s = syncobj(h);
+   int ret = !s ? error(EINVAL) : !s->available ? error(EAGAIN) : 0;
+   if (!ret) { *out = __sprt_syncfile_fd(s->points, s->count); ret = *out < 0 ? -1 : 0; }
+   mtx_unlock(&lock); return ret;
+}
+int drmSyncobjImportSyncFile(int fd, uint32_t h, int in)
+{
+   mtx_lock(&lock); struct sync *s = syncobj(h);
+   int n = s ? __sprt_syncfile_points(in, s->points, MAX_POINTS) : -1;
+   int ret = !s ? error(EINVAL) : n < 0 ? -1 : n > MAX_POINTS ? error(E2BIG) : 0;
+   if (!ret) { s->count = n; s->available = true; cnd_broadcast(&changed); }
+   mtx_unlock(&lock); return ret;
+}
+int drmSyncobjTransfer(int fd, uint32_t dst, uint64_t dp, uint32_t src, uint64_t sp, uint32_t flags)
+{
+   mtx_lock(&lock); struct sync *d = syncobj(dst), *s = syncobj(src);
+   int ret = !d || !s || dp || sp || flags || !s->available ? error(EINVAL) : 0;
+   if (!ret) { bool used = d->used; *d = *s; d->used = used; cnd_broadcast(&changed); }
+   mtx_unlock(&lock); return ret;
+}
+int drmSyncobjHandleToFD(int fd, uint32_t h, int *out) { return error(ENOTSUP); }
+int drmSyncobjFDToHandle(int fd, int in, uint32_t *h) { return error(ENOTSUP); }
+int drmSyncobjTimelineSignal(int fd, const uint32_t *h, uint64_t *p, uint32_t n) { return error(ENOTSUP); }
+int drmSyncobjTimelineWait(int fd, uint32_t *h, uint64_t *p, unsigned n, int64_t t, unsigned f, uint32_t *s) { return error(ENOTSUP); }
+int drmSyncobjQuery2(int fd, uint32_t *h, uint64_t *p, uint32_t n, uint32_t f) { return error(ENOTSUP); }
+int drmGetCap(int fd, uint64_t cap, uint64_t *value)
+{ *value = cap == DRM_CAP_SYNCOBJ; return 0; }
+
+int drmPrimeHandleToFD(int fd, uint32_t h, uint32_t flags, int *out)
+{
+   mtx_lock(&lock); struct bo *b = bo(h); struct __sprt_tau_gpu_buf *buf = NULL;
+   int ret = !live() ? error(ECONNRESET) : !b ? error(EINVAL) : status(gpu.bo_export(&b->desc, &buf));
+   if (!ret) {
+      *out = __sprt_dmabuf_fd(buf, flags & O_CLOEXEC);
+      if (*out < 0) gpu.buf_release(buf);
+      ret = *out < 0 ? -1 : 0;
+   }
+   mtx_unlock(&lock); return ret;
+}
+int drmPrimeFDToHandle(int fd, int in, uint32_t *h)
+{
+   mtx_lock(&lock); struct __sprt_tau_gpu_buf *buf = __sprt_dmabuf_buf(in);
+   struct __sprt_tau_gpu_bo_desc desc;
+   int ret = !live() ? error(ECONNRESET) : !buf ? error(EINVAL) : status(gpu.buf_import(buf, 0, &desc));
+   if (!ret) {
+      if (!desc.bo || desc.bo >= MAX_BOS) { gpu.bo_destroy(desc.bo); ret = error(EINVAL); }
+      else {
+         if (bo(desc.bo)) gpu.bo_destroy(desc.bo);
+         else bos[desc.bo].desc = desc;
+         *h = desc.bo;
+      }
+   }
+   mtx_unlock(&lock); return ret;
+}
+
+struct submission {
+   struct __sprt_tau_gpu_ref refs[64]; unsigned count;
+   struct __sprt_tau_gpu_point needs[MAX_POINTS]; unsigned need_count;
+   struct drm_v3d_multi_sync *ms;
+};
+static int prepare(struct submission *s, uint64_t handles, unsigned count, uint64_t extensions)
+{
+   if (count > 64 || (count && !handles)) return error(EINVAL);
+   for (unsigned i = 0; i < count; ++i) {
+      uint32_t h = ((uint32_t *)PTR(handles))[i];
+      if (!bo(h)) return error(EINVAL);
+      s->refs[s->count++] = (struct __sprt_tau_gpu_ref){h, 1};
+   }
+   unsigned depth = 0;
+   for (struct drm_v3d_extension *e = PTR(extensions); e; e = PTR(e->next)) {
+      if (++depth > 8) return error(EINVAL);
+      if (e->id != DRM_V3D_EXT_ID_MULTI_SYNC) continue;
+      if (s->ms) return error(EINVAL);
+      s->ms = (void *)e;
+      struct drm_v3d_sem *in = PTR(s->ms->in_syncs), *out = PTR(s->ms->out_syncs);
+      if (s->ms->in_sync_count > MAX_SYNCS || s->ms->out_sync_count > MAX_SYNCS) return error(EINVAL);
+      for (unsigned i = 0; i < s->ms->in_sync_count; ++i) {
+         struct sync *sync = syncobj(in[i].handle);
+         if (!sync || !sync->available || in[i].point || in[i].flags) return error(EINVAL);
+         for (unsigned j = 0; j < sync->count; ++j)
+            if (!add_point(s->needs, &s->need_count, sync->points[j])) return error(E2BIG);
+      }
+      for (unsigned i = 0; i < s->ms->out_sync_count; ++i)
+         if (!syncobj(out[i].handle) || out[i].point || out[i].flags) return error(EINVAL);
+   }
+   return 0;
+}
+static int submit(struct submission *s, unsigned kind, const void *body, unsigned bytes, unsigned ring)
+{
+   unsigned long long value;
+   int ret = gpu.submit(ctx, ring, kind, body, bytes, s->refs, s->count,
+                         s->needs, s->need_count, &value);
+   if (ret) return status(ret);
+   struct __sprt_tau_gpu_point point = {ctx, ring, value};
+   for (unsigned i = 0; i < s->count; ++i) bos[s->refs[i].bo].last = point;
+   if (s->ms) {
+      struct drm_v3d_sem *out = PTR(s->ms->out_syncs);
+      for (unsigned i = 0; i < s->ms->out_sync_count; ++i) {
+         struct sync *sync = syncobj(out[i].handle);
+         sync->available = true; sync->count = 1; sync->points[0] = point;
+      }
+   }
+   cnd_broadcast(&changed);
+   return 0;
+}
+static void *bo_bytes(struct bo *b, uint64_t offset, uint64_t bytes)
+{
+   return b && offset <= b->desc.size && bytes <= b->desc.size - offset ?
+          (char *)b->desc.data + offset : NULL;
+}
+static void finish_cpu(struct submission *s)
+{
+   if (s->ms) {
+      struct drm_v3d_sem *out = PTR(s->ms->out_syncs);
+      for (unsigned i = 0; i < s->ms->out_sync_count; ++i) {
+         struct sync *sync = syncobj(out[i].handle);
+         sync->available = true; sync->count = 0;
+      }
+   }
+   cnd_broadcast(&changed);
+}
+static int cpu_job(struct drm_v3d_submit_cpu *p)
+{
+   struct submission s = {0};
+   if (prepare(&s, p->bo_handles, p->bo_handle_count, p->extensions)) return -1;
+   struct drm_v3d_extension *op = NULL; unsigned depth = 0;
+   for (struct drm_v3d_extension *e = PTR(p->extensions); e; e = PTR(e->next)) {
+      if (++depth > 8) return error(EINVAL);
+      if (e->id != DRM_V3D_EXT_ID_MULTI_SYNC) {
+         if (op) return error(EINVAL);
+         op = e;
+      }
+   }
+   if (!op || !s.count) return error(EINVAL);
+   /* CPU mappings are coherent WC; dependencies must complete before host access. */
+   int st = gpu.wait(s.needs, s.need_count, 0, ~0ull);
+   if (st) return status(st);
+   struct bo *first = bo(s.refs[0].bo);
+   uint32_t body[14] = {0};
+   switch (op->id) {
+   case DRM_V3D_EXT_ID_CPU_INDIRECT_CSD: {
+      struct drm_v3d_indirect_csd *ind = (void *)op;
+      uint32_t *counts = bo_bytes(first, ind->offset, 12);
+      if (!counts || !ind->wg_size || ind->wg_size > 1024) return error(EINVAL);
+      uint32_t wg[3]; memcpy(wg, counts, sizeof(wg));
+      uint64_t batches = (ind->wg_size + 15) / 16;
+      bool empty = !wg[0] || !wg[1] || !wg[2];
+      for (unsigned i = 0; i < 3; ++i) {
+         if (wg[i] > 65535) return error(EINVAL);
+         if (!empty) {
+            if (batches > 0x100000000ull / wg[i]) return error(EINVAL);
+            batches *= wg[i];
+         }
+      }
+      uint32_t cfg[7]; memcpy(cfg, ind->submit.cfg, sizeof(cfg));
+      for (unsigned i = 0; i < 3; ++i) {
+         cfg[i] = wg[i] << 16;
+         if (ind->wg_uniform_offsets[i] != UINT32_MAX) {
+            void *dst = bo_bytes(bo(ind->indirect), (uint64_t)ind->wg_uniform_offsets[i] * 4, 4);
+            if (!dst) return error(EINVAL);
+            memcpy(dst, &wg[i], 4);
+         }
+      }
+      if (empty) { finish_cpu(&s); return 0; }
+      cfg[4] = batches - 1;
+      uint32_t *handles = PTR(ind->submit.bo_handles);
+      if (ind->submit.bo_handle_count > 64 - s.count) return error(E2BIG);
+      for (unsigned i = 0; i < ind->submit.bo_handle_count; ++i) {
+         if (!bo(handles[i])) return error(EINVAL);
+         s.refs[s.count++] = (struct __sprt_tau_gpu_ref){handles[i], 1};
+      }
+      return submit(&s, 4, cfg, sizeof(cfg), 2);
+   }
+   case DRM_V3D_EXT_ID_CPU_TIMESTAMP_QUERY: {
+      struct drm_v3d_timestamp_query *q = (void *)op;
+      uint32_t *offsets = PTR(q->offsets), *handles = PTR(q->syncs);
+      for (unsigned i = 0; i < q->count; ++i) {
+         struct sync *sync = syncobj(handles[i]);
+         if (!sync || !bo_bytes(first, offsets[i], 8)) return error(EINVAL);
+         body[0] = 1; body[3] = first->desc.bo; body[4] = offsets[i];
+         if (submit(&s, 5, body, sizeof(body), 3)) return -1;
+         sync->available = true; sync->count = 1; sync->points[0] = first->last;
+      }
+      return 0;
+   }
+   case DRM_V3D_EXT_ID_CPU_RESET_TIMESTAMP_QUERY: {
+      struct drm_v3d_reset_timestamp_query *q = (void *)op;
+      uint32_t *handles = PTR(q->syncs);
+      if (!bo_bytes(first, q->offset, (uint64_t)q->count * 8)) return error(EINVAL);
+      for (unsigned i = 0; i < q->count; ++i) if (!syncobj(handles[i])) return error(EINVAL);
+      if (!q->count) { finish_cpu(&s); return 0; }
+      body[0] = 2; body[3] = first->desc.bo; body[4] = q->offset;
+      body[5] = q->count * 8;
+      if (submit(&s, 5, body, sizeof(body), 3)) return -1;
+      return set_syncs(handles, q->count, false);
+   }
+   case DRM_V3D_EXT_ID_CPU_COPY_TIMESTAMP_QUERY: {
+      struct drm_v3d_copy_timestamp_query *q = (void *)op;
+      if (s.count != 2) return error(EINVAL);
+      struct bo *src = bo(s.refs[1].bo);
+      uint32_t *offsets = PTR(q->offsets), *handles = PTR(q->syncs);
+      unsigned width = q->do_64bit ? 8 : 4;
+      for (unsigned i = 0; i < q->count; ++i) {
+         struct sync *sync = syncobj(handles[i]);
+         void *in = bo_bytes(src, offsets[i], 8);
+         void *out = bo_bytes(first, (uint64_t)q->offset + (uint64_t)i * q->stride,
+                              width * (1 + !!q->availability_bit));
+         if (!sync || !in || !out) return error(EINVAL);
+         int st = sync->available ? gpu.wait(sync->points, sync->count, 0, 0) : -ETIMEDOUT;
+         if (st && st != -ETIMEDOUT) return status(st);
+         if (!st || q->do_partial) memcpy(out, in, width);
+         if (q->availability_bit) {
+            uint64_t available = !st; memcpy((char *)out + width, &available, width);
+         }
+      }
+      finish_cpu(&s); return 0;
+   }
+   default: return error(ENOTSUP);
+   }
+}
+static int ioctl_locked(unsigned long request, void *arg)
+{
+   if (!live()) return error(ECONNRESET);
+   switch (request) {
+   case DRM_IOCTL_V3D_GET_PARAM: {
+      struct drm_v3d_get_param *p = arg;
+      if (p->param < DRM_V3D_PARAM_SUPPORTS_MULTISYNC_EXT) p->value = params.values[p->param];
+      else if (p->param == DRM_V3D_PARAM_SUPPORTS_MULTISYNC_EXT || p->param == DRM_V3D_PARAM_SUPPORTS_CPU_QUEUE) p->value = 1;
+      else if (p->param == DRM_V3D_PARAM_MAX_PERF_COUNTERS) p->value = params.values[11];
+      else if (p->param == DRM_V3D_PARAM_GLOBAL_RESET_COUNTER || p->param == DRM_V3D_PARAM_CONTEXT_RESET_COUNTER) {
+         unsigned written; int ret = gpu.query(1, 0, 0, &params, sizeof(params), &written);
+         if (ret) return status(ret);
+         p->value = params.resets;
+      } else return error(EINVAL);
+      return 0;
+   }
+   case DRM_IOCTL_V3D_CREATE_BO: {
+      struct drm_v3d_create_bo *p = arg; unsigned h; void *data;
+      if (p->flags) return error(EINVAL);
+      uint64_t size = ((uint64_t)p->size + 4095) & ~4095ull;
+      int ret = gpu.bo_create(0, 3, size, 0, 0, &h, &data);
+      if (ret) return status(ret);
+      if (!h || h >= MAX_BOS) { gpu.bo_destroy(h); return error(ENOMEM); }
+      bos[h] = (struct bo){.desc = {h, 0, 0, 3, size, data}};
+      p->handle = h; p->offset = params.heap_va + (uintptr_t)data - (uintptr_t)heap_data;
+      return 0;
+   }
+   case DRM_IOCTL_GEM_CLOSE: {
+      struct drm_gem_close *p = arg;
+      if (!bo(p->handle)) return error(EINVAL);
+      int ret = gpu.bo_destroy(p->handle);
+      if (!ret) memset(&bos[p->handle], 0, sizeof(struct bo));
+      return status(ret);
+   }
+   case DRM_IOCTL_V3D_MMAP_BO: {
+      struct drm_v3d_mmap_bo *p = arg; struct bo *b = bo(p->handle);
+      if (!b) return error(EINVAL);
+      p->offset = (uintptr_t)b->desc.data; return 0;
+   }
+   case DRM_IOCTL_V3D_GET_BO_OFFSET: {
+      struct drm_v3d_get_bo_offset *p = arg; struct bo *b = bo(p->handle);
+      if (!b) return error(EINVAL);
+      p->offset = params.heap_va + (uintptr_t)b->desc.data - (uintptr_t)heap_data; return 0;
+   }
+   case DRM_IOCTL_V3D_WAIT_BO: {
+      struct drm_v3d_wait_bo *p = arg; struct bo *b = bo(p->handle);
+      if (!b) return error(EINVAL);
+      return status(gpu.wait(&b->last, b->last.value ? 1 : 0, 0, p->timeout_ns));
+   }
+   case DRM_IOCTL_V3D_SUBMIT_CL: {
+      struct drm_v3d_submit_cl *p = arg; struct submission s = {0};
+      if (p->perfmon_id || p->in_sync_bcl || p->in_sync_rcl || p->out_sync) return error(ENOTSUP);
+      if (prepare(&s, p->bo_handles, p->bo_handle_count, p->extensions)) return -1;
+      uint32_t body[] = {p->bcl_start,p->bcl_end,p->rcl_start,p->rcl_end,p->qma,p->qms,p->qts,
+                         !!(p->flags & DRM_V3D_SUBMIT_CL_FLUSH_CACHE)};
+      return submit(&s, 2, body, sizeof(body), 0);
+   }
+   case DRM_IOCTL_V3D_SUBMIT_TFU: {
+      struct drm_v3d_submit_tfu *p = arg; struct submission s = {0}; uint32_t handles[4]; unsigned n = 0;
+      for (unsigned i = 0; i < 4; ++i) if (p->bo_handles[i]) handles[n++] = p->bo_handles[i];
+      if (p->in_sync || p->out_sync) return error(ENOTSUP);
+      if (prepare(&s, (uintptr_t)handles, n, p->extensions)) return -1;
+      uint32_t body[] = {p->iia,p->iis,p->ica,p->iua,p->ioa,p->ios,p->coef[0],p->coef[1],p->coef[2],p->coef[3],p->icfg};
+      return submit(&s, 3, body, sizeof(body), 1);
+   }
+   case DRM_IOCTL_V3D_SUBMIT_CPU: return cpu_job(arg);
+   case DRM_IOCTL_V3D_SUBMIT_CSD: {
+      struct drm_v3d_submit_csd *p = arg; struct submission s = {0};
+      if (p->perfmon_id || p->in_sync || p->out_sync) return error(ENOTSUP);
+      if (prepare(&s, p->bo_handles, p->bo_handle_count, p->extensions)) return -1;
+      return submit(&s, 4, p->cfg, 7 * sizeof(uint32_t), 2);
+   }
+   default: return error(ENOTSUP);
+   }
+}
+int drmIoctl(int fd, unsigned long request, void *arg)
+{
+   if (fd != TAU_FD || !arg) return error(EINVAL);
+   mtx_lock(&lock); int ret = ioctl_locked(request, arg); mtx_unlock(&lock); return ret;
+}
