Subject: [PATCH] venus: dma-buf and sync_file over the runtime's descriptors on Tau

--- a/src/util/libsync.h
+++ b/src/util/libsync.h
@@ -155,6 +155,51 @@
 	return ret;
 }
 
+#if DETECT_OS_TAU
+/* A sync_file on Tau is a descriptor of the runtime over fence points of the
+ * GPU session (gpufd.h): a merge is the union of the points, the later value
+ * of a timeline kept. */
+#include <sprt/c/cross/tau_sprt/gpufd.h>
+
+static inline int sync_merge(const char *name, int fd1, int fd2)
+{
+	int n1 = __sprt_syncfile_points(fd1, NULL, 0);
+	int n2 = __sprt_syncfile_points(fd2, NULL, 0);
+	if (n1 < 0 || n2 < 0)
+		return -1;
+
+	struct __sprt_tau_gpu_point *points =
+		(struct __sprt_tau_gpu_point *)calloc(n1 + n2 + 1, sizeof(*points));
+	if (!points) {
+		errno = ENOMEM;
+		return -1;
+	}
+	__sprt_syncfile_points(fd1, points, n1);
+	__sprt_syncfile_points(fd2, points + n1, n2);
+
+	int count = n1;
+	for (int i = n1; i < n1 + n2; i++) {
+		int k = 0;
+		while (k < count && (points[k].ctx != points[i].ctx ||
+		                     points[k].ring != points[i].ring))
+			k++;
+		if (k == count)
+			points[count++] = points[i];
+		else if (points[i].value > points[k].value)
+			points[k].value = points[i].value;
+	}
+
+	int fd = __sprt_syncfile_fd(points, count);
+	free(points);
+	return fd;
+}
+
+static inline bool
+sync_valid_fd(int fd)
+{
+	return __sprt_syncfile_points(fd, NULL, 0) >= 0;
+}
+#else
 static inline int sync_merge(const char *name, int fd1, int fd2)
 {
 	struct sync_merge_data data = {{0}};
