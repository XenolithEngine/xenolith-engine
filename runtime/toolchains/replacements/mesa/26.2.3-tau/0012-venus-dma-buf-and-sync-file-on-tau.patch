+/* Adds (ring, fence) to the points, keeping the larger fence of a ring. */
+static uint32_t
+tau_points_add(const struct tau_renderer *tau,
+               struct __sprt_tau_gpu_point *points,
+               uint32_t count,
+               uint32_t ring,
+               uint64_t fence)
+{
+   for (uint32_t i = 0; i < count; i++) {
+      if (points[i].ring == ring) {
+         if (fence > points[i].value)
+            points[i].value = fence;
+         return count;
+      }
+   }
+   points[count] = (struct __sprt_tau_gpu_point){
+      .ctx = tau->ctx,
+      .ring = ring,
+      .value = fence,
+   };
+   return count + 1;
+}
+
+/* A sync_file of the submissions that are to raise the sync; one already
+ * there is signaled. */
 static int
 tau_sync_export_syncobj(struct vn_renderer *renderer,
-                        struct vn_renderer_sync *sync,
+                        struct vn_renderer_sync *_sync,
                         bool sync_file)
 {
-   return -1;
+   struct tau_renderer *tau = tau_renderer(renderer);
+   struct tau_sync *sync = (struct tau_sync *)_sync;
+
+   if (!sync_file)
+      return -1;
+
+   struct __sprt_tau_gpu_point points[TAU_GPU_RINGS];
+   uint32_t count = 0;
+
+   mtx_lock(&tau->sync_mutex);
+   tau_sync_update_locked(tau, sync);
+   for (uint32_t i = 0; i < sync->point_count; i++) {
+      const struct tau_sync_point *p = &sync->points[i];
+      if (p->value > sync->value)
+         count = tau_points_add(tau, points, count, p->ring, p->fence);
+   }
+   mtx_unlock(&tau->sync_mutex);
+
+   return __sprt_syncfile_fd(points, count);
 }
 
