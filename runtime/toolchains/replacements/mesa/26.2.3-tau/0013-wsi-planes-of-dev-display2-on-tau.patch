+   if (!wsi->sw)
+      wsi->WaitForFences(chain->base.device, 1, &chain->base.fences[image_index], true, ~0ull);
    mtx_lock(&screen->mutex);
    VkResult result = wsi_tau_check(screen, chain->generation, chain->serial);
    if (result != VK_SUCCESS)
       goto done;
+   if (screen->planes) {
