 static struct wsi_tau_screen tau_screen;
@@ -71,15 +85,74 @@
    TAU_HOOK(present);
    TAU_HOOK(close);
 #undef TAU_HOOK
+#define TAU_HOOK2(name) s->p_##name = dlsym(module, "__sprt_tau_display2_" #name)
