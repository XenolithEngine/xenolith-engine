-/* Software rendering is complete before WSI copies into the driver's buffers. */
+/* A commit of the image's buffer on the primary plane, the whole mode: it returns at the blank
+ * that shows it, and the image shown before is free again. The damage is not needed: the plane
+ * shows the buffer whole. */
+static VkResult
+wsi_tau_show(struct wsi_tau_swapchain *chain, uint32_t image_index)
+{
+   struct wsi_tau_screen *screen = chain->screen;
+   unsigned long long blank;
+   if (screen->p_show(chain->images[image_index].buffer, &blank) < 0)
+      return VK_ERROR_OUT_OF_DATE_KHR;
+   for (uint32_t i = 0; i < chain->base.image_count; i++)
+      chain->images[i].shown = i == image_index;
+   return VK_SUCCESS;
+}
+
 static VkResult
 wsi_tau_swapchain_queue_present(struct wsi_swapchain *wsi_chain,
                                   uint32_t image_index,
@@ -703,12 +787,22 @@
