    uint32_t x0 = 0, y0 = 0, x1 = width, y1 = height;
@@ -789,8 +883,14 @@
    struct wsi_tau_swapchain *chain = (struct wsi_tau_swapchain *)wsi_chain;
 
    for (uint32_t i = 0; i < chain->base.image_count; i++) {
-      if (chain->images[i].base.image != VK_NULL_HANDLE)
-         wsi_destroy_image(&chain->base, &chain->images[i].base);
+      struct wsi_tau_image *image = &chain->images[i];
