+      if (image->base.image != VK_NULL_HANDLE)
+         wsi_destroy_image(&chain->base, &image->base);
+      if (image->fd >= 0)
+         close(image->fd);
    }
 
    wsi_swapchain_finish(&chain->base);
@@ -798,6 +898,53 @@
    return VK_SUCCESS;
 }
 
+/* The blit's destination of a plane: a linear buffer in exportable memory of the device. */
+static VkResult
+wsi_tau_create_plane_mem(const struct wsi_swapchain *chain,
+                         const struct wsi_image_info *info,
+                         struct wsi_image *image)
+{
+   return wsi_create_buffer_blit_context(chain, info, image,
+                                         VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT);
+}
+
+static unsigned
+wsi_tau_plane_format(VkFormat format)
+{
+   switch (format) {
+   case VK_FORMAT_B8G8R8A8_UNORM:
+   case VK_FORMAT_B8G8R8A8_SRGB:
+      return __SPRT_TAU_DISPLAY2_B8G8R8X8;
+   case VK_FORMAT_R8G8B8A8_UNORM:
+   case VK_FORMAT_R8G8B8A8_SRGB:
+      return __SPRT_TAU_DISPLAY2_R8G8B8X8;
+   default:
+      return 0;
+   }
+}
+
+/* The image's blit memory as a dma-buf, imported into dev.display@2 by its export token. */
+static VkResult
+wsi_tau_import_image(struct wsi_tau_swapchain *chain, struct wsi_tau_image *image, VkFormat format)
+{
+   const struct wsi_device *wsi = chain->base.wsi;
+   struct wsi_tau_screen *screen = chain->screen;
+   const VkMemoryGetFdInfoKHR fd_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_GET_FD_INFO_KHR,
+      .memory = image->base.blit.memory,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+   };
+   unsigned token = 0;
+   if (wsi->GetMemoryFdKHR(chain->base.device, &fd_info, &image->fd) != VK_SUCCESS ||
+       screen->buf_token(screen->dmabuf_buf(image->fd), &token) < 0 ||
+       screen->p_import(token, wsi_tau_plane_format(format), chain->extent.width,
+                        chain->extent.height, image->base.row_pitches[0], 0, &image->buffer) < 0) {
+      fprintf(stderr, "Tau WSI: the display did not import the image's buffer\n");
+      return VK_ERROR_SURFACE_LOST_KHR;
+   }
+   return VK_SUCCESS;
+}
+
