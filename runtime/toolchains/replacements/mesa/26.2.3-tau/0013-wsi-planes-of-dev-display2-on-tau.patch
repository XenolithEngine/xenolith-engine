+/* The generation of the open session, either major; < 0 when it is lost. */
+static int
+wsi_tau_query(struct wsi_tau_screen *s, unsigned long long *generation)
+{
+   return s->planes ? s->p_query(NULL, generation) : s->query(NULL, generation);
+}
+
+static void
+wsi_tau_connected(struct wsi_tau_screen *s, unsigned long long generation)
+{
+   if (s->lost)
+      fprintf(stderr, "Tau WSI: the display is back, generation %llu\n", generation);
+   if (s->generation != generation)
+      s->next = 0;
+   s->lost = false;
+   s->opened = true;
+   s->generation = generation;
+}
+
+/* The planes for a GPU; false without dev.display@2, which leaves dev.display@1 to try. */
 static bool
-wsi_tau_connect(struct wsi_tau_screen *s)
+wsi_tau_connect_planes(struct wsi_tau_screen *s)
+{
+   struct __sprt_tau_display2_info in;
+   unsigned long long generation;
+   if (!s->p_open || !s->p_query || !s->p_import || !s->p_release || !s->p_show || !s->buf_token ||
+       !s->dmabuf_buf)
+      return false;
+   if (s->p_query(&in, &generation) < 0) {
+      if (s->p_open(0, &in) < 0 || s->p_query(&in, &generation) < 0)
+         return false;
+   }
+   if (!in.width || !in.height)
+      return false;
+   if (!s->planes)
+      fprintf(stderr, "Tau WSI: planes of dev.display@2, %ux%u\n", in.width, in.height);
+   s->planes = true;
+   wsi_tau_connected(s, generation);
+   s->width = in.width;
+   s->height = in.height;
+   s->stride = in.width * 4;
+   s->refresh = in.refresh_mhz ? in.refresh_mhz : 60000;
+   return true;
+}
+
+/* The caller holds the screen lock; only WSI reconnects and frees gone mappings. A GPU takes the
+ * planes when they are there; the session stays of the major it opened with. */
+static bool
+wsi_tau_connect(struct wsi_tau_screen *s, bool gpu)
 {
    struct __sprt_tau_display_info in;
    unsigned long long generation;
+   if (gpu && (!s->opened || s->planes) && wsi_tau_connect_planes(s))
+      return true;
+   if (s->planes)
+      return false;
    if (!s->open || !s->query || !s->buffer || !s->present || !s->close)
       return false;
    if (s->query(&in, &generation) < 0) {
