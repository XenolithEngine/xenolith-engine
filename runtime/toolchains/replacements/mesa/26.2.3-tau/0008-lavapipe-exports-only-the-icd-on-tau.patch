Subject: [PATCH] lavapipe: only the ICD's entry points exported on Tau

--- a/src/gallium/targets/lavapipe/meson.build
+++ b/src/gallium/targets/lavapipe/meson.build
@@ -23,7 +23,9 @@
   link_whole : [ liblavapipe_st ],
   link_with : [libpipe_loader_static, libgallium, libwsw, libswdri, libws_null, libswkmsdri ],
   gnu_symbol_visibility : 'hidden',
-  link_args : [ld_args_bsymbolic, ld_args_gc_sections],
+  # Tau: only the loader's entry points; the static LLVM's symbols stay inside, the table small.
+  link_args : [ld_args_bsymbolic, ld_args_gc_sections] + (host_machine.system() == 'tau' ? vulkan_icd_link_args : []),
+  link_depends : host_machine.system() == 'tau' ? vulkan_icd_link_depends : [],
   # On Apple systems, "weak" is actually "weak_import", which is slightly different.
   # The linker still expects a definition for weak symbols at build time, just not at runtime.
   # We have to forcibly ignore undefined symbols, which unfortunately applies to all symbols.
