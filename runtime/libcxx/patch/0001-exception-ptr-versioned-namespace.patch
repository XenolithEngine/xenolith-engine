+
+// sprt overlay: sprt OWNS exception_ptr and the uncaught/current/rethrow operations
+// (SPRTCxxException.cpp defines them in the versioned ABI namespace std::__sprt, not the
+// canonical std). Keeping them UNVERSIONED here would make the vendored TUs reference a
+// bare std::exception_ptr / std::uncaught_exceptions that clashes with a foreign/system
+// libc++'s canonical symbols on the ABI-shared targets (e.g. macOS) -- the very reason
+// libstdc++ hides them in std::__exception_ptr. terminate/unexpected stay canonical (they
+// are libc++abi symbols). See runtime/libcxx/patch/.
+_LIBCPP_BEGIN_NAMESPACE_STD
 
 #if _LIBCPP_STD_VER <= 17 || defined(_LIBCPP_ENABLE_CXX20_REMOVED_UNCAUGHT_EXCEPTION)
