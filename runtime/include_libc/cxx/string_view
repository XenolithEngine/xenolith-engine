// sprt overlay for <string_view>: back std::basic_string_view with sprt's
// (fully-constexpr) sprt::basic_string_view.
//
// OPT-IN, DEFAULT OFF: define SPRT_STD_STRING_SPRT to enable. It travels with the
// sprt <string> overlay so std::string and std::string_view stay interoperable and
// both usable in constant expressions.
//
// When enabled: std::basic_string_view<CharT,Traits> DERIVES from
// sprt::basic_string_view<CharT,Traits> (libc++ forward-declares std::basic_string_view
// as a class template in <__fwd/string_view.h>, so a plain alias is impossible — same
// derive technique as the <string> overlay). Converting ctors from the base absorb
// base-typed results (substr, ...); the sprt comparison / hash / literals apply through
// the derived-to-base conversion.

#include <__config>

#if !defined(SPRT_STD_STRING_SPRT)

#include_next <string_view>

#else // sprt-backed std::basic_string_view (opt-in)

#ifndef _LIBCPP_STRING_VIEW
#define _LIBCPP_STRING_VIEW

#include <__fwd/string_view.h>
#include <__string/char_traits.h>
#include <compare>
#include <cstddef>
#include <limits>

#include <sprt/cxx/string_view>

#if !defined(_LIBCPP_HAS_NO_PRAGMA_SYSTEM_HEADER)
#  pragma GCC system_header
#endif

_LIBCPP_PUSH_MACROS
#include <__undef_macros>

_LIBCPP_BEGIN_NAMESPACE_STD

template <class _CharT, class _Traits>
class basic_string_view : public ::sprt::basic_string_view<_CharT, _Traits> {
  using __base = ::sprt::basic_string_view<_CharT, _Traits>;

public:
  using typename __base::traits_type;
  using typename __base::value_type;
  using typename __base::pointer;
  using typename __base::const_pointer;
  using typename __base::reference;
  using typename __base::const_reference;
  using typename __base::const_iterator;
  using typename __base::iterator;
  using typename __base::const_reverse_iterator;
  using typename __base::reverse_iterator;
  using typename __base::size_type;
  using typename __base::difference_type;

  using __base::npos;

  using __base::__base; // inherit sprt's ctor set (const CharT*, (CharT*, n), ...)

  _LIBCPP_HIDE_FROM_ABI constexpr basic_string_view() noexcept                          = default;
  _LIBCPP_HIDE_FROM_ABI constexpr basic_string_view(const basic_string_view&) noexcept  = default;
  _LIBCPP_HIDE_FROM_ABI constexpr basic_string_view& operator=(const basic_string_view&) noexcept = default;

  // Absorb base-typed results (substr, ...) without slicing.
  _LIBCPP_HIDE_FROM_ABI constexpr basic_string_view(const __base& __b) noexcept : __base(__b) {}
};

// hash — forward to sprt's hash over the base (so a string and its view hash alike).
template <class _CharT, class _Traits>
struct hash<basic_string_view<_CharT, _Traits> > {
  _LIBCPP_HIDE_FROM_ABI size_t operator()(const basic_string_view<_CharT, _Traits>& __s) const _NOEXCEPT {
    return ::sprt::hash< ::sprt::basic_string_view<_CharT, _Traits> >()(__s);
  }
};

inline namespace literals {
inline namespace string_view_literals {

#if defined(__clang__)
#  pragma clang diagnostic push
#  pragma clang diagnostic ignored "-Wuser-defined-literals"
#elif defined(__GNUC__)
#  pragma GCC diagnostic push
#  pragma GCC diagnostic ignored "-Wliteral-suffix"
#endif

_LIBCPP_HIDE_FROM_ABI constexpr basic_string_view<char> operator""sv(const char* __s, size_t __n) noexcept {
  return basic_string_view<char>(__s, __n);
}
_LIBCPP_HIDE_FROM_ABI constexpr basic_string_view<wchar_t> operator""sv(const wchar_t* __s, size_t __n) noexcept {
  return basic_string_view<wchar_t>(__s, __n);
}
_LIBCPP_HIDE_FROM_ABI constexpr basic_string_view<char8_t> operator""sv(const char8_t* __s, size_t __n) noexcept {
  return basic_string_view<char8_t>(__s, __n);
}
_LIBCPP_HIDE_FROM_ABI constexpr basic_string_view<char16_t> operator""sv(const char16_t* __s, size_t __n) noexcept {
  return basic_string_view<char16_t>(__s, __n);
}
_LIBCPP_HIDE_FROM_ABI constexpr basic_string_view<char32_t> operator""sv(const char32_t* __s, size_t __n) noexcept {
  return basic_string_view<char32_t>(__s, __n);
}

#if defined(__clang__)
#  pragma clang diagnostic pop
#elif defined(__GNUC__)
#  pragma GCC diagnostic pop
#endif

} // namespace string_view_literals
} // namespace literals

_LIBCPP_END_NAMESPACE_STD

_LIBCPP_POP_MACROS

#endif // _LIBCPP_STRING_VIEW

#endif // !SPRT_STD_STRING_SPRT
