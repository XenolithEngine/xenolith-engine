// Standard <unordered_map>, backed by sprt::__unordered_map in its node-indirection (Stl = true)
// mode: the flat open-addressed hash array stores individually heap-allocated nodes, so element
// addresses are STABLE — references and pointers to elements survive rehash and unrelated erase,
// exactly as [unord.req] requires (only iterators are invalidated by rehash). Because the nodes are
// stable, this wrapper provides a real conforming operator[] / at() returning mapped_type& (unlike
// the sprt __pool_/__malloc_ maps, which return an access_token proxy). std::unordered_map is a thin
// DERIVED class (not an alias) so it can add operator[]/at and carry its own deduction guides.
//
// Deviations from std (all documented, no consumer needs them): at() traps instead of throwing
// out_of_range (-fno-exceptions); no node handles (extract / insert(node_type&&) / merge); no
// std::unordered_multimap; the default hasher is sprt::hash<Key> rather than std::hash<Key> (pass a
// hasher explicitly to use a std::hash specialization); erase may invalidate iterators to OTHER
// elements (the open-addressed backing compacts on erase) although their references stay valid.

#ifndef RUNTIME_INCLUDE_LIBC_STL_UNORDERED_MAP_H_
#define RUNTIME_INCLUDE_LIBC_STL_UNORDERED_MAP_H_

#include <__sprt_stl_config.h>

#include <__unordered/chain.h> // std::__detail::chain_memory — the multi backend (fully in the STL layer)

#include <sprt/cxx/unordered_map>
#include <sprt/cxx/new>
#include <sprt/cxx/iterator>
#include <sprt/cxx/type_traits>
#include <sprt/cxx/__functional/compare.h>

namespace sprt {

template <typename _It>
using __uomap_iter_key_t = remove_const_t<typename iterator_traits<_It>::value_type::first_type>;
template <typename _It>
using __uomap_iter_mapped_t = typename iterator_traits<_It>::value_type::second_type;

} // namespace sprt

namespace std {

template <class _Key, class _Tp, class _Hash = sprt::hash<_Key>,
		class _Pred = sprt::equal_to<_Key>, class _Alloc = allocator<sprt::pair<const _Key, _Tp>>>
class unordered_map : public sprt::__unordered_map<_Key, _Tp, _Hash, _Pred, _Alloc, /*Stl=*/true> {
	using _Base = sprt::__unordered_map<_Key, _Tp, _Hash, _Pred, _Alloc, true>;

public:
	using key_type = _Key;
	using mapped_type = _Tp;
	using typename _Base::value_type;
	using typename _Base::size_type;

	using _Base::_Base;
	using _Base::operator=;
	constexpr unordered_map() = default;

	// [unord.map.elem] — real mapped_type& access, valid because the node is heap-stable. The
	// non-const operator[] default-inserts (like std::unordered_map); at() traps on a missing key.
	mapped_type &operator[](const key_type &__k) { return this->try_emplace(__k).first->second; }
	mapped_type &operator[](key_type &&__k) {
		return this->try_emplace(sprt::move_unsafe(__k)).first->second;
	}
	mapped_type &at(const key_type &__k) {
		auto __it = this->find(__k);
		if (__it == this->end()) {
			__builtin_trap();
		}
		return __it->second;
	}
	const mapped_type &at(const key_type &__k) const {
		auto __it = this->find(__k);
		if (__it == this->end()) {
			__builtin_trap();
		}
		return __it->second;
	}
};

// [unord.map.overview] deduction guides. Inherited constructors don't generate implicit guides for
// the derived class, so each supported form is spelled out. The bucket-count argument is a plain
// size_t (matching the sprt ctors); the iterator guide requires it (sprt has no (first,last) ctor).
template <class _Key, class _Tp, class _Hash = sprt::hash<_Key>, class _Pred = sprt::equal_to<_Key>,
		class _Alloc = allocator<sprt::pair<const _Key, _Tp>>>
unordered_map(initializer_list<sprt::pair<_Key, _Tp>>, size_t = 0, _Hash = _Hash(), _Pred = _Pred(),
		_Alloc = _Alloc()) -> unordered_map<_Key, _Tp, _Hash, _Pred, _Alloc>;

template <class _It, class _Hash = sprt::hash<sprt::__uomap_iter_key_t<_It>>,
		class _Pred = sprt::equal_to<sprt::__uomap_iter_key_t<_It>>,
		class _Alloc = allocator<
				sprt::pair<const sprt::__uomap_iter_key_t<_It>, sprt::__uomap_iter_mapped_t<_It>>>>
unordered_map(_It, _It, size_t, _Hash = _Hash(), _Pred = _Pred(), _Alloc = _Alloc())
		-> unordered_map<sprt::__uomap_iter_key_t<_It>, sprt::__uomap_iter_mapped_t<_It>, _Hash, _Pred,
				_Alloc>;

// allocator-only spellings of the above (LWG-style extra guides).
template <class _Key, class _Tp, class _Alloc>
unordered_map(initializer_list<sprt::pair<_Key, _Tp>>, size_t, _Alloc)
		-> unordered_map<_Key, _Tp, sprt::hash<_Key>, sprt::equal_to<_Key>, _Alloc>;

template <class _Key, class _Tp, class _Hash, class _Alloc>
unordered_map(initializer_list<sprt::pair<_Key, _Tp>>, size_t, _Hash, _Alloc)
		-> unordered_map<_Key, _Tp, _Hash, sprt::equal_to<_Key>, _Alloc>;

// [unord.map.erasure] std::erase_if (C++20).
template <class _Key, class _Tp, class _Hash, class _Pred, class _Alloc, class _Predicate>
typename unordered_map<_Key, _Tp, _Hash, _Pred, _Alloc>::size_type erase_if(
		unordered_map<_Key, _Tp, _Hash, _Pred, _Alloc> &__c, _Predicate __pred) {
	const auto __old = __c.size();
	for (auto __i = __c.begin(), __last = __c.end(); __i != __last;) {
		if (__pred(*__i)) {
			__i = __c.erase(__i);
		} else {
			++__i;
		}
	}
	return __old - __c.size();
}

// std::unordered_multimap — equivalent-key variant, implemented ENTIRELY in the STL layer over the
// separate-chaining __detail::chain_memory (equal keys adjacent in iteration → valid equal_range;
// references stable). insert/emplace always add and return an iterator (never a pair); erase(key)
// removes ALL matching. No operator[]/at (as in std). Heterogeneous lookup reuses the sprt
// __unordered_map_compatible_key concept.
template <class _Key, class _Tp, class _Hash = sprt::hash<_Key>,
		class _Pred = sprt::equal_to<_Key>, class _Alloc = allocator<sprt::pair<const _Key, _Tp>>>
class unordered_multimap : public _Alloc::base_class {
public:
	using key_type = _Key;
	using mapped_type = _Tp;
	using value_type = sprt::pair<const _Key, _Tp>;
	using hasher = _Hash;
	using key_equal = _Pred;
	using allocator_type = _Alloc;
	using container_type = __detail::chain_memory<key_type, value_type, _Hash, _Pred, _Alloc>;
	using pointer = typename sprt::allocator_traits<_Alloc>::pointer;
	using const_pointer = typename sprt::allocator_traits<_Alloc>::const_pointer;
	using reference = value_type &;
	using const_reference = const value_type &;
	using size_type = size_t;
	using difference_type = ptrdiff_t;
	using iterator = typename container_type::iterator;
	using const_iterator = typename container_type::const_iterator;

	~unordered_multimap() { }

	unordered_multimap() : _container(0, hasher(), key_equal(), allocator_type()) { }

	explicit unordered_multimap(size_type __n, const hasher &__hf = hasher(),
			const key_equal &__eql = key_equal(), const allocator_type &__a = allocator_type())
	: _container(__n, __hf, __eql, __a) { }

	template <class _It,
			sprt::enable_if_t<sprt::__has_input_iterator_category<_It>::value, int> = 0>
	unordered_multimap(_It __f, _It __l, size_type __n = 0, const hasher &__hf = hasher(),
			const key_equal &__eql = key_equal(), const allocator_type &__a = allocator_type())
	: _container(__n, __hf, __eql, __a) {
		while (__f != __l) { _container.insert_multi(*__f++); }
	}

	unordered_multimap(initializer_list<value_type> __il, size_type __n = 0,
			const hasher &__hf = hasher(), const key_equal &__eql = key_equal(),
			const allocator_type &__a = allocator_type())
	: _container(__n, __hf, __eql, __a) {
		for (auto &__it : __il) { _container.insert_multi(__it); }
	}

	unordered_multimap(const unordered_multimap &__o)
	: _container(0, __o.hash_function(), __o.key_eq(),
			  sprt::allocator_traits<allocator_type>::select_on_container_copy_construction(
					  __o.get_allocator())) {
		_container.copy_from(__o._container);
	}
	unordered_multimap(unordered_multimap &&__o)
	: _container(0, __o.hash_function(), __o.key_eq(), __o.get_allocator()) {
		_container.move_from(sprt::move(__o._container));
	}
	explicit unordered_multimap(const allocator_type &__a)
	: _container(0, hasher(), key_equal(), __a) { }

	unordered_multimap &operator=(const unordered_multimap &__o) {
		_container.copy_from(__o._container);
		return *this;
	}
	unordered_multimap &operator=(unordered_multimap &&__o) {
		_container.move_from(sprt::move(__o._container));
		return *this;
	}
	unordered_multimap &operator=(initializer_list<value_type> __il) {
		clear();
		for (auto &__it : __il) { _container.insert_multi(__it); }
		return *this;
	}

	allocator_type get_allocator() const noexcept { return _container.get_allocator(); }

	iterator begin() noexcept { return _container.begin(); }
	const_iterator begin() const noexcept { return _container.begin(); }
	iterator end() noexcept { return _container.end(); }
	const_iterator end() const noexcept { return _container.end(); }
	const_iterator cbegin() const noexcept { return _container.begin(); }
	const_iterator cend() const noexcept { return _container.end(); }

	bool empty() const noexcept { return _container.size() == 0; }
	size_type size() const noexcept { return _container.size(); }
	size_type max_size() const noexcept { return _container.max_size(); }

	template <class... _Args>
	iterator emplace(_Args &&...__args) {
		return _container.emplace_multi(sprt::forward<_Args>(__args)...);
	}
	template <class... _Args>
	iterator emplace_hint(const_iterator, _Args &&...__args) {
		return _container.emplace_multi(sprt::forward<_Args>(__args)...);
	}
	iterator insert(const value_type &__v) { return _container.insert_multi(__v); }
	iterator insert(value_type &&__v) { return _container.insert_multi(sprt::move_unsafe(__v)); }
	template <class _P>
	iterator insert(_P &&__v) {
		return _container.insert_multi(sprt::forward<_P>(__v));
	}
	iterator insert(const_iterator, const value_type &__v) { return _container.insert_multi(__v); }
	iterator insert(const_iterator, value_type &&__v) {
		return _container.insert_multi(sprt::move_unsafe(__v));
	}
	template <class _P>
	iterator insert(const_iterator, _P &&__v) {
		return _container.insert_multi(sprt::forward<_P>(__v));
	}
	template <class _It,
			sprt::enable_if_t<sprt::__has_input_iterator_category<_It>::value, int> = 0>
	void insert(_It __f, _It __l) {
		while (__f != __l) { _container.insert_multi(*__f++); }
	}
	void insert(initializer_list<value_type> __il) {
		for (auto &__it : __il) { _container.insert_multi(__it); }
	}

	iterator erase(const_iterator __p) { return _container.erase(__p); }
	iterator erase(iterator __p) { return _container.erase(__p); }
	size_type erase(const key_type &__k) { return _container.erase_all(__k); }
	iterator erase(const_iterator __f, const_iterator __l) {
		while (__f != __l) { __f = _container.erase(__f); }
		return _container.iter_cast(__l);
	}
	void clear() noexcept { _container.clear_free(); }
	void swap(unordered_multimap &__o) noexcept { _container.swap(__o._container); }

	hasher hash_function() const { return _container.hash_function(); }
	key_equal key_eq() const { return _container.key_eq(); }

	iterator find(const key_type &__k) { return _container.find(__k); }
	const_iterator find(const key_type &__k) const { return _container.find(__k); }
	template <sprt::__unordered_map_compatible_key<unordered_multimap> _K>
	iterator find(const _K &__k) {
		return _container.find(__k);
	}
	template <sprt::__unordered_map_compatible_key<unordered_multimap> _K>
	const_iterator find(const _K &__k) const {
		return _container.find(__k);
	}
	size_type count(const key_type &__k) const { return _container.count(__k); }
	template <sprt::__unordered_map_compatible_key<unordered_multimap> _K>
	size_type count(const _K &__k) const {
		return _container.count(__k);
	}
	bool contains(const key_type &__k) const { return _container.find(__k) != _container.end(); }
	template <sprt::__unordered_map_compatible_key<unordered_multimap> _K>
	bool contains(const _K &__k) const {
		return _container.find(__k) != _container.end();
	}
	sprt::pair<iterator, iterator> equal_range(const key_type &__k) {
		return _container.equal_range(__k);
	}
	sprt::pair<const_iterator, const_iterator> equal_range(const key_type &__k) const {
		return _container.equal_range(__k);
	}

	float load_factor() const noexcept { return _container.load_factor(); }
	float max_load_factor() const noexcept { return _container.max_load_factor(); }
	void max_load_factor(float __z) { _container.max_load_factor(__z); }
	void rehash(size_type __n) { _container.rehash(__n); }
	void reserve(size_type __n) { rehash(__builtin_ceilf(__n / max_load_factor())); }
	size_type bucket_count() const noexcept { return _container.bucket_count(); }

protected:
	container_type _container;
};

template <class _Key, class _Tp, class _Hash, class _Pred, class _Alloc>
inline void swap(unordered_multimap<_Key, _Tp, _Hash, _Pred, _Alloc> &__x,
		unordered_multimap<_Key, _Tp, _Hash, _Pred, _Alloc> &__y) noexcept {
	__x.swap(__y);
}

template <class _Key, class _Tp, class _Hash = sprt::hash<_Key>, class _Pred = sprt::equal_to<_Key>,
		class _Alloc = allocator<sprt::pair<const _Key, _Tp>>>
unordered_multimap(initializer_list<sprt::pair<_Key, _Tp>>, size_t = 0, _Hash = _Hash(),
		_Pred = _Pred(), _Alloc = _Alloc()) -> unordered_multimap<_Key, _Tp, _Hash, _Pred, _Alloc>;

template <class _It, class _Hash = sprt::hash<sprt::__uomap_iter_key_t<_It>>,
		class _Pred = sprt::equal_to<sprt::__uomap_iter_key_t<_It>>,
		class _Alloc = allocator<
				sprt::pair<const sprt::__uomap_iter_key_t<_It>, sprt::__uomap_iter_mapped_t<_It>>>>
unordered_multimap(_It, _It, size_t, _Hash = _Hash(), _Pred = _Pred(), _Alloc = _Alloc())
		-> unordered_multimap<sprt::__uomap_iter_key_t<_It>, sprt::__uomap_iter_mapped_t<_It>, _Hash,
				_Pred, _Alloc>;

template <class _Key, class _Tp, class _Hash, class _Pred, class _Alloc, class _Predicate>
typename unordered_multimap<_Key, _Tp, _Hash, _Pred, _Alloc>::size_type erase_if(
		unordered_multimap<_Key, _Tp, _Hash, _Pred, _Alloc> &__c, _Predicate __pred) {
	const auto __old = __c.size();
	for (auto __i = __c.begin(), __last = __c.end(); __i != __last;) {
		if (__pred(*__i)) {
			__i = __c.erase(__i);
		} else {
			++__i;
		}
	}
	return __old - __c.size();
}

} // namespace std

#endif // RUNTIME_INCLUDE_LIBC_STL_UNORDERED_MAP_H_
