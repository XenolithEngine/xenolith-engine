// Standard <map>, backed by sprt::__map (red-black tree). NOTE: operator[] and at() return a
// lazy-insertion access_token proxy, NOT mapped_type& — use m[k] = v / m[k].get() / m[k].ptr()
// / m[k].unwrap([](mapped_type&){...}) (a deliberate -fno-exceptions deviation). Also missing
// vs std::map: node handles (extract/merge/node_type) and std::multimap. swap / == / <=> are
// found by ADL on sprt::__map. Deduction guides are on sprt::__map (alias-template CTAD flows
// std::map deduction through them).

#ifndef RUNTIME_INCLUDE_LIBC_STL_MAP_H_
#define RUNTIME_INCLUDE_LIBC_STL_MAP_H_

#include <__sprt_stl_config.h>

#include <sprt/cxx/map>
#include <sprt/cxx/new>
#include <sprt/cxx/iterator>
#include <sprt/cxx/type_traits>
#include <sprt/cxx/__functional/compare.h>

namespace sprt {

template <typename _It>
using __map_iter_key_t = remove_const_t<typename iterator_traits<_It>::value_type::first_type>;
template <typename _It>
using __map_iter_mapped_t = typename iterator_traits<_It>::value_type::second_type;

} // namespace sprt

namespace std {

// std::map is a thin derived class (not an alias) so it carries its own deduction guides: the
// iterator guide's key/mapped types are computed from the iterator, which alias-template CTAD
// cannot deduce back through an alias.
template <class _Key, class _Tp, class _Compare = sprt::less<_Key>,
		class _Alloc = allocator<sprt::pair<const _Key, _Tp>>>
class map : public sprt::__map<_Key, _Tp, _Compare, _Alloc> {
	using _Base = sprt::__map<_Key, _Tp, _Compare, _Alloc>;

public:
	using _Base::_Base;
	using _Base::operator=;
	constexpr map() = default;
};

// [map.overview] deduction guides.
template <class _It, class _Comp = sprt::less<sprt::__map_iter_key_t<_It>>,
		class _Alloc = allocator<
				sprt::pair<const sprt::__map_iter_key_t<_It>, sprt::__map_iter_mapped_t<_It>>>>
map(_It, _It, _Comp = _Comp(), _Alloc = _Alloc())
		-> map<sprt::__map_iter_key_t<_It>, sprt::__map_iter_mapped_t<_It>, _Comp, _Alloc>;

template <class _Key, class _Tp, class _Comp = sprt::less<_Key>,
		class _Alloc = allocator<sprt::pair<const _Key, _Tp>>>
map(initializer_list<sprt::pair<_Key, _Tp>>, _Comp = _Comp(), _Alloc = _Alloc())
		-> map<_Key, _Tp, _Comp, _Alloc>;

template <class _It, class _Alloc>
map(_It, _It, _Alloc) -> map<sprt::__map_iter_key_t<_It>, sprt::__map_iter_mapped_t<_It>,
		sprt::less<sprt::__map_iter_key_t<_It>>, _Alloc>;

template <class _Key, class _Tp, class _Alloc>
map(initializer_list<sprt::pair<_Key, _Tp>>, _Alloc) -> map<_Key, _Tp, sprt::less<_Key>, _Alloc>;

// [map.erasure] std::erase_if (C++20).
template <class _Key, class _Tp, class _Compare, class _Alloc, class _Pred>
typename map<_Key, _Tp, _Compare, _Alloc>::size_type erase_if(
		map<_Key, _Tp, _Compare, _Alloc> &__c, _Pred __pred) {
	const auto __old = __c.size();
	for (auto __i = __c.begin(), __last = __c.end(); __i != __last;) {
		if (__pred(*__i)) {
			__i = __c.erase(__i);
		} else {
			++__i;
		}
	}
	return __old - __c.size();
}

} // namespace std

#endif // RUNTIME_INCLUDE_LIBC_STL_MAP_H_
