// Vendor <__assertion_handler> (normally CMake-generated). A failed libc++
// hardening assertion traps; the message argument is accepted but unused (no
// stderr dependency in the freestanding runtimes build).
#ifndef RUNTIME_INCLUDE_LIBC_STL___ASSERTION_HANDLER_H_
#define RUNTIME_INCLUDE_LIBC_STL___ASSERTION_HANDLER_H_

#include <__config>

#define _LIBCPP_ASSERTION_HANDLER(message) ((void)(message), __builtin_trap())

#endif // RUNTIME_INCLUDE_LIBC_STL___ASSERTION_HANDLER_H_
