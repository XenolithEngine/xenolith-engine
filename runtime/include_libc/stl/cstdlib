// Standard C-library wrapper backed by the sprt freestanding runtime. Re-exports
// the sprt C-function sub-namespace into namespace std, reproducing exactly what
// the old "-isystem sprt/cxx -D__SPRT_AS_STD" mechanism exposed for this header.

#ifndef RUNTIME_INCLUDE_LIBC_STL_CSTDLIB_H_
#define RUNTIME_INCLUDE_LIBC_STL_CSTDLIB_H_

// Always pull the full std implementations when used through the STL layer.
#include <__sprt_stl_config.h>

#include <sprt/cxx/cstdlib>
// C++ <cstdlib> also carries the integer abs overloads; sprt keeps the abs family
// in the math layer (sprt::_cmath), so pull <cmath> in to expose std::abs here too
// (libc++'s <cstdlib> likewise routes abs through <math.h>). Same functions as
// <cmath>, so there is no duplicate declaration / ambiguity when both are included.
#include <cmath>

namespace std {
using namespace sprt::_cstdlib_types;
#if __STDC_HOSTED__ == 1
using namespace sprt::_cstdlib;
#endif
} // namespace std

#endif // RUNTIME_INCLUDE_LIBC_STL_CSTDLIB_H_
