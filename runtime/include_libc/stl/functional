// Standard <functional>, backed by sprt. Provides the transparent comparison and
// identity function objects, reference_wrapper/ref/cref, invoke/invoke_r, a real
// std::hash primary template, and std::function (backed by sprt::__malloc_function).
// NOT provided (no sprt backing): std::bad_function_call (this runtime is
// -fno-exceptions, so an empty call is a debug-asserted programming error, not a
// throw), move_only_function, bind / bind_front, mem_fn / not_fn, the arithmetic,
// logical and bitwise function objects (plus, minus, logical_and, bit_and, ...).

#ifndef RUNTIME_INCLUDE_LIBC_STL_FUNCTIONAL_H_
#define RUNTIME_INCLUDE_LIBC_STL_FUNCTIONAL_H_

// Always pull the full std implementations when used through the STL layer.
#include <__sprt_stl_config.h>

#include <sprt/cxx/functional>
#include <sprt/cxx/function>
#include <sprt/cxx/type_traits>
#include <sprt/cxx/utility>
#include <sprt/cxx/__functional/invoke.h>
#include <sprt/cxx/__functional/reference_wrapper.h>

namespace std {

// std::function is backed by sprt::__malloc_function (the malloc-allocated erased
// callable). A thin derived class (rather than an alias) so it carries its own
// class-template argument deduction guides. The converting ctor/assignment inherited
// from the base exclude all function types (via __function_base_tag), so copying a
// std::function copies rather than re-wraps it.
template <typename _Signature>
class function : public sprt::__malloc_function<_Signature> {
	using _Base = sprt::__malloc_function<_Signature>;

public:
	using _Base::_Base;
	using _Base::operator=;
	using _Base::operator();
	using _Base::operator==;
	using _Base::operator!=;
	using _Base::operator bool;
	using _Base::swap;
#ifdef __cpp_rtti
	using _Base::target;
	using _Base::target_type;
#endif
};

template <typename _Res, typename... _ArgTypes>
function(_Res (*)(_ArgTypes...)) -> function<_Res(_ArgTypes...)>;

template <typename _Fn,
		typename _Sig = typename sprt::__function_guide_helper<decltype(&_Fn::operator())>::type>
function(_Fn) -> function<_Sig>;


// Transparent comparison function objects + identity (sprt::__functional/compare.h).
using sprt::equal_to;
using sprt::not_equal_to;
using sprt::less;
using sprt::less_equal;
using sprt::greater;
using sprt::greater_equal;
using sprt::identity;

// arithmetic / logical / bitwise function objects (sprt::__functional/operations.h).
using sprt::plus;
using sprt::minus;
using sprt::multiplies;
using sprt::divides;
using sprt::modulus;
using sprt::negate;
using sprt::logical_and;
using sprt::logical_or;
using sprt::logical_not;
using sprt::bit_and;
using sprt::bit_or;
using sprt::bit_xor;
using sprt::bit_not;

// mem_fn / not_fn / bind_front / bind_back (sprt::__functional/bind.h). NB: the classic
// std::bind with placeholders is not provided.
using sprt::mem_fn;
using sprt::not_fn;
using sprt::bind_front;
using sprt::bind_back;

// reference_wrapper and its factories (sprt::__functional/reference_wrapper.h).
using sprt::reference_wrapper;
using sprt::ref;
using sprt::cref;

// std::invoke / invoke_r delegate to sprt's internal __invoke (sprt exposes no
// public `invoke`). The trailing return type keeps invoke SFINAE-friendly.
template <typename _Fn, typename... _Args>
constexpr auto invoke(_Fn &&__f, _Args &&...__args) noexcept(
		noexcept(sprt::__invoke(sprt::forward<_Fn>(__f), sprt::forward<_Args>(__args)...)))
		-> decltype(sprt::__invoke(sprt::forward<_Fn>(__f), sprt::forward<_Args>(__args)...)) {
	return sprt::__invoke(sprt::forward<_Fn>(__f), sprt::forward<_Args>(__args)...);
}

template <typename _Ret, typename _Fn, typename... _Args>
constexpr _Ret invoke_r(_Fn &&__f, _Args &&...__args) noexcept(
		noexcept(sprt::__invoke(sprt::forward<_Fn>(__f), sprt::forward<_Args>(__args)...))) {
	// [func.invoke]: INVOKE<R>(...) — for cv-void R the result is discarded.
	if constexpr (sprt::is_void<_Ret>::value) {
		sprt::__invoke(sprt::forward<_Fn>(__f), sprt::forward<_Args>(__args)...);
	} else {
		return sprt::__invoke(sprt::forward<_Fn>(__f), sprt::forward<_Args>(__args)...);
	}
}

// SPECIAL: a real std::hash primary template (delegating to sprt::hash) so user code
// can write `template <> struct std::hash<T>` specializations and so the sprt hash
// specializations (optional, variant, type_index, bitset, ...) are reachable through
// std::hash. [unord.hash]/2 requires the primary to be a *disabled* specialization for
// types with no enabled hash (deleted default/copy ctors, no call operator) so that
// e.g. is_default_constructible_v<hash<NotHashable>> is false. sprt::hash has an
// undefined primary, so `sprt::hash<T>()(...)` is well-formed exactly for hashable T;
// __hash_enabled keys the enabled/disabled split on that.
template <typename _Tp, typename = void>
struct __hash_enabled {
	__hash_enabled() = delete;
	__hash_enabled(const __hash_enabled &) = delete;
	__hash_enabled &operator=(const __hash_enabled &) = delete;
};

template <typename _Tp>
struct __hash_enabled<_Tp, sprt::void_t<decltype(sprt::hash<_Tp>()(sprt::declval<const _Tp &>()))>> {
	sprt::size_t operator()(const _Tp &__v) const noexcept(noexcept(sprt::hash<_Tp>()(__v))) {
		return sprt::hash<_Tp>()(__v);
	}
};

template <typename _Tp>
struct hash : __hash_enabled<_Tp> { };

} // namespace std

#endif // RUNTIME_INCLUDE_LIBC_STL_FUNCTIONAL_H_
