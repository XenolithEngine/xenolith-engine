// <stdexcept>, based on libc++'s original in the Itanium (non-VCRUNTIME) ABI
// layout that libc++abi's stdlib_stdexcept.cpp implements: the __libcpp_refstring
// message store (methods provided by libc++'s include/refstring.h) and the nine
// exception classes. std::exception is the sprt one (<sprt/cxx/exception>).
//
// The `const std::string&` constructors of the standard are intentionally omitted
// here: libc++abi neither defines nor uses them, and declaring them would force a
// dependency on the full sprt <string>. Their absence does not change any class's
// ABI (layout / vtable / __imp_ offset), so a libc++abi built against this header
// stays link-compatible with a runtime that provides the string overloads.
#ifndef RUNTIME_INCLUDE_LIBC_STL_STDEXCEPT_H_
#define RUNTIME_INCLUDE_LIBC_STL_STDEXCEPT_H_

#include <__config>
#include <sprt/cxx/exception> // std::exception

_LIBCPP_BEGIN_NAMESPACE_STD

// Ref-counted immutable string used to store the exception message. Only the
// class is declared here; the bodies live in libc++'s include/refstring.h, which
// libc++abi compiles (and which static_asserts sizeof == sizeof(const char*)).
class _LIBCPP_HIDDEN __libcpp_refstring {
	const char *__imp_;
	bool __uses_refcount() const;

public:
	explicit __libcpp_refstring(const char *__msg);
	__libcpp_refstring(const __libcpp_refstring &__s) noexcept;
	__libcpp_refstring &operator=(const __libcpp_refstring &__s) noexcept;
	~__libcpp_refstring();
	_LIBCPP_HIDE_FROM_ABI const char *c_str() const noexcept { return __imp_; }
};

_LIBCPP_END_NAMESPACE_STD

namespace std { // purposefully not using a versioning namespace

class _LIBCPP_EXPORTED_FROM_ABI logic_error : public exception {
private:
	std::__libcpp_refstring __imp_;

public:
	explicit logic_error(const char *);
	logic_error(const logic_error &) noexcept;
	logic_error &operator=(const logic_error &) noexcept;
	~logic_error() noexcept override;
	const char *what() const noexcept override;
};

class _LIBCPP_EXPORTED_FROM_ABI runtime_error : public exception {
private:
	std::__libcpp_refstring __imp_;

public:
	explicit runtime_error(const char *);
	runtime_error(const runtime_error &) noexcept;
	runtime_error &operator=(const runtime_error &) noexcept;
	~runtime_error() noexcept override;
	const char *what() const noexcept override;
};

class _LIBCPP_EXPORTED_FROM_ABI domain_error : public logic_error {
public:
	_LIBCPP_HIDE_FROM_ABI explicit domain_error(const char *__s) : logic_error(__s) { }
	_LIBCPP_HIDE_FROM_ABI domain_error(const domain_error &) noexcept = default;
	_LIBCPP_HIDE_FROM_ABI domain_error &operator=(const domain_error &) noexcept = default;
	~domain_error() noexcept override;
};

class _LIBCPP_EXPORTED_FROM_ABI invalid_argument : public logic_error {
public:
	_LIBCPP_HIDE_FROM_ABI explicit invalid_argument(const char *__s) : logic_error(__s) { }
	_LIBCPP_HIDE_FROM_ABI invalid_argument(const invalid_argument &) noexcept = default;
	_LIBCPP_HIDE_FROM_ABI invalid_argument &operator=(const invalid_argument &) noexcept = default;
	~invalid_argument() noexcept override;
};

