// SPECIAL: sprt::move is SFINAE-disabled for pointer types (a refcount-safety
// guard), so a plain `using sprt::move;` would not give a conforming std::move.
// Define the unrestricted standard std::move here. (A direct declaration like this
// shadows the pointer-restricted sprt::move that any `using namespace sprt;` in
// other stl headers would otherwise inject, so std::move stays unrestricted.)
template <typename _Tp>
[[nodiscard]]
constexpr typename sprt::remove_reference<_Tp>::type &&move(_Tp &&__value) noexcept {
	return static_cast<typename sprt::remove_reference<_Tp>::type &&>(__value);
}

