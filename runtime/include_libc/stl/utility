// [utility.intcmp] integer comparison functions (C++20). Pure library, no sprt
// backing and no exceptions, so they are implemented directly in the wrapper.
// Each is Mandated to operate on standard (signed/unsigned) integer types only.
template <typename _Tp>
inline constexpr bool __is_standard_integer = sprt::is_same_v<_Tp, signed char>
		|| sprt::is_same_v<_Tp, short> || sprt::is_same_v<_Tp, int> || sprt::is_same_v<_Tp, long>
		|| sprt::is_same_v<_Tp, long long> || sprt::is_same_v<_Tp, unsigned char>
		|| sprt::is_same_v<_Tp, unsigned short> || sprt::is_same_v<_Tp, unsigned int>
		|| sprt::is_same_v<_Tp, unsigned long> || sprt::is_same_v<_Tp, unsigned long long>;

template <typename _Tp, typename _Up>
constexpr bool cmp_equal(_Tp __t, _Up __u) noexcept {
	static_assert(__is_standard_integer<_Tp> && __is_standard_integer<_Up>,
			"cmp_equal requires standard integer types");
	if constexpr (sprt::is_signed_v<_Tp> == sprt::is_signed_v<_Up>) {
		return __t == __u;
	} else if constexpr (sprt::is_signed_v<_Tp>) {
		return __t >= 0 && sprt::make_unsigned_t<_Tp>(__t) == __u;
	} else {
		return __u >= 0 && sprt::make_unsigned_t<_Up>(__u) == __t;
	}
}

template <typename _Tp, typename _Up>
constexpr bool cmp_not_equal(_Tp __t, _Up __u) noexcept {
	return !std::cmp_equal(__t, __u);
}

template <typename _Tp, typename _Up>
constexpr bool cmp_less(_Tp __t, _Up __u) noexcept {
	static_assert(__is_standard_integer<_Tp> && __is_standard_integer<_Up>,
			"cmp_less requires standard integer types");
	if constexpr (sprt::is_signed_v<_Tp> == sprt::is_signed_v<_Up>) {
		return __t < __u;
	} else if constexpr (sprt::is_signed_v<_Tp>) {
		return __t < 0 || sprt::make_unsigned_t<_Tp>(__t) < __u;
	} else {
		return __u >= 0 && __t < sprt::make_unsigned_t<_Up>(__u);
	}
}

template <typename _Tp, typename _Up>
constexpr bool cmp_greater(_Tp __t, _Up __u) noexcept {
	return std::cmp_less(__u, __t);
}

template <typename _Tp, typename _Up>
constexpr bool cmp_less_equal(_Tp __t, _Up __u) noexcept {
	return !std::cmp_less(__u, __t);
}

template <typename _Tp, typename _Up>
constexpr bool cmp_greater_equal(_Tp __t, _Up __u) noexcept {
	return !std::cmp_less(__t, __u);
}

template <typename _Rp, typename _Tp>
constexpr bool in_range(_Tp __t) noexcept {
	static_assert(__is_standard_integer<_Rp> && __is_standard_integer<_Tp>,
			"in_range requires standard integer types");
	return std::cmp_greater_equal(__t, sprt::Min<_Rp>) && std::cmp_less_equal(__t, sprt::Max<_Rp>);
}

} // namespace std

// The get<> accessors for std::pair (== sprt::pair) must live in namespace sprt so
// that structured bindings find them by ADL on the sprt::pair type. tuple_size /
// tuple_element stay in std (they are named qualified), and `using sprt::get` below
// re-exposes the pair accessors as std::get. None of this touches sprt's sources.
namespace sprt {

template <sprt::size_t _Ip, typename _T1, typename _T2>
constexpr sprt::conditional_t<_Ip == 0, _T1, _T2> &get(sprt::pair<_T1, _T2> &__p) noexcept {
	static_assert(_Ip < 2, "pair index out of range");
	if constexpr (_Ip == 0) {
		return __p.first;
	} else {
		return __p.second;
	}
}
template <sprt::size_t _Ip, typename _T1, typename _T2>
constexpr const sprt::conditional_t<_Ip == 0, _T1, _T2> &get(
		const sprt::pair<_T1, _T2> &__p) noexcept {
	static_assert(_Ip < 2, "pair index out of range");
	if constexpr (_Ip == 0) {
		return __p.first;
	} else {
		return __p.second;
	}
}
template <sprt::size_t _Ip, typename _T1, typename _T2>
constexpr sprt::conditional_t<_Ip == 0, _T1, _T2> &&get(sprt::pair<_T1, _T2> &&__p) noexcept {
	static_assert(_Ip < 2, "pair index out of range");
	if constexpr (_Ip == 0) {
		return static_cast<_T1 &&>(__p.first);
	} else {
		return static_cast<_T2 &&>(__p.second);
	}
}
template <sprt::size_t _Ip, typename _T1, typename _T2>
constexpr const sprt::conditional_t<_Ip == 0, _T1, _T2> &&get(
		const sprt::pair<_T1, _T2> &&__p) noexcept {
	static_assert(_Ip < 2, "pair index out of range");
	if constexpr (_Ip == 0) {
		return static_cast<const _T1 &&>(__p.first);
	} else {
		return static_cast<const _T2 &&>(__p.second);
	}
}

template <typename _Tp, typename _T1, typename _T2>
constexpr _Tp &get(sprt::pair<_T1, _T2> &__p) noexcept {
	static_assert(!sprt::is_same_v<_T1, _T2>, "get<T>(pair) requires distinct element types");
	if constexpr (sprt::is_same_v<_Tp, _T1>) {
		return __p.first;
	} else {
		return __p.second;
	}
}
template <typename _Tp, typename _T1, typename _T2>
constexpr const _Tp &get(const sprt::pair<_T1, _T2> &__p) noexcept {
	static_assert(!sprt::is_same_v<_T1, _T2>, "get<T>(pair) requires distinct element types");
	if constexpr (sprt::is_same_v<_Tp, _T1>) {
		return __p.first;
	} else {
		return __p.second;
	}
}
template <typename _Tp, typename _T1, typename _T2>
constexpr _Tp &&get(sprt::pair<_T1, _T2> &&__p) noexcept {
	static_assert(!sprt::is_same_v<_T1, _T2>, "get<T>(pair) requires distinct element types");
	if constexpr (sprt::is_same_v<_Tp, _T1>) {
		return static_cast<_T1 &&>(__p.first);
	} else {
		return static_cast<_T2 &&>(__p.second);
	}
}
template <typename _Tp, typename _T1, typename _T2>
constexpr const _Tp &&get(const sprt::pair<_T1, _T2> &&__p) noexcept {
	static_assert(!sprt::is_same_v<_T1, _T2>, "get<T>(pair) requires distinct element types");
	if constexpr (sprt::is_same_v<_Tp, _T1>) {
		return static_cast<const _T1 &&>(__p.first);
	} else {
		return static_cast<const _T2 &&>(__p.second);
	}
}

} // namespace sprt

namespace std {

// Tuple protocol for std::pair (== sprt::pair). sprt provides none of these.
template <typename _T1, typename _T2>
struct tuple_size<sprt::pair<_T1, _T2>> : sprt::integral_constant<sprt::size_t, 2> { };

template <typename _T1, typename _T2>
struct tuple_element<0, sprt::pair<_T1, _T2>> {
	using type = _T1;
};
template <typename _T1, typename _T2>
struct tuple_element<1, sprt::pair<_T1, _T2>> {
	using type = _T2;
};

using sprt::get; // expose the pair accessors as std::get<>(pair)

} // namespace std

#endif // RUNTIME_INCLUDE_LIBC_STL_UTILITY_H_
