// Standard <set>, backed by sprt::__set (red-black tree). Unlike <map> there is no operator[],
// so no access_token — set is a close std::set match (iterator == const_iterator, as in the
// standard). Missing vs std::set: node handles (extract/merge/node_type) and std::multiset.
// swap / == / <=> via ADL on sprt::__set; deduction guides on sprt::__set (alias CTAD).

#ifndef RUNTIME_INCLUDE_LIBC_STL_SET_H_
#define RUNTIME_INCLUDE_LIBC_STL_SET_H_

#include <__sprt_stl_config.h>

#include <sprt/cxx/set>
#include <sprt/cxx/new>
#include <sprt/cxx/iterator>
#include <sprt/cxx/__functional/compare.h>

namespace sprt {

template <typename _It>
using __set_iter_val_t = typename iterator_traits<_It>::value_type;

} // namespace sprt

namespace std {

// std::set is a thin derived class (not an alias) so it carries its own deduction guides
// (alias-template CTAD cannot deduce the value type back through an alias from an iterator).
template <class _Key, class _Compare = sprt::less<_Key>, class _Alloc = allocator<_Key>>
class set : public sprt::__set<_Key, _Compare, _Alloc> {
	using _Base = sprt::__set<_Key, _Compare, _Alloc>;

public:
	using _Base::_Base;
	using _Base::operator=;
	constexpr set() = default;
};

// [set.overview] deduction guides.
template <class _It, class _Comp = sprt::less<sprt::__set_iter_val_t<_It>>,
		class _Alloc = allocator<sprt::__set_iter_val_t<_It>>>
set(_It, _It, _Comp = _Comp(), _Alloc = _Alloc()) -> set<sprt::__set_iter_val_t<_It>, _Comp, _Alloc>;

template <class _Key, class _Comp = sprt::less<_Key>, class _Alloc = allocator<_Key>>
set(initializer_list<_Key>, _Comp = _Comp(), _Alloc = _Alloc()) -> set<_Key, _Comp, _Alloc>;

template <class _It, class _Alloc>
set(_It, _It, _Alloc)
		-> set<sprt::__set_iter_val_t<_It>, sprt::less<sprt::__set_iter_val_t<_It>>, _Alloc>;

template <class _Key, class _Alloc>
set(initializer_list<_Key>, _Alloc) -> set<_Key, sprt::less<_Key>, _Alloc>;

// [set.erasure] std::erase_if (C++20).
template <class _Key, class _Compare, class _Alloc, class _Pred>
typename set<_Key, _Compare, _Alloc>::size_type erase_if(set<_Key, _Compare, _Alloc> &__c, _Pred __pred) {
	const auto __old = __c.size();
	for (auto __i = __c.begin(), __last = __c.end(); __i != __last;) {
		if (__pred(*__i)) {
			__i = __c.erase(__i);
		} else {
			++__i;
		}
	}
	return __old - __c.size();
}

} // namespace std

#endif // RUNTIME_INCLUDE_LIBC_STL_SET_H_
