// Standard <vector>, backed by sprt. std::allocator is a full sprt allocator policy
// (see <new>), so std::vector<T> == sprt::__vector<T, std::allocator<T>> with the
// canonical standard spelling. NOTE: no allocator-aware CTAD deduction guides and no
// bit-packed std::vector<bool> specialization; std::erase/erase_if are provided below.

#ifndef RUNTIME_INCLUDE_LIBC_STL_VECTOR_H_
#define RUNTIME_INCLUDE_LIBC_STL_VECTOR_H_

// Always pull the full std implementations when used through the STL layer.
#include <__sprt_stl_config.h>

#include <sprt/cxx/vector>
#include <sprt/cxx/__algorithm/remove.h>

namespace std {

template <class _Tp, class _Alloc = allocator<_Tp>>
using vector = sprt::__vector<_Tp, _Alloc>;

// [vector.erasure] std::erase / std::erase_if (C++20): erase-remove, return count.
template <class _Tp, class _Alloc, class _Up>
typename vector<_Tp, _Alloc>::size_type erase(vector<_Tp, _Alloc> &__c, const _Up &__value) {
	auto __it = sprt::remove(__c.begin(), __c.end(), __value);
	auto __n = __c.end() - __it;
	__c.erase(__it, __c.end());
	return static_cast<typename vector<_Tp, _Alloc>::size_type>(__n);
}

template <class _Tp, class _Alloc, class _Pred>
typename vector<_Tp, _Alloc>::size_type erase_if(vector<_Tp, _Alloc> &__c, _Pred __pred) {
	auto __it = sprt::remove_if(__c.begin(), __c.end(), __pred);
	auto __n = __c.end() - __it;
	__c.erase(__it, __c.end());
	return static_cast<typename vector<_Tp, _Alloc>::size_type>(__n);
}

} // namespace std

#endif // RUNTIME_INCLUDE_LIBC_STL_VECTOR_H_
