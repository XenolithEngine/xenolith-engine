// Standard <cctype>, backed by sprt. The classification predicates (isalnum,
// isalpha, ... isxdigit) come from sprt::_cctype. std::toupper / std::tolower are
// implemented over the C++-primary constexpr forms sprt::toupper_c /
// sprt::tolower_c (not the C-library extern "C" toupper/tolower), so that in C++
// the C++ functions are the ones used. As in the standard, an int that is not
// representable as unsigned char is returned unchanged.

#ifndef RUNTIME_INCLUDE_LIBC_STL_CCTYPE_H_
#define RUNTIME_INCLUDE_LIBC_STL_CCTYPE_H_

// Always pull the full std implementations when used through the STL layer.
#include <__sprt_stl_config.h>

#include <sprt/cxx/cctype>

namespace std {
using namespace sprt::_cctype;

[[nodiscard]]
inline constexpr int toupper(int __c) {
	return (__c >= 0 && __c <= 0xFF)
			? static_cast<int>(static_cast<unsigned char>(sprt::toupper_c(static_cast<char>(__c))))
			: __c;
}

[[nodiscard]]
inline constexpr int tolower(int __c) {
	return (__c >= 0 && __c <= 0xFF)
			? static_cast<int>(static_cast<unsigned char>(sprt::tolower_c(static_cast<char>(__c))))
			: __c;
}

} // namespace std

#endif // RUNTIME_INCLUDE_LIBC_STL_CCTYPE_H_
