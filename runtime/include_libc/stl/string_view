// Standard <string_view>, backed by sprt::basic_string_view. The comparison operators are
// found by ADL on sprt::basic_string_view; std::hash<basic_string_view> reaches the sprt
// hash specialization through the delegating std::hash in <functional>.

#ifndef RUNTIME_INCLUDE_LIBC_STL_STRING_VIEW_H_
#define RUNTIME_INCLUDE_LIBC_STL_STRING_VIEW_H_

// Always pull the full std implementations when used through the STL layer.
#include <__sprt_stl_config.h>

#include <sprt/cxx/string_view>

namespace std {
using sprt::basic_string_view;
using sprt::string_view;
using sprt::wstring_view;
using sprt::u8string_view;
using sprt::u16string_view;
using sprt::u32string_view;

inline namespace literals {
inline namespace string_view_literals {
using sprt::literals::string_view_literals::operator""sv;
} // namespace string_view_literals
} // namespace literals
} // namespace std

#endif // RUNTIME_INCLUDE_LIBC_STL_STRING_VIEW_H_
