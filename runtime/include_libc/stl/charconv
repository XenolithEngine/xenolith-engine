// Standard <charconv>, backed by sprt. to_chars uses sprt::itoa/dtoa; from_chars uses the
// portable sprt::_cstdlib::strto* wrappers (+ __sprt_errno for overflow) — see the sprt header.
// std::errc here is the minimal enum sprt provides (the full errc belongs to <system_error>).

#ifndef RUNTIME_INCLUDE_LIBC_STL_CHARCONV_H_
#define RUNTIME_INCLUDE_LIBC_STL_CHARCONV_H_

#include <__sprt_stl_config.h>

#include <sprt/cxx/charconv>

namespace std {
using sprt::chars_format;
using sprt::errc;
using sprt::from_chars;
using sprt::from_chars_result;
using sprt::to_chars;
using sprt::to_chars_result;
} // namespace std

#endif // RUNTIME_INCLUDE_LIBC_STL_CHARCONV_H_
