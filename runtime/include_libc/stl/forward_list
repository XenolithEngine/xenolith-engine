// Standard <forward_list>, backed by sprt::__forward_list (singly linked list). std::forward_list
// is a thin derived class (not an alias) so it carries its own deduction guides. The list
// operations remove/remove_if/unique/sort/merge/reverse/splice_after are provided (as element-
// moving members, see the sprt header). swap / == / <=> via ADL on sprt::__forward_list.

#ifndef RUNTIME_INCLUDE_LIBC_STL_FORWARD_LIST_H_
#define RUNTIME_INCLUDE_LIBC_STL_FORWARD_LIST_H_

#include <__sprt_stl_config.h>

#include <sprt/cxx/forward_list>
#include <sprt/cxx/new>
#include <sprt/cxx/iterator>
#include <sprt/cxx/initializer_list>

namespace sprt {

template <typename _It>
using __forward_list_iter_val_t = typename iterator_traits<_It>::value_type;

} // namespace sprt

namespace std {

template <class _Tp, class _Alloc = allocator<_Tp>>
class forward_list : public sprt::__forward_list<_Tp, _Alloc> {
	using _Base = sprt::__forward_list<_Tp, _Alloc>;

public:
	using _Base::_Base;
	using _Base::operator=;
	constexpr forward_list() = default;
};

// [forward.list.overview] deduction guides.
template <class _It, class _Alloc = allocator<sprt::__forward_list_iter_val_t<_It>>>
forward_list(_It, _It, _Alloc = _Alloc())
		-> forward_list<sprt::__forward_list_iter_val_t<_It>, _Alloc>;

template <class _Tp, class _Alloc = allocator<_Tp>>
forward_list(initializer_list<_Tp>, _Alloc = _Alloc()) -> forward_list<_Tp, _Alloc>;

// [forward.list.erasure] std::erase / std::erase_if (C++20). forward_list has no size(), so
// count is tracked manually via the before_begin / erase_after walk.
template <class _Tp, class _Alloc, class _Pred>
typename forward_list<_Tp, _Alloc>::size_type erase_if(forward_list<_Tp, _Alloc> &__c, _Pred __pred) {
	typename forward_list<_Tp, _Alloc>::size_type __removed = 0;
	auto __prev = __c.before_begin();
	auto __cur = __c.begin();
	while (__cur != __c.end()) {
		if (__pred(*__cur)) {
			__cur = __c.erase_after(__prev);
			++__removed;
		} else {
			__prev = __cur;
			++__cur;
		}
	}
	return __removed;
}

template <class _Tp, class _Alloc, class _Up>
typename forward_list<_Tp, _Alloc>::size_type erase(forward_list<_Tp, _Alloc> &__c, const _Up &__value) {
	return std::erase_if(__c, [&](const _Tp &__e) { return __e == __value; });
}

} // namespace std

#endif // RUNTIME_INCLUDE_LIBC_STL_FORWARD_LIST_H_
