// Standard <source_location>, backed by the sprt freestanding runtime.
//
// __builtin_source_location() requires the type std::source_location::__impl, so
// <sprt/cxx/source_location> always defines at least that. Here we request the FULL
// std::source_location (with current()/line()/column()/file_name()/function_name())
// by defining __SPRT_STD_SOURCE_LOCATION before including the sprt header, so that
// `std::source_location::current()` works for code that includes <source_location>.
// (When <sprt/cxx/source_location> is included directly the macro is unset and
// std::source_location stays the minimal shell, with the full type as
// sprt::source_location — unchanged sprt behaviour.)
//
// NOTE: to get the full std type, include <source_location> before any header that
// pulls <sprt/cxx/source_location> first (normal include-it-first practice); once the
// shell is defined in a TU it cannot be upgraded.

#ifndef RUNTIME_INCLUDE_LIBC_STL_SOURCE_LOCATION_H_
#define RUNTIME_INCLUDE_LIBC_STL_SOURCE_LOCATION_H_

// Always pull the full std implementations when used through the STL layer.
// __sprt_stl_config.h defines __SPRT_STD_SOURCE_LOCATION, which makes the sprt
// header below provide the full std::source_location.
#include <__sprt_stl_config.h>

#include <sprt/cxx/source_location>

#endif // RUNTIME_INCLUDE_LIBC_STL_SOURCE_LOCATION_H_
