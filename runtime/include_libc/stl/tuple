// Standard <tuple>, backed by sprt::tuple. The type, get<>, factories and comparison
// operators live in namespace sprt (comparisons found by ADL on sprt::tuple); the
// tuple_size / tuple_element protocol primaries and their sprt::tuple specializations
// live in namespace std (via <sprt/cxx/__tuple/protocol.h> + <sprt/cxx/tuple>).

#ifndef RUNTIME_INCLUDE_LIBC_STL_TUPLE_H_
#define RUNTIME_INCLUDE_LIBC_STL_TUPLE_H_

// Always pull the full std implementations when used through the STL layer.
#include <__sprt_stl_config.h>

#include <sprt/cxx/tuple>

namespace std {
using sprt::tuple;
using sprt::make_tuple;
using sprt::forward_as_tuple;
using sprt::tie;
using sprt::tuple_cat;
using sprt::apply;
using sprt::make_from_tuple;
using sprt::ignore;
using sprt::get; // also exposes the pair/array get<> overloads as std::get
} // namespace std

#endif // RUNTIME_INCLUDE_LIBC_STL_TUPLE_H_
