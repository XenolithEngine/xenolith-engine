// Hand-written replacement for libc++'s <__config>, based on the original macro
// definitions but self-contained (no <__configuration/*> chain) and targeted at
// wasm32 + clang + freestanding. It exists ONLY to satisfy the libc++ build-
// internal headers that libc++abi pulls from its own tree (atomic_support.h,
// overridable_function.h, cxa_guard_impl.h, <__assert>). The runtime's public
// std:: comes from the sprt STL, so _LIBCPP_BEGIN_NAMESPACE_STD opens plain
// namespace std (no inline __1 version namespace) to stay a single std::.
#ifndef RUNTIME_INCLUDE_LIBC_STL___CONFIG_H_
#define RUNTIME_INCLUDE_LIBC_STL___CONFIG_H_

#include <__config_site>

#if !defined(_LIBCPP_HAS_NO_PRAGMA_SYSTEM_HEADER)
#  pragma GCC system_header
#endif

// --- version / namespace ---------------------------------------------------
#define _LIBCPP_VERSION 210000
#ifndef _LIBCPP_ABI_NAMESPACE
#  define _LIBCPP_ABI_NAMESPACE __1
#endif
#define _LIBCPP_BEGIN_UNVERSIONED_NAMESPACE_STD namespace std {
#define _LIBCPP_END_UNVERSIONED_NAMESPACE_STD }
// Single, unversioned std:: (matches the sprt STL).
#define _LIBCPP_BEGIN_NAMESPACE_STD namespace std {
#define _LIBCPP_END_NAMESPACE_STD }

// --- stringify -------------------------------------------------------------
#define _LIBCPP_TOSTRING2(x) #x
#define _LIBCPP_TOSTRING(x) _LIBCPP_TOSTRING2(x)

// --- visibility / linkage --------------------------------------------------
#define _LIBCPP_VISIBILITY(vis) __attribute__((__visibility__(vis)))
#define _LIBCPP_HIDDEN __attribute__((__visibility__("hidden")))
#define _LIBCPP_EXCLUDE_FROM_EXPLICIT_INSTANTIATION __attribute__((__exclude_from_explicit_instantiation__))
#define _LIBCPP_HIDE_FROM_ABI \
	_LIBCPP_HIDDEN _LIBCPP_EXCLUDE_FROM_EXPLICIT_INSTANTIATION __attribute__((__nodebug__))
#define _LIBCPP_HIDE_FROM_ABI_VIRTUAL _LIBCPP_HIDE_FROM_ABI
#define _LIBCPP_INLINE_VISIBILITY _LIBCPP_HIDE_FROM_ABI
#define _LIBCPP_FUNC_VIS
#define _LIBCPP_TYPE_VIS
#define _LIBCPP_TEMPLATE_VIS
#define _LIBCPP_EXPORTED_FROM_ABI
#define _LIBCPP_OVERRIDABLE_FUNC_VIS
#define _LIBCPP_WEAK __attribute__((__weak__))

// --- misc qualifiers -------------------------------------------------------
#if __has_cpp_attribute(msvc::no_unique_address)
#  define _LIBCPP_NO_UNIQUE_ADDRESS [[msvc::no_unique_address]]
#elif __has_cpp_attribute(no_unique_address)
#  define _LIBCPP_NO_UNIQUE_ADDRESS [[__no_unique_address__]]
#else
#  define _LIBCPP_NO_UNIQUE_ADDRESS
#endif

#if __has_builtin(__builtin_assume)
#  define _LIBCPP_ASSUME(expr) __builtin_assume(static_cast<bool>(expr))
#else
#  define _LIBCPP_ASSUME(expr) ((void)0)
#endif

#define _LIBCPP_CONSTINIT constinit
#define _LIBCPP_NORETURN [[__noreturn__]]
#define _LIBCPP_NODISCARD [[__nodiscard__]]
#define _LIBCPP_NOALIAS __attribute__((__malloc__))
#define _LIBCPP_USING_IF_EXISTS __attribute__((__using_if_exists__))
#define _LIBCPP_ALWAYS_INLINE __attribute__((__always_inline__))
#define _LIBCPP_NOINLINE __attribute__((__noinline__))
#define _LIBCPP_INIT_PRIORITY_MAX

// clang is not the GCC compiler.
// (_LIBCPP_COMPILER_GCC intentionally left undefined.)

// --- diagnostics -----------------------------------------------------------
#define _LIBCPP_DIAGNOSTIC_PUSH _Pragma("clang diagnostic push")
#define _LIBCPP_DIAGNOSTIC_POP _Pragma("clang diagnostic pop")
#define _LIBCPP_CLANG_DIAGNOSTIC_IGNORED(str) _Pragma(_LIBCPP_TOSTRING(clang diagnostic ignored str))
#define _LIBCPP_GCC_DIAGNOSTIC_IGNORED(str)
#define _LIBCPP_WARNING(x) _Pragma(_LIBCPP_TOSTRING(GCC warning x))

// --- hardening -------------------------------------------------------------
#define _LIBCPP_HARDENING_MODE_NONE (1 << 1)
#define _LIBCPP_HARDENING_MODE_FAST (1 << 2)
#define _LIBCPP_HARDENING_MODE_EXTENSIVE (1 << 4)
#define _LIBCPP_HARDENING_MODE_DEBUG (1 << 3)
#ifndef _LIBCPP_HARDENING_MODE
#  define _LIBCPP_HARDENING_MODE _LIBCPP_HARDENING_MODE_DEFAULT
#endif

// Assertion semantics (referenced by the vendor __assertion_handler).
#define _LIBCPP_ASSERTION_SEMANTIC_IGNORE (1 << 1)
#define _LIBCPP_ASSERTION_SEMANTIC_OBSERVE (1 << 2)
#define _LIBCPP_ASSERTION_SEMANTIC_QUICK_ENFORCE (1 << 3)
#define _LIBCPP_ASSERTION_SEMANTIC_ENFORCE (1 << 4)
#ifndef _LIBCPP_ASSERTION_SEMANTIC
#  define _LIBCPP_ASSERTION_SEMANTIC _LIBCPP_ASSERTION_SEMANTIC_QUICK_ENFORCE
#endif

#endif // RUNTIME_INCLUDE_LIBC_STL___CONFIG_H_
