// Standard <new>, backed by sprt. The language-required std symbols (allocator,
// construct_at, destroying_delete_t/destroying_delete) and the global operator
// new/delete overloads are ALREADY defined by <sprt/cxx/new>; here we only add
// the std spellings of the tag types that sprt keeps in namespace sprt.

#ifndef RUNTIME_INCLUDE_LIBC_STL_NEW_H_
#define RUNTIME_INCLUDE_LIBC_STL_NEW_H_

// Always pull the full std implementations when used through the STL layer.
#include <__sprt_stl_config.h>

#include <sprt/cxx/new>

namespace std {
using sprt::nothrow_t;
using sprt::nothrow;
using sprt::align_val_t;

// std::launder has no sprt backing; it is a thin compiler-builtin wrapper, so it is
// provided directly here to keep <new> standard-conforming.
template <typename _Tp>
[[nodiscard]]
constexpr _Tp *launder(_Tp *__p) noexcept {
	return __builtin_launder(__p);
}

// [hardware.interference] (C++17). Implementation-defined constants; prefer the
// compiler-provided __GCC_*_SIZE, falling back to the common 64-byte cache line.
#ifdef __GCC_DESTRUCTIVE_SIZE
inline constexpr sprt::size_t hardware_destructive_interference_size = __GCC_DESTRUCTIVE_SIZE;
#else
inline constexpr sprt::size_t hardware_destructive_interference_size = 64;
#endif
#ifdef __GCC_CONSTRUCTIVE_SIZE
inline constexpr sprt::size_t hardware_constructive_interference_size = __GCC_CONSTRUCTIVE_SIZE;
#else
inline constexpr sprt::size_t hardware_constructive_interference_size = 64;
#endif
} // namespace std

#endif // RUNTIME_INCLUDE_LIBC_STL_NEW_H_
