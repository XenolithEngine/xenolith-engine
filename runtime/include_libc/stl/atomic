// Standard header backed by the sprt freestanding runtime. Its symbol family is
// too large (or uses nested namespaces) to enumerate, so it re-exports sprt as a
// whole via a using-directive (per the agreed exception for trait/algorithm/
// iterator/atomic/bit and the concurrency & time families).

#ifndef RUNTIME_INCLUDE_LIBC_STL_ATOMIC_H_
#define RUNTIME_INCLUDE_LIBC_STL_ATOMIC_H_

// Always pull the full std implementations when used through the STL layer.
#include <__sprt_stl_config.h>

#include <sprt/cxx/atomic>

namespace std {
using namespace sprt::__cxx_atomic;
} // namespace std

#endif // RUNTIME_INCLUDE_LIBC_STL_ATOMIC_H_
