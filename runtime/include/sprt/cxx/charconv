// [charconv] to_chars / from_chars built on the sprt runtime number primitives:
//
//   to_chars(integer)  : sprt::itoa (base 10) / _itoa::unsigned_to_hex (base 16) /
//                        a generic power-of-base loop (other bases 2..36).
//   to_chars(floating) : sprt::dtoa (dragonbox shortest round-trip; chars_format and
//                        precision map onto sprt::_dtoa::dtoa_options).
//   from_chars(integer): the sprt::_cstdlib::strtoull wrapper + __sprt_errno overflow probe,
//                        over a grammar-checked magnitude, then a range check against the
//                        target type.
//   from_chars(floating): the sprt::_cstdlib::strto{f,d,ld} wrappers.
//
// Portability note: the low-level __sprt_strto* / __sprt_malloc(a) / errno symbols live in
// libc_impl, which is compiled ONLY for the freestanding (Windows) target, so we must NOT call
// them directly (they do not link on the host). Instead we go through the sprt::_cstdlib
// wrappers — on the host their declarations bind to the system strto*, on freestanding their
// bodies forward to __sprt_strto* — and through __sprt_errno, which forwards to the host libc
// errno on Linux and to the libc_impl errno on freestanding, so the ERANGE overflow signal is
// identical on both targets. Temporary null-terminated copies use a fixed stack buffer rather
// than __sprt_malloca.
//
// itoa/dtoa write their digits RIGHT-ALIGNED, ending at buffer[bufSize-1] (result at
// buffer + bufSize - len); to_chars renders into a scratch buffer and copies the tail forward
// into [first, last).
//
// `errc` is the minimal enum charconv reports (the full std::errc belongs to <system_error>,
// which this layer does not implement). Floating-point NaN/inf render as "NaN"/"inf"/"-inf"
// and there is no hexadecimal-float support (dtoa is decimal only).

#ifndef RUNTIME_INCLUDE_SPRT_CXX_CHARCONV_H_
#define RUNTIME_INCLUDE_SPRT_CXX_CHARCONV_H_

#include <sprt/cxx/cstddef>
#include <sprt/cxx/type_traits>
#include <sprt/cxx/detail/ctypes.h>

#include <sprt/runtime/string.h> // sprt::itoa / sprt::dtoa (+ INT_MAX_DIGITS / DOUBLE_MAX_DIGITS)
#include <sprt/runtime/detail/itoa.h> // _itoa::unsigned_to_hex
#include <sprt/runtime/detail/dtoa.h> // _dtoa::dtoa_options

#include <sprt/wrappers/libc/stdlib.h> // sprt::_cstdlib::strto{ull,f,d,ld} (host/freestanding safe)
#include <sprt/c/__sprt_errno.h> // __sprt_errno (forwards to the platform libc errno)

namespace sprt {

enum class errc {
	invalid_argument = 22, // EINVAL
	result_out_of_range = 34, // ERANGE
	value_too_large = 75, // EOVERFLOW
};

enum class chars_format {
	scientific = 1,
	fixed = 2,
	hex = 4,
	general = fixed | scientific,
};

struct to_chars_result {
	char *ptr;
	errc ec;
	friend bool operator==(const to_chars_result &, const to_chars_result &) = default;
};

struct from_chars_result {
	const char *ptr;
	errc ec;
	friend bool operator==(const from_chars_result &, const from_chars_result &) = default;
};

inline int __cc_digit(char __c, int __base) noexcept {
	int __d;
	if (__c >= '0' && __c <= '9') {
		__d = __c - '0';
	} else if (__c >= 'a' && __c <= 'z') {
		__d = __c - 'a' + 10;
	} else if (__c >= 'A' && __c <= 'Z') {
		__d = __c - 'A' + 10;
	} else {
		return -1;
	}
	return __d < __base ? __d : -1;
}

// ---- to_chars: integer (base 2..36) ---------------------------------------------------------

template <typename _Int,
		enable_if_t<is_integral_v<_Int> && !is_same_v<remove_cv_t<_Int>, bool>, int> = 0>
to_chars_result to_chars(char *__first, char *__last, _Int __value, int __base = 10) {
	// Scratch large enough for the widest (binary) rendering plus a sign.
	char __tmp[sizeof(_Int) * 8 + 2];
	const size_t __cap = sizeof(__tmp);
	size_t __len;

	if (__base == 10) {
		// sprt::itoa renders decimal right-aligned, sign included, and returns the length.
		if constexpr (is_signed_v<_Int>) {
			__len = sprt::itoa(static_cast<int64_t>(__value), __tmp, __cap);
		} else {
			__len = sprt::itoa(static_cast<uint64_t>(__value), __tmp, __cap);
		}
	} else {
		using _Up = make_unsigned_t<_Int>;
		bool __neg = false;
		_Up __mag;
		if constexpr (is_signed_v<_Int>) {
			if (__value < 0) {
				__neg = true;
				__mag = static_cast<_Up>(~static_cast<_Up>(__value) + 1u);
			} else {
				__mag = static_cast<_Up>(__value);
			}
		} else {
			__mag = static_cast<_Up>(__value);
		}

		size_t __mlen;
		if (__base == 16) {
			__mlen = _itoa::unsigned_to_hex(__tmp, __mag, __cap); // lowercase, right-aligned
		} else {
			char *__p = __tmp + __cap;
			const _Up __b = static_cast<_Up>(__base);
			do {
				const int __d = static_cast<int>(__mag % __b);
				*--__p = __d < 10 ? static_cast<char>('0' + __d)
								  : static_cast<char>('a' + __d - 10);
				__mag /= __b;
			} while (__mag != 0);
			__mlen = static_cast<size_t>((__tmp + __cap) - __p);
		}
		if (__neg) {
			__tmp[__cap - __mlen - 1] = '-';
			__mlen += 1;
		}
		__len = __mlen;
	}

	// The rendering occupies __tmp[__cap - __len, __cap); copy it forward into [first, last).
	if (__len > static_cast<size_t>(__last - __first)) {
		return {__last, errc::value_too_large};
	}
	const char *__src = __tmp + __cap - __len;
	for (size_t __i = 0; __i < __len; ++__i) {
		__first[__i] = __src[__i];
	}
	return {__first + __len, errc {}};
}

// ---- to_chars: floating point (sprt::dtoa) --------------------------------------------------

namespace __charconv {

inline to_chars_result __dtoa_copy(char *__first, char *__last, size_t __len,
		const char *__scratch_end) {
	if (__len > static_cast<size_t>(__last - __first)) {
		return {__last, errc::value_too_large};
	}
	const char *__src = __scratch_end - __len;
	for (size_t __i = 0; __i < __len; ++__i) {
		__first[__i] = __src[__i];
	}
	return {__first + __len, errc {}};
}

inline _dtoa::dtoa_options __mode_of(chars_format __fmt) noexcept {
	_dtoa::dtoa_options __opts;
	// scientific -> scientific; fixed/general/hex -> fixed (dtoa auto-switches to scientific
	// for large/small exponents in fixed mode; there is no hex-float rendering).
	__opts.mode = (__fmt == chars_format::scientific) ? _dtoa::dtoa_options::scientific
													  : _dtoa::dtoa_options::fixed;
	return __opts;
}

// Parse a pure run of base-`base` digits [ds, de) (no sign) into an unsigned long long via the
// portable strtoull wrapper, using __sprt_errno to detect an out-of-range magnitude. Leading
// zeros are dropped so a bounded scratch buffer always suffices. Returns false on overflow.
inline bool __parse_mag(const char *__ds, const char *__de, int __base,
		unsigned long long &__out) noexcept {
	while (__ds < __de && *__ds == '0') {
		++__ds;
	}
	const size_t __n = static_cast<size_t>(__de - __ds);
	if (__n == 0) {
		__out = 0;
		return true;
	}
	// 64 base-2 digits is the widest a 64-bit value can occupy; more can never fit (base >= 2).
	if (__n > 64) {
		return false;
	}
	char __tmp[65];
	for (size_t __i = 0; __i < __n; ++__i) {
		__tmp[__i] = __ds[__i];
	}
	__tmp[__n] = '\0';
	__sprt_errno = 0;
	char *__e = __tmp;
	__out = sprt::_cstdlib::strtoull(__tmp, &__e, __base);
	return __sprt_errno == 0;
}

} // namespace __charconv

template <typename _Float, enable_if_t<is_floating_point_v<_Float>, int> = 0>
to_chars_result to_chars(char *__first, char *__last, _Float __value) {
	char __tmp[DOUBLE_MAX_DIGITS + 1];
	const size_t __len = sprt::dtoa(__value, __tmp, DOUBLE_MAX_DIGITS);
	return __charconv::__dtoa_copy(__first, __last, __len, __tmp + DOUBLE_MAX_DIGITS);
}

template <typename _Float, enable_if_t<is_floating_point_v<_Float>, int> = 0>
to_chars_result to_chars(char *__first, char *__last, _Float __value, chars_format __fmt) {
	char __tmp[DOUBLE_MAX_DIGITS + 1];
	const size_t __len = sprt::dtoa(__value, __tmp, DOUBLE_MAX_DIGITS, __charconv::__mode_of(__fmt));
	return __charconv::__dtoa_copy(__first, __last, __len, __tmp + DOUBLE_MAX_DIGITS);
}

// NOTE: dtoa's `precision` bounds the number of SIGNIFICANT digits (not decimal places), so this
// overload approximates the standard's precision for the `general` case only.
template <typename _Float, enable_if_t<is_floating_point_v<_Float>, int> = 0>
to_chars_result to_chars(char *__first, char *__last, _Float __value, chars_format __fmt,
		int __precision) {
	_dtoa::dtoa_options __opts = __charconv::__mode_of(__fmt);
	if (__precision >= 0) {
		__opts.precision = static_cast<uint16_t>(__precision > 65535 ? 65535 : __precision);
	}
	char __tmp[DOUBLE_MAX_DIGITS + 1];
	const size_t __len = sprt::dtoa(__value, __tmp, DOUBLE_MAX_DIGITS, __opts);
	return __charconv::__dtoa_copy(__first, __last, __len, __tmp + DOUBLE_MAX_DIGITS);
}

// ---- from_chars: integer (base 2..36, via strtoull + errno) ---------------------------------

template <typename _Int,
		enable_if_t<is_integral_v<_Int> && !is_same_v<remove_cv_t<_Int>, bool>, int> = 0>
from_chars_result from_chars(const char *__first, const char *__last, _Int &__value,
		int __base = 10) {
	using _Up = make_unsigned_t<_Int>;
	const char *__p = __first;
	bool __neg = false;
	// Only a signed target accepts a leading '-'; from_chars accepts no '+', whitespace or 0x.
	if constexpr (is_signed_v<_Int>) {
		if (__p != __last && *__p == '-') {
			__neg = true;
			++__p;
		}
	}
	const char *__ds = __p;
	while (__p != __last && __cc_digit(*__p, __base) >= 0) {
		++__p;
	}
	if (__p == __ds) {
		return {__first, errc::invalid_argument};
	}

	unsigned long long __mag;
	if (!__charconv::__parse_mag(__ds, __p, __base, __mag)) {
		return {__p, errc::result_out_of_range};
	}
	// Range-check the magnitude against the target type / sign.
	_Up __limit;
	if constexpr (is_signed_v<_Int>) {
		__limit = __neg ? static_cast<_Up>(Max<_Int>) + 1u : static_cast<_Up>(Max<_Int>);
	} else {
		__limit = static_cast<_Up>(-1);
	}
	if (__mag > static_cast<unsigned long long>(__limit)) {
		return {__p, errc::result_out_of_range};
	}

	const _Up __m = static_cast<_Up>(__mag);
	if constexpr (is_signed_v<_Int>) {
		__value = __neg ? static_cast<_Int>(static_cast<_Up>(~__m + 1u)) : static_cast<_Int>(__m);
	} else {
		__value = static_cast<_Int>(__m);
	}
	return {__p, errc {}};
}

// ---- from_chars: floating point (via strto{f,d,ld}) -----------------------------------------

template <typename _Float, enable_if_t<is_floating_point_v<_Float>, int> = 0>
from_chars_result from_chars(const char *__first, const char *__last, _Float &__value,
		chars_format __fmt = chars_format::general) {
	(void) __fmt; // decimal only; hex-float parsing is not supported
	const size_t __n = static_cast<size_t>(__last - __first);
	if (__n == 0) {
		return {__first, errc::invalid_argument};
	}
	// strto* would additionally accept leading whitespace / a '+' sign; from_chars must not.
	if (*__first == ' ' || *__first == '\t' || *__first == '+') {
		return {__first, errc::invalid_argument};
	}

	// strto* need a null-terminated string; copy [first, last) into a bounded stack buffer (a
	// fixed buffer keeps this host/freestanding-portable — no __sprt_malloca). The number is the
	// leading token, so strto* stops within the copy for any realistic input.
	char __buf[512];
	const size_t __m = (__n < sizeof(__buf) - 1) ? __n : (sizeof(__buf) - 1);
	for (size_t __i = 0; __i < __m; ++__i) {
		__buf[__i] = __first[__i];
	}
	__buf[__m] = '\0';

	char *__end = __buf;
	_Float __r;
	if constexpr (is_same_v<remove_cv_t<_Float>, float>) {
		__r = sprt::_cstdlib::strtof(__buf, &__end);
	} else if constexpr (is_same_v<remove_cv_t<_Float>, long double>) {
		__r = sprt::_cstdlib::strtold(__buf, &__end);
	} else {
		__r = static_cast<_Float>(sprt::_cstdlib::strtod(__buf, &__end));
	}
	const size_t __consumed = static_cast<size_t>(__end - __buf);

	if (__consumed == 0) {
		return {__first, errc::invalid_argument};
	}
	// Overflow: strto* yield +/-inf. Distinguish from a legitimate "inf" spelling by checking
	// that the token begins with a numeric character.
	const char __c0 = (*__first == '-') ? (__n > 1 ? __first[1] : '\0') : *__first;
	const bool __numericStart = (__c0 >= '0' && __c0 <= '9') || __c0 == '.';
	if (__numericStart && (__r == Infinity<_Float> || __r == -Infinity<_Float>)) {
		return {__first + __consumed, errc::result_out_of_range};
	}

	__value = __r;
	return {__first + __consumed, errc {}};
}

} // namespace sprt

#endif // RUNTIME_INCLUDE_SPRT_CXX_CHARCONV_H_
