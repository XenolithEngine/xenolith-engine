// Function - реализация std::function, использующая память из pool_t
// some sources from https://github.com/prograholic/blog/blob/master/cxx_function/main.cpp

template <typename, typename, typename = void>
struct check_signature : false_type { };

template <typename Func, typename Ret, typename... Args>
struct check_signature<Func, Ret(Args...),
		typename enable_if< is_convertible_v< decltype(declval<Func>()(declval<Args>()...)), Ret >,
				void>::type> : true_type { };

template <typename Allocator, typename UnusedType>
class SPRT_API __function;

// Empty marker base of every __function specialization; used to recognize any
// __function AND its derived wrappers (__pool_function / __malloc_function /
// std::function) so the converting constructor never tries to wrap one function type
// in another (which would double-wrap on copy).
struct __function_base_tag { };

template <typename T>
class __is_function_type : public false_type { };

template <typename Allocator, typename UnusedType>
class __is_function_type<__function<Allocator, UnusedType>> : public true_type { };

template <typename T>
constexpr bool __is_function_type_v =
		sprt::is_base_of_v<__function_base_tag, sprt::remove_cvref_t<T>>;

template <typename Allocator, typename ReturnType, typename... ArgumentTypes>
class SPRT_API __function<Allocator, ReturnType(ArgumentTypes...)> : public Allocator::base_class,
																	 public __function_base_tag {
public:
	using signature_type = ReturnType(ArgumentTypes...);
	using result_type = ReturnType;
	using allocator_type = Allocator;

	~__function() { clear(); }

	__function(const allocator_type &alloc = allocator_type()) noexcept
	: mAllocator(alloc), mCallback(nullptr) { }

	__function(nullptr_t, const allocator_type &alloc = allocator_type()) noexcept
	: mAllocator(alloc), mCallback(nullptr) { }

	__function &operator=(nullptr_t) noexcept {
		clear();
		mCallback = nullptr;
		return *this;
	}

	__function(const __function &other, const allocator_type &alloc = allocator_type()) noexcept
	: mAllocator(alloc) {
		mCallback = other.mCallback;
		if (mCallback) {
			mCallback()->copy(other.mBuffer, mAllocator, mBuffer);
		}
	}

	__function &operator=(const __function &other) noexcept {
		if (&other == this) {
			return *this;
		}

		clear();
		mCallback = other.mCallback;
		if (mCallback) {
			mCallback()->copy(other.mBuffer, mAllocator, mBuffer);
		}
		return *this;
	}

	__function(__function &&other, const allocator_type &alloc = allocator_type()) noexcept
	: mAllocator(alloc) {
		mCallback = other.mCallback;
		if (mCallback) {
			if (other.mAllocator == mAllocator) {
				mCallback()->move(other.mBuffer, mAllocator, mBuffer);
			} else {
				mCallback()->copy(other.mBuffer, mAllocator, mBuffer);
			}
			other.mCallback = nullptr;
		}
	}

	__function &operator=(__function &&other) noexcept {
		if (&other == this) {
			return *this;
		}

		clear();
		mCallback = other.mCallback;
		if (mCallback) {
			if (other.mAllocator == mAllocator) {
				mCallback()->move(other.mBuffer, mAllocator, mBuffer);
			} else {
				mCallback()->copy(other.mBuffer, mAllocator, mBuffer);
			}
			other.mCallback = nullptr;
		}
		return *this;
	}

	// std::function's converting constructor/assignment: participate only when the
	// (decayed) target is Lvalue-Callable for R(ArgumentTypes...) and is copy
	// constructible, so move-only callables cleanly do not match (SFINAE) rather
	// than hard-error inside the copy trait. is_base_of excludes this __function AND
	// wrappers derived from it (__pool_function/__malloc_function inherit this
	// constructor;
	template <typename FunctionT>
	requires (!sprt::is_base_of_v<__function, sprt::remove_cvref_t<FunctionT>>
			&& sprt::is_invocable_r_v<ReturnType, sprt::decay_t<FunctionT> &, ArgumentTypes...>
			&& sprt::is_copy_constructible_v<sprt::decay_t<FunctionT>>)
	__function(FunctionT &&f, const allocator_type &alloc = allocator_type()) noexcept
	: mAllocator(alloc) {
		// [func.wrap.func.con]: a null function/member pointer produces an EMPTY
		// wrapper, not a stored null target.
		if constexpr (sprt::is_pointer_v<sprt::decay_t<FunctionT>>
				|| sprt::is_member_pointer_v<sprt::decay_t<FunctionT>>) {
			if (f == nullptr) {
				return;
			}
		}
		mCallback = makeFreeFunction(sprt::forward<FunctionT>(f), mAllocator, mBuffer.data());
	}

	template <typename FunctionT>
	requires (!sprt::is_base_of_v<__function, sprt::remove_cvref_t<FunctionT>>
			&& sprt::is_invocable_r_v<ReturnType, sprt::decay_t<FunctionT> &, ArgumentTypes...>
			&& sprt::is_copy_constructible_v<sprt::decay_t<FunctionT>>)
	__function &operator=(FunctionT &&f) noexcept {
		clear();
		// See the converting constructor: a null pointer target means "empty".
		if constexpr (sprt::is_pointer_v<sprt::decay_t<FunctionT>>
				|| sprt::is_member_pointer_v<sprt::decay_t<FunctionT>>) {
			if (f == nullptr) {
				return *this;
			}
		}
		mCallback = makeFreeFunction(sprt::forward<FunctionT>(f), mAllocator, mBuffer.data());
		return *this;
	}

	ReturnType operator()(ArgumentTypes... args) const {
		// Precondition: not empty. std::function throws bad_function_call here;
		// this runtime is -fno-exceptions, so calling an empty function is a
		// programming error (debug-asserted; otherwise a null-callback call).
		sprt_passert(mCallback != nullptr, "calling an empty sprt::function");
		return mCallback()->invoke(mBuffer.data(), sprt::forward<ArgumentTypes>(args)...);
	}

	constexpr bool operator==(nullptr_t) const noexcept { return mCallback == nullptr; }

	constexpr bool operator!=(nullptr_t) const noexcept { return mCallback != nullptr; }

	constexpr explicit operator bool() const noexcept { return mCallback != nullptr; }

	constexpr bool operator==(const __function &other) const noexcept {
		return mAllocator == other.mAllocator && mCallback == other.mCallback
				&& (__sprt_memcmp(mBuffer.data(), other.mBuffer.data(), mBuffer.size()) == 0);
	}

	constexpr bool operator!=(const __function &other) const noexcept {
		return mAllocator != other.mAllocator || mCallback != other.mCallback
				|| (__sprt_memcmp(mBuffer.data(), other.mBuffer.data(), mBuffer.size()) != 0);
	}

	const allocator_type &get_allocator() const { return mAllocator; }

	// [func.wrap.func.mod]: exchange the stored targets. Implemented through the
	// type-erased move machinery (allocation-free for the malloc/pool allocators,
	// whose instances compare equal), so it is genuinely noexcept.
	void swap(__function &other) noexcept {
		if (this == &other) {
			return;
		}
		__function tmp(static_cast<__function &&>(other));
		other = static_cast<__function &&>(*this);
		*this = static_cast<__function &&>(tmp);
	}

#ifdef __cpp_rtti
	// [func.wrap.func.targ]. RTTI is always enabled in this project (-frtti); the
	// guard only keeps the header usable in a hypothetical -fno-rtti translation
	// unit (where these members are simply absent, as target() needs type_info).
	const type_info &target_type() const noexcept {
		return mCallback ? *mCallback()->type : typeid(void);
	}

	template <typename T>
	T *target() noexcept {
		if (mCallback && *mCallback()->type == typeid(T)) {
			return const_cast<T *>(static_cast<const T *>(mCallback()->get_target(mBuffer)));
		}
		return nullptr;
	}

	template <typename T>
	const T *target() const noexcept {
		if (mCallback && *mCallback()->type == typeid(T)) {
			return static_cast<const T *>(mCallback()->get_target(mBuffer));
		}
		return nullptr;
	}
#endif

protected:
	static constexpr auto OptBufferSize = 16;

	using buffer_type = sprt::detail::inline_buffer<uint8_t, OptBufferSize>;

	using invoke_pointer = ReturnType (*)(const void *, ArgumentTypes...);
	using destroy_pointer = void (*)(buffer_type &, allocator_type &);
	using copy_pointer = void *(*)(const buffer_type &, allocator_type &, buffer_type &);
	using move_pointer = void *(*)(buffer_type &, allocator_type &, buffer_type &);

	struct functor_traits {
		invoke_pointer invoke;
		destroy_pointer destroy;
		copy_pointer copy;
		move_pointer move;
#ifdef __cpp_rtti
		// type erasure metadata for target_type()/target<T>(): the static type_info
		// of the stored callable, and an accessor returning the object's address.
		const type_info *type;
		const void *(*get_target)(const buffer_type &);
#endif
	};

	using traits_callback = functor_traits *(*)();

	// --- Type erasure model -------------------------------------------------
	//
	// __function stores an arbitrary callable behind a uniform interface, the
	// same way std::function does, but without RTTI or a real vtable. Two
	// pieces do the erasure:
	//
	//   * mBuffer  - a fixed, max_align_t-aligned inline byte buffer of
	//                OptBufferSize bytes (the "small object optimization" area).
	//   * mCallback - a traits_callback, i.e. a pointer to makeFunctionTraits<F>.
	//                 Calling it yields a per-type `functor_traits` table of
	//                 four function pointers (invoke / destroy / copy / move).
	//                 This table is our hand-rolled vtable; the concrete type F
	//                 is captured only inside those lambdas, never stored.
	//
	// Storage strategy is picked at compile time by makeFunctionTraits /
	// makeFreeFunction based on the callable's size (and alignment):
	//
	//   1. SMALL (sizeof(F) <= OptBufferSize): the callable object F is
	//      constructed in-place directly INTO mBuffer. The buffer bytes *are*
	//      the object, so `invoke` reinterprets the buffer address as `F*`.
	//
	//   2. LARGE (sizeof(F) > OptBufferSize): F cannot fit inline, so it is
	//      heap-allocated through the allocator into a StorageType
	//      (aligned_storage<F>), and only a POINTER to that storage is kept in
	//      mBuffer. `invoke` reads the pointer back out of the buffer, then
	//      dereferences it.
	//
	// --- The "store a pointer into the buffer" idiom ------------------------
	//
	// In the LARGE case the lines below use a form that looks like a C cast but
	// is NOT one:
	//
	//     new (targetBuffer.data(), nothrow) (const StorageType *)(mem);
	//
	// This is the *parenthesized-type-id* placement-new grammar
	// `new (placement-args) (type-id) (initializer)`:
	//
	//     placement-args : `targetBuffer.data(), nothrow`
	//                      -> selects operator new(size_t, void*, nothrow_t),
	//                         which allocates nothing and just returns the
	//                         given buffer address.
	//     type-id        : `const StorageType *`
	//                      -> the object being constructed is a pointer.
	//     initializer    : `(mem)`
	//                      -> that pointer is value-initialized to `mem`.
	//
	// Net effect: it constructs a `const StorageType*` object (a trivial 8-byte
	// value) at the start of the buffer holding `mem` -- i.e. it is exactly
	//     *reinterpret_cast<const StorageType**>(buf) = mem;
	// written as placement-construction of the pointer object. `nullptr` is
	// stored the same way to mark a moved-from buffer as empty.
	//
	// The pointer is read back with
	//     *static_cast<StorageType *const *>(arg)   (in invoke)
	//     *reinterpret_cast<StorageType *const *>(buffer.data())  (destroy/copy/move)
	// The const-qualification differs from the stored `const StorageType*`
	// (pointer-to-const vs const-pointer), but the bit pattern is identical, so
	// the pointer value round-trips unchanged.
	// ------------------------------------------------------------------------
	template <typename FunctionT>
	static functor_traits *makeFunctionTraits() noexcept {
		// decay_t (not remove_cvref_t) so a plain function name is stored as a
		// function pointer, matching std::function's target type.
		using BaseType = sprt::decay_t<FunctionT>;
		if constexpr (sizeof(BaseType) <= OptBufferSize) {
			static functor_traits traits{
				.invoke = [](const void *arg, ArgumentTypes... args) -> ReturnType {
				if constexpr (sprt::is_void_v<ReturnType>) {
					sprt::__invoke(*const_cast<BaseType *>(static_cast<const BaseType *>(arg)),
							sprt::forward<ArgumentTypes>(args)...);
				} else {
					return sprt::__invoke(
							*const_cast<BaseType *>(static_cast<const BaseType *>(arg)),
							sprt::forward<ArgumentTypes>(args)...);
				}
			},
				.destroy =
						[](buffer_type &sourceBuffer, allocator_type &alloc) {
				auto fn = reinterpret_cast<const BaseType *>(sourceBuffer.data());
				if (fn) {
					sprt::destroy_at(fn);
				}
			},
				.copy = [](const buffer_type &sourceBuffer, allocator_type &alloc,
								buffer_type &targetBuffer) -> void * {
				return new (targetBuffer.data(), nothrow)
						BaseType(*reinterpret_cast<const BaseType *>(sourceBuffer.data()));
			},
				.move = [](buffer_type &sourceBuffer, allocator_type &alloc,
								buffer_type &targetBuffer) -> void * {
				auto src = reinterpret_cast<BaseType *>(sourceBuffer.data());
				auto ret = new (targetBuffer.data(), nothrow) BaseType(sprt::move_unsafe(*src));
				// Destroy the moved-from source. A memset would skip ~BaseType and
				// leak whatever the moved-from object still owns (e.g. a captured
				// Rc/handle); the owner nulls mCallback after move, so destroy()
				// is otherwise never called on it.
				sprt::destroy_at(src);
				return ret;
			},
#ifdef __cpp_rtti
				.type = &typeid(BaseType),
				.get_target = [](const buffer_type &buf) -> const void * { return buf.data(); },
#endif
			};

			return &traits;
		} else {
			using StorageType = detail::aligned_storage<BaseType>;
			static functor_traits traits{
				.invoke = [](const void *arg, ArgumentTypes... args) -> ReturnType {
				auto node = *static_cast<StorageType *const *>(arg);
				auto fnPtr = const_cast<BaseType *>(node->ptr());
				if constexpr (sprt::is_void_v<ReturnType>) {
					sprt::__invoke(*fnPtr, sprt::forward<ArgumentTypes>(args)...);
				} else {
					return sprt::__invoke(*fnPtr, sprt::forward<ArgumentTypes>(args)...);
				}
			},
				.destroy =
						[](buffer_type &sourceBuffer, allocator_type &alloc) {
				auto node = *reinterpret_cast<StorageType *const *>(sourceBuffer.data());
				if (node) {
					typename Allocator::template rebind<BaseType>::other ialloc = alloc;
					node->destroy(ialloc);

					typename Allocator::template rebind<StorageType>::other salloc = alloc;
					salloc.deallocate(node, sizeof(StorageType));
				}
			},
				.copy = [](const buffer_type &sourceBuffer, allocator_type &alloc,
								buffer_type &targetBuffer) -> void * {
				auto node = *reinterpret_cast<StorageType *const *>(sourceBuffer.data());

				typename Allocator::template rebind<StorageType>::other ialloc = alloc;
				auto mem = ialloc.allocate(1);
				new (mem->ptr(), sprt::nothrow) BaseType(*node->ptr());

				// store the heap-storage pointer into the target buffer
				// (parenthesized-type-id placement-new; see the idiom note above)
				return new (targetBuffer.data(), nothrow)(const StorageType *)(mem);
			},
				.move = [](buffer_type &sourceBuffer, allocator_type &alloc,
								buffer_type &targetBuffer) -> void * {
				auto node = *reinterpret_cast<StorageType **>(sourceBuffer.data());
				// move = copy the storage pointer to the target buffer, then
				// null the source buffer so its destroy() becomes a no-op
				auto ret = new (targetBuffer.data(), nothrow)(const StorageType *)(node);
				new (sourceBuffer.data(), nothrow)(const StorageType *)(nullptr);
				return ret;
			},
#ifdef __cpp_rtti
				.type = &typeid(BaseType),
				.get_target = [](const buffer_type &buf) -> const void * {
				auto node = *reinterpret_cast<StorageType *const *>(buf.data());
				return node ? node->ptr() : nullptr;
			},
#endif
			};

			return &traits;
		}
	}

	template <typename FunctionT>
	static traits_callback makeFreeFunction(FunctionT &&f, allocator_type &alloc,
			uint8_t *buf) noexcept {
		using BaseType = sprt::decay_t<FunctionT>;
		using StorageType = detail::aligned_storage<BaseType>;
		if constexpr (sizeof(BaseType) <= OptBufferSize
				&& alignof(BaseType) <= alignof(max_align_t)) {
			new (buf, nothrow) BaseType(sprt::forward<FunctionT>(f));
		} else {
			// allocate storage for function
			typename Allocator::template rebind<StorageType>::other ialloc = alloc;
			auto mem = ialloc.allocate(1);

			// emplace function to storage with placement new
			if constexpr (is_convertible_v<allocator_type, memory::pool_t *>) {
				memory::perform_conditional([&] {
					new (mem->ptr(), sprt::nothrow) BaseType(sprt::forward<FunctionT>(f));
				}, alloc);
			} else {
				new (mem->ptr(), sprt::nothrow) BaseType(sprt::forward<FunctionT>(f));
			}

			// emplace storage to internal buffer with placement new:
			// constructs a `const StorageType*` holding `mem` in the buffer
			// (parenthesized-type-id placement-new; see the idiom note above)
			new (buf, sprt::nothrow)(const StorageType *)(mem);
		}
		return &makeFunctionTraits<FunctionT>;
	}

	void clear() {
		if (mCallback) {
			auto t = mCallback();
			t->destroy(mBuffer, mAllocator);
			__sprt_memset(mBuffer.data(), 0, mBuffer.size());
			mCallback = nullptr;
		}
	}

	allocator_type mAllocator;
	traits_callback mCallback = nullptr;
	alignas(max_align_t) buffer_type mBuffer;
};

// Extracts R(Args...) from a functor's operator() for the class-template argument
// deduction guides below (matches non-const/const, unqualified/lvalue-ref forms).
template <typename>
struct __function_guide_helper { };

template <typename _Res, typename _Tp, bool _Nx, typename... _Args>
struct __function_guide_helper<_Res (_Tp::*)(_Args...) noexcept(_Nx)> {
	using type = _Res(_Args...);
};
template <typename _Res, typename _Tp, bool _Nx, typename... _Args>
struct __function_guide_helper<_Res (_Tp::*)(_Args...) & noexcept(_Nx)> {
	using type = _Res(_Args...);
};
template <typename _Res, typename _Tp, bool _Nx, typename... _Args>
struct __function_guide_helper<_Res (_Tp::*)(_Args...) const noexcept(_Nx)> {
	using type = _Res(_Args...);
};
template <typename _Res, typename _Tp, bool _Nx, typename... _Args>
struct __function_guide_helper<_Res (_Tp::*)(_Args...) const & noexcept(_Nx)> {
	using type = _Res(_Args...);
};
// Remaining cv/ref-qualified operator() forms, so CTAD from any callable succeeds
// (mirrors libc++'s exhaustive __strip_signature: {volatile, const volatile} x {,&,&&}
// and the rvalue-ref forms of the plain/const cases).
template <typename _Res, typename _Tp, bool _Nx, typename... _Args>
struct __function_guide_helper<_Res (_Tp::*)(_Args...) && noexcept(_Nx)> {
	using type = _Res(_Args...);
};
template <typename _Res, typename _Tp, bool _Nx, typename... _Args>
struct __function_guide_helper<_Res (_Tp::*)(_Args...) const && noexcept(_Nx)> {
	using type = _Res(_Args...);
};
template <typename _Res, typename _Tp, bool _Nx, typename... _Args>
struct __function_guide_helper<_Res (_Tp::*)(_Args...) volatile noexcept(_Nx)> {
	using type = _Res(_Args...);
};
template <typename _Res, typename _Tp, bool _Nx, typename... _Args>
struct __function_guide_helper<_Res (_Tp::*)(_Args...) volatile & noexcept(_Nx)> {
	using type = _Res(_Args...);
};
template <typename _Res, typename _Tp, bool _Nx, typename... _Args>
struct __function_guide_helper<_Res (_Tp::*)(_Args...) volatile && noexcept(_Nx)> {
	using type = _Res(_Args...);
};
template <typename _Res, typename _Tp, bool _Nx, typename... _Args>
struct __function_guide_helper<_Res (_Tp::*)(_Args...) const volatile noexcept(_Nx)> {
	using type = _Res(_Args...);
};
template <typename _Res, typename _Tp, bool _Nx, typename... _Args>
struct __function_guide_helper<_Res (_Tp::*)(_Args...) const volatile & noexcept(_Nx)> {
	using type = _Res(_Args...);
};
template <typename _Res, typename _Tp, bool _Nx, typename... _Args>
struct __function_guide_helper<_Res (_Tp::*)(_Args...) const volatile && noexcept(_Nx)> {
	using type = _Res(_Args...);
};

template <typename Sig>
class __pool_function : public __function<detail::AllocatorPool<void *>, Sig> {
public:
	using __function<detail::AllocatorPool<void *>, Sig>::__function;
	using __function<detail::AllocatorPool<void *>, Sig>::operator=;
	using __function<detail::AllocatorPool<void *>, Sig>::operator();
	using __function<detail::AllocatorPool<void *>, Sig>::operator==;
	using __function<detail::AllocatorPool<void *>, Sig>::operator!=;
	using __function<detail::AllocatorPool<void *>, Sig>::operator bool;
	using __function<detail::AllocatorPool<void *>, Sig>::get_allocator;
};

template < typename R, typename... ArgTypes >
__pool_function(R (*)(ArgTypes...)) -> __pool_function<R(ArgTypes...)>;

template <typename _Fn,
		typename _Sig = typename __function_guide_helper<decltype(&_Fn::operator())>::type>
__pool_function(_Fn) -> __pool_function<_Sig>;

template <typename Sig>
class __malloc_function : public __function<detail::AllocatorMalloc<void *>, Sig> {
public:
	using __function<detail::AllocatorMalloc<void *>, Sig>::__function;
	using __function<detail::AllocatorMalloc<void *>, Sig>::operator=;
	using __function<detail::AllocatorMalloc<void *>, Sig>::operator();
	using __function<detail::AllocatorMalloc<void *>, Sig>::operator==;
	using __function<detail::AllocatorMalloc<void *>, Sig>::operator!=;
	using __function<detail::AllocatorMalloc<void *>, Sig>::operator bool;
};

template < typename R, typename... ArgTypes >
__malloc_function(R (*)(ArgTypes...)) -> __malloc_function<R(ArgTypes...)>;

template <typename _Fn,
		typename _Sig = typename __function_guide_helper<decltype(&_Fn::operator())>::type>
__malloc_function(_Fn) -> __malloc_function<_Sig>;

// [func.wrap.func.alg] non-member swap; found by ADL for __function and the
// __pool_function / __malloc_function derived types (base-class deduction).
template <typename Allocator, typename Sig>
void swap(__function<Allocator, Sig> &lhs, __function<Allocator, Sig> &rhs) noexcept {
	lhs.swap(rhs);
}

