class variant;

// variant helper classes
template <typename _Tp>
struct variant_size; // not defined

template <typename _Tp>
struct variant_size<const _Tp> : variant_size<_Tp> { };
template <typename _Tp>
struct variant_size<volatile _Tp> : variant_size<_Tp> { };
template <typename _Tp>
struct variant_size<const volatile _Tp> : variant_size<_Tp> { };

template <typename... _Types>
struct variant_size<variant<_Types...>> : integral_constant<size_t, sizeof...(_Types)> { };

template <typename _Tp>
inline constexpr size_t variant_size_v = variant_size<_Tp>::value;

template <size_t _Ip, typename _Tp>
struct variant_alternative; // not defined

template <size_t _Ip, typename _Tp>
using variant_alternative_t = typename variant_alternative<_Ip, _Tp>::type;

template <size_t _Ip, typename _Tp>
struct variant_alternative<_Ip, const _Tp> : add_const<variant_alternative_t<_Ip, _Tp>> { };
template <size_t _Ip, typename _Tp>
struct variant_alternative<_Ip, volatile _Tp> : add_volatile<variant_alternative_t<_Ip, _Tp>> { };
template <size_t _Ip, typename _Tp>
struct variant_alternative<_Ip, const volatile _Tp> : add_cv<variant_alternative_t<_Ip, _Tp>> { };

template <size_t _Ip, typename... _Types>
struct variant_alternative<_Ip, variant<_Types...>> {
	static_assert(_Ip < sizeof...(_Types), "Index out of bounds in variant_alternative<>");
	using type = __type_pack_element<_Ip, _Types...>;
};

inline constexpr size_t variant_npos = static_cast<size_t>(-1);

// [variant.bad.access] -------------------------------------------------------
//
// As with bad_optional_access, this runtime has no exception hierarchy;
// bad_variant_access exists for API completeness and is never thrown.
class bad_variant_access {
public:
	bad_variant_access() noexcept = default;
	bad_variant_access(const bad_variant_access &) noexcept = default;
	bad_variant_access &operator=(const bad_variant_access &) noexcept = default;
	~bad_variant_access() = default;

	const char *what() const noexcept { return "bad_variant_access"; }
};

[[noreturn]]
inline void __throw_bad_variant_access() noexcept {
	// -fno-exceptions: the would-be `throw bad_variant_access()` becomes a
	// defined abort (mirrors libc++'s _LIBCPP_VERBOSE_ABORT strategy).
	__builtin_abort();
}

// [variant.monostate]
struct monostate { };

constexpr bool operator==(monostate, monostate) noexcept { return true; }
constexpr strong_ordering operator<=>(monostate, monostate) noexcept {
	return strong_ordering::equal;
}

// variant_empty: sprt extension. Passed to a visitor when the visited variant is
// valueless (see the design note at the top of this file).
struct variant_empty { };

constexpr bool operator==(variant_empty, variant_empty) noexcept { return true; }
constexpr strong_ordering operator<=>(variant_empty, variant_empty) noexcept {
	return strong_ordering::equal;
}

// hash support (the primary template and element-type specializations come from
// <sprt/cxx/detail/hash.h>; hash<variant<...>> is specialized at the bottom).
template <>
struct hash<monostate> {
	constexpr size_t operator()(const monostate &) const noexcept { return 0; }
};

// Light N-dimensional array of function pointers, used by the visitation engine
// in place of array<> to avoid the dependency.
template <typename _Tp, size_t _Size>
struct __farray {
	static_assert(_Size > 0, "N-dimensional array should never be empty in visit");
	_Tp __buf_[_Size] = {};

	constexpr const _Tp &operator[](size_t __n) const noexcept { return __buf_[__n]; }
};

template <typename... _Types>
constexpr variant<_Types...> &__as_variant(variant<_Types...> &__vs) noexcept {
	return __vs;
}
template <typename... _Types>
constexpr const variant<_Types...> &__as_variant(const variant<_Types...> &__vs) noexcept {
	return __vs;
}
template <typename... _Types>
constexpr variant<_Types...> &&__as_variant(variant<_Types...> &&__vs) noexcept {
	return sprt::move(__vs);
}
template <typename... _Types>
constexpr const variant<_Types...> &&__as_variant(const variant<_Types...> &&__vs) noexcept {
	return sprt::move(__vs);
}

namespace __find_detail {

inline constexpr size_t __not_found = static_cast<size_t>(-1);
inline constexpr size_t __ambiguous = static_cast<size_t>(-2);

template <typename _Tp, typename... _Types>
constexpr size_t __find_index() {
	constexpr bool __matches[] = {is_same_v<_Tp, _Types>...};
	size_t __result = __not_found;
	for (size_t __i = 0; __i < sizeof...(_Types); ++__i) {
		if (__matches[__i]) {
			if (__result != __not_found) {
				return __ambiguous;
			}
			__result = __i;
		}
	}
	return __result;
}

template <size_t _Index>
struct __find_unambiguous_index_sfinae_impl : integral_constant<size_t, _Index> { };

template <>
struct __find_unambiguous_index_sfinae_impl<__not_found> { };
template <>
struct __find_unambiguous_index_sfinae_impl<__ambiguous> { };

template <typename _Tp, typename... _Types>
struct __find_unambiguous_index_sfinae
: __find_unambiguous_index_sfinae_impl<__find_index<_Tp, _Types...>()> { };

template <typename _Tp, typename... _Types>
struct __find_exactly_one_t {
	static constexpr size_t __index = __find_index<_Tp, _Types...>();
	static_assert(__index != __not_found, "the specified type is not a variant alternative");
	static_assert(__index != __ambiguous,
			"the specified type is a variant alternative more than once");
	static constexpr size_t value = __index;
};

} // namespace __find_detail

namespace __variant_detail {

struct __valueless_t { };

enum class _Trait {
	_TriviallyAvailable,
	_Available,
	_Unavailable
};

template <typename _Tp, template <typename> class _IsTriviallyAvailable,
		template <typename> class _IsAvailable>
constexpr _Trait __trait = _IsTriviallyAvailable<_Tp>::value ? _Trait::_TriviallyAvailable
		: _IsAvailable<_Tp>::value							 ? _Trait::_Available
															 : _Trait::_Unavailable;

constexpr _Trait __common_trait(initializer_list<_Trait> __traits) {
	_Trait __result = _Trait::_TriviallyAvailable;
	for (_Trait __t : __traits) {
		if (static_cast<int>(__t) > static_cast<int>(__result)) {
			__result = __t;
		}
	}
	return __result;
}

template <typename... _Types>
struct __traits {
	static constexpr _Trait __copy_constructible_trait = __common_trait(
			{__trait<_Types, is_trivially_copy_constructible, is_copy_constructible>...});
	static constexpr _Trait __move_constructible_trait = __common_trait(
			{__trait<_Types, is_trivially_move_constructible, is_move_constructible>...});
	static constexpr _Trait __copy_assignable_trait = __common_trait({__copy_constructible_trait,
		__trait<_Types, is_trivially_copy_assignable, is_copy_assignable>...});
	static constexpr _Trait __move_assignable_trait = __common_trait({__move_constructible_trait,
		__trait<_Types, is_trivially_move_assignable, is_move_assignable>...});
	static constexpr _Trait __destructible_trait =
			__common_trait({__trait<_Types, is_trivially_destructible, is_destructible>...});
};

// "all of these bools are true"
template <bool... _Preds>
struct __all : bool_constant<(_Preds && ...)> { };

// Makes a trait dependent on a dummy template parameter so that a defaulted
template <typename _Tp, bool>
struct __dependent_type : _Tp { };

// variant stores its active index in the smallest practical integer (this runtime
// does not enable the libc++ index-type ABI optimization, so a plain unsigned).
template <size_t _NumAlts>
using __variant_index_t = unsigned int;

template <typename _IndexType>
constexpr _IndexType __variant_npos = static_cast<_IndexType>(-1);

namespace __access {

struct __union {
	template <typename _Vp>
	static constexpr auto &&__get_alt(_Vp &&__v, in_place_index_t<0>) {
		return sprt::forward<_Vp>(__v).__head;
	}
	template <typename _Vp, size_t _Ip>
	static constexpr auto &&__get_alt(_Vp &&__v, in_place_index_t<_Ip>) {
		return __get_alt(sprt::forward<_Vp>(__v).__tail, in_place_index<_Ip - 1>);
	}
};

struct __base {
	template <size_t _Ip, typename _Vp>
	static constexpr auto &&__get_alt(_Vp &&__v) {
		return __union::__get_alt(sprt::forward<_Vp>(__v).__data, in_place_index<_Ip>);
	}
};

struct __variant {
	template <size_t _Ip, typename _Vp>
	static constexpr auto &&__get_alt(_Vp &&__v) {
		return __base::__get_alt<_Ip>(sprt::forward<_Vp>(__v).__impl_);
	}
};

} // namespace __access

namespace __visitation {

struct __base {
	template <typename _Visitor, typename... _Vs>
	static constexpr decltype(auto) __visit_alt_at(size_t __index, _Visitor &&__visitor,
			_Vs &&...__vs) {
		constexpr auto __fdiagonal =
				__make_fdiagonal<_Visitor &&, decltype(sprt::forward<_Vs>(__vs).__as_base())...>();
		return __fdiagonal[__index](sprt::forward<_Visitor>(__visitor),
				sprt::forward<_Vs>(__vs).__as_base()...);
	}

	template <typename _Visitor, typename... _Vs>
	static constexpr decltype(auto) __visit_alt(_Visitor &&__visitor, _Vs &&...__vs) {
		constexpr auto __fmatrix =
				__make_fmatrix<_Visitor &&, decltype(sprt::forward<_Vs>(__vs).__as_base())...>();
		return __at(__fmatrix, __vs.index()...)(sprt::forward<_Visitor>(__visitor),
				sprt::forward<_Vs>(__vs).__as_base()...);
	}

private:
	template <typename _Tp>
	static constexpr const _Tp &__at(const _Tp &__elem) {
		return __elem;
	}
	template <typename _Tp, size_t _Np, typename... _Indices>
	static constexpr auto &&__at(const __farray<_Tp, _Np> &__elems, size_t __index,
			_Indices... __indices) {
		return __at(__elems[__index], __indices...);
	}

	template <typename _Fp, typename... _Fs>
	static constexpr void __visit_visitor_return_type_check() {
		static_assert(__all<is_same_v<_Fp, _Fs>...>::value,
				"`visit` requires the visitor to have a single return type.");
	}

	template <typename... _Fs>
	static constexpr auto __make_farray(_Fs &&...__fs) {
		__visit_visitor_return_type_check<remove_cvref_t<_Fs>...>();
		using __result = __farray<common_type_t<remove_cvref_t<_Fs>...>, sizeof...(_Fs)>;
		return __result{{sprt::forward<_Fs>(__fs)...}};
	}

	template <size_t... _Is>
	struct __dispatcher {
		template <typename _Fp, typename... _Vs>
		static constexpr decltype(auto) __dispatch(_Fp __f, _Vs... __vs) {
			return sprt::__invoke(static_cast<_Fp>(__f),
					__access::__base::__get_alt<_Is>(static_cast<_Vs>(__vs))...);
		}
	};

	template <typename _Fp, typename... _Vs, size_t... _Is>
	static constexpr auto __make_dispatch(index_sequence<_Is...>) {
		return __dispatcher<_Is...>::template __dispatch<_Fp, _Vs...>;
	}

	template <size_t _Ip, typename _Fp, typename... _Vs>
	static constexpr auto __make_fdiagonal_impl() {
		return __make_dispatch<_Fp, _Vs...>(index_sequence<((void)type_identity<_Vs>{}, _Ip)...>{});
	}

	template <typename _Fp, typename... _Vs, size_t... _Is>
	static constexpr auto __make_fdiagonal_impl(index_sequence<_Is...>) {
		return __base::__make_farray(__make_fdiagonal_impl<_Is, _Fp, _Vs...>()...);
	}

	template <typename _Fp, typename _Vp, typename... _Vs>
	static constexpr auto __make_fdiagonal() {
		constexpr size_t __np = remove_cvref_t<_Vp>::__size();
		static_assert(__all<(__np == remove_cvref_t<_Vs>::__size())...>::value);
		return __make_fdiagonal_impl<_Fp, _Vp, _Vs...>(make_index_sequence<__np>{});
	}

	template <typename _Fp, typename... _Vs, size_t... _Is>
	static constexpr auto __make_fmatrix_impl(index_sequence<_Is...> __is) {
		return __make_dispatch<_Fp, _Vs...>(__is);
	}

	template <typename _Fp, typename... _Vs, size_t... _Is, size_t... _Js, typename... _Ls>
	static constexpr auto __make_fmatrix_impl(index_sequence<_Is...>, index_sequence<_Js...>,
			_Ls... __ls) {
		return __base::__make_farray(
				__make_fmatrix_impl<_Fp, _Vs...>(index_sequence<_Is..., _Js>{}, __ls...)...);
	}

	template <typename _Fp, typename... _Vs>
	static constexpr auto __make_fmatrix() {
		return __make_fmatrix_impl<_Fp, _Vs...>(index_sequence<>{},
				make_index_sequence<remove_cvref_t<_Vs>::__size()>{}...);
	}
};

struct __variant {
	template <typename _Visitor, typename... _Vs>
	static constexpr decltype(auto) __visit_alt_at(size_t __index, _Visitor &&__visitor,
			_Vs &&...__vs) {
		return __base::__visit_alt_at(__index, sprt::forward<_Visitor>(__visitor),
				sprt::forward<_Vs>(__vs).__impl_...);
	}

	template <typename _Visitor, typename... _Vs>
	static constexpr decltype(auto) __visit_alt(_Visitor &&__visitor, _Vs &&...__vs) {
		return __base::__visit_alt(sprt::forward<_Visitor>(__visitor),
				sprt::__as_variant(sprt::forward<_Vs>(__vs)).__impl_...);
	}

	template <typename _Visitor, typename... _Vs>
	static constexpr decltype(auto) __visit_value_at(size_t __index, _Visitor &&__visitor,
			_Vs &&...__vs) {
		return __visit_alt_at(__index, __make_value_visitor(sprt::forward<_Visitor>(__visitor)),
				sprt::forward<_Vs>(__vs)...);
	}

	template <typename _Visitor, typename... _Vs>
	static constexpr decltype(auto) __visit_value(_Visitor &&__visitor, _Vs &&...__vs) {
		return __visit_alt(__make_value_visitor(sprt::forward<_Visitor>(__visitor)),
				sprt::forward<_Vs>(__vs)...);
	}

	template <typename _Rp, typename _Visitor, typename... _Vs>
	static constexpr _Rp __visit_value(_Visitor &&__visitor, _Vs &&...__vs) {
		return __visit_alt(__make_value_visitor<_Rp>(sprt::forward<_Visitor>(__visitor)),
				sprt::forward<_Vs>(__vs)...);
	}

private:
	template <typename _Visitor, typename... _Values>
	static constexpr void __visit_exhaustive_visitor_check() {
		static_assert(is_invocable_v<_Visitor, _Values...>,
				"`visit` requires the visitor to be exhaustive.");
	}

	template <typename _Visitor>
	struct __value_visitor {
		template <typename... _Alts>
		constexpr decltype(auto) operator()(_Alts &&...__alts) const {
			__visit_exhaustive_visitor_check<_Visitor,
					decltype((sprt::forward<_Alts>(__alts).__value))...>();
			return sprt::__invoke(sprt::forward<_Visitor>(__visitor),
					sprt::forward<_Alts>(__alts).__value...);
		}
		_Visitor &&__visitor;
	};

	template <typename _Rp, typename _Visitor>
	struct __value_visitor_return_type {
		template <typename... _Alts>
		constexpr _Rp operator()(_Alts &&...__alts) const {
			__visit_exhaustive_visitor_check<_Visitor,
					decltype((sprt::forward<_Alts>(__alts).__value))...>();
			if constexpr (is_void_v<_Rp>) {
				sprt::__invoke(sprt::forward<_Visitor>(__visitor),
						sprt::forward<_Alts>(__alts).__value...);
			} else {
				return sprt::__invoke(sprt::forward<_Visitor>(__visitor),
						sprt::forward<_Alts>(__alts).__value...);
			}
		}
		_Visitor &&__visitor;
	};

	template <typename _Visitor>
	static constexpr auto __make_value_visitor(_Visitor &&__visitor) {
		return __value_visitor<_Visitor>{sprt::forward<_Visitor>(__visitor)};
	}
	template <typename _Rp, typename _Visitor>
	static constexpr auto __make_value_visitor(_Visitor &&__visitor) {
		return __value_visitor_return_type<_Rp, _Visitor>{sprt::forward<_Visitor>(__visitor)};
	}
};

} // namespace __visitation

#define __SPRT_EAT_SEMICOLON static_assert(true, "")

template <size_t _Index, typename _Tp>
struct __alt {
	using __value_type = _Tp;
	static constexpr size_t __index = _Index;

	template <typename... _Args>
	explicit constexpr __alt(in_place_t, _Args &&...__args)
	: __value(sprt::forward<_Args>(__args)...) { }

	__value_type __value;
};

template <_Trait _DestructibleTrait, size_t _Index, typename... _Types>
union __union;

template <_Trait _DestructibleTrait, size_t _Index>
union __union<_DestructibleTrait, _Index> { };

#define __SPRT_VARIANT_UNION(destructible_trait, destructor_definition)                            \
	template <size_t _Index, typename _Tp, typename... _Types>                                     \
	union __union<destructible_trait, _Index, _Tp, _Types...> {                                    \
	public:                                                                                        \
		explicit constexpr __union(__valueless_t) noexcept : __dummy {} { }                        \
		template <typename... _Args>                                                               \
		explicit constexpr __union(in_place_index_t<0>, _Args &&...__args)                         \
		: __head(in_place, sprt::forward<_Args>(__args)...) { }                                    \
		template <size_t _Ip, typename... _Args>                                                   \
		explicit constexpr __union(in_place_index_t<_Ip>, _Args &&...__args)                       \
		: __tail(in_place_index<_Ip - 1>, sprt::forward<_Args>(__args)...) { }                     \
		__union(const __union &) = default;                                                        \
		__union(__union &&) = default;                                                             \
		__union &operator=(const __union &) = default;                                             \
		__union &operator=(__union &&) = default;                                                  \
		destructor_definition;                                                                     \
                                                                                                   \
	private:                                                                                       \
		char __dummy;                                                                              \
		__alt<_Index, _Tp> __head;                                                                 \
		__union<destructible_trait, _Index + 1, _Types...> __tail;                                 \
		friend struct __access::__union;                                                           \
	}

__SPRT_VARIANT_UNION(_Trait::_TriviallyAvailable, constexpr ~__union() = default);
__SPRT_VARIANT_UNION(_Trait::_Available, constexpr ~__union() { } __SPRT_EAT_SEMICOLON);
__SPRT_VARIANT_UNION(_Trait::_Unavailable, constexpr ~__union() = delete);

#undef __SPRT_VARIANT_UNION

template <_Trait _DestructibleTrait, typename... _Types>
class __base {
public:
	using __index_t = __variant_index_t<sizeof...(_Types)>;

	explicit constexpr __base(__valueless_t) noexcept
	: __data(__valueless_t{}), __index(__variant_npos<__index_t>) { }

	template <size_t _Ip, typename... _Args>
	explicit constexpr __base(in_place_index_t<_Ip>, _Args &&...__args)
	: __data(in_place_index<_Ip>, sprt::forward<_Args>(__args)...), __index(_Ip) { }

	constexpr bool valueless_by_exception() const noexcept { return index() == variant_npos; }

	constexpr size_t index() const noexcept {
		return __index == __variant_npos<__index_t> ? variant_npos : __index;
	}

protected:
	constexpr auto &&__as_base() & { return *this; }
	constexpr auto &&__as_base() && { return sprt::move(*this); }
	constexpr auto &&__as_base() const & { return *this; }
	constexpr auto &&__as_base() const && { return sprt::move(*this); }

	static constexpr size_t __size() { return sizeof...(_Types); }

	__union<_DestructibleTrait, 0, _Types...> __data;
	__index_t __index;

	friend struct __access::__base;
	friend struct __visitation::__base;
};

template <typename _Traits, _Trait = _Traits::__destructible_trait>
class __dtor;

#define __SPRT_VARIANT_DESTRUCTOR(destructible_trait, destructor_definition, destroy)              \
	template <typename... _Types>                                                                  \
	class __dtor<__traits<_Types...>, destructible_trait>                                           \
	: public __base<destructible_trait, _Types...> {                                               \
		using __base_type = __base<destructible_trait, _Types...>;                                 \
