template <typename... _Types>
class __impl : public __copy_assignment<__traits<_Types...>> {
	using __base_type = __copy_assignment<__traits<_Types...>>;

public:
	using __base_type::__base_type;
	__impl(const __impl &) = default;
	__impl(__impl &&) = default;
	__impl &operator=(const __impl &) = default;
	__impl &operator=(__impl &&) = default;

	template <size_t _Ip, typename _Arg>
	constexpr void __assign(_Arg &&__arg) {
		this->__assign_alt(__access::__base::__get_alt<_Ip>(*this), sprt::forward<_Arg>(__arg));
	}

	constexpr void __swap(__impl &__that) {
		if (this->valueless_by_exception() && __that.valueless_by_exception()) {
			// do nothing.
		} else if (this->index() == __that.index()) {
			__visitation::__base::__visit_alt_at(this->index(),
					[](auto &__this_alt, auto &__that_alt) {
				using sprt::swap;
				swap(__this_alt.__value, __that_alt.__value);
			}, *this, __that);
		} else {
			__impl *__lhs = this;
			__impl *__rhs = sprt::addressof(__that);
			if (__lhs->__move_nothrow() && !__rhs->__move_nothrow()) {
				sprt::swap(__lhs, __rhs);
			}
			__impl __tmp(sprt::move(*__rhs));
			this->__generic_construct(*__rhs, sprt::move(*__lhs));
			this->__generic_construct(*__lhs, sprt::move(__tmp));
		}
	}

private:
	constexpr bool __move_nothrow() const {
		constexpr bool __results[] = {is_nothrow_move_constructible_v<_Types>...};
		return this->valueless_by_exception() || __results[this->index()];
	}
};

// Imaginary function used to select, via overload resolution, the alternative an
// arbitrary argument converts to for the converting constructor / assignment.
struct __no_narrowing_check {
	template <typename _Dest, typename _Source>
	using _Apply = type_identity<_Dest>;
};

struct __narrowing_check {
	template <typename _Dest>
	static auto __test_impl(_Dest (&&)[1]) -> type_identity<_Dest>;
	template <typename _Dest, typename _Source>
	using _Apply = decltype(__test_impl<_Dest>({sprt::declval<_Source>()}));
};

template <typename _Dest, typename _Source>
using __check_for_narrowing = typename _If<is_arithmetic<_Dest>::value, __narrowing_check,
		__no_narrowing_check>::template _Apply<_Dest, _Source>;

template <typename _Tp, size_t _Idx>
struct __overload {
	template <typename _Up>
	auto operator()(_Tp, _Up &&) const -> __check_for_narrowing<_Tp, _Up>;
};

template <typename... _Bases>
struct __all_overloads : _Bases... {
	void operator()() const;
	using _Bases::operator()...;
};

template <typename _IdxSeq>
struct __make_overloads_imp;

template <size_t... _Idx>
struct __make_overloads_imp<index_sequence<_Idx...>> {
	template <typename... _Types>
	using _Apply = __all_overloads<__overload<_Types, _Idx>...>;
};

template <typename... _Types>
using _MakeOverloads = typename __make_overloads_imp<
		make_index_sequence<sizeof...(_Types)>>::template _Apply<_Types...>;

template <typename _Tp, typename... _Types>
using __best_match_t = typename invoke_result_t<_MakeOverloads<_Types...>, _Tp, _Tp>::type;

// Common comparison category of a pack of comparison-category types — the result
// type of variant's operator<=> (mirrors std::common_comparison_category_t).
template <typename _Tp>
constexpr int __comparison_category_rank() {
	if (is_same_v<_Tp, strong_ordering>) {
		return 0;
	}
	if (is_same_v<_Tp, weak_ordering>) {
		return 1;
	}
	if (is_same_v<_Tp, partial_ordering>) {
		return 2;
	}
	return -1; // not a comparison category
}

template <typename... _Ts>
struct __common_comparison_category {
	static constexpr int __compute() {
		int __result = 0;
		for (int __rank : {__comparison_category_rank<_Ts>()..., 0}) {
			if (__rank < 0) {
				return -1;
			}
			if (__rank > __result) {
				__result = __rank;
			}
		}
		return __result;
	}
	using type = conditional_t<__compute() == 2, partial_ordering,
			conditional_t<__compute() == 1, weak_ordering, strong_ordering>>;
};

template <typename... _Ts>
using __common_comparison_category_t = typename __common_comparison_category<_Ts...>::type;

