template <typename... _Types>
requires (requires(const _Types &__t) { __t <=> __t; } && ...)
constexpr __variant_detail::__common_comparison_category_t< decltype(sprt::declval<const _Types &>()
		<=> sprt::declval<const _Types &>())...>
operator<=>(const variant<_Types...> &__lhs, const variant<_Types...> &__rhs) {
	using __variant_detail::__visitation::__variant;
	using __result_t = __variant_detail::__common_comparison_category_t<
			decltype(sprt::declval<const _Types &>() <=> sprt::declval<const _Types &>())...>;
	if (__lhs.valueless_by_exception() && __rhs.valueless_by_exception()) {
		return strong_ordering::equal;
	}
	if (__lhs.valueless_by_exception()) {
		return strong_ordering::less;
	}
	if (__rhs.valueless_by_exception()) {
		return strong_ordering::greater;
	}
	if (auto __c = __lhs.index() <=> __rhs.index(); __c != 0) {
		return __c;
	}
	return __variant::__visit_value_at(__lhs.index(),
			[](auto &&__a, auto &&__b) -> __result_t { return __a <=> __b; }, __lhs, __rhs);
}

// [variant.visit]
//
// sprt extension: visiting a valueless variant does not abort; the visitor is
// invoked with a variant_empty in place of the (missing) alternative. For the
// single-variant case this is handled directly below. For the multi-variant case
// (rare, and never produced by trivially-movable variants) any valueless variant
// aborts via __throw_bad_variant_access, matching std::visit's bad_variant_access.

template <typename... _Vs>
constexpr void __throw_if_valueless(_Vs &&...__vs) {
	const bool __valueless = (... || sprt::__as_variant(__vs).valueless_by_exception());
	if (__valueless) {
		sprt::__throw_bad_variant_access();
	}
}

template <typename _Visitor, typename... _Vs, typename>
constexpr decltype(auto) visit(_Visitor &&__visitor, _Vs &&...__vs) {
	using __variant_detail::__visitation::__variant;
	sprt::__throw_if_valueless(__vs...);
	return __variant::__visit_value(sprt::forward<_Visitor>(__visitor),
			sprt::forward<_Vs>(__vs)...);
}

template <typename _Rp, typename _Visitor, typename... _Vs, typename>
constexpr _Rp visit(_Visitor &&__visitor, _Vs &&...__vs) {
	using __variant_detail::__visitation::__variant;
	sprt::__throw_if_valueless(__vs...);
	return __variant::__visit_value<_Rp>(sprt::forward<_Visitor>(__visitor),
			sprt::forward<_Vs>(__vs)...);
}

template <typename... _Types>
constexpr auto swap(variant<_Types...> &__lhs, variant<_Types...> &__rhs)
		noexcept(noexcept(__lhs.swap(__rhs))) -> decltype(__lhs.swap(__rhs)) {
	return __lhs.swap(__rhs);
}

// [variant.hash]

inline size_t __hash_combine(size_t __seed, size_t __value) noexcept {
	return __seed
			^ (__value + static_cast<size_t>(0x9e37'79b9'7f4a'7c15ULL) + (__seed << 6)
					+ (__seed >> 2));
}

template <typename... _Types>
struct hash<variant<_Types...>> {
	size_t operator()(const variant<_Types...> &__v) const noexcept {
		using __variant_detail::__visitation::__variant;
		size_t __res = __v.valueless_by_exception() ? static_cast<size_t>(299'792'458)
													: __variant::__visit_alt([](const auto &__alt) {
			using __alt_type = remove_cvref_t<decltype(__alt)>;
			using __value_type = remove_const_t<typename __alt_type::__value_type>;
			return hash<__value_type>{}(__alt.__value);
		}, __v);
		return sprt::__hash_combine(__res, hash<size_t>{}(__v.index()));
	}
};

