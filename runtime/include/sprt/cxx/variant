	template <typename _That>
	constexpr void __generic_assign(_That &&__that) {
		if (this->valueless_by_exception() && __that.valueless_by_exception()) {
			// do nothing.
		} else if (__that.valueless_by_exception()) {
			this->__destroy();
		} else {
			__visitation::__base::__visit_alt_at(__that.index(),
					[this](auto &__this_alt, auto &&__that_alt) {
				this->__assign_alt(__this_alt,
						sprt::forward<decltype(__that_alt)>(__that_alt).__value);
			}, *this, sprt::forward<_That>(__that));
