template <size_t _N_words, size_t _Size>
class __bitset;

template <size_t _N_words, size_t _Size>
class __bitset {
public:
	using __storage_type = uint64_t;

protected:
	typedef __bitset __self;
	typedef __storage_type *__storage_pointer;
	typedef const __storage_type *__const_storage_pointer;
	static const unsigned __bits_per_word =
			static_cast<unsigned>(sizeof(__storage_type) * __CHAR_BIT__);

	__storage_type __first_[_N_words];

	constexpr __bitset() noexcept : __first_{0} { }
	explicit constexpr __bitset(unsigned long long __v) noexcept : __first_{0} {
		__first_[0] = __v;
	}

	constexpr void operator&=(const __bitset &__v) noexcept {
		for (size_t __i = 0; __i < _N_words; ++__i) { __first_[__i] &= __v.__first_[__i]; }
	}
	constexpr void operator|=(const __bitset &__v) noexcept {
		for (size_t __i = 0; __i < _N_words; ++__i) { __first_[__i] |= __v.__first_[__i]; }
	}
	constexpr void operator^=(const __bitset &__v) noexcept {
		for (size_t __i = 0; __i < _N_words; ++__i) { __first_[__i] ^= __v.__first_[__i]; }
	}

	constexpr void flip() noexcept {
		// do middle whole words
		size_t __n = _Size;
		__storage_pointer __p = __first_;
		for (; __n >= __bits_per_word; ++__p, __n -= __bits_per_word) { *__p = ~*__p; }
		if (__n > 0) {
			*__p ^= (__storage_type(1) << __n) - 1;
		}
	}

	constexpr void flip(size_t n) {
		__first_[n / __bits_per_word] ^= (__storage_type(1) << (n % __bits_per_word));
	}

	constexpr bool all() const noexcept { return !__scan_bits(__bit_not()); }
	constexpr bool any() const noexcept { return __scan_bits(sprt::identity()); }

	constexpr void set() {
		size_t __n = _Size;
		__storage_pointer __p = __first_;

		// do middle whole words
		for (; __n >= __bits_per_word; ++__p, __n -= __bits_per_word) { *__p = ~__storage_type(0); }
		// do last partial word
		if (__n > 0) {
			*__p = ~__storage_type(0) >> (__bits_per_word - __n);
		}
	}

	constexpr void set(size_t n, bool v) {
		if (v) {
			__first_[n / __bits_per_word] |= __storage_type(1) << (n % __bits_per_word);
		} else {
			__first_[n / __bits_per_word] &= ~(__storage_type(1) << (n % __bits_per_word));
		}
	}
	constexpr void reset() {
		for (size_t i = 0; i < _N_words; ++i) { __first_[i] = 0; }
	}

	constexpr void reset(size_t n) {
		__first_[n / __bits_per_word] &= ~(__storage_type(1) << (n % __bits_per_word));
	}

	constexpr size_t count() const {
		size_t ret = 0;
		for (size_t i = 0; i < _N_words; ++i) { ret += sprt::popcount(__first_[i]); }
		return ret;
	}

	constexpr int compare(const __bitset &other) const {
		return __constexpr_memcmp(__first_, other.__first_, _N_words);
	}

	constexpr bool test(size_t n) const {
		return (__first_[n / __bits_per_word] & (__storage_type(1) << (n % __bits_per_word))) != 0;
	}

	constexpr size_t find_first_set() const noexcept {
		for (size_t __i = 0; __i < _N_words; ++__i) {
			if (__first_[__i] != 0) {
				return __i * __bits_per_word + static_cast<size_t>(countr_zero(__first_[__i]));
			}
		}
		return _Size;
	}

	constexpr size_t find_first_not_set() const noexcept {
		for (size_t __i = 0; __i < _N_words; ++__i) {
			if (__i == _N_words - 1 && _Size % __bits_per_word != 0) {
				__storage_type __m = (__storage_type(1) << (_Size % __bits_per_word)) - 1;
				if ((__first_[__i] & __m) != __m) {
					return __i * __bits_per_word + static_cast<size_t>(countr_zero(~__first_[__i]));
				}
			} else if (__first_[__i] != ~__storage_type(0)) {
				return __i * __bits_per_word + static_cast<size_t>(countr_zero(~__first_[__i]));
			}
		}
		return _Size;
	}

private:
	struct __bit_not {
		template <typename _Tp>
		constexpr _Tp operator()(const _Tp &__x) const noexcept {
			return ~__x;
		}
	};

	template <typename _Proj>
	constexpr bool __scan_bits(_Proj __proj) const noexcept {
		size_t __n = _Size;
		__const_storage_pointer __p = __first_;
		// do middle whole words
		for (; __n >= __bits_per_word; ++__p, __n -= __bits_per_word) {
			if (__proj(*__p)) {
				return true;
			}
		}
		// do last partial word
		if (__n > 0) {
			__storage_type __m = ~__storage_type(0) >> (__bits_per_word - __n);
			if (__proj(*__p) & __m) {
				return true;
			}
		}
		return false;
	}
};


template <size_t _Size>
class __bitset<1, _Size> {
public:
	typedef uint64_t __storage_type;

protected:
	typedef __bitset __self;
	typedef __storage_type *__storage_pointer;
	typedef const __storage_type *__const_storage_pointer;
	static const unsigned __bits_per_word =
			static_cast<unsigned>(sizeof(__storage_type) * __CHAR_BIT__);

	__storage_type __first_;

	constexpr __bitset() noexcept : __first_(0) { }
	explicit constexpr __bitset(unsigned long long __v) noexcept {
		if constexpr (_Size == __bits_per_word) {
			__first_ = __v;
		} else {
			__first_ = __v & ~__storage_type(0) >> (__bits_per_word - _Size);
		}
	}

	constexpr void operator&=(const __bitset &__v) noexcept { __first_ &= __v.__first_; }
	constexpr void operator|=(const __bitset &__v) noexcept { __first_ |= __v.__first_; }
	constexpr void operator^=(const __bitset &__v) noexcept { __first_ ^= __v.__first_; }

	constexpr void flip() noexcept { __first_ ^= ~__storage_type(0) >> (__bits_per_word - _Size); }
	constexpr void flip(size_t n) { __first_ ^= (__storage_type(1) << n); }

	constexpr bool all() const noexcept {
		__storage_type __m = ~__storage_type(0) >> (__bits_per_word - _Size);
		return !(~__first_ & __m);
	}
	constexpr bool any() const noexcept {
		__storage_type __m = ~__storage_type(0) >> (__bits_per_word - _Size);
		return __first_ & __m;
	}

	constexpr void set() {
		if constexpr (_Size == __bits_per_word) {
			__first_ = ~__storage_type(0);
		} else {
			__first_ = ~__storage_type(0) >> (__bits_per_word - _Size);
		}
	}

	constexpr void set(size_t n, bool v) {
		if (v) {
			__first_ |= __storage_type(1) << n;
		} else {
			__first_ &= ~(__storage_type(1) << n);
		}
	}

	constexpr void reset() { __first_ = 0; }

	constexpr void reset(size_t n) { __first_ &= ~(__storage_type(1) << n); }

	constexpr size_t count() const { return popcount(__first_); }

	constexpr int compare(const __bitset &other) const {
		if (__first_ < other.__first_) {
			return -1;
		} else if (__first_ == other.__first_) {
			return 0;
		} else {
			return 1;
		}
	}

	constexpr bool test(size_t n) const { return (__first_ & (__storage_type(1) << n)) != 0; }

	constexpr size_t find_first_set() const noexcept {
		if (__first_ != 0) {
			return static_cast<size_t>(countr_zero(__first_));
		}
		return _Size;
	}

	constexpr size_t find_first_not_set() const noexcept {
		__storage_type __m = ~__storage_type(0) >> (__bits_per_word - _Size);
		if ((__first_ & __m) != __m) {
			return static_cast<size_t>(countr_zero(~__first_));
		}
		return _Size;
	}
};

template <>
class __bitset<0, 0> {
public:
	typedef uint64_t __storage_type;

protected:
	typedef __bitset __self;
	typedef __storage_type *__storage_pointer;
	typedef const __storage_type *__const_storage_pointer;
	static const unsigned __bits_per_word =
			static_cast<unsigned>(sizeof(__storage_type) * __CHAR_BIT__);

	constexpr __bitset() noexcept;
	explicit constexpr __bitset(unsigned long long) noexcept;

	constexpr void operator&=(const __bitset &) noexcept { }
	constexpr void operator|=(const __bitset &) noexcept { }
	constexpr void operator^=(const __bitset &) noexcept { }

	constexpr void flip() noexcept { }
	constexpr void flip(size_t n) { }

	constexpr bool all() const noexcept { return true; }
	constexpr bool any() const noexcept { return false; }

	constexpr void set() { }
	constexpr void set(size_t n, bool v) { }
	constexpr void reset() { }
	constexpr void reset(size_t n) { }

	constexpr size_t count() const { return 0; }

	constexpr int compare(const __bitset &) const { return 0; }

	constexpr bool test(size_t n) const { return false; }

	constexpr size_t find_first_set() const noexcept { return 0; }
	constexpr size_t find_first_not_set() const noexcept { return 0; }
};

inline constexpr __bitset<0, 0>::__bitset() noexcept { }

inline constexpr __bitset<0, 0>::__bitset(unsigned long long) noexcept { }

template <size_t _Size>
class bitset;

template <size_t _Size>
class bitset
: private __bitset<_Size == 0 ? 0 : (_Size - 1) / (sizeof(uint64_t) * __CHAR_BIT__) + 1, _Size> {
public:
	static const unsigned __n_words =
			_Size == 0 ? 0 : (_Size - 1) / (sizeof(uint64_t) * __CHAR_BIT__) + 1;
	typedef __bitset<__n_words, _Size> __base;

	constexpr bitset() noexcept { }
	constexpr bitset(unsigned long long __v) noexcept
	: __base(sizeof(unsigned long long) * __CHAR_BIT__ <= _Size ? __v
																: __v & ((1ULL << _Size) - 1)) { }

	// [bitset.cons] construction from a character sequence of `zero`/`one` digits.
	// The rightmost character maps to bit 0; every examined character must be
	// `zero` or `one` (otherwise the standard throws invalid_argument — under the
	// runtime's -fno-exceptions build we abort, mirroring the optional/variant
	// helpers; the throwing test cases are guarded by TEST_HAS_NO_EXCEPTIONS).
	template <typename _CharT, typename _Traits, typename _Alloc>
	constexpr explicit bitset(const __basic_string<_CharT, _Alloc, _Traits> &__str,
			typename __basic_string<_CharT, _Alloc, _Traits>::size_type __pos = 0,
			typename __basic_string<_CharT, _Alloc, _Traits>::size_type __n =
					__basic_string<_CharT, _Alloc, _Traits>::npos,
			_CharT __zero = _CharT('0'), _CharT __one = _CharT('1')) {
		if (__pos > __str.size()) {
			__throw_bitset_out_of_range();
		}
		size_t __rlen = __str.size() - __pos;
		if (__n < __rlen) {
			__rlen = __n;
		}
		__init_from_chars(__str, __pos, __rlen, __zero, __one);
	}

	template <typename _CharT>
	constexpr explicit bitset(const _CharT *__str, size_t __n = static_cast<size_t>(-1),
			_CharT __zero = _CharT('0'), _CharT __one = _CharT('1')) {
		size_t __len = 0;
		while (__len < __n && __str[__len] != _CharT(0)) { ++__len; }
		__init_from_chars(__str, 0, __len, __zero, __one);
	}

	constexpr unsigned long to_ulong() const {
		return static_cast<unsigned long>(__to_integral<unsigned long>());
	}
	constexpr unsigned long long to_ullong() const { return __to_integral<unsigned long long>(); }

	// 23.3.5.2 bitset operations:
	constexpr bitset &operator&=(const bitset &__rhs) noexcept;
	constexpr bitset &operator|=(const bitset &__rhs) noexcept;
	constexpr bitset &operator^=(const bitset &__rhs) noexcept;
	constexpr bitset &set() noexcept;
	constexpr bitset &set(size_t __pos, bool __val = true);
	constexpr bitset &reset() noexcept;
	constexpr bitset &reset(size_t __pos);
	constexpr bitset operator~() const noexcept;
	constexpr bitset &flip() noexcept;
	constexpr bitset &flip(size_t __pos);

	constexpr size_t count() const noexcept;
	constexpr size_t size() const noexcept { return _Size; }
	constexpr bool operator==(const bitset &__rhs) const noexcept;

	constexpr bool test(size_t __pos) const;
	constexpr bool all() const noexcept { return __base::all(); }
	constexpr bool any() const noexcept { return __base::any(); }
	constexpr bool none() const noexcept { return !any(); }

	constexpr size_t find_first_set() const noexcept;
	constexpr size_t find_first_not_set() const noexcept;

	// [bitset.members] element access. The mutable form returns a proxy that writes
	// back through set(); the const form yields the bit value.
	class reference {
		friend class bitset;
		bitset *__b_;
		size_t __pos_;
		constexpr reference(bitset *__b, size_t __pos) noexcept : __b_(__b), __pos_(__pos) { }

	public:
		constexpr reference &operator=(bool __x) noexcept {
			__b_->set(__pos_, __x);
			return *this;
		}
		constexpr reference &operator=(const reference &__x) noexcept {
			__b_->set(__pos_, static_cast<bool>(__x));
			return *this;
		}
		constexpr operator bool() const noexcept { return __b_->test(__pos_); }
		constexpr bool operator~() const noexcept { return !__b_->test(__pos_); }
		constexpr reference &flip() noexcept {
			__b_->flip(__pos_);
			return *this;
		}
	};

	constexpr bool operator[](size_t __pos) const { return test(__pos); }
	constexpr reference operator[](size_t __pos) { return reference(this, __pos); }

	// [bitset.members] bit shifts. Bit 0 is least significant, so <<= moves each
	// bit to a higher index (vacated low bits are zero-filled) and >>= to a lower
	// index. Implemented via test/set so they work for every __base specialization.
	constexpr bitset &operator<<=(size_t __pos) noexcept {
		if (__pos >= _Size) {
			return reset();
		}
		for (size_t __i = _Size; __i-- > 0;) { set(__i, __i >= __pos ? test(__i - __pos) : false); }
		return *this;
	}
	constexpr bitset &operator>>=(size_t __pos) noexcept {
		if (__pos >= _Size) {
			return reset();
		}
		for (size_t __i = 0; __i < _Size; ++__i) {
			set(__i, __i + __pos < _Size ? test(__i + __pos) : false);
		}
		return *this;
	}
	constexpr bitset operator<<(size_t __pos) const noexcept {
		bitset __r(*this);
		__r <<= __pos;
		return __r;
	}
	constexpr bitset operator>>(size_t __pos) const noexcept {
		bitset __r(*this);
		__r >>= __pos;
		return __r;
	}

private:
	[[noreturn]]
	static void __throw_bitset_out_of_range() {
		__builtin_abort();
	}
	[[noreturn]]
	static void __throw_bitset_invalid() {
		__builtin_abort();
	}

	// Fill from a `zero`/`one` character sequence of effective length `__rlen`
	// starting at `__pos`. Per [bitset.cons], only the leading M = min(rlen, _Size)
	// characters contribute: bit i is set from seq[pos + M-1 - i] (so seq[pos] is the
	// most significant contributing bit). Every examined character must be `__zero`
	// or `__one`.
	template <typename _Seq, typename _CharT>
	constexpr void __init_from_chars(const _Seq &__seq, size_t __pos, size_t __rlen, _CharT __zero,
			_CharT __one) {
		size_t __m = __rlen < _Size ? __rlen : _Size;
		for (size_t __k = 0; __k < __rlen; ++__k) {
			_CharT __c = __seq[__pos + __k];
			bool __is_one = (__c == __one);
			if (!__is_one && !(__c == __zero)) {
				__throw_bitset_invalid();
			}
			if (__k < __m && __is_one) {
				__base::set(__m - 1 - __k, true);
			}
		}
	}

	template <typename _Int>
	constexpr _Int __to_integral() const {
		_Int __r = 0;
		size_t __bits = _Size < sizeof(_Int) * __CHAR_BIT__ ? _Size : sizeof(_Int) * __CHAR_BIT__;
		for (size_t __i = 0; __i < __bits; ++__i) {
			if (test(__i)) {
				__r |= (static_cast<_Int>(1) << __i);
			}
		}
		return __r;
	}
};

template <size_t _Size>
inline constexpr bitset<_Size> &bitset<_Size>::operator&=(const bitset &__rhs) noexcept {
	__base::operator&=(__rhs);
	return *this;
}

template <size_t _Size>
inline constexpr bitset<_Size> &bitset<_Size>::operator|=(const bitset &__rhs) noexcept {
	__base::operator|=(__rhs);
	return *this;
}

template <size_t _Size>
inline constexpr bitset<_Size> &bitset<_Size>::operator^=(const bitset &__rhs) noexcept {
	__base::operator^=(__rhs);
	return *this;
}

template <size_t _Size>
inline constexpr bitset<_Size> &bitset<_Size>::set() noexcept {
	__base::set();
	return *this;
}

template <size_t _Size>
constexpr bitset<_Size> &bitset<_Size>::set(size_t __pos, bool __val) {
	if (__pos >= _Size) {
		return *this;
	}

	__base::set(__pos, __val);
	return *this;
}

template <size_t _Size>
inline constexpr bitset<_Size> &bitset<_Size>::reset() noexcept {
	__base::reset();
	return *this;
}

template <size_t _Size>
constexpr bitset<_Size> &bitset<_Size>::reset(size_t __pos) {
	if (__pos >= _Size) {
		return *this;
	}

	__base::reset(__pos);
	return *this;
}

template <size_t _Size>
inline constexpr bitset<_Size> bitset<_Size>::operator~() const noexcept {
	bitset __x(*this);
	__x.flip();
	return __x;
}

template <size_t _Size>
inline constexpr bitset<_Size> &bitset<_Size>::flip() noexcept {
	__base::flip();
	return *this;
}

template <size_t _Size>
constexpr bitset<_Size> &bitset<_Size>::flip(size_t __pos) {
	if (__pos >= _Size) {
		return *this;
	}

	__base::flip(__pos);
	return *this;
}

template <size_t _Size>
inline constexpr size_t bitset<_Size>::count() const noexcept {
	return __base::count();
}

template <size_t _Size>
inline constexpr bool bitset<_Size>::operator==(const bitset &__rhs) const noexcept {
	return __base::compare(__rhs) == 0;
}

template <size_t _Size>
constexpr bool bitset<_Size>::test(size_t __pos) const {
	if (__pos >= _Size) {
		return false;
	}

	return __base::test(__pos);
}

template <size_t _Size>
inline constexpr size_t bitset<_Size>::find_first_set() const noexcept {
	return __base::find_first_set();
}

template <size_t _Size>
inline constexpr size_t bitset<_Size>::find_first_not_set() const noexcept {
	return __base::find_first_not_set();
}

template <size_t _Size>
inline constexpr bitset<_Size> operator&(const bitset<_Size> &__x,
		const bitset<_Size> &__y) noexcept {
	bitset<_Size> __r = __x;
	__r &= __y;
	return __r;
}

template <size_t _Size>
inline constexpr bitset<_Size> operator|(const bitset<_Size> &__x,
		const bitset<_Size> &__y) noexcept {
	bitset<_Size> __r = __x;
	__r |= __y;
	return __r;
}

template <size_t _Size>
inline constexpr bitset<_Size> operator^(const bitset<_Size> &__x,
		const bitset<_Size> &__y) noexcept {
	bitset<_Size> __r = __x;
	__r ^= __y;
	return __r;
}

// [bitset.hash] std::hash support. The primary sprt::hash delegates the std
// wrapper's enabled/disabled split, so specializing it here makes std::hash<bitset>
// an enabled hash. FNV-1a over the individual bits keeps it independent of the
// __base word layout.
template <size_t _Size>
struct hash<bitset<_Size> > {
	constexpr size_t operator()(const bitset<_Size> &__b) const noexcept {
		size_t __r = static_cast<size_t>(14'695'981'039'346'656'037ULL);
		for (size_t __i = 0; __i < _Size; ++__i) {
			__r = (__r ^ static_cast<size_t>(__b.test(__i) ? 1u : 0u))
					* static_cast<size_t>(1'099'511'628'211ULL);
		}
		return __r;
	}
};

