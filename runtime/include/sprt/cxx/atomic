inline void atomic_thread_fence(memory_order __order) noexcept {
	__c11_atomic_thread_fence(static_cast<int>(__order));
}

inline void atomic_signal_fence(memory_order __order) noexcept {
	__c11_atomic_signal_fence(static_cast<int>(__order));
}

// [atomics.nonmembers] atomic_init (deprecated in C++20): non-atomically seed the
// object. Implemented as a relaxed store, which is safe before the atomic is shared.
template <typename _Tp>
inline void atomic_init(volatile atomic<_Tp> *__o, typename atomic<_Tp>::value_type __d) noexcept {
	__o->store(__d, memory_order::relaxed);
}
template <typename _Tp>
inline void atomic_init(atomic<_Tp> *__o, typename atomic<_Tp>::value_type __d) noexcept {
	__o->store(__d, memory_order::relaxed);
}


