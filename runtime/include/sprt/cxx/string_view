// The `sv` suffix (no leading underscore) is reserved for the standard library, which is
// exactly what this is; silence the diagnostic as libc++/libstdc++ do.
#if defined(__clang__)
#pragma clang diagnostic push
#pragma clang diagnostic ignored "-Wuser-defined-literals"
#elif defined(__GNUC__)
#pragma GCC diagnostic push
#pragma GCC diagnostic ignored "-Wliteral-suffix"
#endif

constexpr basic_string_view<char> operator""sv(const char *__s, size_t __n) noexcept {
	return basic_string_view<char>(__s, __n);
}
constexpr basic_string_view<wchar_t> operator""sv(const wchar_t *__s, size_t __n) noexcept {
	return basic_string_view<wchar_t>(__s, __n);
}
constexpr basic_string_view<char8_t> operator""sv(const char8_t *__s, size_t __n) noexcept {
	return basic_string_view<char8_t>(__s, __n);
}
constexpr basic_string_view<char16_t> operator""sv(const char16_t *__s, size_t __n) noexcept {
	return basic_string_view<char16_t>(__s, __n);
}
constexpr basic_string_view<char32_t> operator""sv(const char32_t *__s, size_t __n) noexcept {
	return basic_string_view<char32_t>(__s, __n);
}

