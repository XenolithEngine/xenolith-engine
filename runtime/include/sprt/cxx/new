// Allocation-failure exceptions. libc++abi implements their out-of-line bodies
// (stdlib_new_delete.cpp / stdlib_exception.cpp) and throws them from the global
// operator new; std::exception comes from <sprt/cxx/exception>.
class SPRT_API bad_alloc : public exception {
public:
	bad_alloc() noexcept;
	bad_alloc(const bad_alloc &) noexcept = default;
	bad_alloc &operator=(const bad_alloc &) noexcept = default;
	~bad_alloc() noexcept override;
	const char *what() const noexcept override;
};

class SPRT_API bad_array_new_length : public bad_alloc {
public:
	bad_array_new_length() noexcept;
	~bad_array_new_length() noexcept override;
	const char *what() const noexcept override;
};

