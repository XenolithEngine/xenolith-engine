template <typename T>
inline T *__new_n(size_t sz) {
	return new (sprt::nothrow) T[sz];
}

template <typename T>
inline void __delete_n(T *t, size_t __n) noexcept {
	if constexpr (!sprt::is_trivially_destructible_v<T>) {
		for (; __n > 0; (void)++t, --__n) { sprt::destroy_at(t); }
	}

	if constexpr (alignof(T) <= alignof(__sprt_max_align_t)) {
		__sprt_free(static_cast<void *>(t));
	} else {
		__sprt_aligned_free(static_cast<void *>(t));
	}
}

template <typename T>
requires (sprt::is_trivially_destructible_v<T>)
inline void __delete_n(T *t) noexcept {
	if constexpr (alignof(T) <= alignof(__sprt_max_align_t)) {
		__sprt_free(static_cast<void *>(t));
	} else {
		__sprt_aligned_free(static_cast<void *>(t));
	}
}

template <typename T>
requires (sprt::is_same_v<T, char> || sprt::is_same_v<T, unsigned char>)
inline void __delete_n(const T *t, size_t __n) noexcept {
	__delete_n(const_cast<T *>(t), __n);
}

template <typename T>
requires (sprt::is_same_v<T, char> || sprt::is_same_v<T, unsigned char>)
inline void __delete_n(const T *t) noexcept {
	__delete_n(const_cast<T *>(t));
}

