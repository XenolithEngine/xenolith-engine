namespace sprt::memory {

class OpaquePool;

// Use the compiler-provided pointer width, NOT INTPTR_MAX == INT64_MAX: the
// latter silently evaluates to 0 == 0 (true, i.e. the 64-bit layout) in any TU
// that includes this header before <stdint.h> defines those macros. That made
// allocator_t (and everything after it in thread_base_t, incl. threadMemPool)
// 88 bytes larger in some TUs than others, corrupting cross-TU struct access.
// __SIZEOF_POINTER__ is always defined by the compiler.
#if __SIZEOF_POINTER__ == 8
struct OpaqueAllocator {
	uint64_t __opaque[28];
};
#else
struct OpaqueAllocator {
	uint64_t __opaque[17];
};
#endif


using pool_t = OpaquePool;
using allocator_t = OpaqueAllocator;

template <typename T>
constexpr T *allocate() {
	if (__builtin_is_constant_evaluated()) {
		return std::allocator<T>().allocate(1);
	} else {
		if constexpr (alignof(T) <= alignof(__sprt_max_align_t)) {
			return reinterpret_cast<T *>(__sprt_malloc(sizeof(T)));
		} else {
			return reinterpret_cast<T *>(__sprt_aligned_alloc(alignof(T), sizeof(T)));
		}
	}
}

template <typename T>
constexpr T *allocate(size_t n) {
	if (__builtin_is_constant_evaluated()) {
		return std::allocator<T>().allocate(n);
	} else {
		if constexpr (alignof(T) <= alignof(__sprt_max_align_t)) {
			return reinterpret_cast<T *>(__sprt_malloc(sizeof(T) * n));
		} else {
			return reinterpret_cast<T *>(__sprt_aligned_alloc(alignof(T), sizeof(T) * n));
		}
	}
}

template <typename T>
constexpr void deallocate(T *t) {
	if (__builtin_is_constant_evaluated()) {
		return std::allocator<T>().deallocate(t, 1);
	} else {
		if constexpr (alignof(T) <= alignof(__sprt_max_align_t)) {
			__sprt_free(t);
		} else {
			__sprt_aligned_free(t);
		}
	}
}

template <typename T>
constexpr void deallocate(T *t, size_t n, size_t nbytes = 0) {
	if (__builtin_is_constant_evaluated()) {
		return std::allocator<T>().deallocate(t, n);
	} else {
		if constexpr (alignof(T) <= alignof(__sprt_max_align_t)) {
			if (nbytes > alignof(__sprt_max_align_t)) {
				__sprt_free_sized(t, nbytes);
			} else {
				__sprt_free(t);
			}
		} else {
			if (nbytes > alignof(__sprt_max_align_t)) {
				__sprt_free_aligned_sized(t, alignof(T), nbytes);
			} else {
				__sprt_aligned_free(t);
			}
		}
	}
}

template <typename T>
constexpr T *local_allocate() {
	static_assert(alignof(T) <= alignof(__sprt_max_align_t),
			"Only default alignment supported by local_alloc");
	return reinterpret_cast<T *>(__sprt_local_alloc(sizeof(T)));
}

template <typename T>
constexpr T *local_allocate(size_t n) {
	static_assert(alignof(T) <= alignof(__sprt_max_align_t),
			"Only default alignment supported by local_alloc");
	return reinterpret_cast<T *>(__sprt_local_alloc(sizeof(T) * n));
}

template <typename T>
constexpr void local_deallocate(T *t) {
	__sprt_local_free(t, sizeof(T));
}

template <typename T>
constexpr void local_deallocate(T *t, size_t n, size_t nbytes = 0) {
	if (nbytes > alignof(__sprt_max_align_t)) {
		__sprt_local_free(t, nbytes);
	} else {
		__sprt_local_free(t, n * sizeof(T));
	}
}

