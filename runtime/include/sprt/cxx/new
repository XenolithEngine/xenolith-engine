// On Windows and Wasm sprt fully owns the default operators (implemented over
// mimalloc in libc_impl/builtin_libcxx.cpp), so direct new/delete is safe there
// and needs no deprecation nudge.
#if SPRT_WINDOWS || SPRT_WASM
#define __SPRT_DISALLOW_NEW
#define __SPRT_DISALLOW_DELETE
#else
#define __SPRT_DISALLOW_NEW \
	[[deprecated("It's unsafe to use direct new within freestanding code, use, new (sprt::nothrow)")]]

#define __SPRT_DISALLOW_DELETE \
	[[deprecated("It's unsafe to use direct delete within freestanding code, use, sprt::__delete()")]]
#endif
#if __SPRT_USE_STL == 0

[[nodiscard]]
__SPRT_DISALLOW_NEW void *operator new(sprt::size_t);

[[nodiscard]]
__SPRT_DISALLOW_NEW void *operator new[](sprt::size_t);

__SPRT_DISALLOW_DELETE
void operator delete(void *) noexcept;

__SPRT_DISALLOW_DELETE
void operator delete[](void *) noexcept;

__SPRT_DISALLOW_DELETE
void operator delete(void *, sprt::size_t) noexcept;

__SPRT_DISALLOW_DELETE
void operator delete[](void *, sprt::size_t) noexcept;

[[nodiscard]]
inline void *operator new(sprt::size_t, void *__p) noexcept {
	return __p;
}
[[nodiscard]]
inline void *operator new[](sprt::size_t, void *__p) noexcept {
	return __p;
}
inline void operator delete(void *, void *) noexcept { }
inline void operator delete[](void *, void *) noexcept { }
#endif

namespace sprt {

// [new.delete]: on failure every allocation function keeps retrying while a
// new_handler is installed (the handler may free memory or deinstall itself).
inline void *__new_with_handler(sprt::size_t size, sprt::size_t al) noexcept {
	for (;;) {
		void *p = (al <= alignof(__sprt_max_align_t)) ? __sprt_malloc(size)
													  : __sprt_aligned_alloc(al, size);
		if (p) {
			return p;
		}
		std::new_handler nh = std::get_new_handler();
		if (!nh) {
			return nullptr;
		}
		nh();
	}
}

} // namespace sprt

// The full replaceable operator set (throwing, nothrow, sized and over-aligned
// forms) is only DECLARED here and DEFINED out-of-line, exactly once, in the
// runtime: over mimalloc's typed mi_new / mi_free family in
// libc_impl/builtin_libcxx.cpp on Windows/Wasm, and over the __sprt_ allocator
// wrappers in libc_wrapper/cxx/SPRTCxxNewDelete.cpp elsewhere. Keeping them
// non-inline is deliberate — an inline replaceable operator is weak COMDAT and
// cannot reliably override the platform C++ library's own (weak) operators, so a
// single strong definition in the runtime is what routes every new/delete through
// it in the static-, shared- and mixed-library deployments.
// These global replaceable operators have the standard signatures, so under
// __SPRT_USE_STL libc++'s <new> already declares them (backed by the same runtime
// definitions). Declaring sprt's here too made `new (sprt::nothrow)` ambiguous
// (sprt::nothrow_t == std::nothrow_t). Gate them off in USE_STL, exactly like the
// plain operator new/delete above.
#if __SPRT_USE_STL == 0
[[nodiscard]]
void *operator new(sprt::size_t, const sprt::nothrow_t &) noexcept;
[[nodiscard]]
void *operator new[](sprt::size_t, const sprt::nothrow_t &) noexcept;
[[nodiscard]]
void *operator new(sprt::size_t, sprt::align_val_t, const sprt::nothrow_t &) noexcept;
[[nodiscard]]
void *operator new[](sprt::size_t, sprt::align_val_t, const sprt::nothrow_t &) noexcept;

void operator delete(void *, sprt::align_val_t) noexcept;
void operator delete[](void *, sprt::align_val_t) noexcept;
void operator delete(void *, sprt::size_t, sprt::align_val_t) noexcept;
void operator delete[](void *, sprt::size_t, sprt::align_val_t) noexcept;
void operator delete(void *, sprt::align_val_t, const sprt::nothrow_t &) noexcept;
void operator delete[](void *, sprt::align_val_t, const sprt::nothrow_t &) noexcept;
#endif // __SPRT_USE_STL == 0

[[nodiscard]]
inline constexpr void *operator new(sprt::size_t size, void *ptr, sprt::nothrow_t) noexcept {
	return ptr;
}

[[nodiscard]]
inline constexpr void *operator new[](sprt::size_t size, void *ptr, sprt::nothrow_t) noexcept {
	return ptr;
}

namespace sprt {

struct SPRT_API AllocPlacement {
	static constexpr void *operator new(size_t size, void *ptr) noexcept { return ptr; }
	static constexpr void *operator new[](size_t size, void *ptr) noexcept { return ptr; }

	static constexpr void operator delete(void *, void *) noexcept { }
	static constexpr void operator delete[](void *, void *) noexcept { }
};

struct SPRT_API AllocBase : public AllocPlacement {
	using AllocPlacement::operator new;
	using AllocPlacement::operator new[];
	using AllocPlacement::operator delete;
	using AllocPlacement::operator delete[];

	static void *operator new(size_t size) { return __sprt_malloc(size); }
	static void *operator new[](size_t size) { return __sprt_malloc(size); }

	static void *operator new(size_t size, const sprt::nothrow_t &tag) noexcept {
		return __sprt_malloc(size);
	}

	static void *operator new[](size_t size, const sprt::nothrow_t &tag) noexcept {
		return __sprt_malloc(size);
	}

	static void *operator new(size_t size, sprt::align_val_t al,
			const sprt::nothrow_t &tag) noexcept {
		if (sprt::to_underlying(al) <= alignof(__sprt_max_align_t)) {
			return __sprt_malloc(size);
		} else {
			return __sprt_aligned_alloc(sprt::to_underlying(al), size);
		}
	}

	static void *operator new[](size_t size, sprt::align_val_t al,
			const sprt::nothrow_t &tag) noexcept {
		if (sprt::to_underlying(al) <= alignof(__sprt_max_align_t)) {
			return __sprt_malloc(size);
		} else {
			return __sprt_aligned_alloc(sprt::to_underlying(al), size);
		}
	}

	// Allocation from pool is forbidden for common classes
	static void *operator new(size_t size, memory::pool_t *ptr) noexcept = delete;
	static void *operator new[](size_t size, memory::pool_t *ptr) noexcept = delete;

	static void operator delete(void *ptr) noexcept {
		__sprt_free(ptr); //
	}
	static void operator delete[](void *ptr) noexcept {
		__sprt_free(ptr); //
	}

	static void operator delete(void *ptr, sprt::align_val_t al) noexcept {
		if (sprt::to_underlying(al) <= alignof(__sprt_max_align_t)) {
			__sprt_free(ptr);
		} else {
			__sprt_aligned_free(ptr);
		}
	}
	static void operator delete[](void *ptr, sprt::align_val_t al) noexcept {
		if (sprt::to_underlying(al) <= alignof(__sprt_max_align_t)) {
			__sprt_free(ptr);
		} else {
			__sprt_aligned_free(ptr);
		}
	}

	static constexpr void *operator new(sprt::size_t size, void *ptr, sprt::nothrow_t) noexcept {
		return ptr;
	}

	static constexpr void *operator new[](sprt::size_t size, void *ptr, sprt::nothrow_t) noexcept {
		return ptr;
	}

	constexpr void operator delete(void *, void *) noexcept { }
	constexpr void operator delete[](void *, void *) noexcept { }
};

