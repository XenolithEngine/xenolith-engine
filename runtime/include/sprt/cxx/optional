#define RUNTIME_INCLUDE_SPRT_CXX_OPTIONAL_H_

#include <sprt/cxx/detail/__stl_value_provider.h>

#if __SPRT_STL_LIBCXX_VALUETYPES
// Project libc++'s <optional> into namespace sprt (sprt::optional IS std::optional): a
// single value-type implementation shared with the vendored libc++ pair/tuple/variant/any,
// so there is no dual-namespace divergence between a hand-written sprt::optional and the
// libc++ std::optional the hosted `<optional>` entry already provides.
#include <libcxx/__sprt_compat.h>
#include <libcxx/optional>

namespace sprt {
using std::bad_optional_access;
using std::make_optional;
using std::nullopt;
using std::nullopt_t;
using std::optional;
} // namespace sprt

#else // hosted sprt build: hand-written <optional>

// Standard-conforming <optional>, ported from LLVM libc++'s <optional>
// (runtime/toolchains/src/llvm-project/libcxx/include/optional) into namespace
// sprt and adapted to this freestanding runtime:
//
//  * The class is built from the same layered base classes as libc++
//    (__optional_destruct_base -> __optional_storage_base -> __optional_copy_base
//    -> __optional_move_base -> __optional_copy_assign_base ->
//    __optional_move_assign_base) so that the special members of optional<T>
//    propagate the triviality of T:  is_trivially_copyable_v<optional<int>>,
//    is_trivially_destructible_v<optional<int>>, etc. are all true, and a
//    moved-from optional stays engaged (only the contained value is moved).
//
//  * The runtime is compiled -fno-exceptions, so every member is noexcept: T's
//    operations cannot throw, hence there is no exceptional path to propagate
//    and no exception guard / rollback is required (cf. the original
//    single-class implementation this replaces). value() on a disengaged
//    optional therefore cannot throw bad_optional_access; instead it routes
//    through __throw_bad_optional_access(), which performs a defined abort.
//
//  * The libc++ "throwing access" point of std::optional is value(). The
//    repository's no-exceptions answer to throwing element access (see
//    sprt::detail::access_token used by map/unordered_map::at(), which returns
//    a proxy with get()/get(alt)/ptr()/unwrap(cb)/operator bool instead of
//    throwing out_of_range) is, for optional, simply the standard's own
//    non-throwing surface: value_or(), the C++23 monadic and_then()/transform()
//    /or_else(), operator->/has_value(), and the range begin()/end(). All of
//    those are provided here, so there is no need to bolt an extra proxy onto
//    optional: value() keeps its standard signature and aborts on misuse, while
//    the access_token-style no-throw access is the monadic interface.

#include <sprt/cxx/compare>
#include <sprt/cxx/initializer_list>
#include <sprt/cxx/new>
#include <sprt/cxx/type_traits>
#include <sprt/cxx/__utility/common.h>
#include <sprt/cxx/__utility/in_place.h>
#include <sprt/cxx/__memory/common.h>
#include <sprt/cxx/__functional/invoke.h>
#include <sprt/cxx/detail/sfinae_helpers.h>

namespace sprt {

// [optional.bad.access], class bad_optional_access
//
// This runtime has no exception hierarchy; bad_optional_access is provided for
// API completeness only (it is never thrown). value() on a disengaged optional
// calls __throw_bad_optional_access() below, which aborts.
class bad_optional_access {
public:
	bad_optional_access() noexcept = default;
	bad_optional_access(const bad_optional_access &) noexcept = default;
	bad_optional_access &operator=(const bad_optional_access &) noexcept = default;
	~bad_optional_access() = default;

	const char *what() const noexcept { return "bad_optional_access"; }
};

[[noreturn]]
inline void __throw_bad_optional_access() noexcept {
	// -fno-exceptions: mirror libc++'s _LIBCPP_VERBOSE_ABORT strategy and turn
	// the would-be `throw bad_optional_access()` into a defined abort.
	__builtin_abort();
}

// [optional.nullopt], no-value state indicator. The constructor takes a private
// tag so that `nullopt_t` is NOT constructible from `{}` — otherwise `opt = {}`
// would be ambiguous between `operator=(nullopt_t)` and the copy/move assignment
// (both viable for an empty braced-init). This mirrors the standard requirement
// that nullopt_t be a non-aggregate, non-default-constructible type.
struct nullopt_t {
	enum class _Construct {
		_Token
	};
	explicit constexpr nullopt_t(_Construct) noexcept { }
};

inline constexpr nullopt_t nullopt{nullopt_t::_Construct::_Token};

template <typename _Tp>
class optional;

template <typename _Tp>
struct __is_optional : false_type { };

template <typename _Tp>
struct __is_optional<optional<_Tp>> : true_type { };

template <typename _Tp>
inline constexpr bool __is_optional_v = __is_optional<_Tp>::value;

// Tag used by the C++23 monadic transform()/and_then() machinery to construct
// the contained value in place from invoke(f, args...).
struct __optional_construct_from_invoke_tag { };

// __check_tuple_constructor_fail and __sfinae_ctor_base / __sfinae_assign_base
// are shared with variant; see <sprt/cxx/detail/sfinae_helpers.h>.

// [optional.optional] storage layering ---------------------------------------

template <typename _Tp, bool = is_trivially_destructible<_Tp>::value>
struct __optional_destruct_base;

template <typename _Tp>
struct __optional_destruct_base<_Tp, false> {
	typedef _Tp value_type;
	static_assert(is_object_v<value_type>,
			"instantiation of optional with a non-object type is undefined behavior");
	union {
		char __null_state_;
		remove_cv_t<value_type> __val_;
	};
	bool __engaged_;

	constexpr ~__optional_destruct_base() {
		if (__engaged_) {
			__val_.~value_type();
		}
	}

	constexpr __optional_destruct_base() noexcept : __null_state_(), __engaged_(false) { }

	template <typename... _Args>
	constexpr explicit __optional_destruct_base(in_place_t, _Args &&...__args)
	: __val_(sprt::forward<_Args>(__args)...), __engaged_(true) { }

	template <typename _Fp, typename... _Args>
	constexpr explicit __optional_destruct_base(__optional_construct_from_invoke_tag, _Fp &&__f,
			_Args &&...__args)
	: __val_(sprt::__invoke(sprt::forward<_Fp>(__f), sprt::forward<_Args>(__args)...))
	, __engaged_(true) { }

	constexpr void reset() noexcept {
		if (__engaged_) {
			__val_.~value_type();
			__engaged_ = false;
		}
	}
};

template <typename _Tp>
struct __optional_destruct_base<_Tp, true> {
	typedef _Tp value_type;
	static_assert(is_object_v<value_type>,
			"instantiation of optional with a non-object type is undefined behavior");
	union {
		char __null_state_;
		remove_cv_t<value_type> __val_;
	};
	bool __engaged_;

	constexpr __optional_destruct_base() noexcept : __null_state_(), __engaged_(false) { }

	template <typename... _Args>
	constexpr explicit __optional_destruct_base(in_place_t, _Args &&...__args)
	: __val_(sprt::forward<_Args>(__args)...), __engaged_(true) { }

	template <typename _Fp, typename... _Args>
	constexpr __optional_destruct_base(__optional_construct_from_invoke_tag, _Fp &&__f,
			_Args &&...__args)
	: __val_(sprt::__invoke(sprt::forward<_Fp>(__f), sprt::forward<_Args>(__args)...))
	, __engaged_(true) { }

	constexpr void reset() noexcept {
		if (__engaged_) {
			__engaged_ = false;
		}
	}
};

template <typename _Tp>
struct __optional_storage_base : __optional_destruct_base<_Tp> {
	using __base = __optional_destruct_base<_Tp>;
	using value_type = _Tp;
	using __base::__base;

	constexpr bool has_value() const noexcept { return this->__engaged_; }

	constexpr value_type &__get() & noexcept { return this->__val_; }
	constexpr const value_type &__get() const & noexcept { return this->__val_; }
	constexpr value_type &&__get() && noexcept { return sprt::move_unsafe(this->__val_); }
	constexpr const value_type &&__get() const && noexcept {
		return sprt::move_unsafe(this->__val_);
	}

	template <typename... _Args>
	constexpr void __construct(_Args &&...__args) noexcept {
		// precondition: !has_value()
		sprt::construct_at(sprt::addressof(this->__val_), sprt::forward<_Args>(__args)...);
		this->__engaged_ = true;
	}

	template <typename _That>
	constexpr void __construct_from(_That &&__opt) noexcept {
		if (__opt.has_value()) {
			__construct(sprt::forward<_That>(__opt).__get());
		}
	}

	template <typename _That>
	constexpr void __assign_from(_That &&__opt) noexcept {
		if (this->__engaged_ == __opt.has_value()) {
			if (this->__engaged_) {
				static_cast<_Tp &>(this->__val_) = sprt::forward<_That>(__opt).__get();
			}
		} else {
			if (this->__engaged_) {
				this->reset();
			} else {
				__construct(sprt::forward<_That>(__opt).__get());
			}
		}
	}
};

template <typename _Tp, bool = is_trivially_copy_constructible<_Tp>::value>
struct __optional_copy_base : __optional_storage_base<_Tp> {
	using __optional_storage_base<_Tp>::__optional_storage_base;
};

template <typename _Tp>
struct __optional_copy_base<_Tp, false> : __optional_storage_base<_Tp> {
	using __optional_storage_base<_Tp>::__optional_storage_base;

	__optional_copy_base() = default;

	constexpr __optional_copy_base(const __optional_copy_base &__opt) noexcept {
		this->__construct_from(__opt);
	}

	__optional_copy_base(__optional_copy_base &&) = default;
	__optional_copy_base &operator=(const __optional_copy_base &) = default;
	__optional_copy_base &operator=(__optional_copy_base &&) = default;
};

template <typename _Tp, bool = is_trivially_move_constructible<_Tp>::value>
struct __optional_move_base : __optional_copy_base<_Tp> {
	using __optional_copy_base<_Tp>::__optional_copy_base;
};

template <typename _Tp>
struct __optional_move_base<_Tp, false> : __optional_copy_base<_Tp> {
	using value_type = _Tp;
	using __optional_copy_base<_Tp>::__optional_copy_base;

	__optional_move_base() = default;
	__optional_move_base(const __optional_move_base &) = default;

	constexpr __optional_move_base(__optional_move_base &&__opt) noexcept {
		this->__construct_from(sprt::move(__opt));
	}

	__optional_move_base &operator=(const __optional_move_base &) = default;
	__optional_move_base &operator=(__optional_move_base &&) = default;
};

template <typename _Tp,
		bool = is_trivially_destructible<_Tp>::value && is_trivially_copy_constructible<_Tp>::value
				&& is_trivially_copy_assignable<_Tp>::value>
struct __optional_copy_assign_base : __optional_move_base<_Tp> {
	using __optional_move_base<_Tp>::__optional_move_base;
};

template <typename _Tp>
struct __optional_copy_assign_base<_Tp, false> : __optional_move_base<_Tp> {
	using __optional_move_base<_Tp>::__optional_move_base;

	__optional_copy_assign_base() = default;
	__optional_copy_assign_base(const __optional_copy_assign_base &) = default;
	__optional_copy_assign_base(__optional_copy_assign_base &&) = default;

	constexpr __optional_copy_assign_base &operator=(
			const __optional_copy_assign_base &__opt) noexcept {
		this->__assign_from(__opt);
		return *this;
	}

	__optional_copy_assign_base &operator=(__optional_copy_assign_base &&) = default;
};

template <typename _Tp,
		bool = is_trivially_destructible<_Tp>::value && is_trivially_move_constructible<_Tp>::value
				&& is_trivially_move_assignable<_Tp>::value>
struct __optional_move_assign_base : __optional_copy_assign_base<_Tp> {
	using __optional_copy_assign_base<_Tp>::__optional_copy_assign_base;
};

template <typename _Tp>
struct __optional_move_assign_base<_Tp, false> : __optional_copy_assign_base<_Tp> {
	using value_type = _Tp;
	using __optional_copy_assign_base<_Tp>::__optional_copy_assign_base;

	__optional_move_assign_base() = default;
	__optional_move_assign_base(const __optional_move_assign_base &) = default;
	__optional_move_assign_base(__optional_move_assign_base &&) = default;
	__optional_move_assign_base &operator=(const __optional_move_assign_base &) = default;

	constexpr __optional_move_assign_base &operator=(__optional_move_assign_base &&__opt) noexcept {
		this->__assign_from(sprt::move(__opt));
		return *this;
	}
};

template <typename _Tp>
using __optional_sfinae_ctor_base_t =
		__sfinae_ctor_base<is_copy_constructible<_Tp>::value, is_move_constructible<_Tp>::value>;

template <typename _Tp>
using __optional_sfinae_assign_base_t =
		__sfinae_assign_base< (is_copy_constructible<_Tp>::value && is_copy_assignable<_Tp>::value),
				(is_move_constructible<_Tp>::value && is_move_assignable<_Tp>::value)>;

// [optional.optional], class template optional -------------------------------

template <typename _Tp>
class __SPRT_EMPTY_BASES optional : private __optional_move_assign_base<_Tp>,
									private __optional_sfinae_ctor_base_t<_Tp>,
									private __optional_sfinae_assign_base_t<_Tp> {
	using __base = __optional_move_assign_base<_Tp>;

public:
	using value_type = _Tp;
	using iterator = _Tp *;
	using const_iterator = const _Tp *;

private:
	// Disable the reference extension using these static asserts.
	static_assert(!is_same_v<remove_cvref_t<value_type>, in_place_t>,
			"instantiation of optional with in_place_t is ill-formed");
	static_assert(!is_same_v<remove_cvref_t<value_type>, nullopt_t>,
			"instantiation of optional with nullopt_t is ill-formed");
	static_assert(!is_reference_v<value_type>,
			"instantiation of optional with a reference type is ill-formed");
	static_assert(is_destructible_v<value_type>,
			"instantiation of optional with a non-destructible type is ill-formed");
	static_assert(!is_array_v<value_type>,
			"instantiation of optional with an array type is ill-formed");

	// LWG2756: conditionally explicit conversion from _Up
	struct _CheckOptionalArgsConstructor {
		template <typename _Up>
		static constexpr bool __enable_implicit() {
			return is_constructible_v<_Tp, _Up &&> && is_convertible_v<_Up &&, _Tp>;
		}
		template <typename _Up>
		static constexpr bool __enable_explicit() {
			return is_constructible_v<_Tp, _Up &&> && !is_convertible_v<_Up &&, _Tp>;
		}
	};
	template <typename _Up>
	using _CheckOptionalArgsCtor = _If< !is_same_v<remove_cvref_t<_Up>, in_place_t>
					&& !is_same_v<remove_cvref_t<_Up>, optional>
					&& (!is_same_v<remove_cv_t<_Tp>, bool>
							|| !__is_optional_v<remove_cvref_t<_Up>>),
			_CheckOptionalArgsConstructor, __check_tuple_constructor_fail>;

	template <typename _QualUp>
	struct _CheckOptionalLikeConstructor {
		template <typename _Up, typename _Opt = optional<_Up>>
		static constexpr bool __check_constructible_from_opt() {
			return is_constructible_v<_Tp, _Opt &> || is_constructible_v<_Tp, const _Opt &>
					|| is_constructible_v<_Tp, _Opt &&> || is_constructible_v<_Tp, const _Opt &&>
					|| is_convertible_v<_Opt &, _Tp> || is_convertible_v<const _Opt &, _Tp>
					|| is_convertible_v<_Opt &&, _Tp> || is_convertible_v<const _Opt &&, _Tp>;
		}
		template <typename _Up, typename _Opt = optional<_Up>>
		static constexpr bool __check_assignable_from_opt() {
			return is_assignable_v<_Tp &, _Opt &> || is_assignable_v<_Tp &, const _Opt &>
					|| is_assignable_v<_Tp &, _Opt &&> || is_assignable_v<_Tp &, const _Opt &&>;
		}
		template <typename _Up, typename _QUp = _QualUp>
		static constexpr bool __enable_implicit() {
			return is_convertible_v<_QUp, _Tp>
					&& (is_same_v<remove_cv_t<_Tp>, bool>
							|| !__check_constructible_from_opt<_Up>());
		}
		template <typename _Up, typename _QUp = _QualUp>
		static constexpr bool __enable_explicit() {
			return !is_convertible_v<_QUp, _Tp>
					&& (is_same_v<remove_cv_t<_Tp>, bool>
							|| !__check_constructible_from_opt<_Up>());
		}
		template <typename _Up, typename _QUp = _QualUp>
		static constexpr bool __enable_assign() {
			// Construction / assignability of _QUp to _Tp is checked by the caller.
			return !__check_constructible_from_opt<_Up>() && !__check_assignable_from_opt<_Up>();
		}
	};

	template <typename _Up, typename _QualUp>
	using _CheckOptionalLikeCtor = _If<(!is_same_v<_Up, _Tp> && is_constructible_v<_Tp, _QualUp>),
			_CheckOptionalLikeConstructor<_QualUp>, __check_tuple_constructor_fail>;
	template <typename _Up, typename _QualUp>
	using _CheckOptionalLikeAssign = _If< (!is_same_v<_Up, _Tp> && is_constructible_v<_Tp, _QualUp>
												  && is_assignable_v<_Tp &, _QualUp>),
			_CheckOptionalLikeConstructor<_QualUp>, __check_tuple_constructor_fail>;

public:
	// [optional.ctor], constructors
	constexpr optional() noexcept { }
	constexpr optional(const optional &) = default;
	constexpr optional(optional &&) = default;
	constexpr optional(nullopt_t) noexcept { }

	template <typename _InPlaceT, typename... _Args,
			enable_if_t<is_same_v<_InPlaceT, in_place_t>
							&& is_constructible_v<value_type, _Args...>,
					int> = 0>
	constexpr explicit optional(_InPlaceT, _Args &&...__args) noexcept
	: __base(in_place, sprt::forward<_Args>(__args)...) { }

	template <typename _Up, typename... _Args,
			enable_if_t<is_constructible_v<value_type, initializer_list<_Up> &, _Args...>, int> = 0>
	constexpr explicit optional(in_place_t, initializer_list<_Up> __il, _Args &&...__args) noexcept
	: __base(in_place, __il, sprt::forward<_Args>(__args)...) { }

	template <typename _Up = value_type,
			enable_if_t<_CheckOptionalArgsCtor<_Up>::template __enable_implicit<_Up>(), int> = 0>
	constexpr optional(_Up &&__v) noexcept : __base(in_place, sprt::forward<_Up>(__v)) { }

	template <typename _Up,
			enable_if_t<_CheckOptionalArgsCtor<_Up>::template __enable_explicit<_Up>(), int> = 0>
	constexpr explicit optional(_Up &&__v) noexcept : __base(in_place, sprt::forward<_Up>(__v)) { }

	// LWG2756: conditionally explicit conversion from const optional<_Up> &
	template <typename _Up,
			enable_if_t<
					_CheckOptionalLikeCtor<_Up, const _Up &>::template __enable_implicit<_Up>(),
					int> = 0>
	constexpr optional(const optional<_Up> &__v) noexcept {
		this->__construct_from(__v);
	}
	template <typename _Up,
			enable_if_t<
					_CheckOptionalLikeCtor<_Up, const _Up &>::template __enable_explicit<_Up>(),
					int> = 0>
	constexpr explicit optional(const optional<_Up> &__v) noexcept {
		this->__construct_from(__v);
	}

	// LWG2756: conditionally explicit conversion from optional<_Up> &&
	template <typename _Up,
			enable_if_t<_CheckOptionalLikeCtor<_Up, _Up &&>::template __enable_implicit<_Up>(),
					int> = 0>
	constexpr optional(optional<_Up> &&__v) noexcept {
		this->__construct_from(sprt::move(__v));
	}
	template <typename _Up,
			enable_if_t<_CheckOptionalLikeCtor<_Up, _Up &&>::template __enable_explicit<_Up>(),
					int> = 0>
	constexpr explicit optional(optional<_Up> &&__v) noexcept {
		this->__construct_from(sprt::move(__v));
	}

	template <typename _Tag, typename _Fp, typename... _Args,
			enable_if_t<is_same_v<_Tag, __optional_construct_from_invoke_tag>, int> = 0>
	constexpr explicit optional(_Tag, _Fp &&__f, _Args &&...__args) noexcept
	: __base(__optional_construct_from_invoke_tag{}, sprt::forward<_Fp>(__f),
			  sprt::forward<_Args>(__args)...) { }

	// [optional.assign], assignment
	constexpr optional &operator=(nullopt_t) noexcept {
		reset();
		return *this;
	}

	constexpr optional &operator=(const optional &) = default;
	constexpr optional &operator=(optional &&) = default;

	// LWG2756
	template <typename _Up = value_type,
			enable_if_t<!is_same_v<remove_cvref_t<_Up>, optional>
							&& (!is_same_v<remove_cvref_t<_Up>, value_type>
									|| !__is_scalar(value_type))
							&& is_constructible_v<value_type, _Up>
							&& is_assignable_v<value_type &, _Up>,
					int> = 0>
	constexpr optional &operator=(_Up &&__v) noexcept {
		if (this->has_value()) {
			this->__get() = sprt::forward<_Up>(__v);
		} else {
			this->__construct(sprt::forward<_Up>(__v));
		}
		return *this;
	}

	// LWG2756
	template <typename _Up,
			enable_if_t<
					_CheckOptionalLikeAssign<_Up, const _Up &>::template __enable_assign<_Up>(),
					int> = 0>
	constexpr optional &operator=(const optional<_Up> &__v) noexcept {
		this->__assign_from(__v);
		return *this;
	}

	// LWG2756
	template <typename _Up,
			enable_if_t<_CheckOptionalLikeCtor<_Up, _Up &&>::template __enable_assign<_Up>(), int> =
					0>
	constexpr optional &operator=(optional<_Up> &&__v) noexcept {
		this->__assign_from(sprt::move(__v));
		return *this;
	}

	template <typename... _Args, enable_if_t<is_constructible_v<value_type, _Args...>, int> = 0>
	constexpr _Tp &emplace(_Args &&...__args) noexcept {
		reset();
		this->__construct(sprt::forward<_Args>(__args)...);
		return this->__get();
	}

	template <typename _Up, typename... _Args,
			enable_if_t<is_constructible_v<value_type, initializer_list<_Up> &, _Args...>, int> = 0>
	constexpr _Tp &emplace(initializer_list<_Up> __il, _Args &&...__args) noexcept {
		reset();
		this->__construct(__il, sprt::forward<_Args>(__args)...);
		return this->__get();
	}

	// [optional.swap], swap
	constexpr void swap(optional &__opt) noexcept {
		if (this->has_value() == __opt.has_value()) {
			using sprt::swap;
			if (this->has_value()) {
				swap(this->__get(), __opt.__get());
			}
		} else {
			if (this->has_value()) {
				__opt.__construct(sprt::move_unsafe(this->__get()));
				reset();
			} else {
				this->__construct(sprt::move(__opt.__get()));
				__opt.reset();
			}
		}
	}

	// [optional.iterators], iterator support (C++23 ranges)
	constexpr iterator begin() noexcept {
		return has_value() ? sprt::addressof(this->__get()) : nullptr;
	}
	constexpr const_iterator begin() const noexcept {
		return has_value() ? sprt::addressof(this->__get()) : nullptr;
	}
	constexpr iterator end() noexcept {
		return has_value() ? sprt::addressof(this->__get()) + 1 : nullptr;
	}
	constexpr const_iterator end() const noexcept {
		return has_value() ? sprt::addressof(this->__get()) + 1 : nullptr;
	}

	// [optional.observe], observers
	constexpr const value_type *operator->() const noexcept {
		return sprt::addressof(this->__get());
	}
	constexpr value_type *operator->() noexcept { return sprt::addressof(this->__get()); }

	constexpr const value_type &operator*() const & noexcept { return this->__get(); }
