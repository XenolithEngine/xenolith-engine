#ifndef RUNTIME_INCLUDE_SPRT_CXX_UNORDERED_MAP_H_
#define RUNTIME_INCLUDE_SPRT_CXX_UNORDERED_MAP_H_

#include <sprt/cxx/initializer_list>
#include <sprt/cxx/__algorithm/bounds.h>
#include <sprt/cxx/__functional/compare.h>
#include <sprt/cxx/__utility/pair.h>
#include <sprt/cxx/__memory/allocator_traits.h>

#include <sprt/cxx/detail/hash_memory.h>
#include <sprt/cxx/detail/access_token.h>
#include <sprt/cxx/detail/allocator_pool.h>
#include <sprt/cxx/detail/allocator_malloc.h>
#include <sprt/cxx/detail/allocator_std.h>

namespace sprt {

// Heterogeneous lookup is enabled only when BOTH the hasher and the predicate are transparent
// ([unord.req]); otherwise the plain find(const key_type&) overload (one boundary conversion) applies.
template <typename ExternalKey, typename Map>
concept __unordered_map_compatible_key =
		requires(const typename Map::key_type &k, const ExternalKey &ek) {
			typename Map::hasher::is_transparent;
			typename Map::key_equal::is_transparent;
			typename Map::key_equal()(k, ek);
			typename Map::hasher()(ek);
		};

// `Stl` selects the std::unordered_map-conforming backing: when true the flat hash array stores
// individually heap-allocated nodes (indirect_storage), so element addresses are STABLE across
// rehash and unrelated erase — the reference/pointer-stability guarantee the standard requires.
// When false (the default, used by sprt's own __pool_/__malloc_ maps) the value lives inline in the
// array (faster, but rehash/erase relocate elements). The std wrapper derives with Stl = true.
template <typename Key, typename Value, typename Hash, typename Pred, typename Allocator,
		bool Stl = false>
class __unordered_map : public detail::__allocator_base_t<Allocator> {
public:
	using key_type = Key;
	using mapped_type = Value;
	using value_type = pair<const Key, Value>;

	// The storage machinery runs on the extended sprt allocator protocol; a purely standard
	// allocator (std::allocator, min_allocator, test_allocator, ...) is wrapped into
	// detail::AllocatorStd (see allocator_std.h), while allocator_type / get_allocator() keep
	// exposing the user's own allocator.
	using container_type = detail::hash_memory<key_type, value_type, Hash, Pred,
			detail::__select_sprt_allocator<Allocator>, Stl>;

	// types
	using hasher = Hash;
	using key_equal = Pred;
	using allocator_type = Allocator;
	using pointer = typename allocator_traits<Allocator>::pointer;
	using const_pointer = typename allocator_traits<Allocator>::const_pointer;
	using reference = value_type &;
	using const_reference = const value_type &;
	using size_type = size_t;
	using difference_type = ptrdiff_t;

	using iterator = container_type::iterator;
	using const_iterator = container_type::const_iterator;
	using local_iterator = container_type::local_iterator;
	using const_local_iterator = container_type::const_local_iterator;
	using node_type = container_type::node_type;

	// [unord.req] noexcept specifications, computed from the user allocator/hasher/predicate traits.
	using __atraits = allocator_traits<allocator_type>;
	static constexpr bool __nothrow_swap_v = __atraits::is_always_equal::value
			&& is_nothrow_swappable_v<hasher> && is_nothrow_swappable_v<key_equal>;
	static constexpr bool __nothrow_move_v = is_nothrow_move_constructible_v<hasher>
			&& is_nothrow_move_constructible_v<key_equal>
			&& is_nothrow_move_constructible_v<allocator_type>;
	static constexpr bool __nothrow_move_assign_v =
			(__atraits::propagate_on_container_move_assignment::value
					|| __atraits::is_always_equal::value)
			&& is_nothrow_move_assignable_v<hasher> && is_nothrow_move_assignable_v<key_equal>;

	template <typename AccessType = key_type>
	using access_token = detail::access_token<__unordered_map, AccessType>;

	template <typename AccessType = key_type>
	using const_access_token = detail::const_access_token<__unordered_map, AccessType>;

	~__unordered_map() { }

	__unordered_map() : _container(0, hasher(), key_equal(), allocator_type()) { }

	explicit __unordered_map(size_type n, const hasher &hf = hasher(),
			const key_equal &eql = key_equal(), const allocator_type &a = allocator_type()) noexcept
	: _container(n, hf, eql, a) { }

	template <typename InputIter,
			enable_if_t<__has_input_iterator_category<InputIter>::value, int> = 0>
	__unordered_map(InputIter f, InputIter l, size_type n = 0, const hasher &hf = hasher(),
			const key_equal &eql = key_equal(), const allocator_type &a = allocator_type()) noexcept
	: _container(n, hf, eql, a) {
		// Decompose each element into (key, mapped) and construct in place, so a source range of a
		// foreign pair type (e.g. pair<int, X> for a pair<const int, X> map, incl. a move-only key)
		// is inserted without materializing and moving a value_type.
		while (f != l) {
			_container.try_emplace((*f).first, (*f).second);
			++f;
		}
	}

	__unordered_map(const __unordered_map &other) noexcept
	: __unordered_map(0, other.hash_function(), other.key_eq(),
			  sprt::allocator_traits<allocator_type>::select_on_container_copy_construction(
					  other.get_allocator())) {
		_container.max_load_factor(other.max_load_factor());
		_container.copy_from(other._container);
	}

	__unordered_map(__unordered_map &&other) noexcept(__nothrow_move_v)
	: __unordered_map(0, other.hash_function(), other.key_eq(), other.get_allocator()) {
		_container.max_load_factor(other.max_load_factor());
		_container.move_from(sprt::move(other._container));
	}

	explicit __unordered_map(const Allocator &a) noexcept
	: _container(0, hasher(), key_equal(), allocator_type(a)) { }

	__unordered_map(const __unordered_map &other, const type_identity_t<Allocator> &a) noexcept
	: _container(0, other.hash_function(), other.key_eq(), allocator_type(a)) {
		_container.max_load_factor(other.max_load_factor());
		_container.copy_from(other._container);
	}
	__unordered_map(__unordered_map &&other, const type_identity_t<Allocator> &a) noexcept
	: _container(0, other.hash_function(), other.key_eq(), allocator_type(a)) {
		_container.max_load_factor(other.max_load_factor());
		_container.move_from(sprt::move(other._container));
	}

	__unordered_map(initializer_list<value_type> il, size_type n = 0, const hasher &hf = hasher(),
			const key_equal &eql = key_equal(), const allocator_type &a = allocator_type()) noexcept
	: _container(sprt::max(static_cast<size_type>(n),
						 static_cast<size_type>(
								 __builtin_floorf(il.size() * container_type::CoverageLoadFactor))),
			  hf, eql, a) {
		for (auto &it : il) { _container.insert(it); }
	}

	__unordered_map(size_type n, const allocator_type &a) noexcept
	: __unordered_map(n, hasher(), key_equal(), a) { }

	__unordered_map(size_type n, const hasher &hf, const allocator_type &a) noexcept
	: __unordered_map(n, hf, key_equal(), a) { }

	template <typename InputIter,
			enable_if_t<__has_input_iterator_category<InputIter>::value, int> = 0>
	__unordered_map(InputIter f, InputIter l, size_type n, const allocator_type &a) noexcept
	: __unordered_map(f, l, n, hasher(), key_equal(), a) { }

	template <typename InputIter,
			enable_if_t<__has_input_iterator_category<InputIter>::value, int> = 0>
	__unordered_map(InputIter f, InputIter l, size_type n, const hasher &hf,
			const allocator_type &a) noexcept
	: __unordered_map(f, l, n, hf, key_equal(), a) { }

	__unordered_map(initializer_list<value_type> il, size_type n, const allocator_type &a) noexcept
	: __unordered_map(il, n, hasher(), key_equal(), a) { }

	__unordered_map(initializer_list<value_type> il, size_type n, const hasher &hf,
			const allocator_type &a) noexcept
	: __unordered_map(il, n, hf, key_equal(), a) { }

	__unordered_map &operator=(const __unordered_map &other) noexcept {
		if (this == sprt::addressof(other)) {
			return *this; // copy_from clears then re-reads storage, so self-assignment must no-op
		}
		using traits = sprt::allocator_traits<allocator_type>;

		if constexpr (traits::propagate_on_container_copy_assignment::value) {
			_container.set_allocator(other.get_allocator());
		}

		_container.copy_from(other._container);
		return *this;
	}
	__unordered_map &operator=(__unordered_map &&other) noexcept(__nothrow_move_assign_v) {
		using traits = sprt::allocator_traits<allocator_type>;

		if constexpr (traits::propagate_on_container_move_assignment::value) {
			_container.set_allocator(other.get_allocator());
		}

		_container.move_from(sprt::move(other._container));
		return *this;
	}
	__unordered_map &operator=(initializer_list<value_type> il) noexcept {
		clear();
		rehash(__builtin_floorf(il.size() * container_type::CoverageLoadFactor));
		for (auto &it : il) { _container.insert(it); }
		return *this;
	}

	allocator_type get_allocator() const noexcept {
		if constexpr (detail::__sprt_extended_allocator<Allocator>) {
			return _container.get_allocator();
		} else {
			return _container.get_allocator().get();
		}
	}

	// iterators
	iterator begin() noexcept { return _container.begin(); }
	const_iterator begin() const noexcept { return _container.begin(); }
	iterator end() noexcept { return _container.end(); }
	const_iterator end() const noexcept { return _container.end(); }
	const_iterator cbegin() const noexcept { return _container.begin(); }
	const_iterator cend() const noexcept { return _container.end(); }

	// capacity
	bool empty() const noexcept { return _container.size() == 0; }
	size_type size() const noexcept { return _container.size(); }
	size_type max_size() const noexcept { return _container.max_size(); }

	// modifiers
	template <typename... Args>
	pair<iterator, bool> emplace(Args &&...args) {
		return _container.try_emplace(sprt::forward<Args>(args)...);
	}

	// emplace(a_pair): a single value_type / convertible pair — decomposed and constructed in place.
	template <typename P, enable_if_t<is_constructible_v<value_type, P &&>, int> = 0>
	pair<iterator, bool> emplace(P &&obj) {
		return insert(sprt::forward<P>(obj));
	}

	template <typename... T1, typename... T2>
	pair<iterator, bool> emplace(sprt::piecewise_construct_t, sprt::tuple<T1...> t1,
			sprt::tuple<T2...> t2) {
		return __emplace_piecewise(sprt::move(t1), sprt::move(t2),
				sprt::make_index_sequence<sizeof...(T1)>{},
				sprt::make_index_sequence<sizeof...(T2)>{});
	}

	template <typename _Tup1, typename _Tup2, sprt::size_t... _I1, sprt::size_t... _I2>
	pair<iterator, bool> __emplace_piecewise(_Tup1 &&t1, _Tup2 &&t2, sprt::index_sequence<_I1...>,
			sprt::index_sequence<_I2...>) {
		return _container.try_emplace(key_type(sprt::get<_I1>(sprt::move(t1))...),
				sprt::get<_I2>(sprt::move(t2))...);
	}

	template <typename... Args>
	iterator emplace_hint(const_iterator position, Args &&...args) {
		// there is no hinted variant for hash_memory backend
		return emplace(sprt::forward<Args>(args)...).first;
	}

	pair<iterator, bool> insert(const value_type &obj) { return _container.insert(obj); }
	pair<iterator, bool> insert(value_type &&obj) {
		return _container.insert(sprt::move_unsafe(obj));
	}
	template <typename P,
			enable_if_t<is_constructible_v<value_type, P &&>
							&& !is_same_v<remove_cvref_t<P>, value_type>,
					int> = 0>
	pair<iterator, bool> insert(P &&obj) {
		return _container.try_emplace(sprt::forward<P>(obj).first, sprt::forward<P>(obj).second);
	}

	iterator insert(const_iterator hint, const value_type &obj) {
		return _container.insert(obj).first;
	}
	iterator insert(const_iterator hint, value_type &&obj) {
		return _container.insert(sprt::move_unsafe(obj)).first;
	}
	template <typename P,
			enable_if_t<is_constructible_v<value_type, P &&>
							&& !is_same_v<remove_cvref_t<P>, value_type>,
					int> = 0>
	iterator insert(const_iterator hint, P &&obj) {
		return _container.try_emplace(sprt::forward<P>(obj).first, sprt::forward<P>(obj).second)
				.first;
	}

	template <typename InputIter,
			enable_if_t<__has_input_iterator_category<InputIter>::value, int> = 0>
	void insert(InputIter first, InputIter last) {
		// Decompose (see the range constructor) so a foreign pair range constructs in place.
		while (first != last) {
			_container.try_emplace((*first).first, (*first).second);
			++first;
		}
	}
	void insert(initializer_list<value_type> il) {
		for (auto &it : il) { _container.insert(it); }
	}

	template <typename K, typename... Args>
	iterator emplace_with_token(K &&k, Args &&...args) {
		auto ret = _container.try_emplace(sprt::forward<K>(k), sprt::forward<Args>(args)...);
		if (ret.second == false) {
			ret.first->second = mapped_type(sprt::forward<Args>(args)...);
		}
		return ret.first;
	}

	template <typename... Args>
	pair<iterator, bool> try_emplace(const key_type &k, Args &&...args) {
		return _container.try_emplace(k, sprt::forward<Args>(args)...);
	}
	template <typename... Args>
	pair<iterator, bool> try_emplace(key_type &&k, Args &&...args) {
		return _container.try_emplace(sprt::move_unsafe(k), sprt::forward<Args>(args)...);
	}
	template <typename K, typename... Args>
	pair<iterator, bool> try_emplace(K &&k, Args &&...args) {
		return _container.try_emplace(sprt::forward<K>(k), sprt::forward<Args>(args)...);
	}
	template <typename... Args>
	iterator try_emplace(const_iterator hint, const key_type &k, Args &&...args) {
		return _container.try_emplace(k, sprt::forward<Args>(args)...).first;
	}
	template <typename... Args>
	iterator try_emplace(const_iterator hint, key_type &&k, Args &&...args) {
		return _container.try_emplace(sprt::move_unsafe(k), sprt::forward<Args>(args)...).first;
	}
	template <typename K, typename... Args>
	iterator try_emplace(const_iterator hint, K &&k, Args &&...args) {
		return _container.try_emplace(sprt::forward<K>(k), sprt::forward<Args>(args)...).first;
	}
	template <typename M>
	pair<iterator, bool> insert_or_assign(const key_type &k, M &&obj) {
		auto ret = _container.try_emplace(k, sprt::forward<M>(obj));
		if (ret.second == false) {
			ret.first->second = sprt::forward<M>(obj);
		}
		return ret;
	}
	template <typename M>
	pair<iterator, bool> insert_or_assign(key_type &&k, M &&obj) {
		auto ret = _container.try_emplace(sprt::move_unsafe(k), sprt::forward<M>(obj));
		if (ret.second == false) {
			ret.first->second = sprt::forward<M>(obj);
		}
		return ret;
	}
	template <typename K, typename M>
	pair<iterator, bool> insert_or_assign(K &&k, M &&obj) {
		auto ret = _container.try_emplace(sprt::forward<K>(k), sprt::forward<M>(obj));
		if (ret.second == false) {
			ret.first->second = sprt::forward<M>(obj);
		}
		return ret;
	}
	template <typename M>
	iterator insert_or_assign(const_iterator hint, const key_type &k, M &&obj) {
		auto ret = _container.try_emplace(k, sprt::forward<M>(obj));
		if (ret.second == false) {
			ret.first->second = sprt::forward<M>(obj);
		}
		return ret.first;
	}
	template <typename M>
	iterator insert_or_assign(const_iterator hint, key_type &&k, M &&obj) {
		auto ret = _container.try_emplace(sprt::move_unsafe(k), sprt::forward<M>(obj));
		if (ret.second == false) {
			ret.first->second = sprt::forward<M>(obj);
		}
		return ret.first;
	}
	template <typename K, typename M>
	iterator insert_or_assign(const_iterator hint, K &&k, M &&obj) {
		auto ret = _container.try_emplace(sprt::forward<K>(k), sprt::forward<M>(obj));
		if (ret.second == false) {
			ret.first->second = sprt::forward<M>(obj);
		}
		return ret.first;
	}

	iterator erase(iterator position) { return _container.erase(position); }
	iterator erase(const_iterator position) { return _container.erase(position); }
	size_type erase(const key_type &k) {
		auto it = _container.find(k);
		if (it != _container.end()) {
			_container.erase(it);
			return 1;
		}
		return 0;
	}

	template <__unordered_map_compatible_key<__unordered_map> K>
	size_type erase(K &&x) {
		size_t ret = 0;
		auto it = _container.find(x);
		while (it != _container.end()) {
			_container.erase(it);
			++ret;
			it = _container.find(x);
		}
		return ret;
	}
	iterator erase(const_iterator first, const_iterator last) {
		auto e = cend();
		while (first != last && first != e) { first = _container.erase(first); }
		return _container.to_iterator(first);
	}

	void swap(__unordered_map &other) noexcept(__nothrow_swap_v) {
		_container.swap(other._container);
	}
	void clear() noexcept { _container.clear_free(); }

	// observers
	hasher hash_function() const { return _container.hash_function(); }
	key_equal key_eq() const { return _container.key_eq(); }

	template <typename K>
	iterator find_for_token(const K &k) {
		return _container.find(k);
	}

	template <typename K>
	const_iterator find_for_token(const K &k) const {
		return _container.find(k);
	}

	// map operations
	iterator find(const key_type &k) { return _container.find(k); }
	const_iterator find(const key_type &k) const { return _container.find(k); }


	template <__unordered_map_compatible_key<__unordered_map> K>
	iterator find(const K &k) {
		return _container.find(k);
	}

	template <__unordered_map_compatible_key<__unordered_map> K>
	const_iterator find(const K &k) const {
		return _container.find(k);
	}

	size_type count(const key_type &k) const { return _container.count(k); }

	template <__unordered_map_compatible_key<__unordered_map> K>
	size_type count(const K &k) const {
		return _container.count(k);
	}

	bool contains(const key_type &k) const {
		return _container.find(k) != _container.end(); //
	}

	template <__unordered_map_compatible_key<__unordered_map> K>
	bool contains(const K &k) const {
		return _container.find(k) != _container.end();
	}

	pair<iterator, iterator> equal_range(const key_type &k) { return _container.equal_range(k); }
	pair<const_iterator, const_iterator> equal_range(const key_type &k) const {
		return _container.equal_range(k);
	}


	template <__unordered_map_compatible_key<__unordered_map> K>
	pair<iterator, iterator> equal_range(const K &k) {
		return _container.equal_range(k);
	}

	template <__unordered_map_compatible_key<__unordered_map> K>
	pair<const_iterator, const_iterator> equal_range(const K &k) const {
		return _container.equal_range(k);
	}

	// element access
	access_token<key_type> operator[](const key_type &k) {
		return access_token<key_type>(*this, k);
	}
	access_token<key_type> operator[](key_type &&k) {
		return access_token<key_type>(*this, sprt::move_unsafe(k));
	}

	// Decay the token key so a heterogeneous array/reference key (e.g. a string literal
	// `m["x"]`) is stored as a value/pointer, not an unstorable reference/array type.
	template <__unordered_map_compatible_key<__unordered_map> K>
	access_token<decay_t<K>> operator[](K &&k) {
		return access_token<decay_t<K>>(*this, sprt::forward<K>(k));
	}
	access_token<key_type> at(const key_type &k) { return access_token<key_type>(*this, k); }
	const_access_token<key_type> at(const key_type &k) const {
		return const_access_token<key_type>(*this, k);
	}

	template <__unordered_map_compatible_key<__unordered_map> K>
	access_token<decay_t<const K &>> at(const K &k) {
		return access_token<decay_t<const K &>>(*this, k);
	}
	template <typename K>
	sprt::enable_if_t<sprt::is_invocable_r_v<key_equal, key_type, K>
					&& sprt::is_invocable_v<hasher, K>,
			const_access_token<decay_t<const K &>>>
	at(const K &k) const {
		return const_access_token<decay_t<const K &>>(*this, k);
	}

	// bucket interface
	size_type bucket_count() const noexcept { return _container.bucket_count(); }
	size_type max_bucket_count() const noexcept { return _container.max_bucket_count(); }
	size_type bucket_size(size_type n) const { return _container.bucket_size(n); }
	size_type bucket(const key_type &k) const { return _container.bucket(k); }

	local_iterator begin(size_type n) { return _container.begin(n); }
	const_local_iterator begin(size_type n) const { return _container.begin(n); }
	local_iterator end(size_type n) { return _container.end(n); }
	const_local_iterator end(size_type n) const { return _container.end(n); }
	const_local_iterator cbegin(size_type n) const { return _container.begin(n); }
	const_local_iterator cend(size_type n) const { return _container.end(n); }

	// hash policy
	float load_factor() const noexcept { return _container.load_factor(); }
	float max_load_factor() const noexcept { return _container.max_load_factor(); }
	void max_load_factor(float z) { _container.max_load_factor(z); }
	void rehash(size_type n) { _container.rehash(n); }
	void reserve(size_type n) { rehash(__builtin_ceilf(n / max_load_factor())); }

protected:
	container_type _container;
};

template <typename Key, typename Value, typename Hash = sprt::hash<void>,
		typename Pred = sprt::equal_to<void>>
using __pool_unordered_map =
		__unordered_map<Key, Value, Hash, Pred, detail::AllocatorPool<pair<const Key, Value>>>;

template <typename Key, typename Value, typename Hash = sprt::hash<void>,
		typename Pred = sprt::equal_to<void>>
using __malloc_unordered_map =
		__unordered_map<Key, Value, Hash, Pred, detail::AllocatorMalloc<pair<const Key, Value>>>;

template <typename Key, typename Value, typename Hash, typename Pred, typename Allocator, bool Stl>
inline void swap(__unordered_map<Key, Value, Hash, Pred, Allocator, Stl> &__x,
		__unordered_map<Key, Value, Hash, Pred, Allocator, Stl> &__y)
		noexcept(noexcept(__x.swap(__y))) {
	__x.swap(__y);
}

// [unord.req]: equality is order-independent — equal sizes, and every (key, mapped) of __x has a
// matching key in __y with an equal mapped value (keys are unique).
template <typename Key, typename Value, typename Hash, typename Pred, typename Allocator, bool Stl>
inline bool operator==(const __unordered_map<Key, Value, Hash, Pred, Allocator, Stl> &__x,
		const __unordered_map<Key, Value, Hash, Pred, Allocator, Stl> &__y) noexcept {
	if (__x.size() != __y.size()) {
		return false;
	}
	for (const auto &__e : __x) {
		auto __it = __y.find(__e.first);
		if (__it == __y.end() || !(__it->second == __e.second)) {
			return false;
		}
	}
	return true;
}

