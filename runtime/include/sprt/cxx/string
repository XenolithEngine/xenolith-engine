#ifndef RUNTIME_INCLUDE_SPRT_CXX_STRING_H_
#define RUNTIME_INCLUDE_SPRT_CXX_STRING_H_

#include <sprt/cxx/detail/allocator_malloc.h>
#include <sprt/cxx/detail/allocator_pool.h>
#include <sprt/cxx/detail/allocator_std.h>
#include <sprt/cxx/detail/linear_memory.h>
#include <sprt/cxx/detail/hash.h>

#include <sprt/cxx/detail/constexpr.h>

#include <sprt/cxx/__string/basic_string_fwd.h>
#include <sprt/cxx/__string/char_traits.h>
#include <sprt/cxx/__iterator/concepts.h>
#include <sprt/cxx/string_view>
#include <sprt/cxx/type_traits>

#include <sprt/cxx/compare>
#include <sprt/cxx/initializer_list>

namespace sprt {

struct char_pointer_test;
template <typename T>
struct is_char_pointer { };
template <>
struct is_char_pointer<const char *> {
	using Type = char_pointer_test *;
};
template <>
struct is_char_pointer<char *> {
	using Type = char_pointer_test;
};
template <>
struct is_char_pointer<const char16_t *> {
	using Type = char_pointer_test;
};
template <>
struct is_char_pointer<char16_t *> {
	using Type = char_pointer_test;
};
template <>
struct is_char_pointer<const char32_t *> {
	using Type = char_pointer_test;
};
template <>
struct is_char_pointer<char32_t *> {
	using Type = char_pointer_test;
};

template <typename CharType, typename InputIterator, bool IsIntegral, typename Allocator,
		typename Traits, bool Soo>
struct __basic_string_fill;

// [string.cons] C++23 from_range tag. The std <string> overlay's derived ctor forwards
// std::from_range_t to this one; kept sprt-local so the base doesn't depend on <ranges>.
struct __sprt_from_range_t {
	explicit __sprt_from_range_t() = default;
};
inline constexpr __sprt_from_range_t __sprt_from_range{};

// [container.reqmts]-style container-compatible-range: an input range whose reference
// converts to the string's character type. Constrains the C++23 range members / ctor so
// non-ranges and element-incompatible ranges are correctly rejected.
template <typename _Range, typename _CharT>
concept __string_compatible_range = sprt::ranges::input_range<_Range>
		&& sprt::is_convertible_v<sprt::ranges::range_reference_t<_Range>, _CharT>;

// Traits is a real template parameter (defaulted to sprt::char_traits<CharType>), so the
// std <string> wrapper can expose the standard 3-parameter basic_string<charT, Traits,
// Allocator>. It is appended LAST (std orders it second) to keep every existing 2-argument
// __basic_string<Char, Alloc> spelling working unchanged via the default. All character
// comparison/search goes through traits_type == Traits.
template <typename CharType, typename Allocator, typename Traits, bool UseSoo>
class __basic_string : public detail::__allocator_base_t<Allocator> {
public:
	using allocator_type = Allocator;
	using traits_type = Traits;

	using pointer = CharType *;
	using const_pointer = const CharType *;
	using reference = CharType &;
	using const_reference = const CharType &;

	using size_type = size_t;
	using difference_type = ptrdiff_t; // [string.require]: mandated member type
	using charT = CharType;
	using value_type = CharType;
	using mem_type = detail::linear_memory<CharType, size_t(1),
			detail::__select_sprt_allocator<Allocator>, UseSoo>;
	using self = __basic_string<CharType, allocator_type, Traits, UseSoo>;

	using basic_string = self;

	template <typename _Tp>
	using __sv_like_t = sprt::enable_if_t<
			sprt::is_convertible_v<const _Tp &, basic_string_view<CharType, Traits>>
					&& !sprt::is_convertible_v<const _Tp &, const CharType *>,
			int>;

	using iterator = typename mem_type::iterator;
	using const_iterator = typename mem_type::const_iterator;
	using reverse_iterator = typename mem_type::reverse_iterator;
	using const_reverse_iterator = typename mem_type::const_reverse_iterator;

	static const size_type npos;

	constexpr __basic_string() noexcept : _mem() { }
	constexpr explicit __basic_string(const allocator_type &alloc) noexcept : _mem(alloc) { }

	constexpr __basic_string(const self &str) noexcept : _mem(str._mem) { }
	constexpr __basic_string(const self &str, const allocator_type &alloc) noexcept
	: _mem(str._mem, alloc) { }

	constexpr __basic_string(const self &str, size_type pos, size_type len = npos,
			const allocator_type &alloc = allocator_type()) noexcept
	: _mem(str._mem, pos, len, alloc) { }

	constexpr __basic_string(const charT *s,
			const allocator_type &alloc = allocator_type()) noexcept
	: _mem(s, (s ? __constexpr_strlen(s) : 0), alloc) { }

	constexpr __basic_string(const charT *s, size_type n,
			const allocator_type &alloc = allocator_type()) noexcept
	: _mem(s, n, alloc) { }

	constexpr __basic_string(size_type n, charT c,
			const allocator_type &alloc = allocator_type()) noexcept
	: _mem(alloc) {
		_mem.fill(n, c);
	}

	template <typename InputIterator>
	constexpr __basic_string(InputIterator first, InputIterator last,
			const allocator_type &alloc = allocator_type()) noexcept;

	constexpr __basic_string(initializer_list<charT> il,
			const allocator_type &alloc = allocator_type()) noexcept
	: _mem(alloc) {
		_mem.reserve(il.size());
		for (auto it = il.begin(); it != il.end(); it++) { _mem.emplace_back_unsafe(*it); }
	}

	constexpr __basic_string(__basic_string &&str) noexcept : _mem(sprt::move_unsafe(str._mem)) { }
	constexpr __basic_string(__basic_string &&str, const allocator_type &alloc) noexcept
	: _mem(sprt::move_unsafe(str._mem), alloc) { }

	// [string.cons] C++23 from_range constructor (the std overlay forwards std::from_range).
	template <typename _Range>
	requires __string_compatible_range<_Range, CharType>
	constexpr __basic_string(__sprt_from_range_t, _Range &&__rg,
			const allocator_type &alloc = allocator_type())
	: _mem(alloc) {
		for (auto &&__e : __rg) { _mem.emplace_back(static_cast<CharType>(__e)); }
	}

	constexpr __basic_string &operator=(const __basic_string &str) noexcept {
		_mem = str._mem;
		return *this;
	}

	constexpr __basic_string &operator=(__basic_string &&str) noexcept {
		_mem = sprt::move_unsafe(str._mem);
		return *this;
	}

	constexpr __basic_string &operator=(const charT *s) noexcept {
		_mem.assign(s, __constexpr_strlen(s));
		return *this;
	}

	constexpr __basic_string &operator=(charT ch) noexcept {
		_mem.assign(&ch, 1);
		return *this;
	}

	constexpr __basic_string &operator=(initializer_list<charT> ilist) noexcept {
		_mem.clear();
		_mem.reserve(ilist.size());
		for (auto &it : ilist) { _mem.emplace_back_unsafe(it); }
		return *this;
	}

	template <typename _Tp,
			enable_if_t<is_convertible_v<const _Tp &, basic_string_view<CharType, Traits>>
							&& !is_convertible_v<const _Tp &, const CharType *>,
					int> = 0>
	constexpr __basic_string &operator=(const _Tp &__t) noexcept {
		basic_string_view<CharType, Traits> __sv = __t;
		_mem.assign(__sv.data(), __sv.size());
		return *this;
	}

	constexpr allocator_type get_allocator() const noexcept {
		if constexpr (detail::__sprt_extended_allocator<Allocator>) {
			return _mem.get_allocator();
		} else {
			return _mem.get_allocator().get();
		}
	}

	constexpr iterator begin() noexcept { return _mem.begin(); }
	constexpr iterator end() noexcept { return _mem.end(); }

	constexpr const_iterator begin() const noexcept { return _mem.begin(); }
	constexpr const_iterator end() const noexcept { return _mem.end(); }

	constexpr const_iterator cbegin() const noexcept { return _mem.cbegin(); }
	constexpr const_iterator cend() const noexcept { return _mem.cend(); }

	constexpr reverse_iterator rbegin() noexcept { return reverse_iterator(end()); }
	constexpr reverse_iterator rend() noexcept { return reverse_iterator(begin()); }

	constexpr const_reverse_iterator rbegin() const noexcept {
		return const_reverse_iterator(end());
	}
	constexpr const_reverse_iterator rend() const noexcept {
		return const_reverse_iterator(begin());
	}

	constexpr const_reverse_iterator crbegin() const noexcept {
		return const_reverse_iterator(cend());
	}
	constexpr const_reverse_iterator crend() const noexcept {
		return const_reverse_iterator(cbegin());
	}

	constexpr size_type size() const noexcept { return _mem.size(); }
	constexpr size_type length() const noexcept { return _mem.size(); }
	constexpr size_type capacity() const noexcept { return _mem.capacity(); }

	constexpr size_type max_size() const noexcept {
		return (static_cast<size_type>(-1) / sizeof(CharType)) - 1;
	}

	constexpr void reserve(size_type n = 0) { _mem.reserve(n); }

	constexpr void resize(size_type n) { _mem.resize(n); }
	constexpr void resize(size_type n, charT c) { _mem.resize(n, c); }

	constexpr void clear() { _mem.clear(); }
	constexpr bool empty() const noexcept { return _mem.empty(); }

	// [string.modifiers] swap. linear_memory has no swap of its own, so exchange the
	// storage through its move operations (a stateless allocator is always equal, so
	// no allocator propagation is needed here).
	constexpr void swap(self &other) noexcept { sprt::swap(_mem, other._mem); }

	constexpr void shrink_to_fit() noexcept { _mem.shrink_to_fit(); }

	// [string.access]: for pos == size(), a reference to a charT() object is returned;
	// non-SSO empty strings have no allocated buffer (data() == nullptr), so route the
	// one-past-the-end read to a shared null terminator to stay valid in constant
	// evaluation (and to avoid a null dereference at runtime).
	static constexpr CharType __sprt_null_charT = CharType();

	constexpr reference operator[](size_type pos) noexcept {
		if (pos >= _mem.size()) {
			// s[size()] must yield a valid charT() reference even for a bufferless
			// (empty, non-SSO) string. The referent must not be modified ([string.access]).
			return const_cast<reference>(__sprt_null_charT);
		}
		return _mem.at(pos);
	}
	constexpr const_reference operator[](size_type pos) const noexcept {
		if (pos >= _mem.size()) {
			return __sprt_null_charT;
		}
		return _mem.at(pos);
	}

	constexpr reference at(size_type pos) noexcept {
		sprt_passert(pos < _mem.size(), "string::at: index out of range");
		return _mem.at(pos);
	}
	constexpr const_reference at(size_type pos) const noexcept {
		sprt_passert(pos < _mem.size(), "string::at: index out of range");
		return _mem.at(pos);
	}

	constexpr charT &back() noexcept { return _mem.back(); }
	constexpr const charT &back() const noexcept { return _mem.back(); }

	constexpr charT &front() noexcept { return _mem.front(); }
	constexpr const charT &front() const noexcept { return _mem.front(); }

	constexpr __basic_string &append(const __basic_string &str) {
		_mem.insert_back(str._mem);
		return *this;
	}
	constexpr __basic_string &append(const __basic_string &str, size_type subpos,
			size_type sublen = npos) {
		_mem.insert_back(str._mem, subpos, sublen);
		return *this;
	}
	constexpr __basic_string &append(const charT *s) {
		_mem.insert_back(s, __constexpr_strlen(s));
		return *this;
	}
	constexpr __basic_string &append(const charT *s, size_type n) {
		_mem.insert_back(s, n);
		return *this;
	}
	constexpr __basic_string &append(size_type n, charT c) {
		_mem.resize(_mem.size() + n, c);
		return *this;
	}
	template <typename InputIterator>
	constexpr __basic_string &append(InputIterator first, InputIterator last) {
		auto diff = sprt::distance(first, last);
		_mem.reserve(_mem.size() + diff, true);
		for (auto it = first; it != last; ++it) {
			if (*it != value_type(0)) {
				_mem.emplace_back_unsafe(*it);
			} else {
				break;
			}
		}
		return *this;
	}
	constexpr __basic_string &append(initializer_list<charT> il) {
		_mem.reserve(il.size() + _mem.size(), true);
		for (auto it = il.begin(); it != il.end(); it++) { _mem.emplace_back_unsafe(*it); }
		return *this;
	}

	// string_view-convertible append / operator+= (StringRef, string_view, ...).
	template <typename _Tp, __sv_like_t<_Tp> = 0>
	constexpr __basic_string &append(const _Tp &__t) {
		basic_string_view<CharType, Traits> __sv = __t;
		return this->append(__sv.data(), __sv.size());
	}
	template <typename _Tp, __sv_like_t<_Tp> = 0>
	constexpr __basic_string &append(const _Tp &__t, size_type __pos, size_type __n = npos) {
		basic_string_view<CharType, Traits> __sv = __t;
		__sv = __sv.substr(__pos, __n);
		return this->append(__sv.data(), __sv.size());
	}
	template <typename _Tp, __sv_like_t<_Tp> = 0>
	constexpr __basic_string &operator+=(const _Tp &__t) {
		return this->append(__t);
	}

	constexpr __basic_string &operator+=(const __basic_string &str) { return append(str); }

	constexpr __basic_string &operator+=(const charT *s) { return append(s); }
	constexpr __basic_string &operator+=(charT c) {
		_mem.emplace_back(c);
		return *this;
	}
	constexpr __basic_string &operator+=(initializer_list<charT> il) { return append(il); }

	constexpr __basic_string &assign(const __basic_string &str) {
		_mem.assign(str._mem);
		return *this;
	}
	constexpr __basic_string &assign(const __basic_string &str, size_type subpos,
			size_type sublen = npos) {
		_mem.assign(str._mem, subpos, sublen);
		return *this;
	}
	constexpr __basic_string &assign(const charT *s) {
		_mem.assign(s, __constexpr_strlen(s));
		return *this;
	}
	constexpr __basic_string &assign(const charT *s, size_type n) {
		_mem.assign(s, n);
		return *this;
	}
	constexpr __basic_string &assign(size_type n, charT c) {
		_mem.fill(n, c);
		return *this;
	}

	template <typename InputIterator>
	constexpr __basic_string &assign(InputIterator first, InputIterator last) {
		_mem.clear();
		auto diff = last - first;
		_mem.reserve(diff);
		for (auto it = first; it != last; ++it) { _mem.emplace_back_unsafe(*it); }
		return *this;
	}

	constexpr __basic_string &assign(initializer_list<charT> il) {
		_mem.clear();
		_mem.reserve(il.size());
		for (auto it = il.begin(); it != il.end(); it++) { _mem.emplace_back_unsafe(*it); }
		return *this;
	}
	constexpr __basic_string &assign(__basic_string &&str) noexcept {
		_mem = sprt::move_unsafe(str._mem);
		return *this;
	}

	// string_view-convertible assign (StringRef, string_view, ...).
	template <typename _Tp, __sv_like_t<_Tp> = 0>
	constexpr __basic_string &assign(const _Tp &__t) {
		basic_string_view<CharType, Traits> __sv = __t;
		_mem.assign(__sv.data(), __sv.size());
		return *this;
	}
	template <typename _Tp, __sv_like_t<_Tp> = 0>
	constexpr __basic_string &assign(const _Tp &__t, size_type __pos, size_type __n = npos) {
		basic_string_view<CharType, Traits> __sv = __t;
		__sv = __sv.substr(__pos, __n);
		_mem.assign(__sv.data(), __sv.size());
		return *this;
	}

	constexpr void push_back(CharType c) noexcept { _mem.emplace_back(c); }

	constexpr void emplace_back(CharType c) noexcept { _mem.emplace_back(c); }

	constexpr void pop_back() noexcept { _mem.pop_back(); }

	// [string.modifiers] C++23 range members. Ranges may be input-only (single-pass), so
	// iterate element-by-element rather than using the sized iterator-pair helpers.
	template <typename _Range>
	requires __string_compatible_range<_Range, CharType>
	constexpr __basic_string &append_range(_Range &&__rg) {
		for (auto &&__e : __rg) { _mem.emplace_back(static_cast<CharType>(__e)); }
		return *this;
	}

	template <typename _Range>
	requires __string_compatible_range<_Range, CharType>
	constexpr __basic_string &assign_range(_Range &&__rg) {
		_mem.clear();
		for (auto &&__e : __rg) { _mem.emplace_back(static_cast<CharType>(__e)); }
		return *this;
	}

	template <typename _Range>
	requires __string_compatible_range<_Range, CharType>
	constexpr iterator insert_range(const_iterator __p, _Range &&__rg) {
		const size_type __off = static_cast<size_type>(__p - _mem.data());
		// Buffer the (possibly single-pass) range, then splice it in at __off.
		self __tmp;
		for (auto &&__e : __rg) { __tmp._mem.emplace_back(static_cast<CharType>(__e)); }
		_mem.insert(__off, __tmp._mem.data(), __tmp._mem.size());
		return iterator(_mem.data() + __off);
	}

	template <typename _Range>
	requires __string_compatible_range<_Range, CharType>
	constexpr __basic_string &replace_with_range(const_iterator __i1, const_iterator __i2,
			_Range &&__rg) {
		self __tmp;
		for (auto &&__e : __rg) { __tmp._mem.emplace_back(static_cast<CharType>(__e)); }
		_mem.replace(__i1 - _mem.data(), __i2 - __i1, __tmp._mem.data(), __tmp._mem.size());
		return *this;
	}

	// [string.capacity] C++23 resize_and_overwrite: grow to n writable chars, hand the
	// buffer + n to op (as rvalues), then shrink to op's returned count.
	template <typename _Operation>
	constexpr void resize_and_overwrite(size_type __n, _Operation __op) {
		_mem.resize(__n);
		CharType *__p = _mem.data();
		const size_type __r = static_cast<_Operation &&>(
				__op)(static_cast<CharType *&&>(__p), static_cast<size_type &&>(__n));
		_mem.resize(__r);
		// [string.capacity]: op may write into the one-past-the-end terminator slot;
		// resize() only re-terminates when it shrinks, so restore data()[r] == charT().
		_mem.data()[__r] = CharType();
	}

	constexpr __basic_string &insert(size_type pos, const __basic_string &str) {
		_mem.insert(pos, str._mem);
		return *this;
	}
	constexpr __basic_string &insert(size_type pos, const __basic_string &str, size_type subpos,
			size_type sublen = npos) {
		_mem.insert(pos, str._mem, subpos, sublen);
		return *this;
	}

	constexpr __basic_string &insert(size_type pos, const charT *s) {
		_mem.insert(pos, s, __constexpr_strlen(s));
		return *this;
	}

	constexpr __basic_string &insert(size_type pos, const charT *s, size_type n) {
		_mem.insert(pos, s, n);
		return *this;
	}

	constexpr __basic_string &insert(size_type pos, size_type n, charT c) {
		_mem.insert(pos, n, c);
		return *this;
	}
	constexpr iterator insert(const_iterator p, size_type n, charT c) {
		return _mem.insert(p, n, c);
	}

	constexpr iterator insert(const_iterator p, charT c) { return _mem.insert(p, 1, c); }

	template < typename InputIt >
	constexpr iterator insert(const_iterator pos, InputIt first, InputIt last) {
		return _mem.insert(pos, first, last);
	}

	constexpr iterator insert(const_iterator pos, initializer_list<charT> init) {
		return _mem.insert(pos, init.begin(), init.end());
	}

	// string_view-convertible insert (StringRef, string_view, ...).
	template <typename _Tp, __sv_like_t<_Tp> = 0>
	constexpr __basic_string &insert(size_type __pos, const _Tp &__t) {
		basic_string_view<CharType, Traits> __sv = __t;
		_mem.insert(__pos, __sv.data(), __sv.size());
		return *this;
	}
	template <typename _Tp, __sv_like_t<_Tp> = 0>
	constexpr __basic_string &insert(size_type __pos1, const _Tp &__t, size_type __pos2,
			size_type __n = npos) {
		basic_string_view<CharType, Traits> __sv = __t;
		__sv = __sv.substr(__pos2, __n);
		_mem.insert(__pos1, __sv.data(), __sv.size());
		return *this;
	}

	constexpr __basic_string &erase(size_type pos = 0, size_type len = npos) {
		_mem.erase(pos, len);
		return *this;
	}

	constexpr iterator erase(const_iterator p) { return _mem.erase(p); }

	constexpr iterator erase(const_iterator first, const_iterator last) {
		return _mem.erase(first, last);
	}

	constexpr __basic_string &replace(size_type pos, size_type len, const __basic_string &str) {
		_mem.replace(pos, len, str._mem);
		return *this;
	}
	constexpr __basic_string &replace(const_iterator i1, const_iterator i2,
			const __basic_string &str) {
		_mem.replace(i1 - _mem.data(), i2 - i1, str._mem);
		return *this;
	}

	constexpr __basic_string &replace(size_type pos, size_type len, const __basic_string &str,
			size_type subpos, size_type sublen = npos) {
		_mem.replace(pos, len, str._mem, subpos, sublen);
		return *this;
	}

	constexpr __basic_string &replace(size_type pos, size_type len, const charT *s) {
		_mem.replace(pos, len, s, __constexpr_strlen(s));
		return *this;
	}
	constexpr __basic_string &replace(const_iterator i1, const_iterator i2, const charT *s) {
		_mem.replace(i1 - _mem.data(), i2 - i1, s, __constexpr_strlen(s));
		return *this;
	}

	constexpr __basic_string &replace(size_type pos, size_type len, const charT *s, size_type n) {
		_mem.replace(pos, len, s, n);
		return *this;
	}
	constexpr __basic_string &replace(const_iterator i1, const_iterator i2, const charT *s,
			size_type n) {
		_mem.replace(i1 - _mem.data(), i2 - i1, s, n);
		return *this;
	}

	constexpr __basic_string &replace(size_type pos, size_type len, size_type n, charT c) {
		_mem.replace(pos, len, n, c);
		return *this;
	}
	constexpr __basic_string &replace(const_iterator i1, const_iterator i2, size_type n, charT c) {
		_mem.replace(i1 - _mem.data(), i2 - i1, n, c);
		return *this;
	}

	template < typename InputIt >
	constexpr __basic_string &replace(const_iterator first, const_iterator last, InputIt first2,
			InputIt last2) {
		_mem.replace(first, last, first2, last2);
		return *this;
	}

	constexpr __basic_string &replace(const_iterator first, const_iterator last,
