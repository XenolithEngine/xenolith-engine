// [numeric.ops] the <numeric> generalized numeric operations. reduce / transform_reduce are
// evaluated sequentially (no execution-policy overloads; this layer has no parallelism).

#ifndef RUNTIME_INCLUDE_SPRT_CXX_NUMERIC_H_
#define RUNTIME_INCLUDE_SPRT_CXX_NUMERIC_H_

#include <sprt/cxx/cstddef>
#include <sprt/cxx/type_traits>
#include <sprt/cxx/__utility/common.h>
#include <sprt/cxx/__iterator/iterator_ops.h>
#include <sprt/cxx/__functional/operations.h>

namespace sprt {

template <typename _InIt, typename _Tp>
constexpr _Tp accumulate(_InIt __first, _InIt __last, _Tp __init) {
	for (; __first != __last; ++__first) {
		__init = sprt::move_unsafe(__init) + *__first;
	}
	return __init;
}
template <typename _InIt, typename _Tp, typename _Op>
constexpr _Tp accumulate(_InIt __first, _InIt __last, _Tp __init, _Op __op) {
	for (; __first != __last; ++__first) {
		__init = __op(sprt::move_unsafe(__init), *__first);
	}
	return __init;
}

template <typename _InIt, typename _Tp>
constexpr _Tp reduce(_InIt __first, _InIt __last, _Tp __init) {
	for (; __first != __last; ++__first) {
		__init = sprt::move_unsafe(__init) + *__first;
	}
	return __init;
}
template <typename _InIt, typename _Tp, typename _Op>
constexpr _Tp reduce(_InIt __first, _InIt __last, _Tp __init, _Op __op) {
	for (; __first != __last; ++__first) {
		__init = __op(sprt::move_unsafe(__init), *__first);
	}
	return __init;
}
template <typename _InIt>
constexpr typename iterator_traits<_InIt>::value_type reduce(_InIt __first, _InIt __last) {
	return sprt::reduce(__first, __last, typename iterator_traits<_InIt>::value_type {});
}

template <typename _It1, typename _It2, typename _Tp>
constexpr _Tp inner_product(_It1 __f1, _It1 __l1, _It2 __f2, _Tp __init) {
	for (; __f1 != __l1; ++__f1, (void)++__f2) {
		__init = sprt::move_unsafe(__init) + (*__f1) * (*__f2);
	}
	return __init;
}
template <typename _It1, typename _It2, typename _Tp, typename _Op1, typename _Op2>
constexpr _Tp inner_product(_It1 __f1, _It1 __l1, _It2 __f2, _Tp __init, _Op1 __op1, _Op2 __op2) {
	for (; __f1 != __l1; ++__f1, (void)++__f2) {
		__init = __op1(sprt::move_unsafe(__init), __op2(*__f1, *__f2));
	}
	return __init;
}

template <typename _It1, typename _Tp, typename _Redop, typename _Transop>
constexpr _Tp transform_reduce(
		_It1 __f1, _It1 __l1, _Tp __init, _Redop __redop, _Transop __transop) {
	for (; __f1 != __l1; ++__f1) {
		__init = __redop(sprt::move_unsafe(__init), __transop(*__f1));
	}
	return __init;
}
template <typename _It1, typename _It2, typename _Tp, typename _Redop, typename _Transop>
constexpr _Tp transform_reduce(
		_It1 __f1, _It1 __l1, _It2 __f2, _Tp __init, _Redop __redop, _Transop __transop) {
	for (; __f1 != __l1; ++__f1, (void)++__f2) {
		__init = __redop(sprt::move_unsafe(__init), __transop(*__f1, *__f2));
	}
	return __init;
}
template <typename _It1, typename _It2, typename _Tp>
constexpr _Tp transform_reduce(_It1 __f1, _It1 __l1, _It2 __f2, _Tp __init) {
	return sprt::transform_reduce(
			__f1, __l1, __f2, sprt::move_unsafe(__init), plus<> {}, multiplies<> {});
}

template <typename _InIt, typename _OutIt>
constexpr _OutIt partial_sum(_InIt __first, _InIt __last, _OutIt __d) {
	if (__first == __last) {
		return __d;
	}
	typename iterator_traits<_InIt>::value_type __acc = *__first;
	*__d = __acc;
	for (++__first, (void)++__d; __first != __last; ++__first, (void)++__d) {
		__acc = sprt::move_unsafe(__acc) + *__first;
		*__d = __acc;
	}
	return __d;
}
template <typename _InIt, typename _OutIt, typename _Op>
constexpr _OutIt partial_sum(_InIt __first, _InIt __last, _OutIt __d, _Op __op) {
	if (__first == __last) {
		return __d;
	}
	typename iterator_traits<_InIt>::value_type __acc = *__first;
	*__d = __acc;
	for (++__first, (void)++__d; __first != __last; ++__first, (void)++__d) {
		__acc = __op(sprt::move_unsafe(__acc), *__first);
		*__d = __acc;
	}
	return __d;
}

template <typename _InIt, typename _OutIt>
constexpr _OutIt adjacent_difference(_InIt __first, _InIt __last, _OutIt __d) {
	if (__first == __last) {
		return __d;
	}
	typename iterator_traits<_InIt>::value_type __prev = *__first;
	*__d = __prev;
	for (++__first, (void)++__d; __first != __last; ++__first, (void)++__d) {
		typename iterator_traits<_InIt>::value_type __cur = *__first;
		*__d = __cur - __prev;
		__prev = sprt::move_unsafe(__cur);
	}
	return __d;
}
template <typename _InIt, typename _OutIt, typename _Op>
constexpr _OutIt adjacent_difference(_InIt __first, _InIt __last, _OutIt __d, _Op __op) {
	if (__first == __last) {
		return __d;
	}
	typename iterator_traits<_InIt>::value_type __prev = *__first;
	*__d = __prev;
	for (++__first, (void)++__d; __first != __last; ++__first, (void)++__d) {
		typename iterator_traits<_InIt>::value_type __cur = *__first;
		*__d = __op(__cur, __prev);
		__prev = sprt::move_unsafe(__cur);
	}
	return __d;
}

template <typename _FwdIt, typename _Tp>
constexpr void iota(_FwdIt __first, _FwdIt __last, _Tp __value) {
	for (; __first != __last; ++__first, (void)++__value) {
		*__first = __value;
	}
}

template <typename _Mp, typename _Np>
constexpr common_type_t<_Mp, _Np> gcd(_Mp __m, _Np __n) {
	using _Rp = common_type_t<_Mp, _Np>;
	using _Up = make_unsigned_t<_Rp>;
	_Up __a = __m < 0 ? _Up(~_Up(__m) + 1u) : _Up(__m);
	_Up __b = __n < 0 ? _Up(~_Up(__n) + 1u) : _Up(__n);
	while (__b != 0) {
		_Up __t = __a % __b;
		__a = __b;
		__b = __t;
	}
	return static_cast<_Rp>(__a);
}
template <typename _Mp, typename _Np>
constexpr common_type_t<_Mp, _Np> lcm(_Mp __m, _Np __n) {
	using _Rp = common_type_t<_Mp, _Np>;
	if (__m == 0 || __n == 0) {
		return 0;
	}
	_Rp __g = sprt::gcd(__m, __n);
	// LWG 2837: take |x| via the unsigned negate in the WIDENED type — negating in
	// the argument's own type overflows for its minimum value (e.g. INT32_MIN).
	using _Up = make_unsigned_t<_Rp>;
	_Up __am = __m < 0 ? _Up(~_Up(static_cast<_Rp>(__m)) + 1u) : _Up(static_cast<_Rp>(__m));
	_Up __an = __n < 0 ? _Up(~_Up(static_cast<_Rp>(__n)) + 1u) : _Up(static_cast<_Rp>(__n));
	return static_cast<_Rp>((__am / _Up(__g)) * __an);
}

template <typename _Tp>
constexpr enable_if_t<is_integral_v<_Tp> && !is_same_v<remove_cv_t<_Tp>, bool>, _Tp> midpoint(
		_Tp __a, _Tp __b) noexcept {
	using _Up = make_unsigned_t<_Tp>;
	int __k = 1;
	_Up __m = static_cast<_Up>(__a);
	_Up __M = static_cast<_Up>(__b);
	if (__a > __b) {
		__k = -1;
		__m = static_cast<_Up>(__b);
		__M = static_cast<_Up>(__a);
	}
	return static_cast<_Tp>(__a + __k * static_cast<_Tp>(_Up(__M - __m) >> 1));
}
template <typename _Fp>
constexpr enable_if_t<is_floating_point_v<_Fp>, _Fp> midpoint(_Fp __a, _Fp __b) noexcept {
	return __a / 2 + __b / 2;
}
template <typename _Tp>
constexpr _Tp *midpoint(_Tp *__a, _Tp *__b) noexcept {
	return __a + (__b - __a) / 2;
}

} // namespace sprt

#endif // RUNTIME_INCLUDE_SPRT_CXX_NUMERIC_H_
