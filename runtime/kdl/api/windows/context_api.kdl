defaults dll=kernel32 link=import cc=WINAPI

func RtlCaptureContext VOID dll=ntdll stub="manual" { ContextRecord PCONTEXT }
func GetThreadContext BOOL stub=#false { hThread HANDLE; lpContext LPCONTEXT }
func SetThreadContext BOOL stub=#false { hThread HANDLE; lpContext "const CONTEXT *" }
func Wow64GetThreadContext BOOL stub=#false { hThread HANDLE; lpContext PWOW64_CONTEXT }
func Wow64SetThreadContext BOOL stub=#false { hThread HANDLE; lpContext "const WOW64_CONTEXT *" }
func RtlRestoreContext VOID dll=ntdll {
    ContextRecord PCONTEXT
    ExceptionRecord "EXCEPTION_RECORD *"
}
func RtlLookupFunctionEntry PRUNTIME_FUNCTION {
    ControlPc DWORD64
    ImageBase PDWORD64
    HistoryTable PUNWIND_HISTORY_TABLE
}
func RtlAddFunctionTable BOOLEAN stub=#false {
    FunctionTable PRUNTIME_FUNCTION
    EntryCount DWORD
    BaseAddress DWORD64
}
func RtlDeleteFunctionTable BOOLEAN stub=#false { FunctionTable PRUNTIME_FUNCTION }
func RtlUnwindEx VOID {
    TargetFrame PVOID
    TargetIp PVOID
    ExceptionRecord PEXCEPTION_RECORD
    ReturnValue PVOID
    ContextRecord PCONTEXT
    HistoryTable PUNWIND_HISTORY_TABLE
}
func RtlVirtualUnwind PEXCEPTION_ROUTINE {
    HandlerType DWORD
    ImageBase DWORD64
    ControlPc DWORD64
    FunctionEntry PRUNTIME_FUNCTION
    ContextRecord PCONTEXT
    HandlerData "PVOID *"
    EstablisherFrame PDWORD64
    ContextPointers PVOID
}
func RtlCaptureStackBackTrace WORD {
    FramesToSkip DWORD
    FramesToCapture DWORD
    BackTrace "PVOID *"
    BackTraceHash PDWORD
}
func AddVectoredExceptionHandler PVOID { First ULONG; Handler PVECTORED_EXCEPTION_HANDLER }
func RemoveVectoredExceptionHandler ULONG { Handle PVOID }
func AddVectoredContinueHandler PVOID { First ULONG; Handler PVECTORED_EXCEPTION_HANDLER }
func RemoveVectoredContinueHandler ULONG { Handle PVOID }
func WaitForDebugEvent BOOL stub=#false { lpDebugEvent LPDEBUG_EVENT; dwMilliseconds DWORD }
func ContinueDebugEvent BOOL stub=#false {
    dwProcessId DWORD
    dwThreadId DWORD
    dwContinueStatus DWORD
}
func DebugActiveProcess BOOL stub=#false { dwProcessId DWORD }
func DebugActiveProcessStop BOOL stub=#false { dwProcessId DWORD }
func DebugBreakProcess BOOL stub=#false { Process HANDLE }
func SetUnhandledExceptionFilter LPTOP_LEVEL_EXCEPTION_FILTER stub=#false {
    lpTopLevelExceptionFilter LPTOP_LEVEL_EXCEPTION_FILTER
}
func NtContinueEx NTSTATUS dll=ntdll { context "CONTEXT *"; args "void *" }
func RaiseException VOID {
    dwExceptionCode DWORD
    dwExceptionFlags DWORD
    nNumberOfArguments DWORD
    lpArguments "const ULONG_PTR *"
}
func setjmp int if="!defined(CORE_RUNTIME_INCLUDE_LIBC_SETJMP_H_)" link=none cc="" dll="" attr="__attribute__((returns_twice))" {
    _Buf "struct _JUMP_BUFFER *"
    - "void *"
}
func longjmp "void __cdecl" if="!defined(CORE_RUNTIME_INCLUDE_LIBC_SETJMP_H_)" link=none cc="" dll="" attr="__SPRT_NORETURN" {
    - "struct _JUMP_BUFFER *"
    _Value int
}
