defaults dll=combase link=import cc=WINAPI

func CoInitializeSecurity HRESULT {
    pSecDesc PSECURITY_DESCRIPTOR
    cAuthSvc LONG
    asAuthSvc "SOLE_AUTHENTICATION_SERVICE *"
    pReserved1 "void *"
    dwAuthnLevel DWORD
    dwImpLevel DWORD
    pAuthList "void *"
    dwCapabilities DWORD
    pReserved3 "void *"
}
func CoCreateInstance HRESULT {
    rclsid REFCLSID
    pUnkOuter "IUnknown *"
    dwClsContext DWORD
    riid REFIID
    ppv "LPVOID *"
}
func CoSetProxyBlanket HRESULT {
    pProxy "IUnknown *"
    dwAuthnSvc DWORD
    dwAuthzSvc DWORD
    pServerPrincName LPWSTR
    dwAuthnLevel DWORD
    dwImpLevel DWORD
    pAuthIdentity "void *"
    dwCapabilities DWORD
}
func CoInitializeEx HRESULT { pvReserved LPVOID; dwCoInit DWORD }
func CoUninitialize void
func CoTaskMemFree void { pv LPVOID }
func SHGetKnownFolderPath HRESULT dll=shell32 {
    rfid REFKNOWNFOLDERID
    dwFlags DWORD
    hToken HANDLE
    ppszPath "PWSTR *"
}
func VariantInit void dll=oleaut32 { pvarg "VARIANTARG *" }
func VariantClear HRESULT dll=oleaut32 { pvarg "VARIANTARG *" }
func VariantCopy HRESULT dll=oleaut32 { pvargDest "VARIANTARG *"; pvargSrc "const VARIANTARG *" }
func SysAllocString BSTR dll=oleaut32 { psz "const OLECHAR *" }
func SysStringLen UINT dll=oleaut32 { bstrString BSTR }
func SysFreeString void dll=oleaut32 { bstrString BSTR }
func StringFromCLSID HRESULT { rclsid REFCLSID; lplpsz "LPOLESTR *" }
func CLSIDFromString HRESULT { lpsz LPCOLESTR; pclsid LPCLSID }
func IIDFromString HRESULT { lpsz LPCOLESTR; lpiid LPIID }
