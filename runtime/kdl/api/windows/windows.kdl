func GetThreadId DWORD dll=kernelbase stub=#false { Thread HANDLE }
// Exported by the runtime, not imported from the system.
//
// These three are defined in libc_impl/src/windows/dll/dllstub_nt_extras.cc and are
// deliberately absent from def/kernel32.def and def/kernelbase.def - were they listed
// there, a consumer would bind straight to kernelbase.dll and never reach the wrapper.
// Each wrapper resolves the system export dynamically and forwards to it where it
// behaves; where it does not (wine has no GetProcessAffinityMask/SetProcessAffinityMask
// export at all, so a direct bind aborts the process, and its GetProcessGroupAffinity
// breaks the two-call protocol) it degrades to a documented failure or a substitute.
func GetProcessAffinityMask BOOL link=sprt dll=kernelbase stub="manual" table=#false {
    hProcess HANDLE
    lpProcessAffinityMask PDWORD_PTR
    lpSystemAffinityMask PDWORD_PTR
}
func SetProcessAffinityMask BOOL link=sprt dll=kernelbase stub="manual" table=#false {
    hProcess HANDLE
    dwProcessAffinityMask DWORD_PTR
}
func GetProcessGroupAffinity BOOL link=sprt dll=kernelbase stub="manual" {
    hProcess HANDLE
    GroupCount PUSHORT
    GroupArray PUSHORT
}
func SetThreadGroupAffinity BOOL dll=kernelbase stub=#false {
    hThread HANDLE
    GroupAffinity "const GROUP_AFFINITY *"
    PreviousGroupAffinity PGROUP_AFFINITY
}
func GetThreadGroupAffinity BOOL dll=kernelbase stub=#false {
    hThread HANDLE
    GroupAffinity PGROUP_AFFINITY
}
