// Checks whether the functions required for fully asynchronous packet processing
// are available at runtime:
// - NtCreateWaitCompletionPacket
// - NtAssociateWaitCompletionPacket
// - NtCancelWaitCompletionPacket
//
// If this routines is not available, next APIs WILL crush:
// - __sprt_RestartEventCompletion2
// - __sprt_RestartEventCompletion
// - __sprt_CancelEventCompletion
// - __sprt_ReportEventAsCompletion
func NtCompletionPacketAvailable BOOL link=none dll=""
func __sprt_RestartEventCompletion2 int link=none dll="" {
    hPacket "void *"
    hIOCP "void *"
    hEvent "void *"
    dwNumberOfBytesTransferred DWORD
    dwCompletionKey UINT_PTR
    lpOverlapped "void *"
}
func __sprt_RestartEventCompletion int link=none dll="" {
    hPacket "void *"
    hIOCP "void *"
    hEvent "void *"
    ncompletion "const void **"
}
func __sprt_CancelEventCompletion int link=none dll="" { hPacket "void *"; cancel int }
func __sprt_ReportEventAsCompletion "void *" link=none dll="" {
    hIOCP "void *"
    hEvent "void *"
    dwNumberOfBytesTransferred DWORD
    dwCompletionKey UINT_PTR
    lpOverlapped "void *"
}
