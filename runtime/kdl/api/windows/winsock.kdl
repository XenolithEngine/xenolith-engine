defaults dll=ws2_32 link=import cc=WINAPI

func getaddrinfo INT {
    pNodeName PCSTR
    pServiceName PCSTR
    pHints "const ADDRINFOA *"
    ppResult "PADDRINFOA *"
}
func freeaddrinfo VOID { pAddrInfo PADDRINFOA }
func gethostbyname "struct hostent *" { name "const char *" }
func getservbyname "struct servent *" { name "const char *"; proto "const char *" }
func WSAPoll int { fdArray LPWSAPOLLFD; fds ULONG; timeout INT }
func WSASocketA SOCKET {
    af int
    type int
    protocol int
    lpProtocolInfo LPWSAPROTOCOL_INFOA
    g GROUP
    dwFlags DWORD
}
func WSASocketW SOCKET {
    af int
    type int
    protocol int
    lpProtocolInfo LPWSAPROTOCOL_INFOW
    g GROUP
    dwFlags DWORD
}
func WSADuplicateSocketW int stub=#false {
    s SOCKET
    dwProcessId DWORD
    lpProtocolInfo LPWSAPROTOCOL_INFOW
}
func WSADuplicateSocketA int dll="" {
    s SOCKET
    dwProcessId DWORD
    lpProtocolInfo LPWSAPROTOCOL_INFOA
}
func WSAIoctl int {
    s SOCKET
    dwIoControlCode DWORD
    lpvInBuffer LPVOID
    cbInBuffer DWORD
    lpvOutBuffer LPVOID
    cbOutBuffer DWORD
    lpcbBytesReturned LPDWORD
    lpOverlapped LPWSAOVERLAPPED
    lpCompletionRoutine LPWSAOVERLAPPED_COMPLETION_ROUTINE
}
func WSAStartup int { wVersionRequested WORD; lpWSAData LPWSADATA }
func WSACleanup int empty=void
func WSASetLastError void { iError int }
func WSAGetLastError int empty=void
func WSACreateEvent WSAEVENT empty=void
func WSAEventSelect int { s SOCKET; hEventObject WSAEVENT; lNetworkEvents long }
func WSAWaitForMultipleEvents DWORD {
    cEvents DWORD
    lphEvents "const WSAEVENT *"
    fWaitAll BOOL
    dwTimeout DWORD
    fAlertable BOOL
}
func WSAEnumNetworkEvents int {
    s SOCKET
    hEventObject WSAEVENT
    lpNetworkEvents LPWSANETWORKEVENTS
}
func WSASetEvent BOOL { hEvent WSAEVENT }
func WSAResetEvent BOOL { hEvent WSAEVENT }
func WSACloseEvent BOOL { hEvent WSAEVENT }
