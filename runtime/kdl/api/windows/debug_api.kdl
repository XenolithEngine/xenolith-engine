func SymSetOptions DWORD { SymOptions DWORD }
func SymInitialize BOOL { hProcess HANDLE; UserSearchPath PCSTR; fInvadeProcess BOOL }
func SymGetOptions DWORD empty=VOID
func SymCleanup BOOL { hProcess HANDLE }
func StackWalk64 BOOL {
    MachineType DWORD
    hProcess HANDLE
    hThread HANDLE
    StackFrame LPSTACKFRAME64
    ContextRecord PVOID
    ReadMemoryRoutine PREAD_PROCESS_MEMORY_ROUTINE64
    FunctionTableAccessRoutine PFUNCTION_TABLE_ACCESS_ROUTINE64
    GetModuleBaseRoutine PGET_MODULE_BASE_ROUTINE64
    TranslateAddress PTRANSLATE_ADDRESS_ROUTINE64
}
func SymGetSymFromAddr64 BOOL {
    hProcess HANDLE
    qwAddr DWORD64
    pdwDisplacement PDWORD64
    Symbol PIMAGEHLP_SYMBOL64
}
func SymGetLineFromAddr64 BOOL {
    hProcess HANDLE
    qwAddr DWORD64
    pdwDisplacement PDWORD
    Line64 PIMAGEHLP_LINE64
}
func UnDecorateSymbolName DWORD {
    name PCSTR
    outputString PSTR
    maxStringLength DWORD
    flags DWORD
}
