defaults dll=kernel32 link=import cc=WINAPI

// ---- Process and Thread Management (processthreadsapi.h) ----
//
// Creates a thread to execute within the virtual address space of another process.
// @param lpThreadAttributes Security attributes (NULL = default).
// @param dwStackSize Initial stack size in bytes (0 = use default).
// @param lpStartAddress Function to execute.
// @param lpParameter Parameter passed to the function.
// @param dwCreationFlags Creation flags.
// @param lpThreadId Pointer to receive thread identifier.
// @return Handle to the new thread, or NULL on failure.
// @see https://docs.microsoft.com/en-us/windows/win32/api/processthreadsapi/nf-processthreadsapi-createthread
//
func CreateThread HANDLE {
    lpThreadAttributes LPSECURITY_ATTRIBUTES
    dwStackSize SIZE_T
    lpStartAddress LPTHREAD_START_ROUTINE
    lpParameter LPVOID
    dwCreationFlags DWORD
    lpThreadId LPDWORD
}
//
// Retrieves a handle to the specified thread object.
// @param dwThreadId Thread identifier.
// @param dwDesiredAccess Desired access (THREAD_QUERY_INFORMATION).
// @return Handle to the thread, or NULL on failure.
// @see https://docs.microsoft.com/en-us/windows/win32/api/processthreadsapi/nf-processthreadsapi-getcurrentthread
//
func OpenThread HANDLE { dwDesiredAccess DWORD; bInheritHandle BOOL; dwThreadId DWORD }
func GetCurrentThread HANDLE empty=void
func GetCurrentThreadId DWORD empty=void
func GetCurrentThreadStackLimits VOID { LowLimit PULONG_PTR; HighLimit PULONG_PTR }
func GetThreadPriority int stub="manual" { hThread HANDLE }
func SetThreadPriority BOOL stub="manual" { hThread HANDLE; nPriority int }
func GetExitCodeThread BOOL { hThread HANDLE; lpExitCode LPDWORD }
func ExitThread void { dwExitCode DWORD }
func ResumeThread DWORD { hThread HANDLE }
func SuspendThread DWORD stub=#false { hThread HANDLE }
func QueueUserAPC DWORD stub=#false { pfnAPC PAPCFUNC; hThread HANDLE; dwData ULONG_PTR }
func GetProcessId DWORD stub=#false { Process HANDLE }
func QueueUserAPC2 BOOL link=none cc="" {
    ApcRoutine PAPCFUNC
    Thread HANDLE
    Data ULONG_PTR
    Flags QUEUE_USER_APC_FLAGS
}
func SetThreadDescription HRESULT { hThread HANDLE; lpThreadDescription PCWSTR }
func GetSystemCpuSetInformation BOOL {
    Information PSYSTEM_CPU_SET_INFORMATION
    BufferLength ULONG
    ReturnedLength PULONG
    Process HANDLE
    Flags ULONG
}
func SetThreadSelectedCpuSets BOOL stub="manual" {
    Thread HANDLE
    CpuSetIds "const ULONG *"
    CpuSetIdCount ULONG
}
func GetThreadSelectedCpuSets BOOL {
    Thread HANDLE
    CpuSetIds PULONG
    CpuSetIdCount ULONG
    RequiredIdCount PULONG
}
func CreateToolhelp32Snapshot HANDLE { dwFlags DWORD; th32ProcessID DWORD }
func Thread32First BOOL { hSnapshot HANDLE; lpte LPTHREADENTRY32 }
func Thread32Next BOOL { hSnapshot HANDLE; lpte LPTHREADENTRY32 }
func InitializeSRWLock VOID { SRWLock PSRWLOCK }
func ReleaseSRWLockExclusive VOID { SRWLock PSRWLOCK }
func ReleaseSRWLockShared VOID { SRWLock PSRWLOCK }
func AcquireSRWLockExclusive VOID { SRWLock PSRWLOCK }
func AcquireSRWLockShared VOID { SRWLock PSRWLOCK }
func TryAcquireSRWLockExclusive BOOLEAN { SRWLock PSRWLOCK }
func TryAcquireSRWLockShared BOOLEAN { SRWLock PSRWLOCK }
func SwitchToThread BOOL empty=VOID
func CreateMutexW HANDLE {
    lpMutexAttributes LPSECURITY_ATTRIBUTES
    bInitialOwner BOOL
    lpName LPCWSTR
}
func CreateSemaphoreW HANDLE {
    lpSemaphoreAttributes LPSECURITY_ATTRIBUTES
    lInitialCount LONG
    lMaximumCount LONG
    lpName LPCWSTR
}
func CreateSemaphoreA HANDLE {
    lpSemaphoreAttributes LPSECURITY_ATTRIBUTES
    lInitialCount LONG
    lMaximumCount LONG
    lpName LPCSTR
}
func OpenSemaphoreW HANDLE stub=#false {
    dwDesiredAccess DWORD
    bInheritHandle BOOL
    lpName LPCWSTR
}
func OpenSemaphoreA HANDLE stub=#false { dwDesiredAccess DWORD; bInheritHandle BOOL; lpName LPCSTR }
func CreateEventW HANDLE {
    lpEventAttributes LPSECURITY_ATTRIBUTES
    bManualReset BOOL
    bInitialState BOOL
    lpName LPCWSTR
}
func CreateEventA HANDLE stub=#false {
    lpEventAttributes LPSECURITY_ATTRIBUTES
    bManualReset BOOL
    bInitialState BOOL
    lpName LPCSTR
}
func SetEvent BOOL { hEvent HANDLE }
func ResetEvent BOOL { hEvent HANDLE }
func ReleaseSemaphore BOOL { hSemaphore HANDLE; lReleaseCount LONG; lpPreviousCount LPLONG }
func SwitchToFiber VOID { lpFiber LPVOID }
func DeleteFiber VOID { lpFiber LPVOID }
func ConvertFiberToThread BOOL empty=VOID
func CreateFiberEx LPVOID {
    dwStackCommitSize SIZE_T
    dwStackReserveSize SIZE_T
    dwFlags DWORD
    lpStartAddress LPFIBER_START_ROUTINE
    lpParameter LPVOID
}
func ConvertThreadToFiberEx LPVOID { lpParameter LPVOID; dwFlags DWORD }
func CreateFiber LPVOID {
    dwStackSize SIZE_T
    lpStartAddress LPFIBER_START_ROUTINE
    lpParameter LPVOID
}
func ConvertThreadToFiber LPVOID { lpParameter LPVOID }
func TlsAlloc DWORD empty=VOID
func TlsGetValue LPVOID { dwTlsIndex DWORD }
func TlsSetValue BOOL { dwTlsIndex DWORD; lpTlsValue LPVOID }
func TlsFree BOOL { dwTlsIndex DWORD }
func CreateTimerQueue HANDLE empty=VOID
func CreateTimerQueueTimer BOOL {
    phNewTimer PHANDLE
    TimerQueue HANDLE
    Callback WAITORTIMERCALLBACK
    Parameter PVOID
    DueTime DWORD
    Period DWORD
    Flags ULONG
}
func ChangeTimerQueueTimer BOOL { TimerQueue HANDLE; Timer HANDLE; DueTime ULONG; Period ULONG }
func DeleteTimerQueueTimer "BOOL WINAPI" cc="" {
    TimerQueue HANDLE
    Timer HANDLE
    CompletionEvent HANDLE
}
func DeleteTimerQueue "BOOL WINAPI" cc="" { TimerQueue HANDLE }
func DeleteTimerQueueEx "BOOL WINAPI" cc="" { TimerQueue HANDLE; CompletionEvent HANDLE }
// Legacy thread-pool wait: invokes Callback (on a pool thread) when hObject is signalled. Used as
// the fallback for waiting on a process/event when the NtAssociateWaitCompletionPacket family is
// unavailable (e.g. Wine); see dispatch's process backend.
func RegisterWaitForSingleObject BOOL {
    phNewWaitObject PHANDLE
    hObject HANDLE
    Callback WAITORTIMERCALLBACK
    Context PVOID
    dwMilliseconds ULONG
    dwFlags ULONG
}
func UnregisterWaitEx BOOL { WaitHandle HANDLE; CompletionEvent HANDLE }
func UnregisterWait BOOL { WaitHandle HANDLE }
