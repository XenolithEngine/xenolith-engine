defaults dll=advapi32 link=import cc=WINAPI

func CryptAcquireContextW BOOL {
    phProv "HCRYPTPROV *"
    szContainer LPCWSTR
    szProvider LPCWSTR
    dwProvType DWORD
    dwFlags DWORD
}
func CryptReleaseContext BOOL { hProv HCRYPTPROV; dwFlags DWORD }
func CryptGenRandom BOOL { hProv HCRYPTPROV; dwLen DWORD; pbBuffer "BYTE *" }
func CertFreeCertificateContext BOOL dll=crypt32 { pCertContext PCCERT_CONTEXT }
func CertEnumCertificatesInStore PCCERT_CONTEXT dll=crypt32 {
    hCertStore HCERTSTORE
    pPrevCertContext PCCERT_CONTEXT
}
func CertFindCertificateInStore PCCERT_CONTEXT dll=crypt32 {
    hCertStore HCERTSTORE
    dwCertEncodingType DWORD
    dwFindFlags DWORD
    dwFindType DWORD
    pvFindPara "const void *"
    pPrevCertContext PCCERT_CONTEXT
}
func CertGetIntendedKeyUsage BOOL dll=crypt32 {
    dwCertEncodingType DWORD
    pCertInfo PCERT_INFO
    pbKeyUsage "BYTE *"
    cbKeyUsage DWORD
}
func CertGetEnhancedKeyUsage BOOL dll=crypt32 {
    pCertContext PCCERT_CONTEXT
    dwFlags DWORD
    pUsage PCERT_ENHKEY_USAGE
    pcbUsage "DWORD *"
}
func CertOpenSystemStoreA HCERTSTORE dll=crypt32 {
    hProv HCRYPTPROV_LEGACY
    szSubsystemProtocol LPCSTR
}
func CertOpenSystemStoreW HCERTSTORE dll=crypt32 {
    hProv HCRYPTPROV_LEGACY
    szSubsystemProtocol LPCWSTR
}
func CertCloseStore BOOL dll=crypt32 { hCertStore HCERTSTORE; dwFlags DWORD }
func CryptExportKey BOOL {
    hKey HCRYPTKEY
    hExpKey HCRYPTKEY
    dwBlobType DWORD
    dwFlags DWORD
    pbData "BYTE *"
    pdwDataLen "DWORD *"
}
func CryptImportKey BOOL {
    hProv HCRYPTPROV
    pbData "const BYTE *"
    dwDataLen DWORD
    hPubKey HCRYPTKEY
    dwFlags DWORD
    phKey "HCRYPTKEY *"
}
func CryptEncrypt BOOL {
    hKey HCRYPTKEY
    hHash HCRYPTHASH
    Final BOOL
    dwFlags DWORD
    pbData "BYTE *"
    pdwDataLen "DWORD *"
    dwBufLen DWORD
}
func CryptDecrypt BOOL {
    hKey HCRYPTKEY
    hHash HCRYPTHASH
    Final BOOL
    dwFlags DWORD
    pbData "BYTE *"
    pdwDataLen "DWORD *"
}
func CryptDestroyKey BOOL { hKey HCRYPTKEY }
func CryptGetHashParam BOOL {
    hHash HCRYPTHASH
    dwParam DWORD
    pbData "BYTE *"
    pdwDataLen "DWORD *"
    dwFlags DWORD
}
func CryptCreateHash BOOL {
    hProv HCRYPTPROV
    Algid ALG_ID
    hKey HCRYPTKEY
    dwFlags DWORD
    phHash "HCRYPTHASH *"
}
func CryptHashData BOOL { hHash HCRYPTHASH; pbData "const BYTE *"; dwDataLen DWORD; dwFlags DWORD }
func CryptHashSessionKey BOOL { hHash HCRYPTHASH; hKey HCRYPTKEY; dwFlags DWORD }
func CryptDestroyHash BOOL { hHash HCRYPTHASH }
