defaults dll=shell32 link=import cc=WINAPI

func SHGetKnownFolderPath HRESULT redeclare=#true {
    rfid REFKNOWNFOLDERID
    dwFlags DWORD
    hToken HANDLE
    ppszPath "LPWSTR *"
}
func ILCreateFromPathW PIDLIST_ABSOLUTE if="defined(__cplusplus)" stub=#false { pszPath PCWSTR }
func ILFree void if="defined(__cplusplus)" stub=#false { pidl PIDLIST_ABSOLUTE }
func SHCreateItemFromIDList HRESULT if="defined(__cplusplus)" stub=#false {
    pidl PCIDLIST_ABSOLUTE
    riid REFIID
    ppv "void **"
}
// Wraps a path as an IShellItem. Unlike SHCreateItemFromIDList this does not require the item to
// exist, which is what makes it usable for a save dialog's target directory.
func SHCreateItemFromParsingName HRESULT if="defined(__cplusplus)" stub=#false {
    pszPath PCWSTR
    pbc "void *"
    riid REFIID
    ppv "void **"
}
// Opens the containing folder with the given items selected — "reveal in Explorer". With cidl 0
// and apidl null it opens `pidlFolder` itself.
func SHOpenFolderAndSelectItems HRESULT if="defined(__cplusplus)" stub=#false {
    pidlFolder PCIDLIST_ABSOLUTE
    cidl UINT
    apidl PCUITEMID_CHILD_ARRAY
    dwFlags DWORD
}
