defaults dll=user32 link=import cc=WINAPI

func ShellExecuteA HINSTANCE dll=shell32 {
    hwnd HWND
    lpOperation LPCSTR
    lpFile LPCSTR
    lpParameters LPCSTR
    lpDirectory LPCSTR
    nShowCmd INT
}
func ShellExecuteW HINSTANCE dll=shell32 {
    hwnd HWND
    lpOperation LPCWSTR
    lpFile LPCWSTR
    lpParameters LPCWSTR
    lpDirectory LPCWSTR
    nShowCmd INT
}
func LoadImageW HANDLE { hInst HINSTANCE; name LPCWSTR; type UINT; cx int; cy int; fuLoad UINT }
func LoadCursorW HCURSOR { hInstance HINSTANCE; lpCursorName LPCWSTR }
func GetKeyState SHORT { nVirtKey int }
func GetWindowLongPtrW LONG_PTR { hWnd HWND; nIndex int }
func SetWindowLongPtrW LONG_PTR { hWnd HWND; nIndex int; dwNewLong LONG_PTR }
func CreateWindowExW HWND {
    dwExStyle DWORD
    lpClassName LPCWSTR
    lpWindowName LPCWSTR
    dwStyle DWORD
    X int
    Y int
    nWidth int
    nHeight int
    hWndParent HWND
    hMenu HMENU
    hInstance HINSTANCE
    lpParam LPVOID
}
func ShowWindow BOOL { hWnd HWND; nCmdShow int }
func SetForegroundWindow BOOL { hWnd HWND }
func SetActiveWindow HWND { hWnd HWND }
func SetFocus HWND { hWnd HWND }
func EnableWindow BOOL { hWnd HWND; bEnable BOOL }
func IsWindowEnabled BOOL { hWnd HWND }
func GetWindowRect BOOL { hWnd HWND; lpRect LPRECT }
func GetClientRect BOOL stub=#false { hWnd HWND; lpRect LPRECT }
func ClientToScreen BOOL stub=#false { hWnd HWND; lpPoint LPPOINT }
func ScreenToClient BOOL stub=#false { hWnd HWND; lpPoint LPPOINT }
func SetWindowLongW LONG { hWnd HWND; nIndex int; dwNewLong LONG }
func AdjustWindowRect BOOL { lpRect LPRECT; dwStyle DWORD; bMenu BOOL }
func AdjustWindowRectEx BOOL { lpRect LPRECT; dwStyle DWORD; bMenu BOOL; dwExStyle DWORD }
func DefWindowProcW LRESULT link=none cc="" { hWnd HWND; Msg UINT; wParam WPARAM; lParam LPARAM }
func SetWindowPos BOOL {
    hWnd HWND
    hWndInsertAfter HWND
    X int
    Y int
    cx int
    cy int
    uFlags UINT
}
func MonitorFromWindow HANDLE { hwnd HWND; dwFlags DWORD }
func GetDpiForWindow UINT { hwnd HWND }
func FlashWindow BOOL { hWnd HWND; bInvert BOOL }
func GetWindowPlacement BOOL { hWnd HWND; lpwndpl "WINDOWPLACEMENT *" }
func SetWindowPlacement BOOL { hWnd HWND; lpwndpl "const WINDOWPLACEMENT *" }
func DestroyWindow BOOL { hWnd HWND }
func SetCursor HCURSOR { hCursor HCURSOR }
func RegisterClassW ATOM { lpWndClass "const WNDCLASSW *" }
// The clipboard. Owned by a WINDOW, which is why the message-only window serves it: OpenClipboard
// takes one, and the delayed-rendering messages are delivered to whichever window took the selection.
//
// OpenClipboard can fail because another process holds the clipboard open - an ordinary outcome, not
// an error condition, and one a caller has to answer rather than retry forever.
func OpenClipboard BOOL stub=#false { hWndNewOwner HWND }
func CloseClipboard BOOL stub=#false empty=void
func EmptyClipboard BOOL stub=#false empty=void
// A null hMem declares DELAYED RENDERING: the owner is asked for the bytes with WM_RENDERFORMAT
// when someone actually pastes. With a handle, the clipboard TAKES OWNERSHIP of it.
func SetClipboardData HANDLE stub=#false { uFormat UINT; hMem HANDLE }
func GetClipboardData HANDLE stub=#false { uFormat UINT }
// Walk with 0 to start; returns 0 when there are no more. Requires an open clipboard.
func EnumClipboardFormats UINT stub=#false { format UINT }
func CountClipboardFormats int stub=#false empty=void
func IsClipboardFormatAvailable BOOL stub=#false { format UINT }
// Registers a format by NAME, which is how a MIME type reaches the Windows clipboard at all. The id
// is stable for the session and the same for every process that asks for the same name.
func RegisterClipboardFormatW UINT stub=#false { lpszFormat LPCWSTR }
func GetClipboardFormatNameW int stub=#false { format UINT; lpszFormatName LPWSTR; cchMaxCount int }
func GetClipboardOwner HWND stub=#false empty=void
// WM_CLIPBOARDUPDATE for as long as the window is listening.
func AddClipboardFormatListener BOOL stub=#false { hwnd HWND }
func RemoveClipboardFormatListener BOOL stub=#false { hwnd HWND }
func GetClipboardSequenceNumber DWORD stub=#false empty=void
func UnregisterClassW BOOL { lpClassName LPCWSTR; hInstance HINSTANCE }
func GetSystemMenu HMENU { hWnd HWND; bRevert BOOL }
func SetMenuItemInfoW BOOL { hmenu HMENU; item UINT; fByPositon BOOL; lpmii LPCMENUITEMINFOW }
func SetMenuDefaultItem BOOL { hMenu HMENU; uItem UINT; fByPos UINT }
func TrackPopupMenu BOOL {
    hMenu HMENU
