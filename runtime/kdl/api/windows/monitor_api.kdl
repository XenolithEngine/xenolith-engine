defaults dll=user32 link=import cc=WINAPI

func GetMonitorInfoW BOOL { hMonitor HMONITOR; lpmi LPMONITORINFO }
func GetNumberOfPhysicalMonitorsFromHMONITOR BOOL dll=dxva2 {
    hMonitor HMONITOR
    pdwNumberOfPhysicalMonitors LPDWORD
}
func GetPhysicalMonitorsFromHMONITOR BOOL dll=dxva2 {
    hMonitor HMONITOR
    dwPhysicalMonitorArraySize DWORD
    pPhysicalMonitorArray LPPHYSICAL_MONITOR
}
func SetProcessDpiAwareness HRESULT dll=shcore { value PROCESS_DPI_AWARENESS }
func GetProcessDpiAwareness HRESULT dll=shcore { hprocess HANDLE; value "PROCESS_DPI_AWARENESS *" }
func GetDpiForMonitor HRESULT dll=shcore {
    hmonitor HMONITOR
    dpiType MONITOR_DPI_TYPE
    dpiX "UINT *"
    dpiY "UINT *"
}
func EnumDisplayDevicesW BOOL {
    lpDevice LPCWSTR
    iDevNum DWORD
    lpDisplayDevice PDISPLAY_DEVICEW
    dwFlags DWORD
}
func CreateDCW HDC dll=gdi32 {
    pwszDriver LPCWSTR
    pwszDevice LPCWSTR
    pszPort LPCWSTR
    pdm "const DEVMODEW *"
}
func GetDeviceCaps int dll=gdi32 { hdc HDC; index int }
func EnumDisplayMonitors BOOL { hdc HDC; lprcClip LPCRECT; lpfnEnum MONITORENUMPROC; dwData LPARAM }
func DeleteDC BOOL dll=gdi32 { hdc HDC }
func EnumDisplaySettingsW BOOL { lpszDeviceName LPCWSTR; iModeNum DWORD; lpDevMode "DEVMODEW *" }
func ChangeDisplaySettingsExW LONG {
    lpszDeviceName LPCWSTR
    lpDevMode "DEVMODEW *"
    hwnd HWND
    dwflags DWORD
    lParam LPVOID
}
func DestroyPhysicalMonitor BOOL dll=dxva2 { hMonitor HANDLE }
func DestroyPhysicalMonitors BOOL dll=dxva2 {
    dwPhysicalMonitorArraySize DWORD
    pPhysicalMonitorArray LPPHYSICAL_MONITOR
}
func SetProcessDpiAwarenessContext BOOL { value DPI_AWARENESS_CONTEXT }
func GetSystemMetricsForDpi int { nIndex int; dpi UINT }
func SetupDiOpenDevRegKey HKEY dll=setupapi {
    DeviceInfoSet HDEVINFO
    DeviceInfoData PSP_DEVINFO_DATA
    Scope DWORD
    HwProfile DWORD
    KeyType DWORD
    samDesired REGSAM
}
func SetupDiGetClassDevsExW HDEVINFO dll=setupapi {
    ClassGuid "const GUID *"
    Enumerator PCWSTR
    hwndParent HWND
    Flags DWORD
    DeviceInfoSet HDEVINFO
    MachineName PCWSTR
    Reserved PVOID
}
func SetupDiEnumDeviceInterfaces BOOL dll=setupapi {
    DeviceInfoSet HDEVINFO
    DeviceInfoData PSP_DEVINFO_DATA
    InterfaceClassGuid "const GUID *"
    MemberIndex DWORD
    DeviceInterfaceData PSP_DEVICE_INTERFACE_DATA
}
func SetupDiGetDeviceInterfaceDetailW BOOL dll=setupapi {
    DeviceInfoSet HDEVINFO
    DeviceInterfaceData PSP_DEVICE_INTERFACE_DATA
    DeviceInterfaceDetailData PSP_DEVICE_INTERFACE_DETAIL_DATA_W
    DeviceInterfaceDetailDataSize DWORD
    RequiredSize PDWORD
    DeviceInfoData PSP_DEVINFO_DATA
}
func SetupDiDestroyDeviceInfoList BOOL dll=setupapi { DeviceInfoSet HDEVINFO }
