defaults dll=advapi32 link=import cc=WINAPI

func AllocateAndInitializeSid BOOL {
    pIdentifierAuthority PSID_IDENTIFIER_AUTHORITY
    nSubAuthorityCount BYTE
    nSubAuthority0 DWORD
    nSubAuthority1 DWORD
    nSubAuthority2 DWORD
    nSubAuthority3 DWORD
    nSubAuthority4 DWORD
    nSubAuthority5 DWORD
    nSubAuthority6 DWORD
    nSubAuthority7 DWORD
    pSid "PSID *"
}
func GetSidSubAuthorityCount LPBYTE { Sid LPSID }
func GetSidSubAuthority LPDWORD { Sid LPSID; nSubAuthority DWORD }
func FreeSid PVOID { pSid PSID }
func GetSecurityInfo DWORD {
    handle HANDLE
    ObjectType SE_OBJECT_TYPE
    SecurityInfo SECURITY_INFORMATION
    ppsidOwner "PSID *"
    ppsidGroup "PSID *"
    ppDacl "PACL *"
    ppSacl "PACL *"
    ppSecurityDescriptor "PSECURITY_DESCRIPTOR *"
}
func CreateAppContainerProfile HRESULT dll=userenv {
    pszAppContainerName PCWSTR
    pszDisplayName PCWSTR
    pszDescription PCWSTR
    pCapabilities PSID_AND_ATTRIBUTES
    dwCapabilityCount DWORD
    ppSidAppContainerSid "PSID *"
}
func DeriveAppContainerSidFromAppContainerName HRESULT dll=userenv {
    pszAppContainerName PCWSTR
    ppsidAppContainerSid "PSID *"
}
func GetAppContainerFolderPath HRESULT dll=userenv { pszAppContainerSid PCWSTR; ppszPath "PWSTR *" }
func DeleteAppContainerProfile HRESULT dll=userenv { pszAppContainerName PCWSTR }
func GetNamedSecurityInfoW DWORD {
    pObjectName LPCWSTR
    ObjectType SE_OBJECT_TYPE
    SecurityInfo SECURITY_INFORMATION
    ppsidOwner "PSID *"
    ppsidGroup "PSID *"
    ppDacl "PACL *"
    ppSacl "PACL *"
    ppSecurityDescriptor "PSECURITY_DESCRIPTOR *"
}
func SetEntriesInAclW DWORD {
    cCountOfExplicitEntries ULONG
    pListOfExplicitEntries PEXPLICIT_ACCESS_W
    OldAcl PACL
    NewAcl "PACL *"
}
func SetNamedSecurityInfoW DWORD {
    pObjectName LPWSTR
    ObjectType SE_OBJECT_TYPE
    SecurityInfo SECURITY_INFORMATION
    psidOwner PSID
    psidGroup PSID
    pDacl PACL
    pSacl PACL
}
func ConvertSidToStringSidW BOOL { Sid PSID; StringSid "LPWSTR *" }
func CloseWindowStation BOOL dll=user32 { hWinSta HWINSTA }
func SetProcessWindowStation BOOL dll=user32 { hWinSta HWINSTA }
func GetProcessWindowStation HWINSTA dll=user32 empty=VOID
func GetUserObjectInformationW BOOL dll=user32 {
    hObj HANDLE
    nIndex int
    pvInfo PVOID
    nLength DWORD
    lpnLengthNeeded LPDWORD
}
func RegisterEventSourceW HANDLE { lpUNCServerName LPCWSTR; lpSourceName LPCWSTR }
func DeregisterEventSource BOOL { hEventLog HANDLE }
func ReportEventW BOOL {
    hEventLog HANDLE
    wType WORD
    wCategory WORD
    dwEventID DWORD
    lpUserSid PSID
    wNumStrings WORD
    dwDataSize DWORD
    lpStrings "LPCWSTR *"
    lpRawData LPVOID
}
func LookupPrivilegeValueA BOOL { lpSystemName LPCSTR; lpName LPCSTR; lpLuid PLUID }
func LookupPrivilegeValueW BOOL { lpSystemName LPCWSTR; lpName LPCWSTR; lpLuid PLUID }
func AdjustTokenPrivileges BOOL {
    TokenHandle HANDLE
    DisableAllPrivileges BOOL
    NewState PTOKEN_PRIVILEGES
    BufferLength DWORD
    PreviousState PTOKEN_PRIVILEGES
    ReturnLength PDWORD
}
