defaults dll=kernel32 link=import cc=WINAPI

func CreateFileW HANDLE dll=kernelbase {
    lpFileName LPCWSTR
    dwDesiredAccess DWORD
    dwShareMode DWORD
    lpSecurityAttributes LPSECURITY_ATTRIBUTES
    dwCreationDisposition DWORD
    dwFlagsAndAttributes DWORD
    hTemplateFile HANDLE
}
func CreateFileA HANDLE dll=kernelbase {
    lpFileName LPCSTR
    dwDesiredAccess DWORD
    dwShareMode DWORD
    lpSecurityAttributes LPSECURITY_ATTRIBUTES
    dwCreationDisposition DWORD
    dwFlagsAndAttributes DWORD
    hTemplateFile HANDLE
}
func ReadFile BOOL {
    hFile HANDLE
    lpBuffer LPVOID
    nNumberOfBytesToRead DWORD
    lpNumberOfBytesRead LPDWORD
    lpOverlapped LPOVERLAPPED
}
func WriteFile BOOL {
    hFile HANDLE
    lpBuffer LPCVOID
    nNumberOfBytesToWrite DWORD
    lpNumberOfBytesWritten LPDWORD
    lpOverlapped LPOVERLAPPED
}
func GetOverlappedResult BOOL stub=#false {
    hFile HANDLE
    lpOverlapped LPOVERLAPPED
    lpNumberOfBytesTransferred LPDWORD
    bWait BOOL
}
typedef LPOVERLAPPED_COMPLETION_ROUTINE "void (*)(DWORD dwErrorCode, DWORD dwNumberOfBytesTransfered, LPOVERLAPPED lpOverlapped)"
