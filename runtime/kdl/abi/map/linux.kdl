header "sprt/gen/c/cross/linux_sprt/locale.h"

header "sprt/gen/c/cross/linux_sprt/loongarch64_sprt/config.h"

header "sprt/gen/c/cross/linux_sprt/loongarch64_sprt/fcntl.h" abi="cross/shared/linux/loongarch64+riscv64+x86_64/fcntl.kdl"

header "sprt/gen/c/cross/linux_sprt/loongarch64_sprt/fenv.h"

header "sprt/gen/c/cross/linux_sprt/loongarch64_sprt/jmp_buf.h"

header "sprt/gen/c/cross/linux_sprt/loongarch64_sprt/signal.h" abi="cross/shared/linux+wasm/aarch64+e2k+loongarch64+riscv64+wasm32+wasm64+x86_64/signal.kdl"

header "sprt/gen/c/cross/linux_sprt/loongarch64_sprt/syscall.h"

header "sprt/gen/c/cross/linux_sprt/math.h" abi="cross/shared/linux+wasm+windows/math.kdl"

