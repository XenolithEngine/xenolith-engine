// The linux platform: the cross fragments under sprt/gen/c/cross/linux_sprt.

platforms { platform linux_sprt { arch aarch64_sprt e2k_sprt loongarch64_sprt riscv64_sprt x86_64_sprt; arch e2k128_sprt like=e2k_sprt; arch e2k32_sprt like=e2k_sprt; }; }

header "sprt/gen/c/cross/linux_sprt/aarch64_sprt/config.h"

header "sprt/gen/c/cross/linux_sprt/aarch64_sprt/fcntl.h"

header "sprt/gen/c/cross/linux_sprt/aarch64_sprt/fenv.h"

header "sprt/gen/c/cross/linux_sprt/aarch64_sprt/jmp_buf.h"

header "sprt/gen/c/cross/linux_sprt/aarch64_sprt/signal.h" abi="cross/shared/linux+wasm/aarch64+e2k+loongarch64+riscv64+wasm32+wasm64+x86_64/signal.kdl"

header "sprt/gen/c/cross/linux_sprt/aarch64_sprt/syscall.h" abi="cross/shared/android+linux/aarch64+riscv64/syscall.kdl"

header "sprt/gen/c/cross/linux_sprt/clockid.h" abi="cross/shared/android+linux+wasm+windows/clockid.kdl"

header "sprt/gen/c/cross/linux_sprt/config.h"

header "sprt/gen/c/cross/linux_sprt/dir_ptr.h" abi="cross/shared/linux+wasm+windows/dir_ptr.kdl"

header "sprt/gen/c/cross/linux_sprt/e2k_sprt/config.h"

header "sprt/gen/c/cross/linux_sprt/e2k_sprt/fcntl.h"

header "sprt/gen/c/cross/linux_sprt/e2k_sprt/fenv.h"

header "sprt/gen/c/cross/linux_sprt/e2k_sprt/jmp_buf.h"

header "sprt/gen/c/cross/linux_sprt/e2k_sprt/signal.h" abi="cross/shared/linux+wasm/aarch64+e2k+loongarch64+riscv64+wasm32+wasm64+x86_64/signal.kdl"

header "sprt/gen/c/cross/linux_sprt/e2k_sprt/syscall.h"

header "sprt/gen/c/cross/linux_sprt/errno.h" abi="cross/shared/linux+wasm/errno.kdl" guard=CORE_RUNTIME_INCLUDE_C_CROSS_LINUX_SPRT_ERRNO_H_

header "sprt/gen/c/cross/linux_sprt/fdset.h" abi="cross/shared/android+linux+macos+wasm/fdset.kdl"

header "sprt/gen/c/cross/linux_sprt/file_ptr.h"

