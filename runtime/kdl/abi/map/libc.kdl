    include "sprt/gen/c/cross/macos_sprt/errno.h" if="!(SPRT_IOS) && SPRT_MACOS"
    include "sprt/gen/c/cross/android_sprt/errno.h" if="!(SPRT_IOS) && !(SPRT_MACOS) && SPRT_ANDROID"
    include "sprt/gen/c/cross/linux_sprt/errno.h" if="!(SPRT_IOS) && !(SPRT_MACOS) && !(SPRT_ANDROID) && SPRT_LINUX"
    include "sprt/gen/c/cross/nuttx_sprt/errno.h" if="!(SPRT_IOS) && !(SPRT_MACOS) && !(SPRT_ANDROID) && !(SPRT_LINUX) && SPRT_NUTTX"
    include "sprt/gen/c/cross/embox_sprt/errno.h" if="!(SPRT_IOS) && !(SPRT_MACOS) && !(SPRT_ANDROID) && !(SPRT_LINUX) && !(SPRT_NUTTX) && SPRT_EMBOX"
    include "sprt/gen/c/cross/embox_user_sprt/errno.h" if="!(SPRT_IOS) && !(SPRT_MACOS) && !(SPRT_ANDROID) && !(SPRT_LINUX) && !(SPRT_NUTTX) && !(SPRT_EMBOX) && SPRT_EMBOX_USER"
    include "sprt/gen/c/cross/tau_sprt/errno.h" if="!(SPRT_IOS) && !(SPRT_MACOS) && !(SPRT_ANDROID) && !(SPRT_LINUX) && !(SPRT_NUTTX) && !(SPRT_EMBOX) && !(SPRT_EMBOX_USER) && SPRT_TAU"
    include "sprt/gen/c/cross/windows_sprt/errno.h" if="!(SPRT_IOS) && !(SPRT_MACOS) && !(SPRT_ANDROID) && !(SPRT_LINUX) && !(SPRT_NUTTX) && !(SPRT_EMBOX) && !(SPRT_EMBOX_USER) && !(SPRT_TAU) && SPRT_WINDOWS"
    include "sprt/gen/c/cross/linux_sprt/errno.h" if="!(SPRT_IOS) && !(SPRT_MACOS) && !(SPRT_ANDROID) && !(SPRT_LINUX) && !(SPRT_NUTTX) && !(SPRT_EMBOX) && !(SPRT_EMBOX_USER) && !(SPRT_TAU) && !(SPRT_WINDOWS)"
}

