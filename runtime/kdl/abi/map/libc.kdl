    type (p)CPU_ALLOC (p)CPU_ALLOC_SIZE (p)CPU_AND (p)CPU_AND_S (p)CPU_CLR (p)CPU_CLR_S
    type (p)CPU_COUNT (p)CPU_COUNT_S (p)CPU_EQUAL (p)CPU_EQUAL_S (p)CPU_FREE (p)CPU_ISSET
    type (p)CPU_ISSET_S (p)CPU_OR (p)CPU_OR_S (p)CPU_SET (p)CPU_SETSIZE (p)CPU_SET_S
    type (p)CPU_XOR (p)CPU_XOR_S (p)CPU_ZERO (p)CPU_ZERO_S (p)CPU_op_S (p)CPU_op_func_S
    type (id)cpu_set_t
}

header "sprt/c/bits/__sprt_def.h" external=#true {
    include "sprt/c/bits/__sprt_config.h"
    include "sprt/gen/c/bits/__sprt_targets.h"
    type CORE_RUNTIME_INCLUDE_C_BITS___SPRT_DEF_H_ DEBUG SPRT_ALIGNAS SPRT_ALWAYSINLINE SPRT_API SPRT_FORCEINLINE
    type SPRT_GLOBAL SPRT_INTERNAL SPRT_LAMBDAINLINE SPRT_LOCAL SPRT_NOEXCEPT SPRT_NO_UNIQUE_ADDRESS
    type SPRT_TEMPLATE_API SPRT_UMBRELLA_END SPRT_UMBRELLA_END_EXCEPT SPRT_UMBRELLA_FUNC SPRT_UMBRELLA_REQUIRED __SPRT_ID
    type (p)ATTR (p)ATTR_GNU (p)BEGIN_DECL (p)C_FUNC (p)DLLEXPORT (p)DLLIMPORT
    type (p)EMPTY_BASES (p)END_DECL (p)FALLBACK_ATTR (p)FUNCTION__ (p)HAS_ATTR (p)HAS_BUILTIN
    type (p)HIDDEN (p)NOEXCEPT (p)NORETURN (p)RESTRICT (p)STDC_11__ (p)STDC_17__
    type (p)STDC_23__ (p)STDC_NONE__ (p)VISIBLE
}

