// The libc ABI shared by every platform: sprt/gen/c/bits, the cross dispatchers, and the
// hand-written headers they include.

header "sprt/c/__sprt_string.h" external=#true {
    include "sprt/c/bits/__sprt_def.h"
    include "sprt/gen/c/bits/__sprt_size_t.h"
    include "sprt/gen/c/bits/__sprt_null.h"
    include "sprt/gen/c/cross/__sprt_locale.h"
    type CORE_RUNTIME_INCLUDE_C___SPRT_STRING_H_ __sprt_memchr __sprt_memcmp __sprt_memcpy __sprt_memmove __sprt_memset
    type __sprt_strcat __sprt_strchr __sprt_strcmp __sprt_strcoll __sprt_strcpy __sprt_strcspn
    type __sprt_strerror __sprt_strlen __sprt_strncat __sprt_strncmp __sprt_strncpy __sprt_strnlen
    type __sprt_strpbrk __sprt_strrchr __sprt_strspn __sprt_strstr __sprt_strtok __sprt_strxfrm
    type (id)errno_t
}

header "sprt/c/bits/__sprt_config.h" external=#true {
    type SPRT_STD_THREADING_SPRT
    type (p)CONFIG_COMPILER_ASSISTED_INTS (p)CONFIG_DEFINE_UNAVAILABLE_FUNCTIONS (p)STD_EXTERNAL (p)STD_OWNED_BEGIN (p)STD_OWNED_END (p)USE_LIBCXX_SOURCE_LOCATION
    type (p)USE_STL (p)USE_STL_COMPARATORS (p)USE_STL_ITERATOR_TAGS
}

header "sprt/c/bits/__sprt_cpuset_t.h" external=#true {
    include "sprt/c/bits/__sprt_def.h"
