// Native Linux (asm-generic) errno numbers, mirrored from the kernel uapi. The sprt runtime
// routes its errno cell to the libc __errno_location() on Linux, so these MUST equal the
// system values — verify against glibc/musl on a hosted build.
macro EPERM 1 public=#true
macro ENOENT 2 public=#true
macro ESRCH 3 public=#true
macro EINTR 4 public=#true
macro EIO 5 public=#true
macro ENXIO 6 public=#true
macro E2BIG 7 public=#true
macro ENOEXEC 8 public=#true
macro EBADF 9 public=#true
macro ECHILD 10 public=#true
macro EAGAIN 11 public=#true
macro ENOMEM 12 public=#true
macro EACCES 13 public=#true
macro EFAULT 14 public=#true
macro ENOTBLK 15 public=#true
macro EBUSY 16 public=#true
macro EEXIST 17 public=#true
macro EXDEV 18 public=#true
macro ENODEV 19 public=#true
macro ENOTDIR 20 public=#true
macro EISDIR 21 public=#true
macro EINVAL 22 public=#true
macro ENFILE 23 public=#true
macro EMFILE 24 public=#true
macro ENOTTY 25 public=#true
macro ETXTBSY 26 public=#true
macro EFBIG 27 public=#true
macro ENOSPC 28 public=#true
macro ESPIPE 29 public=#true
macro EROFS 30 public=#true
macro EMLINK 31 public=#true
macro EPIPE 32 public=#true
macro EDOM 33 public=#true
macro ERANGE 34 public=#true
macro EDEADLK 35 public=#true
