// Native Embox errno numbers from src/compat/libc/include/errno.h.
// Several values diverge from Linux (EPERM=1001, network errors in the 3xx range).
//
// Embox declares only ~90 of the codes sprt's canonical <errno.h> exposes. The
// rest are kept here - portable code names them, and errno_canonical.h maps a few
// unconditionally - at their Linux numbers, which are free on Embox. Their
// equality asserts in libc_wrapper/c/common/errno.cc are skipped for Embox alone,
// since there is no native constant to compare against.
macro EPERM 1001 public=#true
macro ENOENT 2 public=#true
macro ESRCH 3 public=#true
macro EINTR 4 public=#true
macro EIO 5 public=#true
macro ENXIO 300 public=#true
macro E2BIG 7 public=#true
macro ENOEXEC 8 public=#true
macro EBADF 9 public=#true
macro ECHILD 10 public=#true
macro EAGAIN 11 public=#true
macro ENOMEM 12 public=#true
macro EACCES 301 public=#true
macro EFAULT 14 public=#true
macro ENOTBLK 15 public=#true
macro EBUSY 16 public=#true
macro EEXIST 302 public=#true
macro EXDEV 18 public=#true
macro ENODEV 19 public=#true
macro ENOTDIR 20 public=#true
macro EISDIR 21 public=#true
macro EINVAL 22 public=#true
macro ENFILE 23 public=#true
macro EMFILE 24 public=#true
macro ENOTTY 303 public=#true
macro ETXTBSY 26 public=#true
macro EFBIG 27 public=#true
macro ENOSPC 28 public=#true
macro ESPIPE 29 public=#true
macro EROFS 30 public=#true
macro EMLINK 31 public=#true
macro EPIPE 304 public=#true
macro EDOM 33 public=#true
macro ERANGE 34 public=#true
macro EDEADLK 35 public=#true
macro ENAMETOOLONG 36 public=#true
macro ENOLCK 203 public=#true
macro ENOSYS 38 public=#true
macro ENOTEMPTY 66 public=#true
macro ELOOP 40 public=#true
macro EWOULDBLOCK EAGAIN public=#true
macro ENOMSG 42 public=#true
macro EIDRM 43 public=#true
macro ECHRNG 44 public=#true
macro EL2NSYNC 45 public=#true
macro EL3HLT 46 public=#true
macro EL3RST 47 public=#true
macro ELNRNG 48 public=#true
macro EUNATCH 49 public=#true
macro ENOCSI 50 public=#true
macro EL2HLT 51 public=#true
macro EBADE 52 public=#true
macro EBADR 53 public=#true
macro EXFULL 54 public=#true
macro ENOANO 55 public=#true
macro EBADRQC 56 public=#true
macro EBADSLT 57 public=#true
macro EDEADLOCK EDEADLK public=#true
macro EBFONT 59 public=#true
macro ENOSTR 60 public=#true
macro ENODATA 61 public=#true
macro ETIME 62 public=#true
macro ENOSR 63 public=#true
macro ENONET 64 public=#true
macro ENOPKG 65 public=#true
// Embox has no EREMOTE. The Linux number (66) is its ENOTEMPTY, so a canonical
// mapping through it would turn "directory not empty" into "object is remote";
// give it a value outside every range Embox assigns instead.
macro EREMOTE 400 public=#true
macro ENOLINK 67 public=#true
macro EADV 68 public=#true
macro ESRMNT 69 public=#true
macro ECOMM 70 public=#true
macro EPROTO 71 public=#true
macro EMULTIHOP 72 public=#true
macro EDOTDOT 73 public=#true
macro EBADMSG 74 public=#true
macro EOVERFLOW 75 public=#true
macro ENOTUNIQ 76 public=#true
macro EBADFD 77 public=#true
macro EREMCHG 78 public=#true
macro ELIBACC 79 public=#true
macro ELIBBAD 80 public=#true
macro ELIBSCN 81 public=#true
macro ELIBMAX 82 public=#true
macro ELIBEXEC 83 public=#true
macro EILSEQ 84 public=#true
macro ERESTART 85 public=#true
macro ESTRPIPE 86 public=#true
macro EUSERS 87 public=#true
macro ENOTSOCK 320 public=#true
macro EDESTADDRREQ 321 public=#true
macro EMSGSIZE 322 public=#true
macro EPROTOTYPE 323 public=#true
macro ENOPROTOOPT 324 public=#true
macro EPROTONOSUPPORT 325 public=#true
macro ESOCKTNOSUPPORT 326 public=#true
macro EOPNOTSUPP 327 public=#true
macro ENOTSUP 95 public=#true
macro EPFNOSUPPORT 328 public=#true
macro EAFNOSUPPORT 329 public=#true
macro EADDRINUSE 330 public=#true
macro EADDRNOTAVAIL 331 public=#true
macro ENETDOWN 350 public=#true
macro ENETUNREACH 351 public=#true
macro ENETRESET 352 public=#true
macro ECONNABORTED 353 public=#true
macro ECONNRESET 354 public=#true
macro ENOBUFS 355 public=#true
macro EISCONN 356 public=#true
macro ENOTCONN 357 public=#true
macro ESHUTDOWN 358 public=#true
macro ETOOMANYREFS 359 public=#true
macro ETIMEDOUT 360 public=#true
macro ECONNREFUSED 361 public=#true
macro EHOSTDOWN 364 public=#true
macro EHOSTUNREACH 365 public=#true
macro EALREADY 311 public=#true
macro EINPROGRESS 310 public=#true
macro ESTALE 116 public=#true
macro EUCLEAN 117 public=#true
macro ENOTNAM 118 public=#true
macro ENAVAIL 119 public=#true
macro EISNAM 120 public=#true
macro EREMOTEIO 121 public=#true
macro EDQUOT 122 public=#true
macro ENOMEDIUM 123 public=#true
macro EMEDIUMTYPE 124 public=#true
macro ECANCELED 125 public=#true
macro ENOKEY 126 public=#true
macro EKEYEXPIRED 127 public=#true
macro EKEYREVOKED 128 public=#true
macro EKEYREJECTED 129 public=#true
macro EOWNERDEAD 130 public=#true
macro ENOTRECOVERABLE 131 public=#true
