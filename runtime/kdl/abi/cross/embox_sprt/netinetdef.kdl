macro IPV6_MULTICAST_ALL 0x1050
macro IPV6_ROUTER_ALERT_ISOLATE 0x1051
macro IPV6_IPSEC_POLICY 0x1052
macro IPV6_XFRM_POLICY 0x1053
macro IPV6_HDRINCL 0x1054
macro IPV6_RECVHOPOPTS 0x1055
macro IPV6_HOPOPTS 0x1056
macro IPV6_RXHOPOPTS IPV6_HOPOPTS
macro IPV6_RTHDRDSTOPTS 0x1057
macro IPV6_RECVRTHDR 0x1058
macro IPV6_RTHDR 0x1059
macro IPV6_RECVDSTOPTS 0x105a
macro IPV6_DSTOPTS 0x105b
macro IPV6_RXDSTOPTS IPV6_DSTOPTS
macro IPV6_RECVPATHMTU 0x105c
macro IPV6_PATHMTU 0x105d
macro IPV6_DONTFRAG 0x105e
macro IPV6_RECVTCLASS 0x105f
macro IPV6_AUTOFLOWLABEL 0x1060
macro IPV6_ADDR_PREFERENCES 0x1061
macro IPV6_MINHOPCOUNT 0x1062
macro IPV6_ORIGDSTADDR 0x1063
macro IPV6_RECVORIGDSTADDR IPV6_ORIGDSTADDR
macro IPV6_TRANSPARENT 0x1064
macro IPV6_UNICAST_IF 0x1065
macro IPV6_RECVFRAGSIZE 0x1066
macro IPV6_FREEBIND 0x1067
macro IPV6_PMTUDISC_DONT 0
macro IPV6_PMTUDISC_WANT 1
macro IPV6_PMTUDISC_DO 2
macro IPV6_PMTUDISC_PROBE 3
macro IPV6_PMTUDISC_INTERFACE 4
