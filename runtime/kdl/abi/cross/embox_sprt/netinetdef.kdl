// Embox netinet option numbers. The IPPROTO_* protocol numbers are IANA's and match
// Linux, but the socket options at each protocol level are numbered from 1 in
// Embox's own order - IP_MULTICAST_IF is 1 there, not 32, and IPV6_MULTICAST_IF is
// 20, not 17. setsockopt() gets these untranslated, so the table has to be Embox's.
//
// Options Embox does not implement keep a distinct value above 0x1000, clear of the
// windows it actually uses, so an unsupported request fails with ENOPROTOOPT
// instead of setting a different option; their asserts in SPRuntimeCSysSocket.cpp
// are #ifdef'd on the native spelling.
//
// NB: Embox's own IP_TOS/IP_TTL/IP_HDRINCL (1/2/3) collide with its
// IP_MULTICAST_IF/IP_MULTICAST_TTL/IP_MULTICAST_LOOP (1/2/3). That is the
// platform's numbering, mirrored here as-is - the asserts below pin both sides.
macro INET_ADDRSTRLEN 16
macro INET6_ADDRSTRLEN 46
macro IPPORT_RESERVED 1024
macro IPPROTO_IP 0
macro IPPROTO_HOPOPTS 0
macro IPPROTO_ICMP 1
macro IPPROTO_IGMP 2
macro IPPROTO_IPIP 4
macro IPPROTO_TCP 6
macro IPPROTO_EGP 8
macro IPPROTO_PUP 12
macro IPPROTO_UDP 17
macro IPPROTO_IDP 22
macro IPPROTO_TP 29
macro IPPROTO_DCCP 33
macro IPPROTO_IPV6 41
macro IPPROTO_ROUTING 43
macro IPPROTO_FRAGMENT 44
macro IPPROTO_RSVP 46
macro IPPROTO_GRE 47
macro IPPROTO_ESP 50
macro IPPROTO_AH 51
macro IPPROTO_ICMPV6 58
macro IPPROTO_NONE 59
macro IPPROTO_DSTOPTS 60
macro IPPROTO_MTP 92
macro IPPROTO_BEETPH 94
macro IPPROTO_ENCAP 98
macro IPPROTO_PIM 103
macro IPPROTO_COMP 108
macro IPPROTO_SCTP 132
macro IPPROTO_UDPLITE 136
macro IPPROTO_MPLS 137
macro IPPROTO_RAW 255
// Not declared by Embox; the IANA numbers are kept.
macro IPPROTO_MH 135
macro IPPROTO_ETHERNET 143
macro IPPROTO_MPTCP 262
// Embox's enum ends one past IPPROTO_RAW.
macro IPPROTO_MAX 256
// --- IPPROTO_IP level ---------------------------------------------------------
// NuttX: __SO_PROTOCOL is 16.
macro IP_MULTICAST_IF 1
macro IP_MULTICAST_TTL 2
macro IP_MULTICAST_LOOP 3
macro IP_ADD_MEMBERSHIP 4
macro IP_DROP_MEMBERSHIP 5
macro IP_UNBLOCK_SOURCE 6
macro IP_BLOCK_SOURCE 7
macro IP_ADD_SOURCE_MEMBERSHIP 8
macro IP_DROP_SOURCE_MEMBERSHIP 9
macro IP_MSFILTER 10
macro IP_MULTICAST_ALL 11
macro IP_PKTINFO 12
macro IP_TOS 0x01
macro IP_TTL 0x02
macro IP_HDRINCL 0x03
// Unimplemented by Embox.
macro IP_OPTIONS 0x1001
macro IP_ROUTER_ALERT 0x1002
macro IP_RECVOPTS 0x1003
macro IP_RETOPTS 0x1004
macro IP_RECVRETOPTS IP_RETOPTS
macro IP_PKTOPTIONS 0x1005
macro IP_PMTUDISC 0x1006
macro IP_MTU_DISCOVER IP_PMTUDISC
macro IP_RECVERR 0x1007
macro IP_RECVTTL 0x1008
macro IP_RECVTOS 0x1009
macro IP_MTU 0x100a
macro IP_FREEBIND 0x100b
macro IP_IPSEC_POLICY 0x100c
macro IP_XFRM_POLICY 0x100d
macro IP_PASSSEC 0x100e
macro IP_TRANSPARENT 0x100f
macro IP_ORIGDSTADDR 0x1010
macro IP_RECVORIGDSTADDR IP_ORIGDSTADDR
macro IP_MINTTL 0x1011
macro IP_NODEFRAG 0x1012
macro IP_CHECKSUM 0x1013
macro IP_BIND_ADDRESS_NO_PORT 0x1014
macro IP_RECVFRAGSIZE 0x1015
macro IP_RECVERR_RFC4884 0x1016
macro IP_UNICAST_IF 0x1017
macro IP_PMTUDISC_DONT 0
macro IP_PMTUDISC_WANT 1
macro IP_PMTUDISC_DO 2
macro IP_PMTUDISC_PROBE 3
macro IP_PMTUDISC_INTERFACE 4
macro IP_PMTUDISC_OMIT 5
macro IP_DEFAULT_MULTICAST_TTL 1
macro IP_DEFAULT_MULTICAST_LOOP 1
macro IP_MAX_MEMBERSHIPS 20
// MCAST_* (RFC 3678 protocol-independent multicast) - not in Embox.
macro MCAST_JOIN_GROUP 0x1030
macro MCAST_BLOCK_SOURCE 0x1031
macro MCAST_UNBLOCK_SOURCE 0x1032
macro MCAST_LEAVE_GROUP 0x1033
macro MCAST_JOIN_SOURCE_GROUP 0x1034
macro MCAST_LEAVE_SOURCE_GROUP 0x1035
macro MCAST_MSFILTER 0x1036
macro MCAST_EXCLUDE 0
macro MCAST_INCLUDE 1
// --- IPPROTO_IPV6 level -------------------------------------------------------
macro IPV6_JOIN_GROUP 22
macro IPV6_LEAVE_GROUP 21
macro IPV6_MULTICAST_HOPS 25
macro IPV6_MULTICAST_IF 20
macro IPV6_MULTICAST_LOOP 23
macro IPV6_UNICAST_HOPS 24
macro IPV6_V6ONLY 28
macro IPV6_PKTINFO 0x1068
macro IPV6_RECVPKTINFO 0x1069
macro IPV6_TCLASS 0x106a
macro IPV6_RECVHOPLIMIT 0x106b
macro IPV6_HOPLIMIT 0x106c
// Embox gives these their own numbers rather than aliasing JOIN/LEAVE_GROUP.
macro IPV6_ADD_MEMBERSHIP 26
macro IPV6_DROP_MEMBERSHIP 27
