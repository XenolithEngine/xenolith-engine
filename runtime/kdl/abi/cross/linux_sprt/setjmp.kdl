cond native_jmp_buf_defined "!defined(NATIVE_JMP_BUF_DEFINED)"
struct (id)__jmp_buf_tag if="@native_jmp_buf_defined" {
    field __jb __jmp_buf
    field __fl "unsigned long"
    field __ss "unsigned long [128 / sizeof(long)]"
}
typedef native_jmp_buf "struct __jmp_buf_tag [1]" if="@native_jmp_buf_defined"
typedef native_sigjmp_buf native_jmp_buf if="@native_jmp_buf_defined"
