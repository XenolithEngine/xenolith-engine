macro MSG_CTRUNC 0x0008
macro MSG_TRUNC 0x0020
macro MSG_DONTWAIT 0x0040
macro MSG_EOR 0x0080
macro MSG_WAITALL 0x0100
macro MSG_NOSIGNAL 0x4000
macro SOMAXCONN 128
// Platform-specific extras (namespaced with __SPRT_*) so they never collide with the
