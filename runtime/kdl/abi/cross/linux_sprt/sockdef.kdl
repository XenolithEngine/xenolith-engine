// PF_MAX follows the libc, not the arch: glibc >= 2.35 knows PF_MCTP (46), while
// glibc 2.33 (x86_64/aarch64 targets) and musl stop at 45. riscv64 is pinned to
// glibc 2.35, loongarch64 to 2.36.
macro PF_MAX 46 if="(ARCH_ID == ARCH_ID_RISCV64 || ARCH_ID == ARCH_ID_LOONGARCH64) && !__SPRT_LINUX_MUSL"
macro PF_MAX 45 if="!((ARCH_ID == ARCH_ID_RISCV64 || ARCH_ID == ARCH_ID_LOONGARCH64) && !__SPRT_LINUX_MUSL)"
