// Portable core socket constants, namespaced (__SPRT_*) so they are safe to include on
// every build; <sys/socket.h> expands the public names from these, and each is
// static_asserted against the native header in SPRuntimeCSysSocket.cpp.
macro SHUT_RD 0
macro SHUT_WR 1
macro SHUT_RDWR 2
macro SOCK_STREAM 1
macro SOCK_DGRAM 2
macro SOCK_RAW 3
macro SOCK_SEQPACKET 5
macro SOCK_CLOEXEC "02000000"
macro SOCK_NONBLOCK "04000"
macro AF_UNSPEC 0
macro AF_UNIX 1
macro AF_INET 2
macro AF_INET6 10
macro SOL_SOCKET 1
macro SO_REUSEADDR 2
macro SO_TYPE 3
macro SO_ERROR 4
macro SO_DONTROUTE 5
