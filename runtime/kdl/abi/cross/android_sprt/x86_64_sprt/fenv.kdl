struct typedef=`__sprt_fenv_t` {
    struct __x87 {
        field __control "unsigned int"
        field __status "unsigned int"
        field __tag "unsigned int"
        field __others "unsigned int [4]"
    }
    // Control word register
    // Status word register
    // Tag word register
    // EIP, Pointer Selector, etc
    field __mxcsr "unsigned int"
}
typedef `__sprt_fexcept_t` "unsigned int"
macro FE_INVALID 0x01
macro FE_DENORMAL 0x02
macro FE_DIVBYZERO 0x04
