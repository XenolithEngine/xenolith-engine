struct typedef=`__sprt_fenv_t` {
    field __control "unsigned short"
    field __mxcsr_hi "unsigned short"
    field __status "unsigned short"
    field __mxcsr_lo "unsigned short"
    field __tag "unsigned int"
    field __other "char [16]"
}
typedef `__sprt_fexcept_t` "unsigned short"
// Exception flags
macro FE_INVALID 0x01
macro FE_DENORMAL 0x02
macro FE_DIVBYZERO 0x04
macro FE_OVERFLOW 0x08
macro FE_UNDERFLOW 0x10
macro FE_INEXACT 0x20
macro FE_ALL_EXCEPT "(FE_DIVBYZERO | FE_DENORMAL | FE_INEXACT |\n                       FE_INVALID | FE_OVERFLOW | FE_UNDERFLOW)"
// Rounding modes
macro FE_TONEAREST 0x0000
macro FE_DOWNWARD 0x0400
macro FE_UPWARD 0x0800
macro FE_TOWARDZERO 0x0c00
