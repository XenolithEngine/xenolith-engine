// MCAST_* group-membership options: the *_GROUP / *_SOURCE_GROUP numbers differ
// on Windows (winsock ws2ipdef.h); BLOCK/UNBLOCK/MSFILTER and EXCLUDE/INCLUDE match.
macro MCAST_JOIN_GROUP 80
macro MCAST_LEAVE_GROUP 81
macro MCAST_JOIN_SOURCE_GROUP 82
macro MCAST_LEAVE_SOURCE_GROUP 83
macro MCAST_BLOCK_SOURCE 84
macro MCAST_UNBLOCK_SOURCE 85
macro MCAST_EXCLUDE 2
macro MCAST_INCLUDE 1
