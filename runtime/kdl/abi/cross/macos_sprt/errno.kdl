// Native macOS (Darwin) errno numbers, mirrored from <sys/errno.h>. The sprt runtime routes
// its errno cell to libSystem's __error() on macOS, so these MUST equal the system values —
// the static_asserts in libc_wrapper/c/common/errno.cc verify this on a hosted build.
macro EPERM 1 public=#true
macro ENOENT 2 public=#true
macro ESRCH 3 public=#true
macro EINTR 4 public=#true
macro EIO 5 public=#true
macro ENXIO 6 public=#true
macro E2BIG 7 public=#true
macro ENOEXEC 8 public=#true
macro EBADF 9 public=#true
macro ECHILD 10 public=#true
macro EDEADLK 11 public=#true
macro ENOMEM 12 public=#true
macro EACCES 13 public=#true
macro EFAULT 14 public=#true
macro ENOTBLK 15 public=#true
macro EBUSY 16 public=#true
macro EEXIST 17 public=#true
macro EXDEV 18 public=#true
macro ENODEV 19 public=#true
macro ENOTDIR 20 public=#true
macro EISDIR 21 public=#true
macro EINVAL 22 public=#true
macro ENFILE 23 public=#true
macro EMFILE 24 public=#true
macro ENOTTY 25 public=#true
macro ETXTBSY 26 public=#true
macro EFBIG 27 public=#true
macro ENOSPC 28 public=#true
macro ESPIPE 29 public=#true
macro EROFS 30 public=#true
macro EMLINK 31 public=#true
macro EPIPE 32 public=#true
macro EDOM 33 public=#true
macro ERANGE 34 public=#true
macro EAGAIN 35 public=#true
macro EWOULDBLOCK EAGAIN public=#true
macro EINPROGRESS 36 public=#true
macro EALREADY 37 public=#true
macro ENOTSOCK 38 public=#true
macro EDESTADDRREQ 39 public=#true
macro EMSGSIZE 40 public=#true
macro EPROTOTYPE 41 public=#true
macro ENOPROTOOPT 42 public=#true
macro EPROTONOSUPPORT 43 public=#true
macro ESOCKTNOSUPPORT 44 public=#true
macro ENOTSUP 45 public=#true
macro EPFNOSUPPORT 46 public=#true
macro EAFNOSUPPORT 47 public=#true
macro EADDRINUSE 48 public=#true
macro EADDRNOTAVAIL 49 public=#true
macro ENETDOWN 50 public=#true
macro ENETUNREACH 51 public=#true
macro ENETRESET 52 public=#true
macro ECONNABORTED 53 public=#true
macro ECONNRESET 54 public=#true
macro ENOBUFS 55 public=#true
macro EISCONN 56 public=#true
macro ENOTCONN 57 public=#true
macro ESHUTDOWN 58 public=#true
macro ETOOMANYREFS 59 public=#true
macro ETIMEDOUT 60 public=#true
macro ECONNREFUSED 61 public=#true
macro ELOOP 62 public=#true
macro ENAMETOOLONG 63 public=#true
macro EHOSTDOWN 64 public=#true
macro EHOSTUNREACH 65 public=#true
macro ENOTEMPTY 66 public=#true
macro EPROCLIM 67 public=#true
macro EUSERS 68 public=#true
macro EDQUOT 69 public=#true
macro ESTALE 70 public=#true
macro EREMOTE 71 public=#true
macro EBADRPC 72 public=#true
macro ERPCMISMATCH 73 public=#true
macro EPROGUNAVAIL 74 public=#true
macro EPROGMISMATCH 75 public=#true
macro EPROCUNAVAIL 76 public=#true
macro ENOLCK 77 public=#true
macro ENOSYS 78 public=#true
macro EFTYPE 79 public=#true
macro EAUTH 80 public=#true
macro ENEEDAUTH 81 public=#true
macro EPWROFF 82 public=#true
macro EDEVERR 83 public=#true
macro EOVERFLOW 84 public=#true
macro EBADEXEC 85 public=#true
macro EBADARCH 86 public=#true
macro ESHLIBVERS 87 public=#true
macro EBADMACHO 88 public=#true
macro ECANCELED 89 public=#true
macro EIDRM 90 public=#true
macro ENOMSG 91 public=#true
macro EILSEQ 92 public=#true
macro ENOATTR 93 public=#true
macro EBADMSG 94 public=#true
macro EMULTIHOP 95 public=#true
macro ENODATA 96 public=#true
macro ENOLINK 97 public=#true
macro ENOSR 98 public=#true
macro ENOSTR 99 public=#true
macro EPROTO 100 public=#true
macro ETIME 101 public=#true
macro EOPNOTSUPP 102 public=#true
macro ENOPOLICY 103 public=#true
