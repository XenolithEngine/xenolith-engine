macro SIGHUP 1
macro SIGINT 2
macro SIGQUIT 3
macro SIGILL 4
macro SIGTRAP 5
macro SIGABRT 6
macro SIGIOT SIGABRT
macro SIGEMT 7
macro SIGFPE 8
macro SIGKILL 9
macro SIGBUS 10
macro SIGSEGV 11
macro SIGSYS 12
macro SIGPIPE 13
macro SIGALRM 14
macro SIGTERM 15
macro SIGURG 16
macro SIGSTOP 17
macro SIGTSTP 18
macro SIGCONT 19
macro SIGCHLD 20
