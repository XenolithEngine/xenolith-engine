// Portable core socket constants, namespaced (__SPRT_*) so they are safe to include on
// every build; <sys/socket.h> expands the public names from these, and each is
// static_asserted against the native header in SPRuntimeCSysSocket.cpp.
macro SHUT_RD 0
macro SHUT_WR 1
macro SHUT_RDWR 2
macro SOCK_STREAM 1
macro SOCK_DGRAM 2
macro SOCK_RAW 3
macro SOCK_SEQPACKET 5
macro SOCK_CLOEXEC "02000000"
macro SOCK_NONBLOCK "04000"
macro AF_UNSPEC 0
macro AF_UNIX 1
macro AF_INET 2
macro AF_INET6 30
macro SOL_SOCKET 0xffff
macro SO_REUSEADDR 0x0004
macro SO_TYPE 0x1008
macro SO_ERROR 0x1007
macro SO_DONTROUTE 0x0010
macro SO_BROADCAST 0x0020
macro SO_SNDBUF 0x1001
macro SO_RCVBUF 0x1002
macro SO_KEEPALIVE 0x0008
macro SO_OOBINLINE 0x0100
macro SO_LINGER 0x0080
macro SO_REUSEPORT 0x0200
macro MSG_OOB 0x1
macro MSG_PEEK 0x2
macro MSG_DONTROUTE 0x4
macro MSG_EOR 0x8
macro MSG_TRUNC 0x10
macro MSG_CTRUNC 0x20
macro MSG_WAITALL 0x40
macro MSG_DONTWAIT 0x80
macro MSG_NOSIGNAL 0x80000
macro SOMAXCONN 128
// Platform-specific extras (namespaced with __SPRT_*) so they never collide with the
// native <sys/socket.h>. These are always visible; the wrapper static_asserts them
// against the native values in SPRuntimeCSysSocket.cpp.
// getsockopt/setsockopt option names (Darwin values; mirror the __SPRT_SO_* above)
macro SO_DEBUG 0x0001
macro SO_ACCEPTCONN 0x0002
macro SO_USELOOPBACK 0x0040
macro SO_TIMESTAMP 0x0400
macro SO_SNDLOWAT 0x1003
macro SO_RCVLOWAT 0x1004
macro SO_SNDTIMEO 0x1005
macro SO_RCVTIMEO 0x1006
