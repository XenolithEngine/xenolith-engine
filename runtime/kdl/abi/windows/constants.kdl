macro HKEY_PERFORMANCE_DATA "(( HKEY ) (ULONG_PTR)((LONG)0x80000004) )"
macro HKEY_PERFORMANCE_TEXT "(( HKEY ) (ULONG_PTR)((LONG)0x80000050) )"
macro HKEY_PERFORMANCE_NLSTEXT "(( HKEY ) (ULONG_PTR)((LONG)0x80000060) )"
macro HKEY_CURRENT_CONFIG "(( HKEY ) (ULONG_PTR)((LONG)0x80000005) )"
macro HKEY_DYN_DATA "(( HKEY ) (ULONG_PTR)((LONG)0x80000006) )"
macro HKEY_CURRENT_USER_LOCAL_SETTINGS "(( HKEY ) (ULONG_PTR)((LONG)0x80000007) )"
// Registry value retrieval flags
macro RRF_RT_REG_NONE 0x00000001
// Registry value types (winnt.h).
macro REG_NONE 0
macro REG_SZ 1
macro REG_EXPAND_SZ 2
macro REG_BINARY 3
macro REG_DWORD 4
macro REG_MULTI_SZ 7
macro REG_QWORD 11
macro RRF_RT_REG_SZ 0x00000002
macro RRF_RT_REG_EXPAND_SZ 0x00000004
macro RRF_RT_REG_BINARY 0x00000008
macro RRF_RT_REG_DWORD 0x00000010
macro RRF_RT_REG_MULTI_SZ 0x00000020
macro RRF_RT_REG_QWORD 0x00000040
macro RRF_RT_DWORD "(RRF_RT_REG_BINARY | RRF_RT_REG_DWORD)"
macro RRF_RT_QWORD "(RRF_RT_REG_BINARY | RRF_RT_REG_QWORD)"
macro RRF_RT_ANY 0x0000ffff
macro RRF_SUBKEY_WOW6464KEY 0x00010000
macro RRF_SUBKEY_WOW6432KEY 0x00020000
macro RRF_WOW64_MASK 0x00030000
macro RRF_NOEXPAND 0x10000000
macro RRF_ZEROONFAILURE 0x20000000
// Variant data types
enum VARENUM {
    value VT_EMPTY 0
    value VT_NULL 1
    value VT_I2 2
    value VT_I4 3
    value VT_R4 4
    value VT_R8 5
    value VT_CY 6
    value VT_DATE 7
    value VT_BSTR 8
    value VT_DISPATCH 9
    value VT_ERROR 10
    value VT_BOOL 11
    value VT_VARIANT 12
    value VT_UNKNOWN 13
    value VT_DECIMAL 14
    value VT_I1 16
    value VT_UI1 17
    value VT_UI2 18
    value VT_UI4 19
    value VT_I8 20
    value VT_UI8 21
    value VT_INT 22
    value VT_UINT 23
    value VT_VOID 24
    value VT_HRESULT 25
    value VT_PTR 26
    value VT_SAFEARRAY 27
    value VT_CARRAY 28
    value VT_USERDEFINED 29
    value VT_LPSTR 30
    value VT_LPWSTR 31
    value VT_FILETIME 64
    value VT_BLOB 65
    value VT_STREAM 66
    value VT_STORAGE 67
    value VT_STREAMED_OBJECT 68
    value VT_STORED_OBJECT 69
    value VT_BLOB_OBJECT 70
    value VT_CF 71
    value VT_CLSID 72
    value VT_VECTOR 0x1000
    value VT_ARRAY 0x2000
    value VT_BYREF 0x4000
    value VT_RESERVED 0x8000
    value VT_ILLEGAL 0xffff
    value VT_ILLEGALMASKED 0xfff
    value VT_TYPEMASK 0xfff
}
// VARIANT_BOOL type
macro VARIANT_TRUE "((VARIANT_BOOL)-1)"
macro VARIANT_FALSE "((VARIANT_BOOL)0)"
enum tagCLSCTX typedef=CLSCTX {
    value CLSCTX_INPROC_SERVER 0x1
    value CLSCTX_INPROC_HANDLER 0x2
    value CLSCTX_LOCAL_SERVER 0x4
    value CLSCTX_INPROC_SERVER16 0x8
    value CLSCTX_REMOTE_SERVER 0x10
    value CLSCTX_INPROC_HANDLER16 0x20
    value CLSCTX_RESERVED1 0x40
    value CLSCTX_RESERVED2 0x80
    value CLSCTX_RESERVED3 0x100
    value CLSCTX_RESERVED4 0x200
    value CLSCTX_NO_CODE_DOWNLOAD 0x400
    value CLSCTX_RESERVED5 0x800
    value CLSCTX_NO_CUSTOM_MARSHAL 0x1000
    value CLSCTX_ENABLE_CODE_DOWNLOAD 0x2000
    value CLSCTX_NO_FAILURE_LOG 0x4000
    value CLSCTX_DISABLE_AAA 0x8000
    value CLSCTX_ENABLE_AAA 0x10000
    value CLSCTX_FROM_DEFAULT_CONTEXT 0x20000
    value CLSCTX_ACTIVATE_X86_SERVER 0x40000
    value CLSCTX_ACTIVATE_32_BIT_SERVER CLSCTX_ACTIVATE_X86_SERVER
    value CLSCTX_ACTIVATE_64_BIT_SERVER 0x80000
    value CLSCTX_ENABLE_CLOAKING 0x100000
    value CLSCTX_APPCONTAINER 0x400000
    value CLSCTX_ACTIVATE_AAA_AS_IU 0x800000
    value CLSCTX_RESERVED6 0x1000000
    value CLSCTX_ACTIVATE_ARM32_SERVER 0x2000000
    value CLSCTX_ALLOW_LOWER_TRUST_REGISTRATION 0x4000000
    value CLSCTX_SERVER_MUST_BE_EQUAL_OR_GREATER_PRIVILEGE 0x8000000
    value CLSCTX_DO_NOT_ELEVATE_SERVER 0x10000000
    value CLSCTX_PS_DLL 0x80000000
    value CLSCTX_ALL "CLSCTX_INPROC_SERVER | CLSCTX_INPROC_HANDLER | CLSCTX_LOCAL_SERVER | CLSCTX_REMOTE_SERVER"
}
enum tag_WBEM_GENERIC_FLAG_TYPE typedef=WBEM_GENERIC_FLAG_TYPE {
    value WBEM_FLAG_RETURN_IMMEDIATELY 0x10
    value WBEM_FLAG_RETURN_WBEM_COMPLETE 0
    value WBEM_FLAG_BIDIRECTIONAL 0
    value WBEM_FLAG_FORWARD_ONLY 0x20
    value WBEM_FLAG_NO_ERROR_OBJECT 0x40
    value WBEM_FLAG_RETURN_ERROR_OBJECT 0
    value WBEM_FLAG_SEND_STATUS 0x80
    value WBEM_FLAG_DONT_SEND_STATUS 0
    value WBEM_FLAG_ENSURE_LOCATABLE 0x100
    value WBEM_FLAG_DIRECT_READ 0x200
    value WBEM_FLAG_SEND_ONLY_SELECTED 0
    value WBEM_RETURN_WHEN_COMPLETE 0
    value WBEM_RETURN_IMMEDIATELY 0x10
    value WBEM_MASK_RESERVED_FLAGS 0x1f000
    value WBEM_FLAG_USE_AMENDED_QUALIFIERS 0x20000
    value WBEM_FLAG_STRONG_VALIDATION 0x100000
}
// Handle duplication flags
macro DUPLICATE_CLOSE_SOURCE 0x00000001
macro DUPLICATE_SAME_ACCESS 0x00000002
macro WAIT_FAILED "((DWORD)0xFFFFFFFF)"
macro WAIT_OBJECT_0 "((STATUS_WAIT_0 ) + 0 )"
macro WAIT_ABANDONED "((STATUS_ABANDONED_WAIT_0 ) + 0 )"
macro WAIT_ABANDONED_0 "((STATUS_ABANDONED_WAIT_0 ) + 0 )"
macro WAIT_IO_COMPLETION STATUS_USER_APC
// Special values
macro INVALID_HANDLE_VALUE "((HANDLE)(ULONG_PTR)-1)"
macro INVALID_FILE_ATTRIBUTES "((DWORD)-1)"
macro INFINITE 0xFFFFFFFF
