alias NULL if="!defined(`NULL`)"
macro ANYSIZE_ARRAY 1
macro FALSE "((BOOL)0)"
macro TRUE "((BOOL)1)"
// WCHAR and MAX_PATH - defined for standalone compilation
macro MAX_PATH 260
macro MAXIMUM_WAIT_OBJECTS 64
macro HKEY_CLASSES_ROOT "(( HKEY ) (ULONG_PTR)((LONG)0x80000000) )"
macro HKEY_CURRENT_USER "(( HKEY ) (ULONG_PTR)((LONG)0x80000001) )"
macro HKEY_LOCAL_MACHINE "(( HKEY ) (ULONG_PTR)((LONG)0x80000002) )"
