macro LMEM_DISCARDABLE 0x0F00
macro LMEM_VALID_FLAGS 0x0F72
macro LMEM_INVALID_HANDLE 0x8000
macro STACK_SIZE_PARAM_IS_A_RESERVATION 0x00010000
macro SEM_FAILCRITICALERRORS 0x0001
macro SEM_NOGPFAULTERRORBOX 0x0002
macro SEM_NOALIGNMENTFAULTEXCEPT 0x0004
macro SEM_NOOPENFILEERRORBOX 0x8000
macro ObjectBasicInformation 0
macro GENERIC_READ "(0x80000000L)"
macro GENERIC_WRITE "(0x40000000L)"
macro GENERIC_EXECUTE "(0x20000000L)"
macro GENERIC_ALL "(0x10000000L)"
// #define DELETE                           (0x00010000L)
macro DELETE "(0x00010000L)"
macro READ_CONTROL "(0x00020000L)"
macro WRITE_DAC "(0x00040000L)"
macro WRITE_OWNER "(0x00080000L)"
macro SYNCHRONIZE "(0x00100000L)"
macro STANDARD_RIGHTS_REQUIRED "(0x000F0000L)"
macro STANDARD_RIGHTS_READ "(READ_CONTROL)"
macro STANDARD_RIGHTS_WRITE "(READ_CONTROL)"
macro STANDARD_RIGHTS_EXECUTE "(READ_CONTROL)"
macro STANDARD_RIGHTS_ALL "(0x001F0000L)"
macro SPECIFIC_RIGHTS_ALL "(0x0000FFFFL)"
macro KEY_QUERY_VALUE "(0x0001)"
macro KEY_SET_VALUE "(0x0002)"
macro KEY_CREATE_SUB_KEY "(0x0004)"
macro KEY_ENUMERATE_SUB_KEYS "(0x0008)"
macro KEY_NOTIFY "(0x0010)"
macro KEY_CREATE_LINK "(0x0020)"
macro KEY_WOW64_32KEY "(0x0200)"
macro KEY_WOW64_64KEY "(0x0100)"
macro KEY_WOW64_RES "(0x0300)"
macro KEY_READ "((STANDARD_RIGHTS_READ       |\n                                  KEY_QUERY_VALUE            |\n                                  KEY_ENUMERATE_SUB_KEYS     |\n                                  KEY_NOTIFY)\n                                  &\n                                 (~SYNCHRONIZE))"
macro KEY_WRITE "((STANDARD_RIGHTS_WRITE      |\n                                  KEY_SET_VALUE              |\n                                  KEY_CREATE_SUB_KEY)\n                                  &\n                                 (~SYNCHRONIZE))"
macro KEY_EXECUTE "((KEY_READ)\n                                  &\n                                 (~SYNCHRONIZE))"
macro KEY_ALL_ACCESS "((STANDARD_RIGHTS_ALL        |\n                                  KEY_QUERY_VALUE            |\n                                  KEY_SET_VALUE              |\n                                  KEY_CREATE_SUB_KEY         |\n                                  KEY_ENUMERATE_SUB_KEYS     |\n                                  KEY_NOTIFY                 |\n                                  KEY_CREATE_LINK)\n                                  &\n                                 (~SYNCHRONIZE))"
