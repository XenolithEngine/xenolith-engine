struct _OSVERSIONINFOEXW typedef=OSVERSIONINFOEXW also="*POSVERSIONINFOEXW, *LPOSVERSIONINFOEXW, RTL_OSVERSIONINFOEXW, *PRTL_OSVERSIONINFOEXW" {
    field dwOSVersionInfoSize DWORD
