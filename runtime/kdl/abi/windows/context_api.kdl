cond x86_64 "ARCH_ID == ARCH_ID_X86_64"
macro IMAGE_SIZEOF_FILE_HEADER 20
macro IMAGE_FILE_RELOCS_STRIPPED 0x0001
macro IMAGE_FILE_EXECUTABLE_IMAGE 0x0002
macro IMAGE_FILE_LINE_NUMS_STRIPPED 0x0004
macro IMAGE_FILE_LOCAL_SYMS_STRIPPED 0x0008
macro IMAGE_FILE_AGGRESIVE_WS_TRIM 0x0010
macro IMAGE_FILE_LARGE_ADDRESS_AWARE 0x0020
macro IMAGE_FILE_BYTES_REVERSED_LO 0x0080
macro IMAGE_FILE_32BIT_MACHINE 0x0100
macro IMAGE_FILE_DEBUG_STRIPPED 0x0200
macro IMAGE_FILE_REMOVABLE_RUN_FROM_SWAP 0x0400
macro IMAGE_FILE_NET_RUN_FROM_SWAP 0x0800
macro IMAGE_FILE_SYSTEM 0x1000
macro IMAGE_FILE_DLL 0x2000
macro IMAGE_FILE_UP_SYSTEM_ONLY 0x4000
macro IMAGE_FILE_BYTES_REVERSED_HI 0x8000
macro IMAGE_FILE_MACHINE_UNKNOWN 0
macro IMAGE_FILE_MACHINE_TARGET_HOST 0x0001
macro IMAGE_FILE_MACHINE_I386 0x014c
macro IMAGE_FILE_MACHINE_R3000 0x0162
macro IMAGE_FILE_MACHINE_R4000 0x0166
macro IMAGE_FILE_MACHINE_R10000 0x0168
macro IMAGE_FILE_MACHINE_WCEMIPSV2 0x0169
macro IMAGE_FILE_MACHINE_ALPHA 0x0184
macro IMAGE_FILE_MACHINE_SH3 0x01a2
macro IMAGE_FILE_MACHINE_SH3DSP 0x01a3
macro IMAGE_FILE_MACHINE_SH3E 0x01a4
macro IMAGE_FILE_MACHINE_SH4 0x01a6
macro IMAGE_FILE_MACHINE_SH5 0x01a8
macro IMAGE_FILE_MACHINE_ARM 0x01c0
macro IMAGE_FILE_MACHINE_THUMB 0x01c2
macro IMAGE_FILE_MACHINE_ARMNT 0x01c4
macro IMAGE_FILE_MACHINE_AM33 0x01d3
macro IMAGE_FILE_MACHINE_POWERPC 0x01F0
macro IMAGE_FILE_MACHINE_POWERPCFP 0x01f1
macro IMAGE_FILE_MACHINE_IA64 0x0200
macro IMAGE_FILE_MACHINE_MIPS16 0x0266
macro IMAGE_FILE_MACHINE_ALPHA64 0x0284
macro IMAGE_FILE_MACHINE_MIPSFPU 0x0366
macro IMAGE_FILE_MACHINE_MIPSFPU16 0x0466
macro IMAGE_FILE_MACHINE_AXP64 IMAGE_FILE_MACHINE_ALPHA64
macro IMAGE_FILE_MACHINE_TRICORE 0x0520
macro IMAGE_FILE_MACHINE_CEF 0x0CEF
macro IMAGE_FILE_MACHINE_EBC 0x0EBC
macro IMAGE_FILE_MACHINE_AMD64 0x8664
macro IMAGE_FILE_MACHINE_M32R 0x9041
macro IMAGE_FILE_MACHINE_ARM64 0xAA64
macro IMAGE_FILE_MACHINE_CEE 0xC0EE
macro UNW_FLAG_NHANDLER 0x0
macro UNW_FLAG_EHANDLER 0x1
macro UNW_FLAG_UHANDLER 0x2
macro UNW_FLAG_CHAININFO 0x4
macro STILL_ACTIVE STATUS_PENDING
macro EXCEPTION_ACCESS_VIOLATION STATUS_ACCESS_VIOLATION
macro EXCEPTION_DATATYPE_MISALIGNMENT STATUS_DATATYPE_MISALIGNMENT
macro EXCEPTION_BREAKPOINT STATUS_BREAKPOINT
macro EXCEPTION_SINGLE_STEP STATUS_SINGLE_STEP
macro EXCEPTION_ARRAY_BOUNDS_EXCEEDED STATUS_ARRAY_BOUNDS_EXCEEDED
macro EXCEPTION_FLT_DENORMAL_OPERAND STATUS_FLOAT_DENORMAL_OPERAND
macro EXCEPTION_FLT_DIVIDE_BY_ZERO STATUS_FLOAT_DIVIDE_BY_ZERO
macro EXCEPTION_FLT_INEXACT_RESULT STATUS_FLOAT_INEXACT_RESULT
macro EXCEPTION_FLT_INVALID_OPERATION STATUS_FLOAT_INVALID_OPERATION
macro EXCEPTION_FLT_OVERFLOW STATUS_FLOAT_OVERFLOW
macro EXCEPTION_FLT_STACK_CHECK STATUS_FLOAT_STACK_CHECK
macro EXCEPTION_FLT_UNDERFLOW STATUS_FLOAT_UNDERFLOW
macro EXCEPTION_INT_DIVIDE_BY_ZERO STATUS_INTEGER_DIVIDE_BY_ZERO
macro EXCEPTION_INT_OVERFLOW STATUS_INTEGER_OVERFLOW
macro EXCEPTION_PRIV_INSTRUCTION STATUS_PRIVILEGED_INSTRUCTION
macro EXCEPTION_IN_PAGE_ERROR STATUS_IN_PAGE_ERROR
macro EXCEPTION_ILLEGAL_INSTRUCTION STATUS_ILLEGAL_INSTRUCTION
macro EXCEPTION_NONCONTINUABLE_EXCEPTION STATUS_NONCONTINUABLE_EXCEPTION
macro EXCEPTION_STACK_OVERFLOW STATUS_STACK_OVERFLOW
macro EXCEPTION_INVALID_DISPOSITION STATUS_INVALID_DISPOSITION
macro EXCEPTION_GUARD_PAGE STATUS_GUARD_PAGE_VIOLATION
macro EXCEPTION_INVALID_HANDLE STATUS_INVALID_HANDLE
macro EXCEPTION_POSSIBLE_DEADLOCK STATUS_POSSIBLE_DEADLOCK
macro CONTROL_C_EXIT STATUS_CONTROL_C_EXIT
macro EXCEPTION_NONCONTINUABLE 0x1
macro EXCEPTION_EXECUTE_HANDLER 1
macro EXCEPTION_CONTINUE_SEARCH 0
macro EXCEPTION_CONTINUE_EXECUTION "(-1)"
macro EXCEPTION_MAXIMUM_PARAMETERS 15
// WoW64 (32-bit-on-64-bit) CONTEXT flags — used by the WoW64 register context.
macro WOW64_CONTEXT_i386 "0x00010000L"
macro WOW64_CONTEXT_CONTROL "(WOW64_CONTEXT_i386 | 0x00000001L)"
macro WOW64_CONTEXT_INTEGER "(WOW64_CONTEXT_i386 | 0x00000002L)"
macro WOW64_CONTEXT_SEGMENTS "(WOW64_CONTEXT_i386 | 0x00000004L)"
macro WOW64_CONTEXT_FLOATING_POINT "(WOW64_CONTEXT_i386 | 0x00000008L)"
macro WOW64_CONTEXT_DEBUG_REGISTERS "(WOW64_CONTEXT_i386 | 0x00000010L)"
macro WOW64_CONTEXT_EXTENDED_REGISTERS "(WOW64_CONTEXT_i386 | 0x00000020L)"
macro WOW64_CONTEXT_FULL "(WOW64_CONTEXT_CONTROL | WOW64_CONTEXT_INTEGER | WOW64_CONTEXT_SEGMENTS)"
macro WOW64_CONTEXT_ALL "(WOW64_CONTEXT_CONTROL | WOW64_CONTEXT_INTEGER | WOW64_CONTEXT_SEGMENTS\n\t\t\t| WOW64_CONTEXT_FLOATING_POINT | WOW64_CONTEXT_DEBUG_REGISTERS\n\t\t\t| WOW64_CONTEXT_EXTENDED_REGISTERS)"
macro WOW64_SIZE_OF_80387_REGISTERS 80
macro WOW64_MAXIMUM_SUPPORTED_EXTENSION 512
// ---- [debugapi] the native debug loop: DEBUG_EVENT and its payload unions ----
macro EXCEPTION_DEBUG_EVENT 1
macro CREATE_THREAD_DEBUG_EVENT 2
macro CREATE_PROCESS_DEBUG_EVENT 3
macro EXIT_THREAD_DEBUG_EVENT 4
macro EXIT_PROCESS_DEBUG_EVENT 5
macro LOAD_DLL_DEBUG_EVENT 6
macro UNLOAD_DLL_DEBUG_EVENT 7
macro OUTPUT_DEBUG_STRING_EVENT 8
macro RIP_EVENT 9
// 32-bit (i386) CONTEXT as seen from a 64-bit debugger via Wow64GetThreadContext.
struct _WOW64_FLOATING_SAVE_AREA typedef=WOW64_FLOATING_SAVE_AREA {
    field ControlWord DWORD
    field StatusWord DWORD
    field TagWord DWORD
    field ErrorOffset DWORD
    field ErrorSelector DWORD
    field DataOffset DWORD
    field DataSelector DWORD
    field RegisterArea "BYTE [WOW64_SIZE_OF_80387_REGISTERS]"
    field Cr0NpxState DWORD
}
struct _WOW64_CONTEXT typedef=WOW64_CONTEXT also="*PWOW64_CONTEXT" {
    field ContextFlags DWORD
    field Dr0 DWORD
    field Dr1 DWORD
    field Dr2 DWORD
    field Dr3 DWORD
    field Dr6 DWORD
    field Dr7 DWORD
    field FloatSave WOW64_FLOATING_SAVE_AREA
    field SegGs DWORD
    field SegFs DWORD
    field SegEs DWORD
    field SegDs DWORD
    field Edi DWORD
    field Esi DWORD
    field Ebx DWORD
    field Edx DWORD
    field Ecx DWORD
    field Eax DWORD
    field Ebp DWORD
    field Eip DWORD
    field SegCs DWORD
    field EFlags DWORD
    field Esp DWORD
    field SegSs DWORD
    field ExtendedRegisters "BYTE [WOW64_MAXIMUM_SUPPORTED_EXTENSION]"
}
typedef RUNTIME_FUNCTION "struct _IMAGE_RUNTIME_FUNCTION_ENTRY"
typedef PRUNTIME_FUNCTION "struct _IMAGE_RUNTIME_FUNCTION_ENTRY *"
enum _EXCEPTION_DISPOSITION typedef=EXCEPTION_DISPOSITION {
    value ExceptionContinueExecution
    value ExceptionContinueSearch
    value ExceptionNestedException
    value ExceptionCollidedUnwind
}
struct _EXCEPTION_RECORD
struct _CONTEXT
typedef EXCEPTION_ROUTINE "EXCEPTION_DISPOSITION (struct _EXCEPTION_RECORD *ExceptionRecord, PVOID EstablisherFrame, struct _CONTEXT *ContextRecord, PVOID DispatcherContext)"
typedef PEXCEPTION_ROUTINE "EXCEPTION_ROUTINE *"
use "sprt/gen/wrappers/windows/abi/x86_64_sprt/context.h" if="@x86_64"
use "sprt/gen/wrappers/windows/abi/aarch64_sprt/context.h" if="!@x86_64 && ARCH_ID == ARCH_ID_AARCH64"
error "Not implemented" raw=#true if="!@x86_64 && !(ARCH_ID == ARCH_ID_AARCH64)"
struct _EXCEPTION_RECORD typedef=EXCEPTION_RECORD {
    field ExceptionCode DWORD
    field ExceptionFlags DWORD
    field ExceptionRecord "struct _EXCEPTION_RECORD *"
    field ExceptionAddress PVOID
    field NumberParameters DWORD
    field ExceptionInformation "ULONG_PTR [EXCEPTION_MAXIMUM_PARAMETERS]"
}
macro UNWIND_HISTORY_TABLE_SIZE 12
struct _UNWIND_HISTORY_TABLE_ENTRY typedef=UNWIND_HISTORY_TABLE_ENTRY also="*PUNWIND_HISTORY_TABLE_ENTRY" {
    field ImageBase ULONG_PTR
    field FunctionEntry PRUNTIME_FUNCTION
}
struct _UNWIND_HISTORY_TABLE typedef=UNWIND_HISTORY_TABLE also="*PUNWIND_HISTORY_TABLE" {
    field Count DWORD
    field LocalHint BYTE
    field GlobalHint BYTE
    field Search BYTE
    field Once BYTE
    field LowAddress ULONG_PTR
    field HighAddress ULONG_PTR
    field Entry "UNWIND_HISTORY_TABLE_ENTRY [UNWIND_HISTORY_TABLE_SIZE]"
}
typedef PEXCEPTION_RECORD "EXCEPTION_RECORD *"
struct _EXCEPTION_POINTERS typedef=EXCEPTION_POINTERS also="*PEXCEPTION_POINTERS" {
    field ExceptionRecord PEXCEPTION_RECORD
    field ContextRecord PCONTEXT
}
typedef PVECTORED_EXCEPTION_HANDLER "LONG (*)(PEXCEPTION_POINTERS ExceptionInfo)"
struct _NT_TIB typedef=NT_TIB {
    field ExceptionList "struct _EXCEPTION_REGISTRATION_RECORD *"
    field StackBase PVOID
    field StackLimit PVOID
    field SubSystemTib PVOID
    field FiberData PVOID
    field ArbitraryUserPointer PVOID
    field Self "struct _NT_TIB *"
}
typedef PNT_TIB "NT_TIB *"
// LPCONTEXT alias (PCONTEXT is materialized in abi/context_api.h).
typedef LPCONTEXT PCONTEXT
// Top-level (unhandled) exception filter. LPEXCEPTION_POINTERS is the pointer alias
// llvm's Signals.inc uses; PTOP_LEVEL_EXCEPTION_FILTER must carry WINAPI so it binds
// a `LONG WINAPI(...)` filter.
typedef LPEXCEPTION_POINTERS "EXCEPTION_POINTERS *"
typedef PTOP_LEVEL_EXCEPTION_FILTER "LONG (`WINAPI` *)(EXCEPTION_POINTERS *ExceptionInfo)"
typedef LPTOP_LEVEL_EXCEPTION_FILTER PTOP_LEVEL_EXCEPTION_FILTER
struct _EXCEPTION_DEBUG_INFO typedef=EXCEPTION_DEBUG_INFO also="*LPEXCEPTION_DEBUG_INFO" {
    field ExceptionRecord EXCEPTION_RECORD
    field dwFirstChance DWORD
}
struct _CREATE_THREAD_DEBUG_INFO typedef=CREATE_THREAD_DEBUG_INFO also="*LPCREATE_THREAD_DEBUG_INFO" {
    field hThread HANDLE
    field lpThreadLocalBase LPVOID
    field lpStartAddress LPTHREAD_START_ROUTINE
}
struct _CREATE_PROCESS_DEBUG_INFO typedef=CREATE_PROCESS_DEBUG_INFO also="*LPCREATE_PROCESS_DEBUG_INFO" {
    field hFile HANDLE
    field hProcess HANDLE
    field hThread HANDLE
    field lpBaseOfImage LPVOID
    field dwDebugInfoFileOffset DWORD
    field nDebugInfoSize DWORD
    field lpThreadLocalBase LPVOID
    field lpStartAddress LPTHREAD_START_ROUTINE
    field lpImageName LPVOID
    field fUnicode WORD
}
struct _EXIT_THREAD_DEBUG_INFO typedef=EXIT_THREAD_DEBUG_INFO also="*LPEXIT_THREAD_DEBUG_INFO" {
    field dwExitCode DWORD
}
struct _EXIT_PROCESS_DEBUG_INFO typedef=EXIT_PROCESS_DEBUG_INFO also="*LPEXIT_PROCESS_DEBUG_INFO" {
    field dwExitCode DWORD
}
struct _LOAD_DLL_DEBUG_INFO typedef=LOAD_DLL_DEBUG_INFO also="*LPLOAD_DLL_DEBUG_INFO" {
    field hFile HANDLE
    field lpBaseOfDll LPVOID
    field dwDebugInfoFileOffset DWORD
    field nDebugInfoSize DWORD
    field lpImageName LPVOID
    field fUnicode WORD
}
struct _UNLOAD_DLL_DEBUG_INFO typedef=UNLOAD_DLL_DEBUG_INFO also="*LPUNLOAD_DLL_DEBUG_INFO" {
    field lpBaseOfDll LPVOID
}
struct _OUTPUT_DEBUG_STRING_INFO typedef=OUTPUT_DEBUG_STRING_INFO also="*LPOUTPUT_DEBUG_STRING_INFO" {
    field lpDebugStringData LPSTR
    field fUnicode WORD
    field nDebugStringLength WORD
}
struct _RIP_INFO typedef=RIP_INFO also="*LPRIP_INFO" {
    field dwError DWORD
    field dwType DWORD
}
struct _DEBUG_EVENT typedef=DEBUG_EVENT also="*LPDEBUG_EVENT" {
    field dwDebugEventCode DWORD
    field dwProcessId DWORD
    field dwThreadId DWORD
    union u {
        field Exception EXCEPTION_DEBUG_INFO
        field CreateThread CREATE_THREAD_DEBUG_INFO
        field CreateProcessInfo CREATE_PROCESS_DEBUG_INFO
        field ExitThread EXIT_THREAD_DEBUG_INFO
        field ExitProcess EXIT_PROCESS_DEBUG_INFO
        field LoadDll LOAD_DLL_DEBUG_INFO
        field UnloadDll UNLOAD_DLL_DEBUG_INFO
        field DebugString OUTPUT_DEBUG_STRING_INFO
        field RipInfo RIP_INFO
    }
}
