typedef HWND HANDLE
typedef HICON HANDLE
typedef HCURSOR HANDLE
typedef HBRUSH HANDLE
typedef HMENU HANDLE
typedef HBITMAP HANDLE
typedef WNDPROC "LRESULT (*)(HWND, UINT, WPARAM, LPARAM)"
struct tagWNDCLASSW typedef=WNDCLASSW also="*PWNDCLASSW" {
    field style UINT
    field lpfnWndProc WNDPROC
    field cbClsExtra int
    field cbWndExtra int
    field hInstance HINSTANCE
    field hIcon HICON
    field hCursor HCURSOR
    field hbrBackground HBRUSH
    field lpszMenuName LPCWSTR
    field lpszClassName LPCWSTR
}
// For an icon (fIcon TRUE) the hot spot is ignored. A 32bpp hbmColor carries its own alpha, so
// hbmMask only has to exist - an all-zero mask leaves every pixel opaque and lets the alpha
// channel do the shaping.
struct _ICONINFO typedef=ICONINFO also="*PICONINFO" {
    field fIcon BOOL
    field xHotspot DWORD
    field yHotspot DWORD
    field hbmMask HBITMAP
    field hbmColor HBITMAP
}
struct tagSTYLESTRUCT typedef=STYLESTRUCT also="*LPSTYLESTRUCT" {
    field styleOld DWORD
    field styleNew DWORD
}
struct tagWINDOWPOS typedef=WINDOWPOS also="*LPWINDOWPOS, *PWINDOWPOS" {
    field hwnd HWND
    field hwndInsertAfter HWND
    field x int
    field y int
    field cx int
    field cy int
    field flags UINT
}
struct tagNCCALCSIZE_PARAMS typedef=NCCALCSIZE_PARAMS also="*LPNCCALCSIZE_PARAMS" {
    field rgrc "RECT [3]"
    field lppos PWINDOWPOS
}
struct tagMINMAXINFO typedef=MINMAXINFO also="*PMINMAXINFO, *LPMINMAXINFO" {
    field ptReserved POINT
    field ptMaxSize POINT
    field ptMaxPosition POINT
    field ptMinTrackSize POINT
    field ptMaxTrackSize POINT
}
struct tagMENUITEMINFOW typedef=MENUITEMINFOW also="*LPMENUITEMINFOW" {
    field cbSize UINT
    field fMask UINT
    field fType UINT
    field fState UINT
    field wID UINT
    field hSubMenu HMENU
    field hbmpChecked HBITMAP
    field hbmpUnchecked HBITMAP
    field dwItemData ULONG_PTR
    field dwTypeData LPWSTR
    field cch UINT
    field hbmpItem HBITMAP
}
typedef LPCMENUITEMINFOW "MENUITEMINFOW const *"
struct tagWINDOWPLACEMENT typedef=WINDOWPLACEMENT {
    field length UINT
    field flags UINT
    field showCmd UINT
    field ptMinPosition POINT
    field ptMaxPosition POINT
    field rcNormalPosition RECT
}
// NB: the SDK only declares a trailing `RECT rcDevice` under #ifdef _MAC; keeping it
// out matches the Win32 layout (sizeof == 44) that callers pass as `length`.
typedef PWINDOWPLACEMENT "WINDOWPLACEMENT *"
typedef LPWINDOWPLACEMENT "WINDOWPLACEMENT *"
struct tagTRACKMOUSEEVENT typedef=TRACKMOUSEEVENT also="*LPTRACKMOUSEEVENT" {
    field cbSize DWORD
    field dwFlags DWORD
    field hwndTrack HWND
    field dwHoverTime DWORD
}
