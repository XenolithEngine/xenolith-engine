typedef LCTYPE DWORD
typedef OBJECT_ATTRIBUTES "struct _OBJECT_ATTRIBUTES"
typedef POBJECT_ATTRIBUTES "OBJECT_ATTRIBUTES *"
struct _SYSTEM_INFO typedef=SYSTEM_INFO also="*LPSYSTEM_INFO" {
    union {
        field dwOemId DWORD
        struct {
            field wProcessorArchitecture WORD
            field wReserved WORD
        }
    }
    // Obsolete field...do not use
    field dwPageSize DWORD
    field lpMinimumApplicationAddress LPVOID
    field lpMaximumApplicationAddress LPVOID
    field dwActiveProcessorMask DWORD_PTR
    field dwNumberOfProcessors DWORD
    field dwProcessorType DWORD
    field dwAllocationGranularity DWORD
    field wProcessorLevel WORD
    field wProcessorRevision WORD
}
enum _LOGICAL_PROCESSOR_RELATIONSHIP typedef=LOGICAL_PROCESSOR_RELATIONSHIP {
    value RelationProcessorCore
    value RelationNumaNode
    value RelationCache
    value RelationProcessorPackage
    value RelationGroup
    value RelationProcessorDie
    value RelationNumaNodeEx
    value RelationProcessorModule
    value RelationAll 0xffff
}
enum _PROCESSOR_CACHE_TYPE typedef=PROCESSOR_CACHE_TYPE also="*PPROCESSOR_CACHE_TYPE" {
    value CacheUnified
    value CacheInstruction
    value CacheData
    value CacheTrace
    value CacheUnknown
}
enum _COMPUTER_NAME_FORMAT typedef=COMPUTER_NAME_FORMAT {
    value ComputerNameNetBIOS
    value ComputerNameDnsHostname
    value ComputerNameDnsDomain
    value ComputerNameDnsFullyQualified
    value ComputerNamePhysicalNetBIOS
    value ComputerNamePhysicalDnsHostname
    value ComputerNamePhysicalDnsDomain
    value ComputerNamePhysicalDnsFullyQualified
    value ComputerNameMax
}
struct _CACHE_DESCRIPTOR typedef=CACHE_DESCRIPTOR also="*PCACHE_DESCRIPTOR" {
    field Level BYTE
    field Associativity BYTE
    field LineSize WORD
    field Size DWORD
    field Type PROCESSOR_CACHE_TYPE
}
struct _SYSTEM_LOGICAL_PROCESSOR_INFORMATION typedef=SYSTEM_LOGICAL_PROCESSOR_INFORMATION also="*PSYSTEM_LOGICAL_PROCESSOR_INFORMATION" {
    field ProcessorMask ULONG_PTR
    field Relationship LOGICAL_PROCESSOR_RELATIONSHIP
    union DUMMYUNIONNAME {
        struct ProcessorCore {
            field Flags BYTE
        }
        struct NumaNode {
            field NodeNumber DWORD
        }
        field Cache CACHE_DESCRIPTOR
        field Reserved "ULONGLONG [2]"
    }
}
// SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX family (winnt.h). Layout matches the SDK
// (the Reserved padding and ANYSIZE_ARRAY [1] tails are load-bearing.
struct _PROCESSOR_RELATIONSHIP typedef=PROCESSOR_RELATIONSHIP also="*PPROCESSOR_RELATIONSHIP" {
    field Flags BYTE
    field EfficiencyClass BYTE
    field Reserved "BYTE [20]"
    field GroupCount WORD
    field GroupMask "GROUP_AFFINITY [1]"
}
struct _NUMA_NODE_RELATIONSHIP typedef=NUMA_NODE_RELATIONSHIP also="*PNUMA_NODE_RELATIONSHIP" {
    field NodeNumber DWORD
    field Reserved "BYTE [18]"
    field GroupCount WORD
    union {
        field GroupMask GROUP_AFFINITY
        field GroupMasks "GROUP_AFFINITY [1]"
    }
}
struct _CACHE_RELATIONSHIP typedef=CACHE_RELATIONSHIP also="*PCACHE_RELATIONSHIP" {
    field Level BYTE
    field Associativity BYTE
    field LineSize WORD
    field CacheSize DWORD
    field Type PROCESSOR_CACHE_TYPE
    field Reserved "BYTE [18]"
    field GroupCount WORD
    union {
        field GroupMask GROUP_AFFINITY
        field GroupMasks "GROUP_AFFINITY [1]"
    }
}
struct _PROCESSOR_GROUP_INFO typedef=PROCESSOR_GROUP_INFO also="*PPROCESSOR_GROUP_INFO" {
    field MaximumProcessorCount BYTE
    field ActiveProcessorCount BYTE
    field Reserved "BYTE [38]"
    field ActiveProcessorMask KAFFINITY
}
struct _GROUP_RELATIONSHIP typedef=GROUP_RELATIONSHIP also="*PGROUP_RELATIONSHIP" {
    field MaximumGroupCount WORD
    field ActiveGroupCount WORD
    field Reserved "BYTE [20]"
    field GroupInfo "PROCESSOR_GROUP_INFO [1]"
}
struct _SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX typedef=SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX also="*PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX" {
    field Relationship LOGICAL_PROCESSOR_RELATIONSHIP
    field Size DWORD
    union {
        field Processor PROCESSOR_RELATIONSHIP
        field NumaNode NUMA_NODE_RELATIONSHIP
        field Cache CACHE_RELATIONSHIP
        field Group GROUP_RELATIONSHIP
    }
}
struct _IO_COUNTERS typedef=IO_COUNTERS also="*PIO_COUNTERS" {
    field ReadOperationCount ULONGLONG
    field WriteOperationCount ULONGLONG
    field OtherOperationCount ULONGLONG
    field ReadTransferCount ULONGLONG
    field WriteTransferCount ULONGLONG
    field OtherTransferCount ULONGLONG
}
struct _JOBOBJECT_BASIC_LIMIT_INFORMATION typedef=JOBOBJECT_BASIC_LIMIT_INFORMATION also="*PJOBOBJECT_BASIC_LIMIT_INFORMATION" {
    field PerProcessUserTimeLimit LARGE_INTEGER
    field PerJobUserTimeLimit LARGE_INTEGER
    field LimitFlags DWORD
    field MinimumWorkingSetSize SIZE_T
    field MaximumWorkingSetSize SIZE_T
    field ActiveProcessLimit DWORD
    field Affinity ULONG_PTR
    field PriorityClass DWORD
    field SchedulingClass DWORD
}
struct _JOBOBJECT_EXTENDED_LIMIT_INFORMATION typedef=JOBOBJECT_EXTENDED_LIMIT_INFORMATION also="*PJOBOBJECT_EXTENDED_LIMIT_INFORMATION" {
    field BasicLimitInformation JOBOBJECT_BASIC_LIMIT_INFORMATION
    field IoInfo IO_COUNTERS
    field ProcessMemoryLimit SIZE_T
    field JobMemoryLimit SIZE_T
    field PeakProcessMemoryUsed SIZE_T
    field PeakJobMemoryUsed SIZE_T
}
enum _JOBOBJECTINFOCLASS typedef=JOBOBJECTINFOCLASS {
    value JobObjectBasicAccountingInformation 1
    value JobObjectBasicLimitInformation 2
    value JobObjectBasicProcessIdList 3
    value JobObjectBasicUIRestrictions 4
    value JobObjectSecurityLimitInformation 5
    value JobObjectEndOfJobTimeInformation 6
    value JobObjectAssociateCompletionPortInformation 7
    value JobObjectBasicAndIoAccountingInformation 8
    value JobObjectExtendedLimitInformation 9
    value JobObjectJobSetInformation 10
    value JobObjectGroupInformation 11
}
enum _MEMORY_RESOURCE_NOTIFICATION_TYPE typedef=MEMORY_RESOURCE_NOTIFICATION_TYPE {
    value LowMemoryResourceNotification 0
    value HighMemoryResourceNotification 1
}
// File-information structures for SetFileInformationByHandle (winbase.h)
// The FileName[1] tail is ANYSIZE_ARRAY.
struct _FILE_DISPOSITION_INFO typedef=FILE_DISPOSITION_INFO also="*PFILE_DISPOSITION_INFO" {
    field DeleteFile BOOLEAN
}
struct _FILE_RENAME_INFO typedef=FILE_RENAME_INFO also="*PFILE_RENAME_INFO" {
    union {
        field ReplaceIfExists BOOLEAN
        field Flags DWORD
    }
    field RootDirectory HANDLE
    field FileNameLength DWORD
    field FileName "WCHAR [1]"
}
// FindFirstFileEx info levels / search ops (minwinbase.h).
enum _FINDEX_INFO_LEVELS typedef=FINDEX_INFO_LEVELS {
    value FindExInfoStandard
    value FindExInfoBasic
    value FindExInfoMaxInfoLevel
}
enum _FINDEX_SEARCH_OPS typedef=FINDEX_SEARCH_OPS {
    value FindExSearchNameMatch
    value FindExSearchLimitToDirectories
    value FindExSearchLimitToDevices
    value FindExSearchMaxSearchOp
}
struct _MEMORYSTATUSEX typedef=MEMORYSTATUSEX also="*LPMEMORYSTATUSEX" {
    field dwLength DWORD
    field dwMemoryLoad DWORD
    field ullTotalPhys DWORDLONG
    field ullAvailPhys DWORDLONG
    field ullTotalPageFile DWORDLONG
    field ullAvailPageFile DWORDLONG
    field ullTotalVirtual DWORDLONG
    field ullAvailVirtual DWORDLONG
    field ullAvailExtendedVirtual DWORDLONG
}
struct _nlsversioninfo typedef=NLSVERSIONINFO also="*LPNLSVERSIONINFO" {
    field dwNLSVersionInfoSize DWORD
    field dwNLSVersion DWORD
    field dwDefinedVersion DWORD
    field dwEffectiveId DWORD
    field guidCustomVersion GUID
}
struct _REASON_CONTEXT typedef=REASON_CONTEXT also="*PREASON_CONTEXT" {
    field Version ULONG
    field Flags DWORD
    union Reason {
        struct Detailed {
            field LocalizedReasonModule HMODULE
            field LocalizedReasonId ULONG
            field ReasonStringCount ULONG
            field ReasonStrings "LPWSTR *"
        }
        field SimpleReasonString LPWSTR
    }
}
struct _CONSOLE_READCONSOLE_CONTROL typedef=CONSOLE_READCONSOLE_CONTROL also="*PCONSOLE_READCONSOLE_CONTROL" {
    field nLength ULONG
    field nInitialChars ULONG
    field dwCtrlWakeupMask ULONG
    field dwControlKeyState ULONG
}
struct _PUBLIC_OBJECT_BASIC_INFORMATION typedef=PUBLIC_OBJECT_BASIC_INFORMATION also="*PPUBLIC_OBJECT_BASIC_INFORMATION" {
    field Attributes ULONG
    field GrantedAccess ACCESS_MASK
    field HandleCount ULONG
    field PointerCount ULONG
    field Reserved "ULONG [10]"
}
