typedef PIMAGE_TLS_CALLBACK "VOID (*)(PVOID DllHandle, DWORD Reason, PVOID Reserved)"
struct _IMAGE_IMPORT_DESCRIPTOR typedef=IMAGE_IMPORT_DESCRIPTOR {
    union {
        field Characteristics DWORD
        field OriginalFirstThunk DWORD
    }
    // 0 for terminating null import descriptor
    // RVA to original unbound IAT (PIMAGE_THUNK_DATA)
    field TimeDateStamp DWORD
    // -1 if bound, and real date\time stamp
    // in IMAGE_DIRECTORY_ENTRY_BOUND_IMPORT (new BIND)
    // O.W. date/time stamp of DLL bound to (Old BIND)
    field ForwarderChain DWORD
    field Name DWORD
    field FirstThunk DWORD
}
struct _MEMORY_BASIC_INFORMATION typedef=MEMORY_BASIC_INFORMATION also="*PMEMORY_BASIC_INFORMATION" {
    field BaseAddress PVOID
    field AllocationBase PVOID
