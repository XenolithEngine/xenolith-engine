    field RegionSize SIZE_T
    field State DWORD
    field Protect DWORD
    field Type DWORD
}
struct _IMAGE_EXPORT_DIRECTORY typedef=IMAGE_EXPORT_DIRECTORY also="*PIMAGE_EXPORT_DIRECTORY" {
    field Characteristics DWORD
    field TimeDateStamp DWORD
    field MajorVersion WORD
    field MinorVersion WORD
    field Name DWORD
    field Base DWORD
    field NumberOfFunctions DWORD
    field NumberOfNames DWORD
    field AddressOfFunctions DWORD
    field AddressOfNames DWORD
    field AddressOfNameOrdinals DWORD
}
struct _IMAGE_DOS_HEADER typedef=IMAGE_DOS_HEADER also="*PIMAGE_DOS_HEADER" {
