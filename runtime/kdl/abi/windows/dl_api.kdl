    field e_magic WORD
    field e_cblp WORD
    field e_cp WORD
    field e_crlc WORD
    field e_cparhdr WORD
    field e_minalloc WORD
    field e_maxalloc WORD
    field e_ss WORD
    field e_sp WORD
    field e_csum WORD
    field e_ip WORD
    field e_cs WORD
    field e_lfarlc WORD
    field e_ovno WORD
    field e_res "WORD [4]"
    field e_oemid WORD
    field e_oeminfo WORD
    field e_res2 "WORD [10]"
    field e_lfanew LONG
}
struct _IMAGE_DATA_DIRECTORY typedef=IMAGE_DATA_DIRECTORY also="*PIMAGE_DATA_DIRECTORY" {
    field VirtualAddress DWORD
    field Size DWORD
}
struct _IMAGE_TLS_DIRECTORY64 typedef=IMAGE_TLS_DIRECTORY64 also="*PIMAGE_TLS_DIRECTORY64" {
    field StartAddressOfRawData ULONGLONG
    field EndAddressOfRawData ULONGLONG
    field AddressOfIndex ULONGLONG
    field AddressOfCallBacks ULONGLONG
    field SizeOfZeroFill DWORD
    union {
        field Characteristics DWORD
        struct {
            field Reserved0 DWORD bits="20"
            field Alignment DWORD bits="4"
            field Reserved1 DWORD bits="8"
        }
    }
}
