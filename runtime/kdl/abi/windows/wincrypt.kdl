    field NotAfter FILETIME
    field Subject CERT_NAME_BLOB
    field SubjectPublicKeyInfo CERT_PUBLIC_KEY_INFO
    field IssuerUniqueId CRYPT_BIT_BLOB
    field SubjectUniqueId CRYPT_BIT_BLOB
    field cExtension DWORD
    field rgExtension PCERT_EXTENSION
}
struct _CERT_CONTEXT typedef=CERT_CONTEXT also="*PCERT_CONTEXT" {
