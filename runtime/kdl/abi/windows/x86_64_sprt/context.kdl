macro CONTEXT_AMD64 "0x00100000L"
macro CONTEXT_CONTROL "(CONTEXT_AMD64 | 0x00000001L)"
macro CONTEXT_INTEGER "(CONTEXT_AMD64 | 0x00000002L)"
