macro CONTEXT_FULL "(CONTEXT_CONTROL | CONTEXT_INTEGER | CONTEXT_FLOATING_POINT)"
macro CONTEXT_ALL "(CONTEXT_CONTROL | CONTEXT_INTEGER | CONTEXT_SEGMENTS | CONTEXT_FLOATING_POINT | CONTEXT_DEBUG_REGISTERS)"
