struct _PHYSICAL_MONITOR typedef=PHYSICAL_MONITOR also="*LPPHYSICAL_MONITOR" {
    field hPhysicalMonitor HANDLE
    field szPhysicalMonitorDescription "WCHAR [PHYSICAL_MONITOR_DESCRIPTION_SIZE]"
}
struct tagMONITORINFO typedef=MONITORINFO also="*LPMONITORINFO" {
    field cbSize DWORD
    field rcMonitor RECT
    field rcWork RECT
    field dwFlags DWORD
}
struct tagMONITORINFOEXW typedef=MONITORINFOEXW also="*LPMONITORINFOEXW" base="public MONITORINFO" {
    field szDevice "WCHAR [CCHDEVICENAME]"
}
struct _DISPLAY_DEVICEW typedef=DISPLAY_DEVICEW also="*PDISPLAY_DEVICEW, *LPDISPLAY_DEVICEW" {
    field cb DWORD
    field DeviceName "WCHAR [32]"
    field DeviceString "WCHAR [128]"
    field StateFlags DWORD
    field DeviceID "WCHAR [128]"
    field DeviceKey "WCHAR [128]"
}
struct _devicemodeW typedef=DEVMODEW also="*PDEVMODEW, *NPDEVMODEW, *LPDEVMODEW" {
    field dmDeviceName "WCHAR [CCHDEVICENAME]"
    field dmSpecVersion WORD
    field dmDriverVersion WORD
    field dmSize WORD
    field dmDriverExtra WORD
    field dmFields DWORD
    union {
        // printer only fields
        struct {
            field dmOrientation short
            field dmPaperSize short
            field dmPaperLength short
            field dmPaperWidth short
            field dmScale short
            field dmCopies short
            field dmDefaultSource short
            field dmPrintQuality short
        }
        // display only fields
        struct {
            field dmPosition POINTL
            field dmDisplayOrientation DWORD
            field dmDisplayFixedOutput DWORD
        }
    }
    // printer only fields
    // display only fields
    field dmColor short
    field dmDuplex short
    field dmYResolution short
    field dmTTOption short
    field dmCollate short
    field dmFormName "WCHAR [CCHFORMNAME]"
    field dmLogPixels WORD
    field dmBitsPerPel DWORD
    field dmPelsWidth DWORD
    field dmPelsHeight DWORD
    union {
        field dmDisplayFlags DWORD
        field dmNup DWORD
    }
    field dmDisplayFrequency DWORD
    field dmICMMethod DWORD
    field dmICMIntent DWORD
    field dmMediaType DWORD
    field dmDitherType DWORD
    field dmReserved1 DWORD
    field dmReserved2 DWORD
    field dmPanningWidth DWORD
    field dmPanningHeight DWORD
}
struct _SP_DEVINFO_DATA typedef=SP_DEVINFO_DATA also="*PSP_DEVINFO_DATA" {
    field cbSize DWORD
    field ClassGuid GUID
    field DevInst DWORD
    field Reserved ULONG_PTR
}
struct _SP_DEVICE_INTERFACE_DATA typedef=SP_DEVICE_INTERFACE_DATA also="*PSP_DEVICE_INTERFACE_DATA" {
