// ABI half of <commdlg.h>: the CHOOSECOLORW / CHOOSEFONTW layouts and their flag tables.
//
// Both structs are passed to comdlg32 by address with lStructSize set from sizeof, so their size
// and every field offset are load-bearing — pinned against the SDK by
// tests/libc/windows-abi/check-commdlg.cpp.
// HWND / HDC
// LOGFONTW
// A COLORREF is 0x00bbggrr packed into a DWORD.
typedef COLORREF DWORD
// The two hook procedures. Neither dialog is customised here, so the fields only have to be the
// right size — a function pointer, which on every Windows ABI is the size of a data pointer.
typedef LPCCHOOKPROC "void *"
typedef LPCFHOOKPROC "void *"
// ---- ChooseColorW --------------------------------------------------------
macro CC_RGBINIT 0x00000001
macro CC_FULLOPEN 0x00000002
macro CC_PREVENTFULLOPEN 0x00000004
macro CC_SHOWHELP 0x00000008
macro CC_ENABLEHOOK 0x00000010
macro CC_ENABLETEMPLATE 0x00000020
macro CC_ENABLETEMPLATEHANDLE 0x00000040
macro CC_SOLIDCOLOR 0x00000080
macro CC_ANYCOLOR 0x00000100
// ---- ChooseFontW ---------------------------------------------------------
macro CF_SCREENFONTS 0x00000001
macro CF_PRINTERFONTS 0x00000002
macro CF_BOTH "(CF_SCREENFONTS | CF_PRINTERFONTS)"
macro CF_SHOWHELP 0x00000004
macro CF_ENABLEHOOK 0x00000008
macro CF_ENABLETEMPLATE 0x00000010
macro CF_ENABLETEMPLATEHANDLE 0x00000020
macro CF_INITTOLOGFONTSTRUCT 0x00000040
macro CF_USESTYLE 0x00000080
macro CF_EFFECTS 0x00000100
macro CF_APPLY 0x00000200
macro CF_ANSIONLY 0x00000400
macro CF_NOVECTORFONTS 0x00000800
macro CF_NOSIMULATIONS 0x00001000
macro CF_LIMITSIZE 0x00002000
macro CF_FIXEDPITCHONLY 0x00004000
macro CF_WYSIWYG 0x00008000
macro CF_FORCEFONTEXIST 0x00010000
macro CF_SCALABLEONLY 0x00020000
macro CF_TTONLY 0x00040000
macro CF_NOFACESEL 0x00080000
macro CF_NOSTYLESEL 0x00100000
macro CF_NOSIZESEL 0x00200000
macro CF_SELECTSCRIPT 0x00400000
macro CF_NOSCRIPTSEL 0x00800000
macro CF_NOVERTFONTS 0x01000000
macro CF_INACTIVEFONTS 0x02000000
// LOGFONTW::lfWeight values worth naming.
macro FW_NORMAL 400
macro FW_BOLD 700
// rgbResult is a COLORREF: 0x00bbggrr, so the byte order is the reverse of HTML.
struct (p)tagCHOOSECOLORW typedef=CHOOSECOLORW also="*LPCHOOSECOLORW" {
    field lStructSize DWORD
    field hwndOwner HWND
    field hInstance HWND
    field rgbResult COLORREF
    field lpCustColors "COLORREF *"
    field Flags DWORD
    field lCustData LPARAM
    field lpfnHook LPCCHOOKPROC
    field lpTemplateName LPCWSTR
}
// iPointSize is in tenths of a point; lpLogFont carries the result and, with
// CF_INITTOLOGFONTSTRUCT, the initial value too.
struct (p)tagCHOOSEFONTW typedef=CHOOSEFONTW also="*LPCHOOSEFONTW" {
    field lStructSize DWORD
    field hwndOwner HWND
    field hDC HDC
    field lpLogFont "LOGFONTW *"
    field iPointSize INT
    field Flags DWORD
    field rgbColors COLORREF
    field lCustData LPARAM
    field lpfnHook LPCFHOOKPROC
    field lpTemplateName LPCWSTR
    field hInstance HINSTANCE
    field lpszStyle LPWSTR
    field nFontType WORD
    field ___MISSING_ALIGNMENT__ WORD
    field nSizeMin INT
    field nSizeMax INT
}
