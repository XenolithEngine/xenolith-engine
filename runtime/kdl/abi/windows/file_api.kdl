    field FileSystemEffectivePhysicalBytesPerSectorForAtomicity ULONG
    field Flags ULONG
    field ByteOffsetForSectorAlignment ULONG
    field ByteOffsetForPartitionAlignment ULONG
}
//
// File ID Both Directory Info structure used with FileIdBothDirectoryInfo and FileIdBothDirectoryRestartInfo.
// Used by FindFirstFileEx/FindNextFile to enumerate directory contents.
//
struct _FILE_ID_BOTH_DIR_INFO typedef=FILE_ID_BOTH_DIR_INFO also="*PFILE_ID_BOTH_DIR_INFO" {
    field NextEntryOffset DWORD
    field FileIndex DWORD
    field CreationTime LARGE_INTEGER
    field LastAccessTime LARGE_INTEGER
    field LastWriteTime LARGE_INTEGER
    field ChangeTime LARGE_INTEGER
    field EndOfFile LARGE_INTEGER
    field AllocationSize LARGE_INTEGER
    field FileAttributes DWORD
    field FileNameLength DWORD
    field EaSize DWORD
    field ShortNameLength CCHAR
    field ShortName "WCHAR [12]"
    field FileId LARGE_INTEGER
    field FileName "WCHAR [1]"
}
