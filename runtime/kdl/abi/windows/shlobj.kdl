// ABI half of <ShObjIdl_core.h>: the file-dialog value tables and the one struct that crosses the
// boundary. Pinned against the SDK by tests/libc/windows-abi/check-shlobj.cpp.
//
// SIGDN and FILEOPENDIALOGOPTIONS are SDK enums, so they are enums here too and are checked with
// SPRT_ENUM rather than SPRT_CONST.
// GUID
// HWND
// IShellItem::GetDisplayName forms. FILESYSPATH is the only one that yields a real filesystem path,
// and it fails for items that have none (a virtual folder such as "This PC").
enum (p)SIGDN typedef=SIGDN {
    value SIGDN_NORMALDISPLAY 0x00000000
    value SIGDN_PARENTRELATIVEPARSING "(int)0x80018001"
    value SIGDN_DESKTOPABSOLUTEPARSING "(int)0x80028000"
    value SIGDN_PARENTRELATIVEEDITING "(int)0x80031001"
    value SIGDN_DESKTOPABSOLUTEEDITING "(int)0x8004c000"
    value SIGDN_FILESYSPATH "(int)0x80058000"
    value SIGDN_URL "(int)0x80068000"
    value SIGDN_PARENTRELATIVEFORADDRESSBAR "(int)0x8007c001"
    value SIGDN_PARENTRELATIVE "(int)0x80080001"
    value SIGDN_PARENTRELATIVEFORUI "(int)0x80094001"
}
// IFileDialog::SetOptions / GetOptions.
enum (p)FILEOPENDIALOGOPTIONS typedef=FILEOPENDIALOGOPTIONS {
    value FOS_OVERWRITEPROMPT 0x2
    value FOS_STRICTFILETYPES 0x4
    value FOS_NOCHANGEDIR 0x8
    value FOS_PICKFOLDERS 0x20
    value FOS_FORCEFILESYSTEM 0x40
    value FOS_ALLNONSTORAGEITEMS 0x80
    value FOS_NOVALIDATE 0x100
    value FOS_ALLOWMULTISELECT 0x200
    value FOS_PATHMUSTEXIST 0x800
    value FOS_FILEMUSTEXIST 0x1000
    value FOS_CREATEPROMPT 0x2000
    value FOS_SHAREAWARE 0x4000
    value FOS_NOREADONLYRETURN 0x8000
    value FOS_NOTESTFILECREATE 0x10000
    value FOS_HIDEMRUPLACES 0x20000
    value FOS_HIDEPINNEDPLACES 0x40000
    value FOS_NODEREFERENCELINKS 0x100000
    value FOS_OKBUTTONNEEDSINTERACTION 0x200000
    value FOS_DONTADDTORECENT 0x2000000
    value FOS_FORCESHOWHIDDEN 0x10000000
    value FOS_DEFAULTNOMINIMODE 0x20000000
    value FOS_FORCEPREVIEWPANEON 0x40000000
    value FOS_SUPPORTSTREAMABLEITEMS "(int)0x80000000"
}
// One entry of the file-type dropdown. Both members are caller-owned strings; pszSpec is a
// semicolon-separated glob list ("*.png;*.jpg").
struct (p)COMDLG_FILTERSPEC typedef=COMDLG_FILTERSPEC {
    field pszName LPCWSTR
    field pszSpec LPCWSTR
}
//  One property of the shell's property system: a format GUID plus an index inside it.
//
// Passed BY ADDRESS to IShellItem2::GetString / GetFileTime and returned by
// IShellFolder2::MapColumnToSCID, so the layout is ABI and not merely a convenience. The SDK spells
// it in <wtypes.h>; it is here because abi/ is where a layout the shell writes into belongs.
struct (p)PROPERTYKEY typedef=PROPERTYKEY {
    field fmtid GUID
    field pid DWORD
}
typedef REFPROPERTYKEY "const `PROPERTYKEY` &"
// IContextMenu::QueryContextMenu flags. NORMAL is what a plain right-click asks for, and it is the
// one an automated invoke wants too: the shell populates the same verb set the user would see.
// CMF_INCLUDESTATIC is absent on purpose: the SDK defines it only for NTDDI_VERSION < VISTA, and a
// name this table carries that the SDK does not is a promise nothing keeps.
macro CMF_NORMAL 0x00000000
macro CMF_DEFAULTONLY 0x00000001
macro CMF_VERBSONLY 0x00000002
macro CMF_EXPLORE 0x00000004
macro CMF_NOVERBS 0x00000008
macro CMF_CANRENAME 0x00000010
macro CMF_NODEFAULT 0x00000020
macro CMF_ITEMMENU 0x00000080
macro CMF_EXTENDEDVERBS 0x00000100
macro CMF_DISABLEDVERBS 0x00000200
macro CMF_ASYNCVERBSTATE 0x00000400
macro CMF_OPTIMIZEFORINVOKE 0x00000800
macro CMF_SYNCCASCADEMENU 0x00001000
macro CMF_DONOTPICKDEFAULT 0x00002000
//  CMINVOKECOMMANDINFO::fMask. These are the SEE_MASK_* values from <shellapi.h> under a second
// name - the SDK defines them by aliasing, and so does this table, which is why they are pinned
// against the SEE_MASK_ spelling rather than against a CMIC_ one the SDK does not define on its own.
//
// FLAG_NO_UI is what turns an invoke into something a background thread may do: without it the shell
// is free to put up its own error box, on a thread that owns no window.
// CMIC_MASK_ICON is absent for the same reason as CMF_INCLUDESTATIC: its SEE_MASK_ICON is pre-Vista
// only, and the SDK's own comment on it reads "not used".
macro CMIC_MASK_HOTKEY 0x00000020
macro CMIC_MASK_FLAG_NO_UI 0x00000400
macro CMIC_MASK_UNICODE 0x00004000
macro CMIC_MASK_NO_CONSOLE 0x00008000
macro CMIC_MASK_ASYNCOK 0x00100000
macro CMIC_MASK_NOASYNC 0x00000100
// IContextMenu::GetCommandString types. VERBW is what identifies a command language-independently:
// the menu text is localized, the canonical verb ("undelete") is not.
macro GCS_VERBA 0x00000000
macro GCS_HELPTEXTA 0x00000001
macro GCS_VALIDATEA 0x00000002
macro GCS_VERBW 0x00000004
macro GCS_HELPTEXTW 0x00000005
macro GCS_VALIDATEW 0x00000006
macro GCS_UNICODE 0x00000004
//  Argument of IContextMenu::InvokeCommand.
//
// `lpVerb` is deliberately ANSI even in a UTF-16 world: it is either a canonical verb (a 7-bit
// identifier such as "undelete") or MAKEINTRESOURCE of a menu id, and the union of the two is what
// the field has always been. The wide form travels in CMINVOKECOMMANDINFOEX, which this runtime does
// not need.
//
// `cbSize` is the version tag - the shell dispatches on it, so a struct whose size does not match the
// SDK's is not merely mislaid, it is misread. tests/libc/windows-abi/check-shlobj.cpp pins it.
struct (p)CMINVOKECOMMANDINFO typedef=CMINVOKECOMMANDINFO {
    field cbSize DWORD
    field fMask DWORD
    field hwnd HWND
    field lpVerb LPCSTR
    field lpParameters LPCSTR
    field lpDirectory LPCSTR
    field nShow int
    field dwHotKey DWORD
    field hIcon HANDLE
}
typedef LPCMINVOKECOMMANDINFO "`CMINVOKECOMMANDINFO` *"
