}
struct _LUID typedef=LUID also="*PLUID" {
    field LowPart ULONG
    field HighPart LONG
}
struct _LUID_AND_ATTRIBUTES typedef=LUID_AND_ATTRIBUTES also="*PLUID_AND_ATTRIBUTES" {
    field Luid LUID
    field Attributes DWORD
}
