}
typedef PACL "ACL *"
// ============================================================
// Security Identifier (SID) Types (winnt.h)
// ============================================================
enum _ACCESS_MODE typedef=ACCESS_MODE {
    value NOT_USED_ACCESS 0
    value GRANT_ACCESS
    value SET_ACCESS
    value DENY_ACCESS
    value REVOKE_ACCESS
    value SET_AUDIT_SUCCESS
    value SET_AUDIT_FAILURE
}
enum _MULTIPLE_TRUSTEE_OPERATION typedef=MULTIPLE_TRUSTEE_OPERATION {
    value NO_MULTIPLE_TRUSTEE
    value TRUSTEE_IS_IMPERSONATE
}
enum _TRUSTEE_FORM typedef=TRUSTEE_FORM {
    value TRUSTEE_IS_SID
    value TRUSTEE_IS_NAME
    value TRUSTEE_BAD_FORM
    value TRUSTEE_IS_OBJECTS_AND_SID
    value TRUSTEE_IS_OBJECTS_AND_NAME
}
enum _TRUSTEE_TYPE typedef=TRUSTEE_TYPE {
    value TRUSTEE_IS_UNKNOWN
    value TRUSTEE_IS_USER
    value TRUSTEE_IS_GROUP
    value TRUSTEE_IS_DOMAIN
    value TRUSTEE_IS_ALIAS
    value TRUSTEE_IS_WELL_KNOWN_GROUP
    value TRUSTEE_IS_DELETED
    value TRUSTEE_IS_INVALID
    value TRUSTEE_IS_COMPUTER
}
//
// SID_IDENTIFIER_AUTHORITY - 6-byte identifier authority value for SIDs.
// @see https://docs.microsoft.com/en-us/windows/win32/api/winnt/ns-winnt-sid_identifier_authority
//
struct _SID_IDENTIFIER_AUTHORITY typedef=SID_IDENTIFIER_AUTHORITY also="*PSID_IDENTIFIER_AUTHORITY, *LPSID_IDENTIFIER_AUTHORITY" {
    field Value "BYTE [6]"
}
//
// SID - Security Identifier structure.
// A security identifier (SID) uniquely identifies a user or group account.
// @see https://docs.microsoft.com/en-us/windows/win32/api/winnt/ns-winnt-sid
//
struct _SID typedef=SID also="*PSID, *LPSID" {
    field Revision BYTE
    field SubAuthorityCount BYTE
    field IdentifierAuthority SID_IDENTIFIER_AUTHORITY
    field SubAuthority "DWORD [1]"
}
struct _TOKEN_PRIMARY_GROUP typedef=TOKEN_PRIMARY_GROUP also="*PTOKEN_PRIMARY_GROUP" {
    field PrimaryGroup PSID
}
struct _TRUSTEE_W typedef=TRUSTEE_W also="*PTRUSTEE_W, TRUSTEEW, *PTRUSTEEW" {
    field pMultipleTrustee "struct _TRUSTEE_W *"
    field MultipleTrusteeOperation MULTIPLE_TRUSTEE_OPERATION
    field TrusteeForm TRUSTEE_FORM
    field TrusteeType TRUSTEE_TYPE
    field ptstrName LPWSTR
}
struct _EXPLICIT_ACCESS_W typedef=EXPLICIT_ACCESS_W also="*PEXPLICIT_ACCESS_W, EXPLICIT_ACCESSW, *PEXPLICIT_ACCESSW" {
    field grfAccessPermissions DWORD
    field grfAccessMode ACCESS_MODE
    field grfInheritance DWORD
    field Trustee TRUSTEE_W
}
struct _SID_AND_ATTRIBUTES typedef=SID_AND_ATTRIBUTES also="*PSID_AND_ATTRIBUTES" {
    field Sid PSID
    field Attributes DWORD
}
struct _TOKEN_USER typedef=TOKEN_USER also="*PTOKEN_USER" {
    field User SID_AND_ATTRIBUTES
}
struct _TOKEN_GROUPS typedef=TOKEN_GROUPS also="*PTOKEN_GROUPS" {
    field GroupCount DWORD
    field Groups "SID_AND_ATTRIBUTES [1]"
}
struct _SECURITY_CAPABILITIES typedef=SECURITY_CAPABILITIES also="*PSECURITY_CAPABILITIES, *LPSECURITY_CAPABILITIES" {
