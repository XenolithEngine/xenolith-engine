    field CapabilityCount DWORD
    field Reserved DWORD
}
struct _TOKEN_APPCONTAINER_INFORMATION typedef=TOKEN_APPCONTAINER_INFORMATION also="*PTOKEN_APPCONTAINER_INFORMATION" {
