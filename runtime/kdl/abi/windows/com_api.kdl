    value EOAC_ACCESS_CONTROL 0x4
    value EOAC_APPID 0x8
    value EOAC_DYNAMIC 0x10
    value EOAC_REQUIRE_FULLSIC 0x200
    value EOAC_AUTO_IMPERSONATE 0x400
    value EOAC_DISABLE_AAA 0x1000
    value EOAC_NO_CUSTOM_MARSHAL 0x2000
    value EOAC_RESERVED1 0x4000
}
