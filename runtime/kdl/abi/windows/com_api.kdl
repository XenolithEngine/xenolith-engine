typedef KF_DEFINITION_FLAGS DWORD
struct KNOWNFOLDER_DEFINITION typedef=KNOWNFOLDER_DEFINITION {
    field category KF_CATEGORY
    field pszName LPWSTR
    field pszDescription LPWSTR
    field fidParent KNOWNFOLDERID
    field pszRelativePath LPWSTR
    field pszParsingName LPWSTR
    field pszTooltip LPWSTR
    field pszLocalizedName LPWSTR
    field pszIcon LPWSTR
    field pszSecurity LPWSTR
    field dwAttributes DWORD
    field kfdFlags KF_DEFINITION_FLAGS
    field ftidType FOLDERTYPEID
}
