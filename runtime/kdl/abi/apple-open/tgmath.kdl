cond cplusplus "!defined(__cplusplus)"
// fn / fnf / fnl for reals plus cfn / cfnf / cfnl for complex (real & integer ->
// the bare double variant). _Generic's controlling expression is unevaluated, so
// the argument is evaluated exactly once, in the trailing call.
macro __sprt_tg_rc "_Generic((x), float: fn##f, long double: fn##l, double _Complex: c##fn,\n\t\t\tfloat _Complex: c##fn##f, long double _Complex: c##fn##l, default: fn)" params="fn x" if="@cplusplus"
macro __sprt_tg_r "_Generic((x), float: fn##f, long double: fn##l, default: fn)" params="fn x" if="@cplusplus"
// Functions defined for both real and complex arguments.
macro acos "__sprt_tg_rc(acos, (x))(x)" params="x" if="@cplusplus"
macro asin "__sprt_tg_rc(asin, (x))(x)" params="x" if="@cplusplus"
macro atan "__sprt_tg_rc(atan, (x))(x)" params="x" if="@cplusplus"
macro acosh "__sprt_tg_rc(acosh, (x))(x)" params="x" if="@cplusplus"
macro asinh "__sprt_tg_rc(asinh, (x))(x)" params="x" if="@cplusplus"
macro atanh "__sprt_tg_rc(atanh, (x))(x)" params="x" if="@cplusplus"
macro cos "__sprt_tg_rc(cos, (x))(x)" params="x" if="@cplusplus"
macro sin "__sprt_tg_rc(sin, (x))(x)" params="x" if="@cplusplus"
macro tan "__sprt_tg_rc(tan, (x))(x)" params="x" if="@cplusplus"
macro cosh "__sprt_tg_rc(cosh, (x))(x)" params="x" if="@cplusplus"
macro sinh "__sprt_tg_rc(sinh, (x))(x)" params="x" if="@cplusplus"
macro tanh "__sprt_tg_rc(tanh, (x))(x)" params="x" if="@cplusplus"
macro exp "__sprt_tg_rc(exp, (x))(x)" params="x" if="@cplusplus"
macro log "__sprt_tg_rc(log, (x))(x)" params="x" if="@cplusplus"
macro sqrt "__sprt_tg_rc(sqrt, (x))(x)" params="x" if="@cplusplus"
// fabs is real+complex but its complex variant is spelled cabs (not cfabs).
macro fabs "_Generic((x), float: fabsf, long double: fabsl, double _Complex: cabs,\n\t\t\tfloat _Complex: cabsf, long double _Complex: cabsl, default: fabs)(x)" params="x" if="@cplusplus"
// pow is real+complex with two generic arguments.
macro pow "_Generic((x) + (y), float: powf, long double: powl, double _Complex: cpow,\n\t\t\tfloat _Complex: cpowf, long double _Complex: cpowl, default: pow)((x), (y))" params="x y" if="@cplusplus"
// Real-only, single argument.
macro cbrt "__sprt_tg_r(cbrt, (x))(x)" params="x" if="@cplusplus"
macro ceil "__sprt_tg_r(ceil, (x))(x)" params="x" if="@cplusplus"
macro erf "__sprt_tg_r(erf, (x))(x)" params="x" if="@cplusplus"
macro erfc "__sprt_tg_r(erfc, (x))(x)" params="x" if="@cplusplus"
macro exp2 "__sprt_tg_r(exp2, (x))(x)" params="x" if="@cplusplus"
macro expm1 "__sprt_tg_r(expm1, (x))(x)" params="x" if="@cplusplus"
macro floor "__sprt_tg_r(floor, (x))(x)" params="x" if="@cplusplus"
macro ilogb "__sprt_tg_r(ilogb, (x))(x)" params="x" if="@cplusplus"
macro lgamma "__sprt_tg_r(lgamma, (x))(x)" params="x" if="@cplusplus"
macro llrint "__sprt_tg_r(llrint, (x))(x)" params="x" if="@cplusplus"
macro llround "__sprt_tg_r(llround, (x))(x)" params="x" if="@cplusplus"
macro log10 "__sprt_tg_r(log10, (x))(x)" params="x" if="@cplusplus"
macro log1p "__sprt_tg_r(log1p, (x))(x)" params="x" if="@cplusplus"
macro log2 "__sprt_tg_r(log2, (x))(x)" params="x" if="@cplusplus"
macro logb "__sprt_tg_r(logb, (x))(x)" params="x" if="@cplusplus"
macro lrint "__sprt_tg_r(lrint, (x))(x)" params="x" if="@cplusplus"
macro lround "__sprt_tg_r(lround, (x))(x)" params="x" if="@cplusplus"
macro nearbyint "__sprt_tg_r(nearbyint, (x))(x)" params="x" if="@cplusplus"
macro rint "__sprt_tg_r(rint, (x))(x)" params="x" if="@cplusplus"
macro round "__sprt_tg_r(round, (x))(x)" params="x" if="@cplusplus"
macro tgamma "__sprt_tg_r(tgamma, (x))(x)" params="x" if="@cplusplus"
macro trunc "__sprt_tg_r(trunc, (x))(x)" params="x" if="@cplusplus"
// Real-only, two generic arguments (type from their usual arithmetic conversion).
macro atan2 "_Generic((x) + (y), float: atan2f, long double: atan2l, default: atan2)((x), (y))" params="x y" if="@cplusplus"
macro copysign "_Generic((x) + (y), float: copysignf, long double: copysignl, default: copysign)((x), (y))" params="x y" if="@cplusplus"
macro fdim "_Generic((x) + (y), float: fdimf, long double: fdiml, default: fdim)((x), (y))" params="x y" if="@cplusplus"
macro fmax "_Generic((x) + (y), float: fmaxf, long double: fmaxl, default: fmax)((x), (y))" params="x y" if="@cplusplus"
macro fmin "_Generic((x) + (y), float: fminf, long double: fminl, default: fmin)((x), (y))" params="x y" if="@cplusplus"
macro fmod "_Generic((x) + (y), float: fmodf, long double: fmodl, default: fmod)((x), (y))" params="x y" if="@cplusplus"
macro hypot "_Generic((x) + (y), float: hypotf, long double: hypotl, default: hypot)((x), (y))" params="x y" if="@cplusplus"
macro nextafter "_Generic((x) + (y), float: nextafterf, long double: nextafterl, default: nextafter)((x), (y))" params="x y" if="@cplusplus"
macro remainder "_Generic((x) + (y), float: remainderf, long double: remainderl, default: remainder)((x), (y))" params="x y" if="@cplusplus"
// Real-only with a fixed (non-generic) trailing argument; dispatch on the first.
macro frexp "_Generic((x), float: frexpf, long double: frexpl, default: frexp)((x), (y))" params="x y" if="@cplusplus"
macro ldexp "_Generic((x), float: ldexpf, long double: ldexpl, default: ldexp)((x), (y))" params="x y" if="@cplusplus"
macro scalbn "_Generic((x), float: scalbnf, long double: scalbnl, default: scalbn)((x), (y))" params="x y" if="@cplusplus"
macro scalbln "_Generic((x), float: scalblnf, long double: scalblnl, default: scalbln)((x), (y))" params="x y" if="@cplusplus"
macro nexttoward "_Generic((x), float: nexttowardf, long double: nexttowardl, default: nexttoward)((x), (y))" params="x y" if="@cplusplus"
// Real-only, three arguments.
macro fma "_Generic((x) + (y) + (z), float: fmaf, long double: fmal, default: fma)((x), (y), (z))" params="x y z" if="@cplusplus"
macro remquo "_Generic((x) + (y), float: remquof, long double: remquol, default: remquo)((x), (y), (z))" params="x y z" if="@cplusplus"
// Complex-only (real arguments convert to complex through `default:`).
macro carg "_Generic((x), float _Complex: cargf, long double _Complex: cargl, default: carg)(x)" params="x" if="@cplusplus"
macro cimag "_Generic((x), float _Complex: cimagf, long double _Complex: cimagl, default: cimag)(x)" params="x" if="@cplusplus"
macro conj "_Generic((x), float _Complex: conjf, long double _Complex: conjl, default: conj)(x)" params="x" if="@cplusplus"
macro cproj "_Generic((x), float _Complex: cprojf, long double _Complex: cprojl, default: cproj)(x)" params="x" if="@cplusplus"
macro creal "_Generic((x), float _Complex: crealf, long double _Complex: creall, default: creal)(x)" params="x" if="@cplusplus"
