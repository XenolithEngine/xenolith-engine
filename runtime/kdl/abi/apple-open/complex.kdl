//  `complex`/`imaginary` are keywords-via-macro in C only (in C++ they would
//    clash with std::complex). _Complex_I/I and the C11 CMPLX family use clang's
//    __builtin_complex so they are valid constant expressions.
macro complex _Complex if="!defined(__cplusplus) && !defined(complex)"
macro _Complex_I "(__builtin_complex(0.0f, 1.0f))" if="!defined(_Complex_I)"
macro I _Complex_I if="!defined(I)"
macro CMPLXF "__builtin_complex((float)(x), (float)(y))" params="x y" if="!defined(CMPLX)"
macro CMPLXL "__builtin_complex((long double)(x), (long double)(y))" params="x y" if="!defined(CMPLX)"
macro CMPLX "__builtin_complex((double)(x), (double)(y))" params="x y" if="!defined(CMPLX)"
