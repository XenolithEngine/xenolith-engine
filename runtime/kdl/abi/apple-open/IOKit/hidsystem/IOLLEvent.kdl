// device-dependent modifier-key masks (event.flags low bits)
macro NX_DEVICELCTLKEYMASK 0x00000001
macro NX_DEVICELSHIFTKEYMASK 0x00000002
macro NX_DEVICERSHIFTKEYMASK 0x00000004
macro NX_DEVICELCMDKEYMASK 0x00000008
macro NX_DEVICERCMDKEYMASK 0x00000010
macro NX_DEVICELALTKEYMASK 0x00000020
macro NX_DEVICERALTKEYMASK 0x00000040
macro NX_DEVICE_ALPHASHIFT_STATELESS_MASK 0x00000080
macro NX_DEVICERCTLKEYMASK 0x00002000
