//  nw objects — opaque handles. (The real framework makes them OS objects; treated
//    here as plain pointers, which is ABI-compatible and compiles under ARC.)
typedef nw_path_t "struct nw_path *"
typedef nw_path_monitor_t "struct nw_path_monitor *"
typedef nw_interface_t "struct nw_interface *"
enum typedef=nw_path_status_t {
    value nw_path_status_invalid 0
    value nw_path_status_satisfied 1
    value nw_path_status_unsatisfied 2
    value nw_path_status_satisfiable 3
}
enum typedef=nw_interface_type_t {
    value nw_interface_type_other 0
    value nw_interface_type_wifi 1
    value nw_interface_type_cellular 2
    value nw_interface_type_wired 3
    value nw_interface_type_loopback 4
}
