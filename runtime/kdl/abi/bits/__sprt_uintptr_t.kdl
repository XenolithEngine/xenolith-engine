cond assisted "CONFIG_COMPILER_ASSISTED_INTS && defined(__UINTPTR_TYPE__)"
cond e2k128 "defined(__e2k__) && defined(__SIZEOF_POINTER__) && __SIZEOF_POINTER__ > 8"
cond llp64 "defined(__LLP64__) || defined(_WIN64)"
cond ilp32 "defined(_WIN32) || defined(__ILP32__) || defined(__SPRT_WINDOWS)"
typedef uintptr_t __UINTPTR_TYPE__ if="@assisted"
macro UINTPTR_MAX __UINTPTR_MAX__ if="@assisted && defined(__UINTPTR_MAX__)"
error "Compiler-assisted __UINTPTR_MAX__ is not defined" if="@assisted && !defined(__UINTPTR_MAX__)"
macro UINTPTR_WIDTH __UINTPTR_WIDTH__ if="@assisted && defined(__UINTPTR_WIDTH__)"
error "Compiler-assisted __UINTPTR_WIDTH__ is not defined" if="@assisted && !defined(__UINTPTR_WIDTH__)"
macro UINTPTR_FMTX __UINTPTR_FMTX__ if="@assisted && defined(__UINTPTR_FMTX__)"
error "Compiler-assisted __UINTPTR_FMTX__ is not defined" if="@assisted && !defined(__UINTPTR_FMTX__)"
macro UINTPTR_FMTo __UINTPTR_FMTo__ if="@assisted && defined(__UINTPTR_FMTo__)"
error "Compiler-assisted __UINTPTR_FMTo__ is not defined" if="@assisted && !defined(__UINTPTR_FMTo__)"
macro UINTPTR_FMTu __UINTPTR_FMTu__ if="@assisted && defined(__UINTPTR_FMTu__)"
error "Compiler-assisted __UINTPTR_FMTu__ is not defined" if="@assisted && !defined(__UINTPTR_FMTu__)"
macro UINTPTR_FMTx __UINTPTR_FMTx__ if="@assisted && defined(__UINTPTR_FMTx__)"
error "Compiler-assisted __UINTPTR_FMTx__ is not defined" if="@assisted && !defined(__UINTPTR_FMTx__)"
// __UINTPTR_TYPE__
// Use Data models specifications
// e2k -m128 first: it also defines __LP64__ (long stays 8 bytes), but the
// 16-byte pointer needs a 16-byte integer to round-trip through casts;
typedef uintptr_t "unsigned __int128" if="!@assisted && @e2k128"
macro UINTPTR_MAX "(~(unsigned __int128)0)" if="!@assisted && @e2k128"
macro UINTPTR_WIDTH 128 if="!@assisted && @e2k128"
macro UINTPTR_FMTX "\"llX\"" if="!@assisted && @e2k128"
macro UINTPTR_FMTo "\"llo\"" if="!@assisted && @e2k128"
macro UINTPTR_FMTu "\"llu\"" if="!@assisted && @e2k128"
macro UINTPTR_FMTx "\"llx\"" if="!@assisted && @e2k128"
typedef uintptr_t "unsigned long long int" if="!@assisted && !@e2k128 && @llp64"
macro UINTPTR_MAX ULLINT_MAX if="!@assisted && !@e2k128 && @llp64"
macro UINTPTR_WIDTH ULLINT_WIDTH if="!@assisted && !@e2k128 && @llp64"
macro UINTPTR_FMTX ULLINT_FMTX if="!@assisted && !@e2k128 && @llp64"
macro UINTPTR_FMTo ULLINT_FMTo if="!@assisted && !@e2k128 && @llp64"
macro UINTPTR_FMTu ULLINT_FMTu if="!@assisted && !@e2k128 && @llp64"
macro UINTPTR_FMTx ULLINT_FMTx if="!@assisted && !@e2k128 && @llp64"
typedef uintptr_t "unsigned int" if="!@assisted && !@e2k128 && !@llp64 && @ilp32"
macro UINTPTR_MAX UINT_MAX if="!@assisted && !@e2k128 && !@llp64 && @ilp32"
macro UINTPTR_WIDTH UINT_WIDTH if="!@assisted && !@e2k128 && !@llp64 && @ilp32"
macro UINTPTR_FMTX UINT_FMTX if="!@assisted && !@e2k128 && !@llp64 && @ilp32"
macro UINTPTR_FMTo UINT_FMTo if="!@assisted && !@e2k128 && !@llp64 && @ilp32"
macro UINTPTR_FMTu UINT_FMTu if="!@assisted && !@e2k128 && !@llp64 && @ilp32"
macro UINTPTR_FMTx UINT_FMTx if="!@assisted && !@e2k128 && !@llp64 && @ilp32"
typedef uintptr_t "unsigned long int" if="!@assisted && !@e2k128 && !@llp64 && !@ilp32 && defined(__LP64__)"
macro UINTPTR_MAX ULINT_MAX if="!@assisted && !@e2k128 && !@llp64 && !@ilp32 && defined(__LP64__)"
macro UINTPTR_WIDTH ULINT_WIDTH if="!@assisted && !@e2k128 && !@llp64 && !@ilp32 && defined(__LP64__)"
macro UINTPTR_FMTX ULINT_FMTX if="!@assisted && !@e2k128 && !@llp64 && !@ilp32 && defined(__LP64__)"
macro UINTPTR_FMTo ULINT_FMTo if="!@assisted && !@e2k128 && !@llp64 && !@ilp32 && defined(__LP64__)"
macro UINTPTR_FMTu ULINT_FMTu if="!@assisted && !@e2k128 && !@llp64 && !@ilp32 && defined(__LP64__)"
macro UINTPTR_FMTx ULINT_FMTx if="!@assisted && !@e2k128 && !@llp64 && !@ilp32 && defined(__LP64__)"
error "Unknown data model (see https://en.cppreference.com/w/cpp/language/types.html#Data_models)" if="!@assisted && !@e2k128 && !@llp64 && !@ilp32 && !defined(__LP64__)"
