cond assisted "CONFIG_COMPILER_ASSISTED_INTS && defined(__INTMAX_TYPE__)"
cond llp64_or_ilp32 "defined(__LLP64__) || defined(_WIN64) || defined(_WIN32) || defined(__ILP32__) || defined(__SPRT_WINDOWS)"
typedef intmax_t __INTMAX_TYPE__ if="@assisted"
macro INTMAX_MAX __INTMAX_MAX__ if="@assisted && defined(__INTMAX_MAX__)"
error "Compiler-assisted __INTMAX_MAX__ is not defined" if="@assisted && !defined(__INTMAX_MAX__)"
macro INTMAX_WIDTH __INTMAX_WIDTH__ if="@assisted && defined(__INTMAX_WIDTH__)"
error "Compiler-assisted __INTMAX_WIDTH__ is not defined" if="@assisted && !defined(__INTMAX_WIDTH__)"
macro INTMAX_FMTd __INTMAX_FMTd__ if="@assisted && defined(__INTMAX_FMTd__)"
error "Compiler-assisted __INTMAX_FMTd__ is not defined" if="@assisted && !defined(__INTMAX_FMTd__)"
macro INTMAX_FMTi __INTMAX_FMTi__ if="@assisted && defined(__INTMAX_FMTi__)"
error "Compiler-assisted __INTMAX_FMTi__ is not defined" if="@assisted && !defined(__INTMAX_FMTi__)"
macro INTMAX_C "__INTMAX_C(C)" params="C" if="@assisted && defined(__INTMAX_C)"
error "Compiler-assisted __INTMAX_FMTx__ is not defined" if="@assisted && !defined(__INTMAX_C)"
macro `__INTMAX_C_SUFFIX` __INTMAX_C_SUFFIX__ if="@assisted && defined(__INTMAX_C_SUFFIX__)"
error "Compiler-assisted __INTMAX_C_SUFFIX__ is not defined" if="@assisted && !defined(__INTMAX_C_SUFFIX__)"
// __INTMAX_TYPE__
// Use Data models specifications
typedef intmax_t "long long int" if="!@assisted && @llp64_or_ilp32"
macro INTMAX_MAX LLINT_MAX if="!@assisted && @llp64_or_ilp32"
macro INTMAX_WIDTH LLINT_WIDTH if="!@assisted && @llp64_or_ilp32"
macro INTMAX_FMTd LLINT_FMTd if="!@assisted && @llp64_or_ilp32"
macro INTMAX_FMTi LLINT_FMTi if="!@assisted && @llp64_or_ilp32"
macro INTMAX_C "LLINT_C(C)" params="C" if="!@assisted && @llp64_or_ilp32"
macro INTMAX_C_SUFFIX LLINT_C_SUFFIX if="!@assisted && @llp64_or_ilp32"
typedef intmax_t "long int" if="!@assisted && !@llp64_or_ilp32 && defined(__LP64__)"
macro INTMAX_MAX LINT_MAX if="!@assisted && !@llp64_or_ilp32 && defined(__LP64__)"
macro INTMAX_WIDTH LINT_WIDTH if="!@assisted && !@llp64_or_ilp32 && defined(__LP64__)"
macro INTMAX_FMTd LINT_FMTd if="!@assisted && !@llp64_or_ilp32 && defined(__LP64__)"
macro INTMAX_FMTi LINT_FMTi if="!@assisted && !@llp64_or_ilp32 && defined(__LP64__)"
macro INTMAX_C "LINT_C(C)" params="C" if="!@assisted && !@llp64_or_ilp32 && defined(__LP64__)"
macro INTMAX_C_SUFFIX LLINT_C_SUFFIX if="!@assisted && !@llp64_or_ilp32 && defined(__LP64__)"
error "Unknown data model (see https://en.cppreference.com/w/cpp/language/types.html#Data_models)" if="!@assisted && !@llp64_or_ilp32 && !defined(__LP64__)"
// __INTMAX_TYPE__
macro INTMAX_MIN "(-1-INTMAX_MAX)"
