cond assisted "CONFIG_COMPILER_ASSISTED_INTS && defined(__WINT_TYPE__)"
typedef wint_t __WINT_TYPE__ if="@assisted"
macro WINT_MAX __WINT_MAX__ if="@assisted && defined(__WINT_MAX__)"
error "Compiler-assisted __WINT_MAX__ is not defined" if="@assisted && !defined(__WINT_MAX__)"
macro WINT_WIDTH __WINT_WIDTH__ if="@assisted && defined(__WINT_WIDTH__)"
error "Compiler-assisted __WINT_WIDTH__ is not defined" if="@assisted && !defined(__WINT_WIDTH__)"
macro WINT_MIN 0 if="@assisted && defined(__WINT_UNSIGNED__)"
macro WINT_MIN "(-1-WINT_MAX)" if="@assisted && !defined(__WINT_UNSIGNED__)"
typedef wint_t "unsigned short" if="!@assisted && SPRT_WINDOWS"
macro WINT_MAX 0xffff if="!@assisted && SPRT_WINDOWS"
macro WINT_WIDTH 16 if="!@assisted && SPRT_WINDOWS"
macro WINT_MIN 0 if="!@assisted && SPRT_WINDOWS"
typedef wint_t "unsigned int" if="!@assisted && !(SPRT_WINDOWS)"
macro WINT_MAX "0xffff'ffff" if="!@assisted && !(SPRT_WINDOWS)"
macro WINT_WIDTH 32 if="!@assisted && !(SPRT_WINDOWS)"
macro WINT_MIN 0 if="!@assisted && !(SPRT_WINDOWS)"
