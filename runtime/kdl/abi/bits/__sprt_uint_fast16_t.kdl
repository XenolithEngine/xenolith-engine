cond assisted "CONFIG_COMPILER_ASSISTED_INTS && defined(__UINT_FAST16_TYPE__)"
cond data_model "defined(__LLP64__) || defined(_WIN64) || defined(_WIN32) || defined(__ILP32__) || defined(__LP64__) || defined(__SPRT_WINDOWS)"
typedef uint_fast16_t __UINT_FAST16_TYPE__ if="@assisted"
macro UINT_FAST16_MAX __UINT_FAST16_MAX__ if="@assisted && defined(__UINT_FAST16_MAX__)"
error "Compiler-assisted __UINT_FAST16_MAX__ is not defined" if="@assisted && !defined(__UINT_FAST16_MAX__)"
macro UINT_FAST16_WIDTH 16 if="@assisted"
macro UINT_FAST16_FMTX __UINT_FAST16_FMTX__ if="@assisted && defined(__UINT_FAST16_FMTX__)"
error "Compiler-assisted __UINT_FAST16_FMTX__ is not defined" if="@assisted && !defined(__UINT_FAST16_FMTX__)"
macro UINT_FAST16_FMTo __UINT_FAST16_FMTo__ if="@assisted && defined(__UINT_FAST16_FMTo__)"
error "Compiler-assisted __UINT_FAST16_FMTo__ is not defined" if="@assisted && !defined(__UINT_FAST16_FMTo__)"
macro UINT_FAST16_FMTu __UINT_FAST16_FMTu__ if="@assisted && defined(__UINT_FAST16_FMTu__)"
error "Compiler-assisted __UINT_FAST16_FMTu__ is not defined" if="@assisted && !defined(__UINT_FAST16_FMTu__)"
macro UINT_FAST16_FMTx __UINT_FAST16_FMTx__ if="@assisted && defined(__UINT_FAST16_FMTx__)"
error "Compiler-assisted __UINT_FAST16_FMTx__ is not defined" if="@assisted && !defined(__UINT_FAST16_FMTx__)"
// __UINT_FAST16_TYPE__
// Use Data models specifications
typedef uint_fast16_t "unsigned short int" if="!@assisted && @data_model"
macro UINT_FAST16_MAX USHRT_MAX if="!@assisted && @data_model"
macro UINT_FAST16_WIDTH USHRT_WIDTH if="!@assisted && @data_model"
macro UINT_FAST16_FMTX USHRT_FMTX if="!@assisted && @data_model"
macro UINT_FAST16_FMTo USHRT_FMTo if="!@assisted && @data_model"
macro UINT_FAST16_FMTu USHRT_FMTu if="!@assisted && @data_model"
macro UINT_FAST16_FMTx USHRT_FMTx if="!@assisted && @data_model"
error "Unknown data model (see https://en.cppreference.com/w/cpp/language/types.html#Data_models)" if="!@assisted && !@data_model"
