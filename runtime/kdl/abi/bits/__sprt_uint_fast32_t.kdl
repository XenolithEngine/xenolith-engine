cond assisted "CONFIG_COMPILER_ASSISTED_INTS && defined(__UINT_FAST32_TYPE__)"
cond data_model "defined(__LLP64__) || defined(_WIN64) || defined(_WIN32) || defined(__ILP32__) || defined(__LP64__) || defined(__SPRT_WINDOWS)"
typedef uint_fast32_t __UINT_FAST32_TYPE__ if="@assisted"
macro UINT_FAST32_MAX __UINT_FAST32_MAX__ if="@assisted && defined(__UINT_FAST32_MAX__)"
error "Compiler-assisted __UINT_FAST32_MAX__ is not defined" if="@assisted && !defined(__UINT_FAST32_MAX__)"
macro UINT_FAST32_WIDTH 32 if="@assisted"
macro UINT_FAST32_FMTX __UINT_FAST32_FMTX__ if="@assisted && defined(__UINT_FAST32_FMTX__)"
error "Compiler-assisted __UINT_FAST32_FMTX__ is not defined" if="@assisted && !defined(__UINT_FAST32_FMTX__)"
macro UINT_FAST32_FMTo __UINT_FAST32_FMTo__ if="@assisted && defined(__UINT_FAST32_FMTo__)"
error "Compiler-assisted __UINT_FAST32_FMTo__ is not defined" if="@assisted && !defined(__UINT_FAST32_FMTo__)"
macro UINT_FAST32_FMTu __UINT_FAST32_FMTu__ if="@assisted && defined(__UINT_FAST32_FMTu__)"
error "Compiler-assisted __UINT_FAST32_FMTu__ is not defined" if="@assisted && !defined(__UINT_FAST32_FMTu__)"
macro UINT_FAST32_FMTx __UINT_FAST32_FMTx__ if="@assisted && defined(__UINT_FAST32_FMTx__)"
error "Compiler-assisted __UINT_FAST32_FMTx__ is not defined" if="@assisted && !defined(__UINT_FAST32_FMTx__)"
// __UINT_FAST32_TYPE__
// Use Data models specifications
typedef uint_fast32_t "unsigned int" if="!@assisted && @data_model"
macro UINT_FAST32_MAX UINT_MAX if="!@assisted && @data_model"
macro UINT_FAST32_WIDTH UINT_WIDTH if="!@assisted && @data_model"
macro UINT_FAST32_FMTX UINT_FMTX if="!@assisted && @data_model"
macro UINT_FAST32_FMTo UINT_FMTo if="!@assisted && @data_model"
macro UINT_FAST32_FMTu UINT_FMTu if="!@assisted && @data_model"
macro UINT_FAST32_FMTx UINT_FMTx if="!@assisted && @data_model"
error "Unknown data model (see https://en.cppreference.com/w/cpp/language/types.html#Data_models)" if="!@assisted && !@data_model"
