cond assisted "CONFIG_COMPILER_ASSISTED_INTS && defined(__INTPTR_TYPE__)"
cond e2k128 "defined(__e2k__) && defined(__SIZEOF_POINTER__) && __SIZEOF_POINTER__ > 8"
cond llp64 "defined(__LLP64__) || defined(_WIN64)"
cond ilp32 "defined(_WIN32) || defined(__ILP32__) || defined(__SPRT_WINDOWS)"
typedef intptr_t __INTPTR_TYPE__ if="@assisted"
macro INTPTR_MAX __INTPTR_MAX__ if="@assisted && defined(__INTPTR_MAX__)"
error "Compiler-assisted __INTPTR_MAX__ is not defined" if="@assisted && !defined(__INTPTR_MAX__)"
macro INTPTR_WIDTH __INTPTR_WIDTH__ if="@assisted && defined(__INTPTR_WIDTH__)"
error "Compiler-assisted __INTPTR_WIDTH__ is not defined" if="@assisted && !defined(__INTPTR_WIDTH__)"
macro INTPTR_FMTd __INTPTR_FMTd__ if="@assisted && defined(__INTPTR_FMTd__)"
error "Compiler-assisted __INTPTR_FMTd__ is not defined" if="@assisted && !defined(__INTPTR_FMTd__)"
macro INTPTR_FMTi __INTPTR_FMTi__ if="@assisted && defined(__INTPTR_FMTi__)"
error "Compiler-assisted __INTPTR_FMTi__ is not defined" if="@assisted && !defined(__INTPTR_FMTi__)"
// __INTPTR_TYPE__
// Use Data models specifications
// e2k -m128 first: it also defines __LP64__ (long stays 8 bytes), but the
// 16-byte pointer needs a 16-byte integer (see __sprt_uintptr_t.h).
typedef intptr_t __int128 if="!@assisted && @e2k128"
macro INTPTR_MAX "((__int128)((~(unsigned __int128)0) >> 1))" if="!@assisted && @e2k128"
macro INTPTR_WIDTH 128 if="!@assisted && @e2k128"
macro INTPTR_FMTd "\"lld\"" if="!@assisted && @e2k128"
macro INTPTR_FMTi "\"lli\"" if="!@assisted && @e2k128"
typedef intptr_t "long long int" if="!@assisted && !@e2k128 && @llp64"
macro INTPTR_MAX LLINT_MAX if="!@assisted && !@e2k128 && @llp64"
macro INTPTR_WIDTH LLINT_WIDTH if="!@assisted && !@e2k128 && @llp64"
macro INTPTR_FMTd LLINT_FMTd if="!@assisted && !@e2k128 && @llp64"
macro INTPTR_FMTi LLINT_FMTi if="!@assisted && !@e2k128 && @llp64"
typedef intptr_t int if="!@assisted && !@e2k128 && !@llp64 && @ilp32"
macro INTPTR_MAX INT_MAX if="!@assisted && !@e2k128 && !@llp64 && @ilp32"
macro INTPTR_WIDTH INT_WIDTH if="!@assisted && !@e2k128 && !@llp64 && @ilp32"
macro INTPTR_FMTd INT_FMTd if="!@assisted && !@e2k128 && !@llp64 && @ilp32"
macro INTPTR_FMTi INT_FMTi if="!@assisted && !@e2k128 && !@llp64 && @ilp32"
typedef intptr_t "long int" if="!@assisted && !@e2k128 && !@llp64 && !@ilp32 && defined(__LP64__)"
macro INTPTR_MAX LINT_MAX if="!@assisted && !@e2k128 && !@llp64 && !@ilp32 && defined(__LP64__)"
macro INTPTR_WIDTH LINT_WIDTH if="!@assisted && !@e2k128 && !@llp64 && !@ilp32 && defined(__LP64__)"
macro INTPTR_FMTd LINT_FMTd if="!@assisted && !@e2k128 && !@llp64 && !@ilp32 && defined(__LP64__)"
macro INTPTR_FMTi LINT_FMTi if="!@assisted && !@e2k128 && !@llp64 && !@ilp32 && defined(__LP64__)"
error "Unknown data model (see https://en.cppreference.com/w/cpp/language/types.html#Data_models)" if="!@assisted && !@e2k128 && !@llp64 && !@ilp32 && !defined(__LP64__)"
// __INTPTR_TYPE__
macro INTPTR_MIN "(-1-INTPTR_MAX)"
