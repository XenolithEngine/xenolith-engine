cond assisted "CONFIG_COMPILER_ASSISTED_INTS && defined(__UINT32_TYPE__)"
cond data_model "defined(__LLP64__) || defined(_WIN64) || defined(_WIN32) || defined(__ILP32__) || defined(__LP64__) || defined(__SPRT_WINDOWS)"
typedef uint32_t __UINT32_TYPE__ if="@assisted"
macro UINT32_MAX __UINT32_MAX__ if="@assisted && defined(__UINT32_MAX__)"
error "Compiler-assisted __UINT32_MAX__ is not defined" if="@assisted && !defined(__UINT32_MAX__)"
macro UINT32_WIDTH 32 if="@assisted"
macro UINT32_FMTX __UINT32_FMTX__ if="@assisted && defined(__UINT32_FMTX__)"
error "Compiler-assisted __UINT32_FMTX__ is not defined" if="@assisted && !defined(__UINT32_FMTX__)"
macro UINT32_FMTo __UINT32_FMTo__ if="@assisted && defined(__UINT32_FMTo__)"
error "Compiler-assisted __UINT32_FMTo__ is not defined" if="@assisted && !defined(__UINT32_FMTo__)"
macro UINT32_FMTu __UINT32_FMTu__ if="@assisted && defined(__UINT32_FMTu__)"
error "Compiler-assisted __UINT32_FMTu__ is not defined" if="@assisted && !defined(__UINT32_FMTu__)"
macro UINT32_FMTx __UINT32_FMTx__ if="@assisted && defined(__UINT32_FMTx__)"
error "Compiler-assisted __UINT32_FMTx__ is not defined" if="@assisted && !defined(__UINT32_FMTx__)"
macro UINT32_C "__UINT32_C(C)" params="C" if="@assisted && defined(__UINT32_C)"
error "Compiler-assisted __UINT32_C is not defined" if="@assisted && !defined(__UINT32_C)"
macro `__UINT32_C_SUFFIX` __UINT32_C_SUFFIX__ if="@assisted && defined(__UINT32_C_SUFFIX__)"
error "Compiler-assisted __UINT32_C_SUFFIX__ is not defined" if="@assisted && !defined(__UINT32_C_SUFFIX__)"
// __UINT32_TYPE__
// Use Data models specifications
typedef uint32_t "unsigned int" if="!@assisted && @data_model"
macro UINT32_MAX UINT_MAX if="!@assisted && @data_model"
macro UINT32_WIDTH UINT_WIDTH if="!@assisted && @data_model"
macro UINT32_FMTX UINT_FMTX if="!@assisted && @data_model"
macro UINT32_FMTo UINT_FMTo if="!@assisted && @data_model"
macro UINT32_FMTu UINT_FMTu if="!@assisted && @data_model"
macro UINT32_FMTx UINT_FMTx if="!@assisted && @data_model"
macro UINT32_C "UINT_C(C)" params="C" if="!@assisted && @data_model"
macro UINT32_C_SUFFIX UINT_C_SUFFIX if="!@assisted && @data_model"
error "Unknown data model (see https://en.cppreference.com/w/cpp/language/types.html#Data_models)" if="!@assisted && !@data_model"
