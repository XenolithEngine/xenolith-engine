cond assisted "CONFIG_COMPILER_ASSISTED_INTS && defined(__SIZE_TYPE__)"
cond llp64 "defined(__LLP64__) || defined(_WIN64)"
cond ilp32 "defined(_WIN32) || defined(__ILP32__) || defined(__SPRT_WINDOWS)"
cond sprt_windows "defined(__SPRT_WINDOWS)"
typedef size_t __SIZE_TYPE__ if="@assisted"
macro SIZE_MAX __SIZE_MAX__ if="@assisted && defined(__SIZE_MAX__)"
error "Compiler-assisted __SIZE_MAX__ is not defined" if="@assisted && !defined(__SIZE_MAX__)"
macro SIZE_WIDTH __SIZE_WIDTH__ if="@assisted && defined(__SIZE_WIDTH__)"
error "Compiler-assisted __SIZE_WIDTH__ is not defined" if="@assisted && !defined(__SIZE_WIDTH__)"
macro SIZE_FMTX __SIZE_FMTX__ if="@assisted && defined(__SIZE_FMTX__)"
error "Compiler-assisted __SIZE_FMTX__ is not defined" if="@assisted && !defined(__SIZE_FMTX__)"
macro SIZE_FMTo __SIZE_FMTo__ if="@assisted && defined(__SIZE_FMTo__)"
error "Compiler-assisted __SIZE_FMTo__ is not defined" if="@assisted && !defined(__SIZE_FMTo__)"
macro SIZE_FMTu __SIZE_FMTu__ if="@assisted && defined(__SIZE_FMTu__)"
error "Compiler-assisted __SIZE_FMTu__ is not defined" if="@assisted && !defined(__SIZE_FMTu__)"
macro SIZE_FMTx __SIZE_FMTx__ if="@assisted && defined(__SIZE_FMTx__)"
error "Compiler-assisted __SIZE_FMTx__ is not defined" if="@assisted && !defined(__SIZE_FMTx__)"
// __SIZE_TYPE__
// Use Data models specifications
typedef size_t "unsigned long long int" if="!@assisted && @llp64"
macro SIZE_MAX ULLINT_MAX if="!@assisted && @llp64"
macro SIZE_WIDTH ULLINT_WIDTH if="!@assisted && @llp64"
macro SIZE_FMTX ULLINT_FMTX if="!@assisted && @llp64"
macro SIZE_FMTo ULLINT_FMTo if="!@assisted && @llp64"
macro SIZE_FMTu ULLINT_FMTu if="!@assisted && @llp64"
macro SIZE_FMTx ULLINT_FMTx if="!@assisted && @llp64"
typedef size_t "unsigned long int" if="!@assisted && !@llp64 && @ilp32 && @sprt_windows"
macro SIZE_MAX ULINT_MAX if="!@assisted && !@llp64 && @ilp32 && @sprt_windows"
macro SIZE_WIDTH ULINT_WIDTH if="!@assisted && !@llp64 && @ilp32 && @sprt_windows"
macro SIZE_FMTX ULINT_FMTX if="!@assisted && !@llp64 && @ilp32 && @sprt_windows"
macro SIZE_FMTo ULINT_FMTo if="!@assisted && !@llp64 && @ilp32 && @sprt_windows"
macro SIZE_FMTu ULINT_FMTu if="!@assisted && !@llp64 && @ilp32 && @sprt_windows"
macro SIZE_FMTx ULINT_FMTx if="!@assisted && !@llp64 && @ilp32 && @sprt_windows"
typedef size_t "unsigned int" if="!@assisted && !@llp64 && @ilp32 && !@sprt_windows"
macro SIZE_MAX UINT_MAX if="!@assisted && !@llp64 && @ilp32 && !@sprt_windows"
macro SIZE_WIDTH UINT_WIDTH if="!@assisted && !@llp64 && @ilp32 && !@sprt_windows"
macro SIZE_FMTX UINT_FMTX if="!@assisted && !@llp64 && @ilp32 && !@sprt_windows"
macro SIZE_FMTo UINT_FMTo if="!@assisted && !@llp64 && @ilp32 && !@sprt_windows"
macro SIZE_FMTu UINT_FMTu if="!@assisted && !@llp64 && @ilp32 && !@sprt_windows"
macro SIZE_FMTx UINT_FMTx if="!@assisted && !@llp64 && @ilp32 && !@sprt_windows"
typedef size_t "unsigned long int" if="!@assisted && !@llp64 && !@ilp32 && defined(__LP64__)"
macro SIZE_MAX ULINT_MAX if="!@assisted && !@llp64 && !@ilp32 && defined(__LP64__)"
macro SIZE_WIDTH ULINT_WIDTH if="!@assisted && !@llp64 && !@ilp32 && defined(__LP64__)"
macro SIZE_FMTX ULINT_FMTX if="!@assisted && !@llp64 && !@ilp32 && defined(__LP64__)"
macro SIZE_FMTo ULINT_FMTo if="!@assisted && !@llp64 && !@ilp32 && defined(__LP64__)"
macro SIZE_FMTu ULINT_FMTu if="!@assisted && !@llp64 && !@ilp32 && defined(__LP64__)"
macro SIZE_FMTx ULINT_FMTx if="!@assisted && !@llp64 && !@ilp32 && defined(__LP64__)"
error "Unknown data model (see https://en.cppreference.com/w/cpp/language/types.html#Data_models)" if="!@assisted && !@llp64 && !@ilp32 && !defined(__LP64__)"
// __SIZE_TYPE__
typedef rsize_t size_t
macro SIZE_MIN 0
macro RSIZE_MAX SIZE_MAX
macro RSIZE_MIN SIZE_MIN
