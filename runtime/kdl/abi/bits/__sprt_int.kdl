macro SSHRT_MAX 0x7f if="!@llp64 && !@ilp32 && defined(__LP64__) && @sshrt_max"
macro USSHRT_MAX 0xff if="!@llp64 && !@ilp32 && defined(__LP64__) && @usshrt_max"
