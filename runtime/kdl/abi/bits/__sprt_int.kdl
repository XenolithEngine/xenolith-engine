macro LLONG_BIT __LLONG_WIDTH__ if="defined(__LLONG_WIDTH__)"
// Use Data models specifications
macro LLONG_MAX "0x7fffffffffffffffLL" if="@llp64 && @llong_max"
macro ULLONG_MAX "0xFfffffffffffffffULL" if="@llp64 && @ullong_max"
macro LLONG_BIT 64 if="@llp64 && @llong_bit"
