macro LLONG_BIT 64 if="!@llp64 && !@ilp32 && defined(__LP64__) && @llong_bit"
macro LONG_MAX "0x7fffffffffffffffL" if="!@llp64 && !@ilp32 && defined(__LP64__) && @long_bit"
macro ULONG_MAX "0xFfffffffffffffffUL" if="!@llp64 && !@ilp32 && defined(__LP64__) && @ulong_max"
macro LONG_BIT 64 if="!@llp64 && !@ilp32 && defined(__LP64__) && @long_bit"
macro INT_MAX 0x7fffffff if="!@llp64 && !@ilp32 && defined(__LP64__) && @int_max"
macro UINT_MAX "0xffffffffU" if="!@llp64 && !@ilp32 && defined(__LP64__) && @uint_max"
macro INT_BIT 32 if="!@llp64 && !@ilp32 && defined(__LP64__) && @int_bit"
