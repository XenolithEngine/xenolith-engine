cond assisted "CONFIG_COMPILER_ASSISTED_INTS && defined(__INT_LEAST64_TYPE__)"
cond llp64_or_ilp32 "defined(__LLP64__) || defined(_WIN64) || defined(_WIN32) || defined(__ILP32__) || defined(__SPRT_WINDOWS)"
typedef int_least64_t __INT_LEAST64_TYPE__ if="@assisted"
macro INT_LEAST64_MAX __INT_LEAST64_MAX__ if="@assisted && defined(__INT_LEAST64_MAX__)"
error "Compiler-assisted __INT_LEAST64_MAX__ is not defined" if="@assisted && !defined(__INT_LEAST64_MAX__)"
macro INT_LEAST64_WIDTH 64 if="@assisted"
macro INT_LEAST64_FMTd __INT_LEAST64_FMTd__ if="@assisted && defined(__INT_LEAST64_FMTd__)"
error "Compiler-assisted __INT_LEAST64_FMTd__ is not defined" if="@assisted && !defined(__INT_LEAST64_FMTd__)"
macro INT_LEAST64_FMTi __INT_LEAST64_FMTi__ if="@assisted && defined(__INT_LEAST64_FMTi__)"
error "Compiler-assisted __INT_LEAST64_FMTi__ is not defined" if="@assisted && !defined(__INT_LEAST64_FMTi__)"
// __INT_LEAST64_TYPE__
// Use Data models specifications
typedef int_least64_t "long long int" if="!@assisted && @llp64_or_ilp32"
macro INT_LEAST64_MAX LLINT_MAX if="!@assisted && @llp64_or_ilp32"
macro INT_LEAST64_WIDTH LLINT_WIDTH if="!@assisted && @llp64_or_ilp32"
macro INT_LEAST64_FMTd LLINT_FMTd if="!@assisted && @llp64_or_ilp32"
macro INT_LEAST64_FMTi LLINT_FMTi if="!@assisted && @llp64_or_ilp32"
typedef int_least64_t "long int" if="!@assisted && !@llp64_or_ilp32 && defined(__LP64__)"
macro INT_LEAST64_MAX LINT_MAX if="!@assisted && !@llp64_or_ilp32 && defined(__LP64__)"
macro INT_LEAST64_WIDTH LINT_WIDTH if="!@assisted && !@llp64_or_ilp32 && defined(__LP64__)"
macro INT_LEAST64_FMTd LINT_FMTd if="!@assisted && !@llp64_or_ilp32 && defined(__LP64__)"
macro INT_LEAST64_FMTi LINT_FMTi if="!@assisted && !@llp64_or_ilp32 && defined(__LP64__)"
error "Unknown data model (see https://en.cppreference.com/w/cpp/language/types.html#Data_models)" if="!@assisted && !@llp64_or_ilp32 && !defined(__LP64__)"
