cond assisted "CONFIG_COMPILER_ASSISTED_INTS && defined(__INT_FAST32_TYPE__)"
cond data_model "defined(__LLP64__) || defined(_WIN64) || defined(_WIN32) || defined(__ILP32__) || defined(__LP64__) || defined(__SPRT_WINDOWS)"
typedef int_fast32_t __INT_FAST32_TYPE__ if="@assisted"
macro INT_FAST32_MAX __INT_FAST32_MAX__ if="@assisted && defined(__INT_FAST32_MAX__)"
error "Compiler-assisted __INT_FAST32_MAX__ is not defined" if="@assisted && !defined(__INT_FAST32_MAX__)"
macro INT_FAST32_WIDTH 32 if="@assisted"
macro INT_FAST32_FMTd __INT_FAST32_FMTd__ if="@assisted && defined(__INT_FAST32_FMTd__)"
error "Compiler-assisted __INT_FAST32_FMTd__ is not defined" if="@assisted && !defined(__INT_FAST32_FMTd__)"
macro INT_FAST32_FMTi __INT_FAST32_FMTi__ if="@assisted && defined(__INT_FAST32_FMTi__)"
error "Compiler-assisted __INT_FAST32_FMTi__ is not defined" if="@assisted && !defined(__INT_FAST32_FMTi__)"
// __INT_FAST32_TYPE__
// Use Data models specifications
typedef int_fast32_t int if="!@assisted && @data_model"
macro INT_FAST32_MAX INT_MAX if="!@assisted && @data_model"
macro INT_FAST32_WIDTH INT_WIDTH if="!@assisted && @data_model"
macro INT_FAST32_FMTd INT_FMTd if="!@assisted && @data_model"
macro INT_FAST32_FMTi INT_FMTi if="!@assisted && @data_model"
error "Unknown data model (see https://en.cppreference.com/w/cpp/language/types.html#Data_models)" if="!@assisted && !@data_model"
