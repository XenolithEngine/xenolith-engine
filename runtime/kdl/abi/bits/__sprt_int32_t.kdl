cond assisted "CONFIG_COMPILER_ASSISTED_INTS && defined(__INT32_TYPE__)"
cond data_model "defined(__LLP64__) || defined(_WIN64) || defined(_WIN32) || defined(__ILP32__) || defined(__LP64__) || defined(__SPRT_WINDOWS)"
typedef int32_t __INT32_TYPE__ if="@assisted"
macro INT32_MAX __INT32_MAX__ if="@assisted && defined(__INT32_MAX__)"
error "Compiler-assisted __INT32_MAX__ is not defined" if="@assisted && !defined(__INT32_MAX__)"
macro INT32_WIDTH 32 if="@assisted"
macro INT32_FMTd __INT32_FMTd__ if="@assisted && defined(__INT32_FMTd__)"
error "Compiler-assisted __INT32_FMTd__ is not defined" if="@assisted && !defined(__INT32_FMTd__)"
macro INT32_FMTi __INT32_FMTi__ if="@assisted && defined(__INT32_FMTi__)"
error "Compiler-assisted __INT32_FMTi__ is not defined" if="@assisted && !defined(__INT32_FMTi__)"
macro INT32_C "__INT32_C(C)" params="C" if="@assisted && defined(__INT32_C)"
error "Compiler-assisted __INT32_FMTx__ is not defined" if="@assisted && !defined(__INT32_C)"
macro `__INT32_C_SUFFIX` __INT32_C_SUFFIX__ if="@assisted && defined(__INT32_C_SUFFIX__)"
error "Compiler-assisted __INT32_C_SUFFIX__ is not defined" if="@assisted && !defined(__INT32_C_SUFFIX__)"
// __INT32_TYPE__
// Use Data models specifications
typedef int32_t int if="!@assisted && @data_model"
macro INT32_MAX INT_MAX if="!@assisted && @data_model"
macro INT32_WIDTH INT_WIDTH if="!@assisted && @data_model"
macro INT32_FMTd INT_FMTd if="!@assisted && @data_model"
macro INT32_FMTi INT_FMTi if="!@assisted && @data_model"
macro INT32_C "INT_C(C)" params="C" if="!@assisted && @data_model"
macro INT32_C_SUFFIX INT_C_SUFFIX if="!@assisted && @data_model"
error "Unknown data model (see https://en.cppreference.com/w/cpp/language/types.html#Data_models)" if="!@assisted && !@data_model"
