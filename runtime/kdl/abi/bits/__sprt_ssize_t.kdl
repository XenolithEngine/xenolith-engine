cond llp64_or_ilp32 "defined(__LLP64__) || defined(_WIN64) || defined(_WIN32) || defined(__ILP32__) || defined(__SPRT_WINDOWS)"
// ssize_t is always 64-bit for sprt to work with large files on all platforms
// Use Data models specifications
typedef ssize_t "long long int" if="@llp64_or_ilp32"
macro SSIZE_MAX LLINT_MAX if="@llp64_or_ilp32"
macro SSIZE_WIDTH LLINT_WIDTH if="@llp64_or_ilp32"
typedef ssize_t "long int" if="!@llp64_or_ilp32 && defined(__LP64__)"
macro SSIZE_MAX LINT_MAX if="!@llp64_or_ilp32 && defined(__LP64__)"
macro SSIZE_WIDTH LINT_WIDTH if="!@llp64_or_ilp32 && defined(__LP64__)"
error "Unknown data model (see https://en.cppreference.com/w/cpp/language/types.html#Data_models)" if="!@llp64_or_ilp32 && !defined(__LP64__)"
typedef off_t ssize_t
