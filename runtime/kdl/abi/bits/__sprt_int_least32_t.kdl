cond assisted "CONFIG_COMPILER_ASSISTED_INTS && defined(__INT_LEAST32_TYPE__)"
cond data_model "defined(__LLP64__) || defined(_WIN64) || defined(_WIN32) || defined(__ILP32__) || defined(__LP64__) || defined(__SPRT_WINDOWS)"
typedef int_least32_t __INT_LEAST32_TYPE__ if="@assisted"
macro INT_LEAST32_MAX __INT_LEAST32_MAX__ if="@assisted && defined(__INT_LEAST32_MAX__)"
error "Compiler-assisted __INT_LEAST32_MAX__ is not defined" if="@assisted && !defined(__INT_LEAST32_MAX__)"
macro INT_LEAST32_WIDTH 32 if="@assisted"
macro INT_LEAST32_FMTd __INT_LEAST32_FMTd__ if="@assisted && defined(__INT_LEAST32_FMTd__)"
error "Compiler-assisted __INT_LEAST32_FMTd__ is not defined" if="@assisted && !defined(__INT_LEAST32_FMTd__)"
macro INT_LEAST32_FMTi __INT_LEAST32_FMTi__ if="@assisted && defined(__INT_LEAST32_FMTi__)"
error "Compiler-assisted __INT_LEAST32_FMTi__ is not defined" if="@assisted && !defined(__INT_LEAST32_FMTi__)"
// __INT_LEAST32_TYPE__
// Use Data models specifications
typedef int_least32_t int if="!@assisted && @data_model"
macro INT_LEAST32_MAX INT_MAX if="!@assisted && @data_model"
macro INT_LEAST32_WIDTH INT_WIDTH if="!@assisted && @data_model"
macro INT_LEAST32_FMTd INT_FMTd if="!@assisted && @data_model"
macro INT_LEAST32_FMTi INT_FMTi if="!@assisted && @data_model"
error "Unknown data model (see https://en.cppreference.com/w/cpp/language/types.html#Data_models)" if="!@assisted && !@data_model"
