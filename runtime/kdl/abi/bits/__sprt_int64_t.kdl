cond assisted "CONFIG_COMPILER_ASSISTED_INTS && defined(__INT64_TYPE__)"
cond llp64_or_ilp32 "defined(__LLP64__) || defined(_WIN64) || defined(_WIN32) || defined(__ILP32__) || defined(__SPRT_WINDOWS)"
typedef int64_t __INT64_TYPE__ if="@assisted"
macro INT64_MAX __INT64_MAX__ if="@assisted && defined(__INT64_MAX__)"
error "Compiler-assisted __INT64_MAX__ is not defined" if="@assisted && !defined(__INT64_MAX__)"
macro INT64_WIDTH 64 if="@assisted"
macro INT64_FMTd __INT64_FMTd__ if="@assisted && defined(__INT64_FMTd__)"
error "Compiler-assisted __INT64_FMTd__ is not defined" if="@assisted && !defined(__INT64_FMTd__)"
macro INT64_FMTi __INT64_FMTi__ if="@assisted && defined(__INT64_FMTi__)"
error "Compiler-assisted __INT64_FMTi__ is not defined" if="@assisted && !defined(__INT64_FMTi__)"
macro INT64_C "__INT64_C(C)" params="C" if="@assisted && defined(__INT64_C)"
error "Compiler-assisted __INT64_FMTx__ is not defined" if="@assisted && !defined(__INT64_C)"
macro `__INT64_C_SUFFIX` __INT64_C_SUFFIX__ if="@assisted && defined(__INT64_C_SUFFIX__)"
error "Compiler-assisted __INT64_C_SUFFIX__ is not defined" if="@assisted && !defined(__INT64_C_SUFFIX__)"
// __INT64_TYPE__
// Use Data models specifications
typedef int64_t "long long int" if="!@assisted && @llp64_or_ilp32"
macro INT64_MAX LLINT_MAX if="!@assisted && @llp64_or_ilp32"
macro INT64_WIDTH LLINT_WIDTH if="!@assisted && @llp64_or_ilp32"
macro INT64_FMTd LLINT_FMTd if="!@assisted && @llp64_or_ilp32"
macro INT64_FMTi LLINT_FMTi if="!@assisted && @llp64_or_ilp32"
macro INT64_C "LLINT_C(C)" params="C" if="!@assisted && @llp64_or_ilp32"
macro INT64_C_SUFFIX LLINT_C_SUFFIX if="!@assisted && @llp64_or_ilp32"
typedef int64_t "long int" if="!@assisted && !@llp64_or_ilp32 && defined(__LP64__)"
macro INT64_MAX LINT_MAX if="!@assisted && !@llp64_or_ilp32 && defined(__LP64__)"
macro INT64_WIDTH LINT_WIDTH if="!@assisted && !@llp64_or_ilp32 && defined(__LP64__)"
macro INT64_FMTd LINT_FMTd if="!@assisted && !@llp64_or_ilp32 && defined(__LP64__)"
macro INT64_FMTi LINT_FMTi if="!@assisted && !@llp64_or_ilp32 && defined(__LP64__)"
macro INT64_C "LINT_C(C)" params="C" if="!@assisted && !@llp64_or_ilp32 && defined(__LP64__)"
macro INT64_C_SUFFIX LLINT_C_SUFFIX if="!@assisted && !@llp64_or_ilp32 && defined(__LP64__)"
error "Unknown data model (see https://en.cppreference.com/w/cpp/language/types.html#Data_models)" if="!@assisted && !@llp64_or_ilp32 && !defined(__LP64__)"
