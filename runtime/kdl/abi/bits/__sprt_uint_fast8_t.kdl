cond assisted "CONFIG_COMPILER_ASSISTED_INTS && defined(__UINT_FAST8_TYPE__)"
cond data_model "defined(__LLP64__) || defined(_WIN64) || defined(_WIN32) || defined(__ILP32__) || defined(__LP64__) || defined(__SPRT_WINDOWS)"
typedef uint_fast8_t __UINT_FAST8_TYPE__ if="@assisted"
macro UINT_FAST8_MAX __UINT_FAST8_MAX__ if="@assisted && defined(__UINT_FAST8_MAX__)"
error "Compiler-assisted __UINT_FAST8_MAX__ is not defined" if="@assisted && !defined(__UINT_FAST8_MAX__)"
macro UINT_FAST8_WIDTH 8 if="@assisted"
macro UINT_FAST8_FMTX __UINT_FAST8_FMTX__ if="@assisted && defined(__UINT_FAST8_FMTX__)"
error "Compiler-assisted __UINT_FAST8_FMTX__ is not defined" if="@assisted && !defined(__UINT_FAST8_FMTX__)"
macro UINT_FAST8_FMTo __UINT_FAST8_FMTo__ if="@assisted && defined(__UINT_FAST8_FMTo__)"
error "Compiler-assisted __UINT_FAST8_FMTo__ is not defined" if="@assisted && !defined(__UINT_FAST8_FMTo__)"
macro UINT_FAST8_FMTu __UINT_FAST8_FMTu__ if="@assisted && defined(__UINT_FAST8_FMTu__)"
error "Compiler-assisted __UINT_FAST8_FMTu__ is not defined" if="@assisted && !defined(__UINT_FAST8_FMTu__)"
macro UINT_FAST8_FMTx __UINT_FAST8_FMTx__ if="@assisted && defined(__UINT_FAST8_FMTx__)"
error "Compiler-assisted __UINT_FAST8_FMTx__ is not defined" if="@assisted && !defined(__UINT_FAST8_FMTx__)"
// __UINT_FAST8_TYPE__
// Use Data models specifications
typedef uint_fast8_t "unsigned char" if="!@assisted && @data_model"
macro UINT_FAST8_MAX USSHRT_MAX if="!@assisted && @data_model"
macro UINT_FAST8_WIDTH USSHRT_WIDTH if="!@assisted && @data_model"
macro UINT_FAST8_FMTX USSHRT_FMTX if="!@assisted && @data_model"
macro UINT_FAST8_FMTo USSHRT_FMTo if="!@assisted && @data_model"
macro UINT_FAST8_FMTu USSHRT_FMTu if="!@assisted && @data_model"
macro UINT_FAST8_FMTx USSHRT_FMTx if="!@assisted && @data_model"
error "Unknown data model (see https://en.cppreference.com/w/cpp/language/types.html#Data_models)" if="!@assisted && !@data_model"
