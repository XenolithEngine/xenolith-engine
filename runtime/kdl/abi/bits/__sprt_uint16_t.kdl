cond assisted "CONFIG_COMPILER_ASSISTED_INTS && defined(__UINT16_TYPE__)"
cond data_model "defined(__LLP64__) || defined(_WIN64) || defined(_WIN32) || defined(__ILP32__) || defined(__LP64__) || defined(__SPRT_WINDOWS)"
typedef uint16_t __UINT16_TYPE__ if="@assisted"
macro UINT16_MAX __UINT16_MAX__ if="@assisted && defined(__UINT16_MAX__)"
error "Compiler-assisted __UINT16_MAX__ is not defined" if="@assisted && !defined(__UINT16_MAX__)"
macro UINT16_WIDTH 16 if="@assisted"
macro UINT16_FMTX __UINT16_FMTX__ if="@assisted && defined(__UINT16_FMTX__)"
error "Compiler-assisted __UINT16_FMTX__ is not defined" if="@assisted && !defined(__UINT16_FMTX__)"
macro UINT16_FMTo __UINT16_FMTo__ if="@assisted && defined(__UINT16_FMTo__)"
error "Compiler-assisted __UINT16_FMTo__ is not defined" if="@assisted && !defined(__UINT16_FMTo__)"
macro UINT16_FMTu __UINT16_FMTu__ if="@assisted && defined(__UINT16_FMTu__)"
error "Compiler-assisted __UINT16_FMTu__ is not defined" if="@assisted && !defined(__UINT16_FMTu__)"
macro UINT16_FMTx __UINT16_FMTx__ if="@assisted && defined(__UINT16_FMTx__)"
error "Compiler-assisted __UINT16_FMTx__ is not defined" if="@assisted && !defined(__UINT16_FMTx__)"
macro UINT16_C "__UINT16_C(C)" params="C" if="@assisted && defined(__UINT16_C)"
error "Compiler-assisted __UINT16_C is not defined" if="@assisted && !defined(__UINT16_C)"
macro `__UINT16_C_SUFFIX` __UINT16_C_SUFFIX__ if="@assisted && defined(__UINT16_C_SUFFIX__)"
error "Compiler-assisted __UINT16_C_SUFFIX__ is not defined" if="@assisted && !defined(__UINT16_C_SUFFIX__)"
// __UINT16_TYPE__
// Use Data models specifications
typedef uint16_t "unsigned short int" if="!@assisted && @data_model"
macro UINT16_MAX USHRT_MAX if="!@assisted && @data_model"
macro UINT16_WIDTH USHRT_WIDTH if="!@assisted && @data_model"
macro UINT16_FMTX USHRT_FMTX if="!@assisted && @data_model"
macro UINT16_FMTo USHRT_FMTo if="!@assisted && @data_model"
macro UINT16_FMTu USHRT_FMTu if="!@assisted && @data_model"
macro UINT16_FMTx USHRT_FMTx if="!@assisted && @data_model"
macro UINT16_C "USHRT_C(C)" params="C" if="!@assisted && @data_model"
macro UINT16_C_SUFFIX USHRT_C_SUFFIX if="!@assisted && @data_model"
error "Unknown data model (see https://en.cppreference.com/w/cpp/language/types.html#Data_models)" if="!@assisted && !@data_model"
