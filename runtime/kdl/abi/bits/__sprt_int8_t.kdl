cond assisted "CONFIG_COMPILER_ASSISTED_INTS && defined(__INT8_TYPE__)"
cond data_model "defined(__LLP64__) || defined(_WIN64) || defined(_WIN32) || defined(__ILP32__) || defined(__LP64__) || defined(__SPRT_WINDOWS)"
typedef int8_t __INT8_TYPE__ if="@assisted"
macro INT8_MAX __INT8_MAX__ if="@assisted && defined(__INT8_MAX__)"
error "Compiler-assisted __INT8_MAX__ is not defined" if="@assisted && !defined(__INT8_MAX__)"
macro INT8_WIDTH 8 if="@assisted"
macro INT8_FMTd __INT8_FMTd__ if="@assisted && defined(__INT8_FMTd__)"
error "Compiler-assisted __INT8_FMTd__ is not defined" if="@assisted && !defined(__INT8_FMTd__)"
macro INT8_FMTi __INT8_FMTi__ if="@assisted && defined(__INT8_FMTi__)"
error "Compiler-assisted __INT8_FMTi__ is not defined" if="@assisted && !defined(__INT8_FMTi__)"
macro INT8_C "__INT8_C(C)" params="C" if="@assisted && defined(__INT8_C)"
error "Compiler-assisted __INT8_FMTx__ is not defined" if="@assisted && !defined(__INT8_C)"
macro `__INT8_C_SUFFIX` __INT8_C_SUFFIX__ if="@assisted && defined(__INT8_C_SUFFIX__)"
error "Compiler-assisted __INT8_C_SUFFIX__ is not defined" if="@assisted && !defined(__INT8_C_SUFFIX__)"
// __INT8_TYPE__
// Use Data models specifications
typedef int8_t "signed char" if="!@assisted && @data_model"
macro INT8_MAX SSHRT_MAX if="!@assisted && @data_model"
macro INT8_WIDTH SSHRT_WIDTH if="!@assisted && @data_model"
macro INT8_FMTd SSHRT_FMTd if="!@assisted && @data_model"
macro INT8_FMTi SSHRT_FMTi if="!@assisted && @data_model"
macro INT8_C "SSHRT_C(C)" params="C" if="!@assisted && @data_model"
macro INT8_C_SUFFIX SSHRT_C_SUFFIX if="!@assisted && @data_model"
error "Unknown data model (see https://en.cppreference.com/w/cpp/language/types.html#Data_models)" if="!@assisted && !@data_model"
