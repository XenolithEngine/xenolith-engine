cond assisted "CONFIG_COMPILER_ASSISTED_INTS && defined(__INT16_TYPE__)"
cond data_model "defined(__LLP64__) || defined(_WIN64) || defined(_WIN32) || defined(__ILP32__) || defined(__LP64__) || defined(__SPRT_WINDOWS)"
typedef int16_t __INT16_TYPE__ if="@assisted"
macro INT16_MAX __INT16_MAX__ if="@assisted && defined(__INT16_MAX__)"
error "Compiler-assisted __INT16_MAX__ is not defined" if="@assisted && !defined(__INT16_MAX__)"
macro INT16_WIDTH 16 if="@assisted"
macro INT16_FMTd __INT16_FMTd__ if="@assisted && defined(__INT16_FMTd__)"
error "Compiler-assisted __INT16_FMTd__ is not defined" if="@assisted && !defined(__INT16_FMTd__)"
macro INT16_FMTi __INT16_FMTi__ if="@assisted && defined(__INT16_FMTi__)"
error "Compiler-assisted __INT16_FMTi__ is not defined" if="@assisted && !defined(__INT16_FMTi__)"
macro INT16_C "__INT16_C(C)" params="C" if="@assisted && defined(__INT16_C)"
error "Compiler-assisted __INT16_FMTx__ is not defined" if="@assisted && !defined(__INT16_C)"
macro `__INT16_C_SUFFIX` __INT16_C_SUFFIX__ if="@assisted && defined(__INT16_C_SUFFIX__)"
error "Compiler-assisted __INT16_C_SUFFIX__ is not defined" if="@assisted && !defined(__INT16_C_SUFFIX__)"
// __INT16_TYPE__
// Use Data models specifications
typedef int16_t short if="!@assisted && @data_model"
macro INT16_MAX SHRT_MAX if="!@assisted && @data_model"
macro INT16_WIDTH SHRT_WIDTH if="!@assisted && @data_model"
macro INT16_FMTd SHRT_FMTd if="!@assisted && @data_model"
macro INT16_FMTi SHRT_FMTi if="!@assisted && @data_model"
macro INT16_C "SHRT_C(C)" params="C" if="!@assisted && @data_model"
macro INT16_C_SUFFIX SHRT_C_SUFFIX if="!@assisted && @data_model"
error "Unknown data model (see https://en.cppreference.com/w/cpp/language/types.html#Data_models)" if="!@assisted && !@data_model"
