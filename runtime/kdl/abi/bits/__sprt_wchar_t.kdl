cond assisted "CONFIG_COMPILER_ASSISTED_INTS && defined(__WCHAR_TYPE__)"
cond cplusplus "!defined(__cplusplus)"
typedef wchar_t __WCHAR_TYPE__ if="@assisted && @cplusplus"
typedef wchar_t `wchar_t` if="@assisted && defined(__cplusplus)"
macro WCHAR_MAX __WCHAR_MAX__ if="@assisted && defined(__WCHAR_MAX__)"
error "Compiler-assisted __WCHAR_MAX__ is not defined" if="@assisted && !defined(__WCHAR_MAX__)"
macro WCHAR_WIDTH __WCHAR_WIDTH__ if="@assisted && defined(__WCHAR_WIDTH__)"
error "Compiler-assisted __WCHAR_WIDTH__ is not defined" if="@assisted && !defined(__WCHAR_WIDTH__)"
macro WCHAR_MIN "(0+L'\\0')" if="@assisted && L'\\0' - 1 > 0"
macro WCHAR_MIN "(-1-WCHAR_MAX+L'\\0')" if="@assisted && !(L'\\0' - 1 > 0)"
typedef wchar_t "unsigned short" if="!@assisted && SPRT_WINDOWS && @cplusplus"
typedef wchar_t `wchar_t` if="!@assisted && SPRT_WINDOWS && defined(__cplusplus)"
macro WCHAR_MAX "(0xffff)" if="!@assisted && SPRT_WINDOWS"
macro WCHAR_MIN "(0)" if="!@assisted && SPRT_WINDOWS"
macro WCHAR_WIDTH 16 if="!@assisted && SPRT_WINDOWS"
typedef wchar_t int if="!@assisted && !(SPRT_WINDOWS) && @cplusplus"
typedef wchar_t `wchar_t` if="!@assisted && !(SPRT_WINDOWS) && defined(__cplusplus)"
macro WCHAR_MAX "0x7fff'ffff" if="!@assisted && !(SPRT_WINDOWS)"
macro WCHAR_MIN "(-1-0x7fff'ffff)" if="!@assisted && !(SPRT_WINDOWS)"
macro WCHAR_WIDTH 32 if="!@assisted && !(SPRT_WINDOWS)"
