macro UINT64_WIDTH 64 if="@assisted"
macro UINT64_FMTX __UINT64_FMTX__ if="@assisted && defined(__UINT64_FMTX__)"
error "Compiler-assisted __UINT64_FMTX__ is not defined" if="@assisted && !defined(__UINT64_FMTX__)"
