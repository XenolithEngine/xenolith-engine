// __UINT64_TYPE__
// Use Data models specifications
typedef uint64_t "unsigned long long int" if="!@assisted && @llp64_or_ilp32"
macro UINT64_MAX ULLINT_MAX if="!@assisted && @llp64_or_ilp32"
macro UINT64_WIDTH ULLINT_WIDTH if="!@assisted && @llp64_or_ilp32"
macro UINT64_FMTX ULLINT_FMTX if="!@assisted && @llp64_or_ilp32"
macro UINT64_FMTo ULLINT_FMTo if="!@assisted && @llp64_or_ilp32"
macro UINT64_FMTu ULLINT_FMTu if="!@assisted && @llp64_or_ilp32"
macro UINT64_FMTx ULLINT_FMTx if="!@assisted && @llp64_or_ilp32"
macro UINT64_C "ULLINT_C(C)" params="C" if="!@assisted && @llp64_or_ilp32"
macro UINT64_C_SUFFIX ULLINT_C_SUFFIX if="!@assisted && @llp64_or_ilp32"
typedef uint64_t "unsigned long int" if="!@assisted && !@llp64_or_ilp32 && defined(__LP64__)"
