macro UINT64_FMTu ULINT_FMTu if="!@assisted && !@llp64_or_ilp32 && defined(__LP64__)"
macro UINT64_FMTx ULINT_FMTx if="!@assisted && !@llp64_or_ilp32 && defined(__LP64__)"
macro UINT64_C "ULINT_C(C)" params="C" if="!@assisted && !@llp64_or_ilp32 && defined(__LP64__)"
macro UINT64_C_SUFFIX ULLINT_C_SUFFIX if="!@assisted && !@llp64_or_ilp32 && defined(__LP64__)"
