cond assisted "CONFIG_COMPILER_ASSISTED_INTS && defined(__UINT64_TYPE__)"
cond llp64_or_ilp32 "defined(__LLP64__) || defined(_WIN64) || defined(_WIN32) || defined(__ILP32__) || defined(__SPRT_WINDOWS)"
typedef uint64_t __UINT64_TYPE__ if="@assisted"
macro UINT64_MAX __UINT64_MAX__ if="@assisted && defined(__UINT64_MAX__)"
