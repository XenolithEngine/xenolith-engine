cond assisted "CONFIG_COMPILER_ASSISTED_INTS && defined(__UINT8_TYPE__)"
cond data_model "defined(__LLP64__) || defined(_WIN64) || defined(_WIN32) || defined(__ILP32__) || defined(__LP64__) || defined(__SPRT_WINDOWS)"
typedef uint8_t __UINT8_TYPE__ if="@assisted"
macro UINT8_MAX __UINT8_MAX__ if="@assisted && defined(__UINT8_MAX__)"
error "Compiler-assisted __UINT8_MAX__ is not defined" if="@assisted && !defined(__UINT8_MAX__)"
macro UINT8_WIDTH 8 if="@assisted"
macro UINT8_FMTX __UINT8_FMTX__ if="@assisted && defined(__UINT8_FMTX__)"
error "Compiler-assisted __UINT8_FMTX__ is not defined" if="@assisted && !defined(__UINT8_FMTX__)"
macro UINT8_FMTo __UINT8_FMTo__ if="@assisted && defined(__UINT8_FMTo__)"
error "Compiler-assisted __UINT8_FMTo__ is not defined" if="@assisted && !defined(__UINT8_FMTo__)"
macro UINT8_FMTu __UINT8_FMTu__ if="@assisted && defined(__UINT8_FMTu__)"
error "Compiler-assisted __UINT8_FMTu__ is not defined" if="@assisted && !defined(__UINT8_FMTu__)"
macro UINT8_FMTx __UINT8_FMTx__ if="@assisted && defined(__UINT8_FMTx__)"
error "Compiler-assisted __UINT8_FMTx__ is not defined" if="@assisted && !defined(__UINT8_FMTx__)"
macro UINT8_C "__UINT8_C(C)" params="C" if="@assisted && defined(__UINT8_C)"
error "Compiler-assisted __UINT8_C is not defined" if="@assisted && !defined(__UINT8_C)"
macro `__UINT8_C_SUFFIX` __UINT8_C_SUFFIX__ if="@assisted && defined(__UINT8_C_SUFFIX__)"
error "Compiler-assisted __UINT8_C_SUFFIX__ is not defined" if="@assisted && !defined(__UINT8_C_SUFFIX__)"
// __UINT8_TYPE__
// Use Data models specifications
typedef uint8_t "unsigned char" if="!@assisted && @data_model"
macro UINT8_MAX USSHRT_MAX if="!@assisted && @data_model"
macro UINT8_WIDTH USSHRT_WIDTH if="!@assisted && @data_model"
macro UINT8_FMTX USSHRT_FMTX if="!@assisted && @data_model"
macro UINT8_FMTo USSHRT_FMTo if="!@assisted && @data_model"
macro UINT8_FMTu USSHRT_FMTu if="!@assisted && @data_model"
macro UINT8_FMTx USSHRT_FMTx if="!@assisted && @data_model"
macro UINT8_C "USSHRT_C(C)" params="C" if="!@assisted && @data_model"
macro UINT8_C_SUFFIX USSHRT_C_SUFFIX if="!@assisted && @data_model"
error "Unknown data model (see https://en.cppreference.com/w/cpp/language/types.html#Data_models)" if="!@assisted && !@data_model"
