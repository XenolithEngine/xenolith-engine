// The platforms and the architectures the runtime knows, in the order they are tested. A target's
// number is part of the ABI and of the remote protocol (OsArch): it never changes and is never
// reused. Its name, with `_sprt`, is the directory of its fragments under sprt/gen/c/cross.
//
// The platform defines one of SPRT_MACOS, SPRT_IOS, SPRT_DARWIN_UNKNOWN, SPRT_WINDOWS,
// SPRT_ANDROID, SPRT_LINUX, SPRT_WASM, SPRT_NUTTX, SPRT_EMBOX, SPRT_EMBOX_USER, SPRT_TAU, and SPRT_APPLE
// on any Apple/Darwin platform - use it for libSystem/XNU behavior shared across the whole family, and
// SPRT_MACOS / SPRT_IOS only for genuinely OS-specific code. __SPRT_WINDOWS and __SPRT_WASM, defined
// from outside, force the platform for specific cross-compilation targets.
targets PLATFORM flag=SPRT_ suffix=_sprt error="Unknown platform" {
    // clang predefines every TARGET_OS_* macro for Apple targets (even without
    // <TargetConditionals.h> in scope). TARGET_OS_MAC is 1 on EVERY Apple OS - it means "is a
    // Darwin/Apple platform", not "is macOS" - so iOS/tvOS/watchOS (TARGET_OS_IPHONE) MUST be tested
    // before the desktop macOS (TARGET_OS_OSX) branch, otherwise an iOS target is misdetected as
    // macOS.
    group APPLE if="defined(__APPLE__)" {
        target ios 2 if=TARGET_OS_IPHONE {
            macro `SPRT_HAVE_DEDICATED_SIZE_T` 1
        }
        target macos 1 if="TARGET_OS_OSX || TARGET_OS_MAC" {
            macro `SPRT_HAVE_DEDICATED_SIZE_T` 1
        }
        target darwin_unknown 3 dir=darwin_sprt
    }
    target windows 4 if="defined(_WIN32) || defined(_WIN64) || defined(__SPRT_WINDOWS)"
    target android 5 if="defined(__ANDROID__)"
    // Tau capability microkernel. One platform for both sides: the kernel uses the freestanding
    // header subset only, EL0 modules link the runtime as their libc. LLVM knows no such OS; the
    // target-tau toolchain defines __TAU__.
    target tau 11 if="defined(__TAU__)"
    // Embox in user mode: the application is a real EL0 process on its own freestanding libc
    // (runtime/libc_impl), reaching the kernel only through the syscall boundary. Deliberately a
    // SEPARATE platform from EMBOX rather than a flag on it - the two share a kernel but not a libc,
    // not a set of types, and not an address space, so nothing that is true of one is automatically
    // true of the other. See xenolith-os docs/EMBOX-USERSPACE.md. Driven by the target-embox
    // toolchain's `+user` variant, which defines __EMBOX_USER__ and NOT __EMBOX__: none of the Embox
    // libc headers are on the include path for this target, so every branch keyed on SPRT_EMBOX
    // (which assumes them) must stay off. Tested before __EMBOX__ anyway, so that a build that
    // defines both still resolves to the more specific one.
    target embox_user 10 if="defined(__EMBOX_USER__)"
    // Embox RTOS. LLVM has no "embox" OSType, so the toolchain drives -D__EMBOX__ explicitly from
    // target-embox. Tested before __linux__ because Embox may leak linux-ish macros. Platform layer:
    // runtime/core/embox/.
    target embox 9 if="defined(__EMBOX__)"
    // NuttX RTOS. LLVM has no "nuttx" OSType, so the toolchain drives -D__NuttX__ explicitly from
    // target-nuttx (TARGET_GENERAL_CFLAGS in the generated target.mk). NuttX does NOT predefine
    // __linux__; the order here keeps the detection explicit regardless. The platform layer lives in
    // runtime/core/nuttx/ and libc_wrapper forwards to the NuttX libc the way Linux does to glibc.
    target nuttx 8 if="defined(__NuttX__)"
    target linux 6 if="defined(__linux__)"
    // Freestanding WebAssembly (browser / wasi host). No host OS defines a platform macro here, so
    // wasm is detected purely from the compiler's __wasm__ predefine (or an explicit __SPRT_WASM
    // override). The platform layer lives in src/wasm/ and runtime/core/wasm/; errno/fcntl/etc.
    // reuse the Linux numeric values (see cross/wasm_sprt).
    target wasm 7 if="defined(__wasm__) || defined(__SPRT_WASM)"
}

// "Hosted on an RTOS": there is a platform libc to forward to, and it is neither glibc nor Darwin's
// (flat hosted POSIX, no epoll/futex/fork). SPRT_EMBOX_USER is deliberately absent - it has no
// platform libc at all, so it takes the freestanding paths, not these.
macro `SPRT_HOSTED_RTOS` 1 if="SPRT_NUTTX || SPRT_EMBOX"

// Either Embox mode. Use it only for what is true of the Embox KERNEL regardless of where the code
// runs (device names, /dev/fb0 geometry, board quirks); anything about Embox's libc, its types, or
// its flat address space is SPRT_EMBOX alone.
macro `SPRT_EMBOX_ANY` 1 if="SPRT_EMBOX || SPRT_EMBOX_USER"
// The EL0 side of Tau, a module linking the runtime as its libc (make/os/tau-user.mk).
macro `SPRT_TAU_USER` 1 if="SPRT_TAU && defined(__TAU_USER__)"
// The runtime is the libc of an EL0 process with no platform libc under it: EmboxUser and Tau
// share the parts of their platform layers that make no system call.
macro `SPRT_EL0_LIBC` 1 if="SPRT_EMBOX_USER || SPRT_TAU"

targets ARCH suffix=_sprt error="Unknown arch" {
    target aarch64 1 also=arm64 if="defined(__aarch64__) || defined(_M_ARM64)"
    target arm 2 if="defined(__arm__) || defined(_M_ARM)"
    target x86_64 4 also=amd64 if="defined(__x86_64__) || defined(_M_X64)"
    target x86 3 if="defined(i386) || defined(__i386__) || defined(_M_IX86)"
    target wasm64 6 if="defined(__wasm64__)"
    target wasm32 7 if="defined(__wasm32__)"
    target riscv64 8 if="defined(__riscv) && defined(__riscv_xlen) && __riscv_xlen == 64"
    target riscv32 9 if="defined(__riscv) && defined(__riscv_xlen) && __riscv_xlen == 32"
    target loongarch64 10 if="defined(__loongarch__) && defined(__loongarch_grlen) && __loongarch_grlen == 64"
    target loongarch32 11 if="defined(__loongarch__) && defined(__loongarch_grlen) && __loongarch_grlen == 32"
    // MCST lcc: __e2k__ is defined in every mode; the pointer size tells e2k32 (ILP32), e2k64
    // (-m64) and e2k128 (-m128, an ELF64 container) apart.
    target e2k128 13 if="defined(__e2k__) && defined(__SIZEOF_POINTER__) && __SIZEOF_POINTER__ == 16"
    target e2k 5 if="defined(__e2k__) && defined(__SIZEOF_POINTER__) && __SIZEOF_POINTER__ == 8"
    target e2k32 12 if="defined(__e2k__) && defined(__SIZEOF_POINTER__) && __SIZEOF_POINTER__ == 4"
}
