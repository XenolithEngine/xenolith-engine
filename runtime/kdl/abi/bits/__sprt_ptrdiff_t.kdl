cond assisted "CONFIG_COMPILER_ASSISTED_INTS && defined(__PTRDIFF_TYPE__)"
cond llp64 "defined(__LLP64__) || defined(_WIN64)"
cond ilp32 "defined(_WIN32) || defined(__ILP32__) || defined(__SPRT_WINDOWS)"
typedef ptrdiff_t __PTRDIFF_TYPE__ if="@assisted"
macro PTRDIFF_MAX __PTRDIFF_MAX__ if="@assisted && defined(__PTRDIFF_MAX__)"
error "Compiler-assisted __PTRDIFF_MAX__ is not defined" if="@assisted && !defined(__PTRDIFF_MAX__)"
macro PTRDIFF_WIDTH __PTRDIFF_WIDTH__ if="@assisted && defined(__PTRDIFF_WIDTH__)"
error "Compiler-assisted __PTRDIFF_WIDTH__ is not defined" if="@assisted && !defined(__PTRDIFF_WIDTH__)"
macro PTRDIFF_FMTd __PTRDIFF_FMTd__ if="@assisted && defined(__PTRDIFF_FMTd__)"
error "Compiler-assisted __PTRDIFF_FMTd__ is not defined" if="@assisted && !defined(__PTRDIFF_FMTd__)"
macro PTRDIFF_FMTi __PTRDIFF_FMTi__ if="@assisted && defined(__PTRDIFF_FMTi__)"
error "Compiler-assisted __PTRDIFF_FMTi__ is not defined" if="@assisted && !defined(__PTRDIFF_FMTi__)"
typedef ptrdiff_t "long long int" if="!@assisted && @llp64"
macro PTRDIFF_MAX LLINT_MAX if="!@assisted && @llp64"
macro PTRDIFF_WIDTH LLINT_WIDTH if="!@assisted && @llp64"
macro PTRDIFF_FMTd __SPRT_ULLINT_FMTd if="!@assisted && @llp64"
macro PTRDIFF_FMTi __SPRT_ULLINT_FMTi if="!@assisted && @llp64"
typedef ptrdiff_t int if="!@assisted && !@llp64 && @ilp32"
macro PTRDIFF_MAX INT_MAX if="!@assisted && !@llp64 && @ilp32"
macro PTRDIFF_WIDTH INT_WIDTH if="!@assisted && !@llp64 && @ilp32"
macro PTRDIFF_FMTd INT_FMTd if="!@assisted && !@llp64 && @ilp32"
macro PTRDIFF_FMTi INT_FMTi if="!@assisted && !@llp64 && @ilp32"
typedef ptrdiff_t "long int" if="!@assisted && !@llp64 && !@ilp32 && defined(__LP64__)"
macro PTRDIFF_MAX LINT_MAX if="!@assisted && !@llp64 && !@ilp32 && defined(__LP64__)"
macro PTRDIFF_WIDTH LINT_WIDTH if="!@assisted && !@llp64 && !@ilp32 && defined(__LP64__)"
macro PTRDIFF_FMTd __SPRT_ULINT_FMTd if="!@assisted && !@llp64 && !@ilp32 && defined(__LP64__)"
macro PTRDIFF_FMTi __SPRT_ULINT_FMTi if="!@assisted && !@llp64 && !@ilp32 && defined(__LP64__)"
error "Unknown data model (see https://en.cppreference.com/w/cpp/language/types.html#Data_models)" if="!@assisted && !@llp64 && !@ilp32 && !defined(__LP64__)"
macro PTRDIFF_MIN "(-1-PTRDIFF_MAX)"
