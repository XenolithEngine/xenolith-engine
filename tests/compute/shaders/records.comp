#version 450

// One record per invocation; the bound buffer is the whole batch, so its length is the count.
layout (local_size_x = 256) in;

layout (set = 0, binding = 0) buffer Records {
	vec4 records[];
};

void main() {
	uint i = gl_GlobalInvocationID.x;
	if (i >= uint(records.length())) {
		return;
	}
	records[i] = records[i] * vec4(2.0, 3.0, -1.0, 0.5) + vec4(1.0, 0.0, 7.0, 0.0);
}
