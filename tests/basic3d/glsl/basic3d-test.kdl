// A material, a view's block and a vertex for basic3dtest's checks of what xlkdl gpu makes of them
// (checks/material.cpp, checks/vertex.cpp): both kinds of texture, every packed type, fields of
// bits, an array and padding at the end. After a change:
//
//     xlkdl gpu tests/basic3d/glsl/basic3d-test.kdl

import "../../../xenolith/renderer/basic3d/glsl/basic3d.kdl"

schema basic3d_test {
	output "Basic3dTestData.h"
	guard "TESTS_BASIC3D_GLSL_BASIC3DTESTDATA_H_"
	namespace "stappler::xenolith::basic3d::checks"
	copyright "2026 Xenolith Team <admin@xenolith.studio>"
	license "MIT"
}

material Terrain3dTest doc="A terrain's material, as an app would have one" {
	tint vec4
	ground texture-array doc="the surface types, a layer each"
	detail texture2d
	scale vec2
	params vec4 count=2
	flags uint
}

vertex Packed3dTest position=pos doc="A vertex with every packed type" {
	pos vec3
	normal oct16
	uv half2
	color unorm8x4
	layer float
	marks uint bits=4 count=2 doc="two 4-bit marks"
}

block Field3dTest doc="A view's block, as an app would have one" {
	origin vec2
	heights texture2d doc="a height map"
	time float
	tiles uint bits=3 count=8 doc="eight 3-bit values, as a terrain's types' tiling"
}
