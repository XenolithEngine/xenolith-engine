#version 450
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

// clang-format off

#include "sprt_glsl.h"
#include "XL2dGlslParticle.h"
#include "XL2dGlslVertexData.h"

layout (constant_id = 0) const int BUFFERS_ARRAY_SIZE = 1024;
layout (constant_id = 1) const int ENABLE_FEEDBACK = 0;

layout(buffer_reference) readonly buffer EmitterBuffer;
layout(buffer_reference) readonly buffer EmissionPointsBuffer;
layout(buffer_reference) readonly buffer ExtraUintBuffer;
layout(buffer_reference) readonly buffer ExtraFloatBuffer;
layout(buffer_reference) readonly buffer FrameDataBuffer;
layout(buffer_reference) buffer VerticesBuffer;
layout(buffer_reference) buffer FeedbackBuffer;

layout (push_constant) uniform PCB {
	ParticleConstantData pcb;
};

layout(std430, buffer_reference, buffer_reference_align = 8) readonly buffer EmitterBuffer {
	ParticleEmitterData data;
};

layout(std430, buffer_reference, buffer_reference_align = 8) readonly buffer EmissionPointsBuffer {
	ParticleEmissionPoints data;
	vec2 points[];
};

// The same extra data buffer, word by word
layout(std430, buffer_reference, buffer_reference_align = 4) readonly buffer ExtraUintBuffer {
	uint values[];
};

layout(std430, buffer_reference, buffer_reference_align = 4) readonly buffer ExtraFloatBuffer {
	float values[];
};

layout(std430, buffer_reference, buffer_reference_align = 8) readonly buffer FrameDataBuffer {
	ParticleFrameData frames[];
};

layout(std430, buffer_reference, buffer_reference_align = 8) buffer VerticesBuffer {
	Vertex vertices[];
};

layout(std430, buffer_reference, buffer_reference_align = 4) buffer FeedbackBuffer {
	ParticleFeedbackRecord records[];
};

layout (set = 0, binding = 0) buffer ParticlesBuffer {
	ParticleData particles[];
} particleBuffers[BUFFERS_ARRAY_SIZE];

layout(local_size_x = 64) in;

ParticleEmitterData emitter;

uint particleEmissionPointCount() {
	return EmissionPointsBuffer(emitter.emissionData).data.count;
}

vec2 particleEmissionPoint(uint index) {
	return EmissionPointsBuffer(emitter.emissionData).points[index];
}

uint particleExtraUint(uint word) {
	return ExtraUintBuffer(emitter.emissionData).values[word];
}

float particleExtraFloat(uint word) {
	return ExtraFloatBuffer(emitter.emissionData).values[word];
}

#include "XL2dGlslParticleSim.h"

void writeVertex(VerticesBuffer target, uint index, vec2 pos, vec2 tex, vec4 color, uint material) {
	target.vertices[index].pos = vec4(pos, 0.0, 1.0);
	target.vertices[index].color = color;
	target.vertices[index].tex = tex;
	target.vertices[index].material = material;
	target.vertices[index].object = 0;
}

void writeDegenerate(VerticesBuffer target, uint at, uint seats, uint material) {
	for (uint i = 0u; i < seats; ++i) {
		writeVertex(target, at + i, vec2(0.0, 0.0), vec2(0.0, 0.0), vec4(0.0, 0.0, 0.0, 0.0), material);
	}
}

// The strip's own draw, Effekseer's ribbon taken in the screen plane: the emitter's particles
// joined in their birth order, each particle owning the segment to the next born in the one
// vertex list the pass always filled. The order is the cyclic slot walk broken at the frame's
// newest word - within a cycle the births run by index and the wrap between the last slot and
// the first is the seam of the two adjacent cycles, so the walk newest+1, ..., count-1, 0,
// ..., newest is the birth order, and the break between the youngest and the oldest leaves
// the strip open where a closed walk would fold it into a loop. The walk's word is the
// nominal newest the ordered draw rotates by, the same word the pass computes for the seats;
// randomness shifts a birth by less than one slot and the walk takes the slot order for the
// tie. A dead end cuts its segment: the seats a segment never fills draw the same degenerate
// quad a dead particle draws, and the strip runs on through the alive seats beyond it
void stripDraw(uint index, ParticleFrameData frame) {
	VerticesBuffer vertexBuffer = VerticesBuffer(pcb.outVerticesPointer);

	uint slot = index;
	if ((emitter.flags & XL_PARTICLE_FLAG_ORDER_BY_LIFETIME) != 0u) {
		slot = (index + emitter.count - frame.newest - 1u) % emitter.count;
	}
	const uint seats = particleVertexSeats(emitter);
	const uint vertexOffset = frame.vertexOffset + slot * seats;

	ParticleData particle = particleBuffers[frame.particleBufferIndex].particles[index];
	const uint next = (index + 1u == emitter.count) ? 0u : index + 1u;
	if (index == frame.newest || particle.currentLifetime == 0u) {
		writeDegenerate(vertexBuffer, vertexOffset, seats, frame.materialIndex);
		return;
	}
	ParticleData nextParticle = particleBuffers[frame.particleBufferIndex].particles[next];
	if (nextParticle.currentLifetime == 0u) {
		writeDegenerate(vertexBuffer, vertexOffset, seats, frame.materialIndex);
		return;
	}

	vec2 bl;
	vec2 tl;
	vec2 tr;
	vec2 br;
	particleStripSegment(particle, nextParticle, emitter, bl, tl, tr, br);

	// Each end carries its own tint, the color curve's journey reading along the strip, while
	// the window is the owner's own: u along the segment, v across the band, the quad's own
	// corner order and the quad's own scroll, flip and animation frame
	vec4 tintA = particleColor(particle, emitter);
	vec4 tintB = particleColor(nextParticle, emitter);
	const vec4 colorA = tintA * frame.nodeColor;
	const vec4 colorB = tintB * frame.nodeColor;

	vec2 uv0;
	vec2 uv1;
	particleFrameCell(frame, particleAnimFrame(particle, emitter, frame.hFrames * frame.vFrames), uv0, uv1);
	if (emitter.uvScroll.x != 0.0f || emitter.uvScroll.y != 0.0f) {
		vec2 shift = emitter.uvScroll * particleSimTime(frame);
		uv0 += shift;
		uv1 += shift;
	}
	if ((particle.drawFlags & XL_PARTICLE_DRAW_FLAG_FLIP_U) != 0u) {
		float u = uv0.x;
		uv0.x = uv1.x;
		uv1.x = u;
	}

	writeVertex(vertexBuffer, vertexOffset + 0u, bl, vec2(uv0.x, uv1.y), colorA, frame.materialIndex);
	writeVertex(vertexBuffer, vertexOffset + 1u, tl, vec2(uv0.x, uv0.y), colorA, frame.materialIndex);
	writeVertex(vertexBuffer, vertexOffset + 2u, br, vec2(uv1.x, uv1.y), colorB, frame.materialIndex);
	writeVertex(vertexBuffer, vertexOffset + 3u, tr, vec2(uv1.x, uv0.y), colorB, frame.materialIndex);
	writeVertex(vertexBuffer, vertexOffset + 4u, br, vec2(uv1.x, uv1.y), colorB, frame.materialIndex);
	writeVertex(vertexBuffer, vertexOffset + 5u, tl, vec2(uv0.x, uv0.y), colorA, frame.materialIndex);
}

void main() {
	const ParticleFrameData frame = FrameDataBuffer(pcb.frameDataPointer).frames[pcb.emitterIndex];
	emitter = EmitterBuffer(frame.emitterPointer).data;

	const uint index = gl_GlobalInvocationID.x;
	if (index >= emitter.count) {
		return;
	}

	// The strip's own dispatch: no update, no write-back, no feedback - the barrier the pass
	// seated between the two dispatches hands every particle its standing state, and the
	// segment a particle owns reads the next particle, which one dispatch's own invocations
	// cannot order for one another. The update dispatch drew the quad into these seats; this
	// pass overwrites every seat of the emitter, segment or degenerate, one writer whole
	if (pcb.stripPass != 0u) {
		stripDraw(index, frame);
		return;
	}

	ParticleData particle = particleBuffers[frame.particleBufferIndex].particles[index];

	ParticleUpdateCounters counters = ParticleUpdateCounters(0u, 0u);
	if (frame.nframes > 0u) {
		particleUpdate(particle, emitter, frame, index, counters);
		particleBuffers[frame.particleBufferIndex].particles[index] = particle;
	}

	// Only emitters that report back have records
	if (ENABLE_FEEDBACK != 0 && (frame.feedbackPointer.x != 0u || frame.feedbackPointer.y != 0u)) {
		FeedbackBuffer feedback = FeedbackBuffer(frame.feedbackPointer);
		feedback.records[index] = ParticleFeedbackRecord(counters.births, counters.steps,
				particle.currentLifetime > 0u ? 1u : 0u, 0u);
	}

	// Every particle owns its emitter's vertex seats - the quad's six or the ring's own count -
	// and a dead one writes them degenerate. Ordered by lifetime, the slots rotate so the newest
	// particle is drawn last.
	uint slot = index;
	if ((emitter.flags & XL_PARTICLE_FLAG_ORDER_BY_LIFETIME) != 0u) {
		slot = (index + emitter.count - frame.newest - 1u) % emitter.count;
	}

	VerticesBuffer vertexBuffer = VerticesBuffer(pcb.outVerticesPointer);
	const uint seats = particleVertexSeats(emitter);
	const uint vertexOffset = frame.vertexOffset + slot * seats;

	if (particle.currentLifetime == 0u) {
		writeDegenerate(vertexBuffer, vertexOffset, seats, frame.materialIndex);
		return;
	}

	vec2 bl;
	vec2 tl;
	vec2 tr;
	vec2 br;
	particleQuad(particle, emitter, bl, tl, tr, br);

	vec4 particleTint = particleColor(particle, emitter);
	const vec4 color = vec4(particleTint.x * frame.nodeColor.x, particleTint.y * frame.nodeColor.y,
			particleTint.z * frame.nodeColor.z, particleTint.w * frame.nodeColor.w);

	vec2 uv0;
	vec2 uv1;
	particleFrameCell(frame, particleAnimFrame(particle, emitter, frame.hFrames * frame.vFrames), uv0, uv1);

	// Effekseer's scroll - the rendererCommon page words it "Move the UV range at a constant
	// speed." (effekseer.github.io, Help_Tool, rendererCommon) - slides the sampled window over
	// the texture: the emitter's speed in UV per second times the simulation time the frame
	// stands at, particleSimTime above, never a wall clock. The pair's zero guards the add: a
	// scroll-less emitter writes the window the cell built, byte for byte
	if (emitter.uvScroll.x != 0.0f || emitter.uvScroll.y != 0.0f) {
		vec2 shift = emitter.uvScroll * particleSimTime(frame);
		uv0 += shift;
		uv1 += shift;
	}

	// The mirror the birth drew, Effekseer's own flip probability, turns the window around its
	// U: the left and the right corners trade their u, the V the scroll left alone
	if ((particle.drawFlags & XL_PARTICLE_DRAW_FLAG_FLIP_U) != 0u) {
		float u = uv0.x;
		uv0.x = uv1.x;
		uv1.x = u;
	}

	// The corners take the texture as a Sprite does: the top of the quad samples the top of the image
	if (emitter.ringOuter > 0.0f) {
		// Effekseer's ring in the screen plane, the stage's own draw: XL_PARTICLE_RING_CORNERS arc
		// segments, each two color bands wide - inner to middle, middle to outer, the middle edge
		// at the band's half - and each band the quad's own pair of list triangles, the corner
		// order the quad's own. The bands carry the emitter's three colors, each multiplied by the
		// tint the quad would draw; the window maps u along the arc fraction and v across the
		// band, the outer edge at the window's top row as the quad's top, the inner at its bottom
		float rIn;
		float rMid;
		float rOut;
		particleRingRadii(particle, emitter, rIn, rMid, rOut);
		const float vIn = uv1.y;
		const float vOut = uv0.y;
		const float vMid = 0.5f * (vIn + vOut);
		uint at = vertexOffset;
		for (uint s = 0u; s < XL_PARTICLE_RING_CORNERS; ++s) {
			const float f0 = float(s) / float(XL_PARTICLE_RING_CORNERS);
			const float f1 = float(s + 1u) / float(XL_PARTICLE_RING_CORNERS);
			const float u0 = mix(uv0.x, uv1.x, f0);
			const float u1 = mix(uv0.x, uv1.x, f1);
			const vec2 inA = particleRingPoint(particle, emitter, f0, rIn);
			const vec2 inB = particleRingPoint(particle, emitter, f1, rIn);
			const vec2 midA = particleRingPoint(particle, emitter, f0, rMid);
			const vec2 midB = particleRingPoint(particle, emitter, f1, rMid);
			const vec2 outA = particleRingPoint(particle, emitter, f0, rOut);
			const vec2 outB = particleRingPoint(particle, emitter, f1, rOut);
			const vec4 cIn = color * emitter.ringColorInner;
			const vec4 cMid = color * emitter.ringColorMiddle;
			const vec4 cOut = color * emitter.ringColorOuter;
			// the inner band: the quad's (bl, tl, br, tr, br, tl) with the inner edge as its
			// bottom row and the middle as its top
			writeVertex(vertexBuffer, at + 0u, inA, vec2(u0, vIn), cIn, frame.materialIndex);
			writeVertex(vertexBuffer, at + 1u, midA, vec2(u0, vMid), cMid, frame.materialIndex);
			writeVertex(vertexBuffer, at + 2u, inB, vec2(u1, vIn), cIn, frame.materialIndex);
			writeVertex(vertexBuffer, at + 3u, midB, vec2(u1, vMid), cMid, frame.materialIndex);
			writeVertex(vertexBuffer, at + 4u, inB, vec2(u1, vIn), cIn, frame.materialIndex);
			writeVertex(vertexBuffer, at + 5u, midA, vec2(u0, vMid), cMid, frame.materialIndex);
			// the outer band: the middle edge as its bottom row and the outer as its top
			writeVertex(vertexBuffer, at + 6u, midA, vec2(u0, vMid), cMid, frame.materialIndex);
			writeVertex(vertexBuffer, at + 7u, outA, vec2(u0, vOut), cOut, frame.materialIndex);
			writeVertex(vertexBuffer, at + 8u, midB, vec2(u1, vMid), cMid, frame.materialIndex);
			writeVertex(vertexBuffer, at + 9u, outB, vec2(u1, vOut), cOut, frame.materialIndex);
			writeVertex(vertexBuffer, at + 10u, midB, vec2(u1, vMid), cMid, frame.materialIndex);
			writeVertex(vertexBuffer, at + 11u, outA, vec2(u0, vOut), cOut, frame.materialIndex);
			at += 12u;
		}
		return;
	}

	writeVertex(vertexBuffer, vertexOffset + 0, bl, vec2(uv0.x, uv1.y), color, frame.materialIndex);
	writeVertex(vertexBuffer, vertexOffset + 1, tl, vec2(uv0.x, uv0.y), color, frame.materialIndex);
	writeVertex(vertexBuffer, vertexOffset + 2, br, vec2(uv1.x, uv1.y), color, frame.materialIndex);
	writeVertex(vertexBuffer, vertexOffset + 3, tr, vec2(uv1.x, uv0.y), color, frame.materialIndex);
	writeVertex(vertexBuffer, vertexOffset + 4, br, vec2(uv1.x, uv1.y), color, frame.materialIndex);
	writeVertex(vertexBuffer, vertexOffset + 5, tl, vec2(uv0.x, uv0.y), color, frame.materialIndex);
}
