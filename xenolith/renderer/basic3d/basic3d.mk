MODULE_XENOLITH_RENDERER_BASIC3D_SHADERS_DEFINED_IN := $(TOOLKIT_MODULE_PATH)
MODULE_XENOLITH_RENDERER_BASIC3D_SHADERS_PRECOMPILED_HEADERS :=
MODULE_XENOLITH_RENDERER_BASIC3D_SHADERS_SRCS_DIRS :=
MODULE_XENOLITH_RENDERER_BASIC3D_SHADERS_SRCS_OBJS := $(XENOLITH_MODULE_DIR)/renderer/basic3d/glsl/XL3dShaders.cpp
MODULE_XENOLITH_RENDERER_BASIC3D_SHADERS_INCLUDES_DIRS :=
MODULE_XENOLITH_RENDERER_BASIC3D_SHADERS_INCLUDES_OBJS :=
MODULE_XENOLITH_RENDERER_BASIC3D_SHADERS_SHADERS_DIR := $(XENOLITH_MODULE_DIR)/renderer/basic3d/glsl/shaders
MODULE_XENOLITH_RENDERER_BASIC3D_SHADERS_SHADERS_INCLUDE := $(XENOLITH_MODULE_DIR)/renderer/basic3d/glsl/include
MODULE_XENOLITH_RENDERER_BASIC3D_SHADERS_DEPENDS_ON := xenolith_renderer_basic2d_shaders
MODULE_XENOLITH_RENDERER_BASIC3D_SHADERS_PRIVATE_DEPS := $(call sp_toolkit_shaders_objs,\
	$(call sp_toolkit_shaders_files,$(MODULE_XENOLITH_RENDERER_BASIC3D_SHADERS_SHADERS_DIR)))

# module name resolution
$(call define_module, xenolith_renderer_basic3d_shaders, MODULE_XENOLITH_RENDERER_BASIC3D_SHADERS)

MODULE_XENOLITH_RENDERER_BASIC3D_DEFINED_IN := $(TOOLKIT_MODULE_PATH)
MODULE_XENOLITH_RENDERER_BASIC3D_PRIVATE_INCLUDE_PCH := XLCommon.h
MODULE_XENOLITH_RENDERER_BASIC3D_PRECOMPILED_HEADERS :=
MODULE_XENOLITH_RENDERER_BASIC3D_SRCS_DIRS :=
MODULE_XENOLITH_RENDERER_BASIC3D_SRCS_OBJS := $(XENOLITH_MODULE_DIR)/renderer/basic3d/XL3d.cpp
MODULE_XENOLITH_RENDERER_BASIC3D_INCLUDES_DIRS :=
MODULE_XENOLITH_RENDERER_BASIC3D_INCLUDES_OBJS := $(XENOLITH_MODULE_DIR)/renderer/basic3d
MODULE_XENOLITH_RENDERER_BASIC3D_DEPENDS_ON := xenolith_renderer_basic3d_shaders \
	xenolith_renderer_basic2d

#spec

MODULE_XENOLITH_RENDERER_BASIC3D_SHARED_SPEC_SUMMARY := Xenolith basic 3d layer

define MODULE_XENOLITH_RENDERER_BASIC3D_SHARED_SPEC_DESCRIPTION
Module libxenolith-renderer-basic3d draws a depth-tested 3d scene under the basic2d UI:
- Camera (orthographic or perspective, depth in [0, 1])
- Meshes, materials with mip-mapped textures, ambient and sun light
- View3d node, Scene3d with a Vulkan pass before the 2d one
endef

# module name resolution
$(call define_module, xenolith_renderer_basic3d, MODULE_XENOLITH_RENDERER_BASIC3D)
