// The example's pipelines over the 3d pass's interface: the stripes' vertex, the glass's material,
// the view's block and the preambles of the shaders, next to this description, are generated from
// it (docs/usage/tools/xlkdl-gpu.adoc). After a change:
//
//     xlkdl gpu examples/window/basic3d/glsl/basic3d-example.kdl

import "../../../../xenolith/renderer/basic3d/glsl/basic3d.kdl"

schema basic3d_example {
	output "Basic3dExampleData.h"
	guard "EXAMPLES_WINDOW_BASIC3D_GLSL_BASIC3DEXAMPLEDATA_H_"
	namespace "stappler::xenolith::basic3d::example"
	macro-prefix "BASIC3D_EXAMPLE_"
	preambles "."
	copyright "2026 Xenolith Team <admin@xenolith.studio>"
	license "MIT"
}

material Stripes3d doc="The stripes' boxes" {
	first vec4 doc="the first stripes' colour"
	second vec4 doc="the second stripes' colour"
	firstTexture texture2d doc="in place of the first colour, laid over the world's xy"
	secondTexture texture2d doc="in place of the second colour, likewise"
	layers texture-array doc="with STRIPES_LAYERED, in place of the second colour, its layer's"
	layer float
	flags uint doc="STRIPES_SINGLE, STRIPES_LAYERED"
}

const STRIPES_SINGLE 1 type=uint doc="the first colour alone"
const STRIPES_LAYERED 2 type=uint doc="the second colour from the layered texture"

material Glass3d doc="The tinted glass of the translucent pipeline" {
	color vec4 doc="its colour; its alpha comes from the depth behind it"
	density float doc="the alpha is 1 - exp(-density * the distance the view goes through it)"
}

block Example3dView doc="What the example's view gives the pipelines that read it" {
	depthRange float doc="the camera's far - near: a depth difference times it is in world units"
}

vertex Compact3d position=pos doc="The stripes' meshes: a position and a normal, 16 bytes" {
	pos vec3
	normal oct16
}

varyings Stripes3dVaryings doc="What the stripes' vertex shader hands both fragment shaders" {
	normal vec3 doc="in the world"
	world vec3
}

shader basic3d_stripes.vert interface=pass3d varyings=Stripes3dVaryings vertex=Compact3d
shader basic3d_stripes.frag interface=pass3d varyings=Stripes3dVaryings material=Stripes3d
shader basic3d_glass.frag interface=pass3d varyings=Stripes3dVaryings translucent=#true \
	material=Glass3d block=Example3dView
